# Nur auf Vercel nötig (lokal mit `astro dev` gibt es kein Passwort).
# Kurspasswort, das die Studierenden auf /login eingeben
SITE_PASSWORD=
# Zufälliger Schlüssel zum Signieren des Login-Cookies, z. B. `openssl rand -hex 32`
SITE_SESSION_SECRET=
# Einladungslink in den Linear-Workspace für Tag 3, Übung 10 (https://linear.app/<workspace>/join/<code>).
# Wird beim Build in die Seite geschrieben: nach dem Setzen oder Ändern neu deployen. Ohne Wert bleibt der Text mit der E-Mail-Einladung.
LINEAR_INVITE_URL=
# Link zum Miro-Team-Board fürs Innolab (https://miro.com/app/board/<key>/?share_link_id=…).
# Wird beim Build in die Seiten hinter dem Kurspasswort geschrieben: nach dem Setzen oder Ändern neu deployen.
# Ohne Wert bleiben Frame-Hinweise und „Team-Board öffnen“ Text ohne Link.
MIRO_BOARD_URL=
