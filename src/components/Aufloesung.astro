---
// Auflösung einer Übung („erst machen, dann erklären“): verborgen bis `ab` (Wiener Zeit, „2026-10-16T10:10“),
// der Präsentator deckt sie vorher per Knopf auf seinem Bildschirm (Beamer) auf. Steht trotzdem im HTML –
// schützt vor versehentlichem Vorauslesen, nicht vor Absicht. Überschriften darin ohne id, sonst landen sie in Orientierung und „Wo ist Markus“.
// fuer="alle": Den Knopf haben alle – für Arbeitsmaterial mit Pointe (Vorlage, Prompt, Prüfliste), das niemanden
// aussperren darf, wenn der Ablauf früher dran ist oder der Termin wandert. hinweis/knopf: eigene Texte dafür.
// gruppe: Auflösungen mit derselben Gruppe öffnen sich gemeinsam (eine Pointe über zwei Folien, z. B. Video + Erklärung).
import { Eye } from '@lucide/astro';
import { aufloesungAb } from './aufloesung';
const { ab, fuer = 'praesentator', hinweis = 'Die Auflösung erscheint nach der Übung.', knopf = 'Auflösung zeigen', gruppe } = Astro.props as {
  ab: string;
  gruppe?: string;
  fuer?: 'praesentator' | 'alle';
  hinweis?: string;
  knopf?: string;
};
if (!aufloesungAb(ab)) throw new Error(`Aufloesung: ungültiges ab="${ab}", erwartet JJJJ-MM-TTTHH:MM`);
---
<div class="aufloesung" data-aufloesung-ab={ab} data-aufloesung-gruppe={gruppe}>
  <p class="small muted" data-aufloesung-hinweis>{hinweis}</p>
  <button type="button" class="aufloesung-knopf" data-aufloesung-zeigen data-nur-praesentator={fuer === 'praesentator' ? '' : undefined}><Eye size={18} aria-hidden="true" /> {knopf}</button>
  <div data-aufloesung-inhalt hidden><slot /></div>
</div>
<script>
  import { aufgeloest } from './aufloesung';
  document.querySelectorAll<HTMLElement>('[data-aufloesung-ab]').forEach(box => {
    if (box.dataset.bound) return; box.dataset.bound = '1';
    const inhalt = box.querySelector<HTMLElement>('[data-aufloesung-inhalt]');
    const zeigen = () => {
      if (inhalt) inhalt.hidden = false;
      // Der Knopf verschwindet gleich; ohne neuen Fokus spränge die Tastatur an den Seitenanfang.
      if (inhalt && box.contains(document.activeElement)) { inhalt.tabIndex = -1; inhalt.focus({ preventScroll: true }); }
      box.querySelectorAll<HTMLElement>('[data-aufloesung-hinweis], [data-aufloesung-zeigen]').forEach(el => el.remove());
      // Dieselbe Gruppe mit öffnen: deren Knopf auslösen (er ist danach weg, darum keine Endlosschleife).
      const gruppe = box.dataset.aufloesungGruppe;
      if (gruppe) document.querySelectorAll<HTMLElement>(`[data-aufloesung-gruppe="${CSS.escape(gruppe)}"] [data-aufloesung-zeigen]`).forEach(k => k.click());
    };
    box.querySelector('[data-aufloesung-zeigen]')?.addEventListener('click', zeigen);
    const ab = box.dataset.aufloesungAb ?? '';
    if (aufgeloest(ab, new Date())) { zeigen(); return; }
    // Seite bleibt im Kurs offen: jede Minute nachsehen, bis es so weit ist.
    const uhr = setInterval(() => { if (aufgeloest(ab, new Date())) { clearInterval(uhr); zeigen(); } }, 60_000);
  });
</script>
<style>
  .aufloesung-knopf { display: inline-flex; align-items: center; gap: .4rem; font: inherit; padding: .35rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: none; color: inherit; cursor: pointer; }
  .aufloesung-knopf:hover { border-color: var(--accent); }
</style>
