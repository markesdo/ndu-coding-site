---
// Auflösung einer Übung („erst machen, dann erklären“): verborgen bis `ab` (Wiener Zeit, „2026-10-16T10:10“),
// der Präsentator deckt sie vorher per Knopf auf seinem Bildschirm (Beamer) auf. Steht trotzdem im HTML –
// schützt vor versehentlichem Vorauslesen, nicht vor Absicht. Überschriften darin ohne id, sonst landen sie in Orientierung und „Wo ist Markus“.
// fuer="alle": Den Knopf haben alle – für Arbeitsmaterial mit Pointe (Vorlage, Prompt, Prüfliste), das niemanden
// aussperren darf, wenn der Ablauf früher dran ist oder der Termin wandert. hinweis/knopf: eigene Texte dafür.
// gruppe: Auflösungen mit derselben Gruppe öffnen sich gemeinsam (eine Pointe über zwei Folien, z. B. Video + Erklärung).
// Aufdecken für alle (lib/aufgedeckt.ts, api/aufgedeckt.ts): Klickt der Präsentator den Knopf, meldet er die Kennung
// (Gruppe, sonst Knopftext); Seiten der Studierenden fragen am Kurstag nach und öffnen sie. `ab` ist damit nur der späte
// Rückfall, falls niemand aufdeckt – meist das Ende des Kurstags.
import { Eye } from '@lucide/astro';
import { aufloesungAb } from './aufloesung';
const { ab, fuer = 'praesentator', hinweis = 'Die Auflösung erscheint nach der Übung.', knopf = 'Auflösung zeigen', gruppe } = Astro.props as {
  ab: string;
  gruppe?: string;
  fuer?: 'praesentator' | 'alle';
  hinweis?: string;
  knopf?: string;
};
if (!aufloesungAb(ab)) throw new Error(`Aufloesung: ungültiges ab="${ab}", erwartet JJJJ-MM-TTTHH:MM`);
---
<div class="aufloesung" data-aufloesung-ab={ab} data-aufloesung-gruppe={gruppe} data-aufloesung-kennung={gruppe ?? knopf}>
  <p class="small muted" data-aufloesung-hinweis>{hinweis}</p>
  <button type="button" class="aufloesung-knopf" data-aufloesung-zeigen data-nur-praesentator={fuer === 'praesentator' ? '' : undefined}><Eye size={18} aria-hidden="true" /> {knopf}</button>
  <div data-aufloesung-inhalt hidden><slot /></div>
</div>
<script>
  import { aufgeloest } from './aufloesung';
  import { AUFGEDECKT_MS, AUFGEDECKT_TIMEOUT_MS, heuteZuFragen } from '../lib/aufgedeckt';
  import { PRAESENTATOR_SCHLUESSEL } from '../lib/beamer';
  import { abfrageKette, jsonHolen, zeitlimit } from '../lib/kette';
  const praesentatorKey = (): string | null => { try { return localStorage.getItem(PRAESENTATOR_SCHLUESSEL); } catch { return null; } };
  const zuOeffnen = new Map<string, () => void>();
  // Erst alle Knöpfe binden, dann öffnen: Sonst löst eine Box, die schon offen sein soll, den Knopf einer
  // späteren aus derselben Gruppe aus, bevor der einen Listener hat.
  const offen: (() => void)[] = [];
  document.querySelectorAll<HTMLElement>('[data-aufloesung-ab]').forEach(box => {
    if (box.dataset.bound) return; box.dataset.bound = '1';
    const inhalt = box.querySelector<HTMLElement>('[data-aufloesung-inhalt]');
    const zeigen = () => {
      if (inhalt) inhalt.hidden = false;
      // Der Knopf verschwindet gleich; ohne neuen Fokus spränge die Tastatur an den Seitenanfang.
      if (inhalt && box.contains(document.activeElement)) { inhalt.tabIndex = -1; inhalt.focus({ preventScroll: true }); }
      box.querySelectorAll<HTMLElement>('[data-aufloesung-hinweis], [data-aufloesung-zeigen]').forEach(el => el.remove());
      // Dieselbe Gruppe mit öffnen: deren Knopf auslösen (er ist danach weg, darum keine Endlosschleife).
      const gruppe = box.dataset.aufloesungGruppe;
      if (gruppe) document.querySelectorAll<HTMLElement>(`[data-aufloesung-gruppe="${CSS.escape(gruppe)}"] [data-aufloesung-zeigen]`).forEach(k => k.click());
      // Für den Schritt-Hinweis im Beamer (Layout.astro): Öffnet die Uhr die Auflösung, gab es keinen Klick.
      document.dispatchEvent(new Event('aufloesung-offen'));
    };
    const kennung = box.dataset.aufloesungKennung ?? '';
    zuOeffnen.set(kennung, zeigen);
    box.querySelector('[data-aufloesung-zeigen]')?.addEventListener('click', (e) => {
      // Ein echter Klick des Präsentators deckt für alle auf; die Gruppen-Klicks unten sind nicht isTrusted.
      const key = praesentatorKey();
      if (e.isTrusted && key && kennung) {
        fetch('/api/aufgedeckt', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-presenter-key': key }, body: JSON.stringify({ kennung }), signal: zeitlimit(8000) })
          .catch((err) => console.warn('[aufloesung] Aufdecken nicht gemeldet:', err));
      }
      zeigen();
    });
    const ab = box.dataset.aufloesungAb ?? '';
    if (aufgeloest(ab, new Date())) { offen.push(zeigen); return; }
    // Seite bleibt im Kurs offen: jede Minute nachsehen, bis es so weit ist.
    const uhr = setInterval(() => { if (aufgeloest(ab, new Date())) { clearInterval(uhr); zeigen(); } }, 60_000);
  });
  offen.forEach(zeigen => zeigen());

  // Studierende: am Kurstag nachfragen, was der Präsentator aufgedeckt hat. Nur solange heute noch etwas zu ist,
  // nur im sichtbaren Tab, nicht beim Präsentator selbst (der deckt per Knopf auf).
  const geschlossen = () => [...document.querySelectorAll<HTMLElement>('[data-aufloesung-ab]')]
    .filter((b) => b.querySelector('[data-aufloesung-inhalt][hidden]'));
  if (!praesentatorKey() && heuteZuFragen(geschlossen().map((b) => b.dataset.aufloesungAb ?? ''), new Date())) {
    const kette = abfrageKette({
      ruheMs: AUFGEDECKT_MS,
      ruht: () => document.hidden,
      runde: async () => {
        try {
          const d = (await jsonHolen('/api/aufgedeckt', AUFGEDECKT_TIMEOUT_MS)) as { offen?: unknown };
          for (const k of Array.isArray(d.offen) ? d.offen : []) if (typeof k === 'string') zuOeffnen.get(k)?.();
        } catch {
          // Netz weg oder lokal ohne API: die Uhrzeit bleibt der Rückfall.
        }
        // Alles offen (oder Kurstag vorbei): nur noch selten nachsehen – die Kette kennt kein Ende.
        return heuteZuFragen(geschlossen().map((b) => b.dataset.aufloesungAb ?? ''), new Date()) ? AUFGEDECKT_MS : 10 * 60_000;
      },
    });
    kette.sofort();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) kette.sofort(); });
  }
</script>
<style>
  .aufloesung-knopf { display: inline-flex; align-items: center; gap: .4rem; font: inherit; padding: .35rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: none; color: inherit; cursor: pointer; }
  .aufloesung-knopf:hover { border-color: var(--accent); }
</style>
