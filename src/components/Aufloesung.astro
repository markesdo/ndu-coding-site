---
// Auflösung einer Übung („erst machen, dann erklären“): verborgen bis `ab` (Wiener Zeit, „2026-10-16T10:10“),
// der Präsentator deckt sie vorher per Knopf auf seinem Bildschirm (Beamer) auf. Steht trotzdem im HTML –
// schützt vor versehentlichem Vorauslesen, nicht vor Absicht. Überschriften darin ohne id, sonst landen sie in Orientierung und „Wo ist Markus“.
// fuer="alle": Den Knopf haben alle – für Arbeitsmaterial mit Pointe (Vorlage, Prompt, Prüfliste), das niemanden
// aussperren darf, wenn der Ablauf früher dran ist oder der Termin wandert. hinweis/knopf: eigene Texte dafür.
// gruppe: Auflösungen mit derselben Gruppe öffnen sich gemeinsam (eine Pointe über zwei Folien, z. B. Video + Erklärung) –
// wenn der Präsentator aufdeckt oder die Uhrzeit erreicht ist; ein Klick der Studierenden öffnet nur die eine Box.
// Aufdecken für alle (lib/aufgedeckt.ts, api/aufgedeckt.ts): Klickt der Präsentator im Beamer-Modus den Knopf (oder →),
// meldet er die Kennung (Gruppe, sonst Seite + Knopftext, aufloesungKennung); die anderen Seiten fragen nach, solange
// etwas zu ist, und öffnen sie. `ab` ist damit nur der späte Rückfall, falls niemand aufdeckt – meist das Ende des Kurstags.
import { Eye } from '@lucide/astro';
import { aufloesungAb, aufloesungKennung } from './aufloesung';
import { kennungFehler } from '../lib/aufgedeckt';
const { ab, fuer = 'praesentator', hinweis = 'Die Auflösung erscheint nach der Übung.', knopf = 'Auflösung zeigen', gruppe } = Astro.props as {
  ab: string;
  gruppe?: string;
  fuer?: 'praesentator' | 'alle';
  hinweis?: string;
  knopf?: string;
};
if (!aufloesungAb(ab)) throw new Error(`Aufloesung: ungültiges ab="${ab}", erwartet JJJJ-MM-TTTHH:MM`);
// Die Kennung muss beim Server genauso ankommen (lib/aufgedeckt.ts), sonst fände die Seite ihre Meldung nicht.
const kennung = aufloesungKennung(Astro.url.pathname, gruppe, knopf);
const fehler = kennungFehler(gruppe, knopf, kennung);
if (fehler) throw new Error(`Aufloesung auf ${Astro.url.pathname}: ${fehler}`);
---
<div class="aufloesung" data-aufloesung-ab={ab} data-aufloesung-gruppe={gruppe} data-aufloesung-kennung={kennung}>
  <p class="small muted" data-aufloesung-hinweis>{hinweis}</p>
  <button type="button" class="aufloesung-knopf" data-aufloesung-zeigen data-nur-praesentator={fuer === 'praesentator' ? '' : undefined}><Eye size={18} aria-hidden="true" /> {knopf}</button>
  <div data-aufloesung-inhalt hidden><slot /></div>
</div>
<script>
  import { aufgeloest, aufloesungSteuerung, type AufloesungBox } from './aufloesung';
  import { hinweis } from './hinweis';
  import { AUFGEDECKT_MS, MELDEN_TIMEOUT_MS, abfrageAbstand, aufdeckenMelden, aufgedecktHolen } from '../lib/aufgedeckt';
  import { PRAESENTATOR_SCHLUESSEL } from '../lib/beamer';
  import { abfrageKette, zeitlimit, type Kette } from '../lib/kette';
  const praesentatorKey = (): string | null => { try { return localStorage.getItem(PRAESENTATOR_SCHLUESSEL); } catch { return null; } };
  const imBeamer = () => document.documentElement.hasAttribute('data-beamer');
  const melden = (kennung: string) => {
    const key = praesentatorKey();
    if (!key) return;
    void aufdeckenMelden({
      senden: () => fetch('/api/aufgedeckt', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-presenter-key': key }, body: JSON.stringify({ kennung }), signal: zeitlimit(MELDEN_TIMEOUT_MS) }),
      warten: (ms) => new Promise((r) => setTimeout(r, ms)),
      hinweis: (text) => hinweis(text, 8000),
    });
  };
  // Erst alle Boxen anmelden, dann öffnen: Eine Box, die schon offen sein soll, öffnet ihre Gruppe mit.
  const boxen: (AufloesungBox & { el: HTMLElement })[] = [];
  const steuerung = aufloesungSteuerung(boxen, melden);
  const istZu = (el: HTMLElement) => !!el.querySelector('[data-aufloesung-inhalt][hidden]');
  document.querySelectorAll<HTMLElement>('[data-aufloesung-ab]').forEach(el => {
    if (el.dataset.bound) return; el.dataset.bound = '1';
    const inhalt = el.querySelector<HTMLElement>('[data-aufloesung-inhalt]');
    const oeffnen = () => {
      if (!inhalt || !inhalt.hidden) return;
      inhalt.hidden = false;
      // Der Knopf verschwindet gleich; ohne neuen Fokus spränge die Tastatur an den Seitenanfang.
      if (el.contains(document.activeElement)) { inhalt.tabIndex = -1; inhalt.focus({ preventScroll: true }); }
      el.querySelectorAll<HTMLElement>('[data-aufloesung-hinweis], [data-aufloesung-zeigen]').forEach(x => x.remove());
      // Für den Schritt-Hinweis im Beamer (Layout.astro): Öffnet die Uhr die Auflösung, gab es keinen Klick.
      document.dispatchEvent(new Event('aufloesung-offen'));
    };
    const box = { el, kennung: el.dataset.aufloesungKennung ?? '', gruppe: el.dataset.aufloesungGruppe, oeffnen };
    boxen.push(box);
    // Auch der synthetische Klick der Pfeiltaste im Beamer (Layout.astro, knopf.click()) kommt hier an und meldet.
    el.querySelector('[data-aufloesung-zeigen]')?.addEventListener('click', () =>
      steuerung.knopf(box, !praesentatorKey() ? 'studi' : imBeamer() ? 'beamer' : 'praesentator'));
  });
  const uhrPruefen = () => { for (const b of boxen) if (istZu(b.el) && aufgeloest(b.el.dataset.aufloesungAb ?? '', new Date())) steuerung.uhr(b); };
  uhrPruefen();

  // Nachfragen, was der Präsentator aufgedeckt hat: Studierende und Geräte des Präsentators außerhalb des Beamers (der
  // Beamer-Tab deckt selbst auf). Solange etwas zu ist und der Tab sichtbar – oft, wenn eine geschlossene Auflösung heute
  // fällig wird, sonst selten (Termine wandern). Ist alles offen, hört die Kette auf; jede Minute und beim Zurückkehren in
  // den Tab wird neu entschieden.
  const zu = () => boxen.filter((b) => istZu(b.el));
  const abstand = () => (imBeamer() ? null : abfrageAbstand(zu().map((b) => b.el.dataset.aufloesungAb ?? ''), new Date()));
  let kette: Kette | null = null;
  const nachfragen = () => {
    if (kette) { kette.sofort(); return; }
    if (document.hidden || abstand() === null) return;
    const k = abfrageKette({
      ruheMs: AUFGEDECKT_MS,
      ruht: () => document.hidden,
      runde: async () => {
        try {
          for (const kennung of await aufgedecktHolen([...new Set(zu().map((b) => b.kennung))])) steuerung.aufgedeckt(kennung);
        } catch {
          // Netz weg oder lokal ohne API: die Uhrzeit bleibt der Rückfall.
        }
        const ms = abstand();
        if (ms === null) { k.stoppen(); kette = null; }
        return ms ?? AUFGEDECKT_MS;
      },
    });
    kette = k;
    k.sofort();
  };
  nachfragen();
  // Seite bleibt im Kurs offen: jede Minute die Uhrzeit prüfen und ob sich das Nachfragen (wieder) lohnt.
  setInterval(() => { uhrPruefen(); if (!kette) nachfragen(); }, 60_000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) nachfragen(); });
</script>
<style>
  .aufloesung-knopf { display: inline-flex; align-items: center; gap: .4rem; font: inherit; padding: .35rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: none; color: inherit; cursor: pointer; }
  .aufloesung-knopf:hover { border-color: var(--accent); }
</style>
