---
// Antwortrunde (lib/antworten.ts, api/antworten.ts): Studierende schicken einen Satz über die Seite.
// ansicht="eingabe": Rollen-Knöpfe (mit „vergeben“, wenn die Rolle schon geantwortet hat – trotzdem wählbar, um die
// eigene Antwort zu ändern), Eingabe, Abschicken und „2 von 3 haben geantwortet“. Präsentator und Beamer sehen nur
// die Statuszeile (Markus antwortet nicht selbst; der Beamer zeigt, was alle sehen).
// ansicht="antworten": „Eure Sätze“ nach Rolle – gehört in die <Aufloesung gruppe=…> der Runde; der Server gibt die Texte
// erst nach dem Aufdecken heraus. Fragt nur nach, solange der Block zu sehen ist und der Tab vorn.
// Eine Abfrage pro Seite und Runde (beide Ansichten teilen sie), nur solange ein Block zu sehen ist; nach dem Aufdecken
// nur noch alle 30 s (öffnet „Runde leeren“ die Runde wieder, kommt die Eingabe zurück). Fällt die API aus (503, Netz), steht „Antwort bitte laut sagen.“ da – reihum laut bleibt der Rückfall.
// Ein Platz pro Rolle (api/antworten.ts): Wer abschickt, überschreibt die Antwort seiner Rolle. Die eigene Antwort merkt
// sich der Browser nur zum Vorausfüllen. „Runde leeren“: nur Präsentator, nicht im Beamer.
// Texte immer als textContent, nie als HTML.
import { MAX_TEXT, RUNDEN, eingabeTexte } from '../lib/antworten';
const { runde, ansicht } = Astro.props as { runde: string; ansicht: 'eingabe' | 'antworten' };
const r = RUNDEN[runde];
if (!r) throw new Error(`Antwortrunde: unbekannte runde="${runde}"`);
// „2 von 3 haben geantwortet“: ein Platz pro Rolle.
const erwartet = r.rollen.length;
const feld = `antwort-${runde}`;
const texte = eingabeTexte(r);
---
<div class="antwortrunde" data-antwortrunde={runde} data-kennung={r.kennung} data-hinweis={texte.hinweis} data-ansicht={ansicht} data-erwartet={erwartet} data-rollen={JSON.stringify(r.rollen)}>
  {ansicht === 'eingabe' ? (
    <div class="ar-eingabe" data-ar-eingabe hidden>
      <p class="ar-schritt">Antwort hier auf der Seite: <span data-ar-hinweis>{texte.hinweis}</span></p>
      {r.rollen.length > 0 && (
        <div class="ar-rollen" role="group" aria-label="Deine Rolle">
          {r.rollen.map((x) => <button type="button" class="ar-rolle" data-ar-rolle={x.id} aria-pressed="false">{x.label}<span class="ar-vergeben" data-ar-vergeben hidden> · vergeben</span></button>)}
        </div>
      )}
      <form class="ar-form" data-ar-form hidden={r.rollen.length > 0}>
        <label for={feld}>{texte.label}</label>
        <div class="ar-zeile">
          <textarea id={feld} rows="2" maxlength={MAX_TEXT} required placeholder={texte.platzhalter || undefined} data-ar-text></textarea>
          <button type="submit" class="ar-senden">Abschicken</button>
        </div>
      </form>
      <p class="small ar-meldung" data-ar-meldung role="status" aria-live="polite"></p>
      <p class="small" data-ar-gesendet hidden>Gesendet – du kannst bis zum Aufdecken noch ändern.</p>
    </div>
  ) : (
    <div class="ar-antworten">
      <p class="ar-titel"><strong>Eure Sätze</strong></p>
      <ul class="ar-liste" data-ar-liste></ul>
    </div>
  )}
  <p class="small muted ar-status" data-ar-status aria-live="polite"></p>
  {ansicht === 'eingabe' && <button type="button" class="ar-leeren small" data-ar-leeren data-nur-praesentator>Runde leeren</button>}
  <p class="small ar-rueckfall" data-ar-rueckfall hidden>{ansicht === 'eingabe' ? 'Antwort bitte laut sagen.' : 'Sagt eure Sätze laut, reihum.'}</p>
</div>
<script>
  import {
    ANTWORTEN_FREI_MS, ANTWORTEN_MS, ANTWORTEN_TIMEOUT_MS, antwortenGruppieren, betrifftRunde, gesendetGilt, rolleBesetzt, rolleWaehlbar, statusText,
    textPruefen, type Rolle, type Stand,
  } from '../lib/antworten';
  import { wienerZeit } from './jetzt';
  import { abfrageKette, jsonHolen, zeitlimit, type Kette } from '../lib/kette';
  import { PRAESENTATOR_SCHLUESSEL } from '../lib/beamer';
  import { AUFGEDECKT_GEMELDET } from '../lib/aufgedeckt';
  import { hinweis } from './hinweis';

  const lesen = (k: string): string | null => {
    try { return localStorage.getItem(k); } catch { try { return sessionStorage.getItem(k); } catch { return null; } }
  };
  const schreiben = (k: string, v: string) => {
    try { localStorage.setItem(k, v); return; } catch { /* privat/gesperrt */ }
    try { sessionStorage.setItem(k, v); } catch { /* dann nur für diesen Aufruf */ }
  };
  type Eigene = { rolle: string; text: string };
  const eigeneSchluessel = (runde: string) => `ndu-antwort:${runde}:${wienerZeit(new Date()).datum}`;
  const eigeneLesen = (runde: string): Eigene | null => {
    try { const e = JSON.parse(lesen(eigeneSchluessel(runde)) ?? 'null'); return e && typeof e.text === 'string' && typeof e.rolle === 'string' ? e : null; } catch { return null; }
  };

  // Eine gemeinsame Abfrage pro Runde für alle Blöcke der Seite.
  type Block = { el: HTMLElement; sichtbar: boolean; zeigen: (s: Stand) => void; fehler: () => void };
  const abfragen = new Map<string, { bloecke: Block[]; kette: Kette }>();
  const abfrage = (runde: string) => {
    let a = abfragen.get(runde);
    if (a) return a;
    const bloecke: Block[] = [];
    const kette = abfrageKette({
      ruheMs: ANTWORTEN_MS,
      ruht: () => document.hidden || !bloecke.some((b) => b.sichtbar),
      runde: async () => {
        try {
          const s = (await jsonHolen(`/api/antworten?runde=${encodeURIComponent(runde)}`, ANTWORTEN_TIMEOUT_MS)) as Stand;
          bloecke.forEach((b) => b.zeigen(s));
          return s.frei ? ANTWORTEN_FREI_MS : ANTWORTEN_MS;
        } catch {
          bloecke.forEach((b) => b.fehler());
          return ANTWORTEN_MS;
        }
      },
    });
    a = { bloecke, kette };
    abfragen.set(runde, a);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && bloecke.some((b) => b.sichtbar)) kette.sofort(); });
    // Präsentator hat aufgedeckt und der Server hat es gespeichert: gleich neu fragen statt bis zu 4 s „zu“ zu zeigen.
    const kennung = document.querySelector<HTMLElement>(`[data-antwortrunde="${CSS.escape(runde)}"]`)?.dataset.kennung ?? '';
    document.addEventListener(AUFGEDECKT_GEMELDET, (e) => { if (betrifftRunde({ kennung }, (e as CustomEvent).detail)) kette.sofort(); });
    return a;
  };

  document.querySelectorAll<HTMLElement>('[data-antwortrunde]').forEach((box) => {
    if (box.dataset.bound) return; box.dataset.bound = '1';
    const runde = box.dataset.antwortrunde ?? '';
    const eingabe = box.dataset.ansicht === 'eingabe';
    const erwartet = Number(box.dataset.erwartet) || 3;
    const rollen = JSON.parse(box.dataset.rollen ?? '[]') as Rolle[];
    const q = <T extends HTMLElement>(s: string) => box.querySelector<T>(s);
    const status = q('[data-ar-status]')!;
    const rueckfall = q('[data-ar-rueckfall]')!;
    const meldung = q('[data-ar-meldung]');
    const bereich = q('[data-ar-eingabe]');
    const form = q<HTMLFormElement>('[data-ar-form]');
    const feld = q<HTMLTextAreaElement>('[data-ar-text]');
    const gesendet = q('[data-ar-gesendet]');
    const liste = q('[data-ar-liste]');
    const knoepfe = [...box.querySelectorAll<HTMLButtonElement>('[data-ar-rolle]')];
    const melden = (t: string) => { if (meldung) meldung.textContent = t; };
    const BESETZT = 'Diese Rolle hat schon jemand – wählt eine andere.';

    let rolle: string | null = null;
    let frei = false;
    let vergeben: string[] = [];
    // Rolle, die dieser Browser selbst abgeschickt hat und die laut Server noch gilt.
    let eigeneRolle: string | null = null;
    const rolleWaehlen = (id: string | null) => {
      rolle = id;
      knoepfe.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.arRolle === id)));
      if (form && id) form.hidden = false;
      melden(rolleBesetzt(vergeben, rolle, eigeneRolle) ? BESETZT : '');
    };
    const eigene = eingabe ? eigeneLesen(runde) : null;
    const hinweisRolle = q('[data-ar-hinweis]');
    // Nach dem Senden ist die Rolle fest (ein Browser, ein Platz); nach „Runde leeren“ wieder frei.
    const knoepfeAktualisieren = () => {
      knoepfe.forEach((k) => {
        const id = k.dataset.arRolle ?? '';
        k.querySelector<HTMLElement>('[data-ar-vergeben]')!.hidden = !vergeben.includes(id);
        k.disabled = !rolleWaehlbar(id, vergeben, eigeneRolle);
      });
      const label = rollen.find((r) => r.id === eigeneRolle)?.label;
      if (hinweisRolle) hinweisRolle.textContent = label ? `deine Rolle ist ${label} – ändern kannst du deine Antwort, nicht die Rolle.` : (box.dataset.hinweis ?? '');
    };
    if (eigene) { eigeneRolle = eigene.rolle; rolleWaehlen(eigene.rolle); if (feld) feld.value = eigene.text; if (gesendet) gesendet.hidden = false; }
    knoepfeAktualisieren();
    knoepfe.forEach((k) => k.addEventListener('click', () => { rolleWaehlen(k.dataset.arRolle ?? null); feld?.focus(); }));

    const zeigen = (s: Stand) => {
      frei = s.frei;
      vergeben = s.vergeben;
      rueckfall.hidden = true;
      if (eingabe) {
        if (bereich) bereich.hidden = frei;
        // Nach „Runde leeren“ ist die eigene Rolle frei: „Gesendet“ weg, Text bleibt zum erneuten Abschicken.
        if (eigeneRolle !== null && !gesendetGilt(vergeben, eigeneRolle)) eigeneRolle = null;
        knoepfeAktualisieren();
        if (gesendet) gesendet.hidden = eigeneRolle === null;
        if (meldung?.textContent === BESETZT && !rolleBesetzt(vergeben, rolle, eigeneRolle)) melden('');
        status.textContent = frei ? 'Aufgedeckt – eure Sätze stehen auf der nächsten Folie.' : statusText(s.anzahl, erwartet);
        return;
      }
      if (!liste) return;
      if (!frei) { liste.replaceChildren(); status.textContent = `${statusText(s.anzahl, erwartet)} Die Sätze erscheinen nach dem Aufdecken.`; return; }
      const gruppen = antwortenGruppieren(rollen, s.antworten ?? []);
      liste.replaceChildren(...gruppen.map((g) => {
        const li = document.createElement('li');
        const b = document.createElement('strong');
        b.textContent = `${g.label}: `;
        li.append(b, g.texte.map((t) => `„${t}“`).join(' · '));
        return li;
      }));
      status.textContent = gruppen.length ? '' : 'Keine Sätze über die Seite – dann reihum laut.';
    };
    const a = abfrage(runde);
    const block: Block = { el: box, sichtbar: false, zeigen, fehler: () => { rueckfall.hidden = false; } };
    a.bloecke.push(block);
    new IntersectionObserver((e) => {
      const vorher = block.sichtbar;
      block.sichtbar = e.some((x) => x.isIntersecting);
      if (block.sichtbar && !vorher) a.kette.sofort();
    }).observe(box);

    q<HTMLButtonElement>('[data-ar-leeren]')?.addEventListener('click', async () => {
      const key = lesen(PRAESENTATOR_SCHLUESSEL);
      if (!key || !confirm('Alle Antworten dieser Runde von heute löschen und das Aufdecken zurücknehmen?')) return;
      try {
        const r = await fetch('/api/antworten', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'x-presenter-key': key },
          body: JSON.stringify({ runde, leeren: true }), signal: zeitlimit(ANTWORTEN_TIMEOUT_MS),
        });
        hinweis(r.ok && !r.redirected ? 'Runde geleert, Aufdecken zurückgenommen.' : `Runde nicht geleert (Status ${r.status}).`, 6000);
      } catch {
        hinweis('Runde nicht geleert (Netz).', 6000);
      }
      a.kette.sofort();
    });

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!feld || frei) return; // nach dem Aufdecken nichts mehr schicken
      const p = textPruefen(feld.value);
      if ('fehler' in p) { melden(p.fehler === 'leer' ? 'Bitte einen Satz eingeben.' : `Bitte höchstens ${feld.maxLength} Zeichen.`); feld.focus(); return; }
      if (!rolle) { melden('Bitte zuerst deine Rolle wählen.'); return; }
      if (rolleBesetzt(vergeben, rolle, eigeneRolle)) { melden(BESETZT); return; }
      const knopf = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (knopf) knopf.disabled = true;
      const e: Eigene = { rolle, text: p.text };
      try {
        const r = await fetch('/api/antworten', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ runde, ...e }), signal: zeitlimit(ANTWORTEN_TIMEOUT_MS),
        });
        const st = r.redirected ? 0 : r.status;
        if (st === 200) {
          schreiben(eigeneSchluessel(runde), JSON.stringify(e));
          eigeneRolle = e.rolle;
          if (!vergeben.includes(e.rolle)) vergeben = [...vergeben, e.rolle];
          knoepfeAktualisieren();
          if (gesendet) gesendet.hidden = false;
          melden('');
          a.kette.sofort();
        } else if (st === 409) { melden('Schon aufgedeckt – Senden geht nicht mehr.'); a.kette.sofort(); }
        else if (st === 400) { melden(`Bitte einen Satz mit höchstens ${feld.maxLength} Zeichen.`); }
        else { melden('Nicht gesendet.'); rueckfall.hidden = false; }
      } catch {
        melden('Nicht gesendet.');
        rueckfall.hidden = false;
      } finally {
        if (knopf) knopf.disabled = false;
      }
    });
  });
</script>
<style>
  .antwortrunde { margin: .4rem 0; }
  /* Eingabe als eigene Fläche, damit sie sich vom Folientext abhebt. */
  .ar-eingabe { border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 10px; background: var(--bg-2); padding: .8rem 1rem .7rem; }
  .ar-schritt { margin: 0 0 .6rem; font-weight: 600; }
  .ar-schritt span { font-weight: 400; color: var(--muted); }
  .ar-rollen { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .6rem; }
  .ar-rolle, .ar-senden { font: inherit; font-weight: 700; min-height: 44px; padding: .5rem 1.2rem; border: 2px solid var(--accent); border-radius: 10px; background: var(--accent-soft); color: var(--fg); cursor: pointer; transition: background-color .12s, color .12s; }
  .ar-rolle:hover:not(:disabled), .ar-rolle:focus-visible { background: color-mix(in srgb, var(--accent) 35%, var(--bg-2)); }
  .ar-rolle:focus-visible, .ar-senden:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  /* Gewählt und Abschicken: gefüllt; Hover dunkelt nur leicht ab, damit es nicht wie gesperrt aussieht. */
  .ar-rolle[aria-pressed='true'], .ar-senden { background: var(--accent); color: var(--on-accent); }
  .ar-rolle[aria-pressed='true']:hover:not(:disabled), .ar-senden:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 85%, var(--fg)); }
  .ar-rolle:disabled { opacity: .45; cursor: not-allowed; border-color: var(--border); background: none; color: var(--fg); }
  .ar-rolle[aria-pressed='true'] .ar-vergeben { color: inherit; }
  .ar-senden:disabled { opacity: .5; cursor: wait; }
  .ar-form label { display: block; font-size: .9rem; margin-bottom: .2rem; }
  .ar-zeile { display: flex; gap: .5rem; align-items: flex-start; }
  .ar-zeile textarea { flex: 1; min-width: 0; font: inherit; padding: .45rem .6rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: inherit; resize: vertical; }
  .ar-status:empty { display: none; }
  .ar-vergeben { font-weight: 400; color: var(--muted); }
  .ar-leeren { font: inherit; padding: .15rem .6rem; border: 1px solid var(--border); border-radius: 6px; background: none; color: var(--muted); cursor: pointer; }
  :global(html[data-beamer]) .ar-leeren { display: none; }
  .ar-status, .ar-rueckfall, [data-ar-gesendet], .ar-meldung { margin: .3rem 0; }
  .ar-meldung:empty { display: none; }
  .ar-titel { margin: 0 0 .2rem; }
  .ar-liste { margin: 0 0 .3rem; font-size: .95em; }
  .ar-liste:empty { display: none; }
  .ar-liste li { overflow-wrap: anywhere; line-height: 1.35; margin: 0 0 .15rem; }
  /* Markus antwortet nicht selbst; im Beamer nur die Statuszeile. */
  :global(html[data-ist-praesentator]) .ar-eingabe, :global(html[data-beamer]) .ar-eingabe { display: none; }
  @media (max-width: 520px) { .ar-zeile { flex-direction: column; align-items: stretch; } }
</style>
