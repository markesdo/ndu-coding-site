---
// Logo und Kursname (marke-name.ts) – Seitenleiste, Kopfleiste (Layout.astro), Login und Startseite.
// Der Name ist ein einziges Wort: Bei schmaler Spalte oder großer Grundschrift bricht er nach „programmieren_“ um,
// notfalls auch mitten im Wort – nie über den Rand. Die Kopfleiste (einzeilig) kürzt stattdessen mit „…“; dort ohne <wbr>,
// denn Chrome bricht an <wbr> auch bei white-space: nowrap um.
// name: pro Kurs (lib/navigation.ts) – „innolab_2026“ im Innolab; ohne Angabe der Name des Coding-Kurses.
import { STANDARD_MARKE, markeTeilen } from './marke-name';
const { einzeilig = false, name = STANDARD_MARKE } = Astro.props as { einzeilig?: boolean; name?: string };
const [vorne, hinten] = markeTeilen(name);
---
<span class="brand-mark" aria-hidden="true">›<i></i></span>{einzeilig || !hinten
  ? <span class="brand-name">{name}</span>
  : <span class="brand-name">{vorne}<wbr />{hinten}</span>}

<style is:global>
  .brand-name { min-width: 0; overflow-wrap: anywhere; line-height: 1.25; }
</style>
