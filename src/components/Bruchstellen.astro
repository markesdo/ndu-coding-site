---
// Vier typische Bruchstellen am Handy (/konzepte/responsive): je ein Mini-Bildschirm vorher und nachher, reines HTML/CSS.
// Die Mini-Bildschirme bleiben wie die Mini-Apps der Animationen auch im Dark Mode hell.
import { Menu } from '@lucide/astro';
---
<div class="bs">
  <section class="bs-fall" aria-labelledby="bs-wort">
    <h3 id="bs-wort">1 · Ein langes Wort</h3>
    <div class="bs-paar">
      <figure><div class="bs-handy bs-kaputt" lang="de"><p class="bs-gross">Ausleihbestätigung</p><p class="bs-text">Deine Anfrage ist da.</p></div><figcaption>vorher</figcaption></figure>
      <figure><div class="bs-handy" lang="de"><p class="bs-gross bs-trennen">Ausleihbestätigung</p><p class="bs-text">Deine Anfrage ist da.</p></div><figcaption>nachher</figcaption></figure>
    </div>
    <p class="small">Deutsche Komposita sind länger als jede englische Vorlage. Lange Wörter dürfen umbrechen – mit Trennstrich (<code>hyphens-auto</code>, die Seite braucht dafür <code>lang="de"</code>).</p>
  </section>

  <section class="bs-fall" aria-labelledby="bs-tippen">
    <h3 id="bs-tippen">2 · Zu klein zum Antippen</h3>
    <div class="bs-paar">
      <figure><div class="bs-handy bs-kaputt"><p class="bs-text"><b>Zelt</b> · 5 € pro Tag</p><p class="bs-winzig"><span>Bearbeiten</span> <span>Löschen</span></p></div><figcaption>vorher</figcaption></figure>
      <figure><div class="bs-handy"><p class="bs-text"><b>Zelt</b> · 5 € pro Tag</p><p class="bs-knoepfe"><span>Bearbeiten</span><span>Löschen</span></p></div><figcaption>nachher</figcaption></figure>
    </div>
    <p class="small">Ein Finger trifft keine 16 px. Kursregel: Alles Antippbare ist mindestens 44 px hoch und hat Abstand zum Nachbarn. (Die Richtlinie WCAG verlangt mindestens 24 px.)</p>
  </section>

  <section class="bs-fall" aria-labelledby="bs-tabelle">
    <h3 id="bs-tabelle">3 · Eine breite Tabelle</h3>
    <div class="bs-paar">
      <figure><div class="bs-handy bs-kaputt"><table class="bs-tab"><tr><th>Gegenstand</th><th>Ort</th><th>Preis</th><th>Status</th></tr><tr><td>Bohrmaschine</td><td>Krems</td><td>3 €</td><td>verliehen</td></tr><tr><td>Zelt</td><td>Tulln</td><td>5 €</td><td>frei</td></tr></table></div><figcaption>vorher</figcaption></figure>
      <figure><div class="bs-handy"><div class="bs-karte"><b>Bohrmaschine</b><span>3 € · verliehen</span></div><div class="bs-karte"><b>Zelt</b><span>5 € · frei</span></div></div><figcaption>nachher</figcaption></figure>
    </div>
    <p class="small">Am Handy wird aus jeder Zeile eine Karte. Welche Spalten dort fehlen dürfen – hier der Ort –, ist eine Produktentscheidung.</p>
  </section>

  <section class="bs-fall" aria-labelledby="bs-kopf">
    <h3 id="bs-kopf">4 · Der Kopf bricht um</h3>
    <div class="bs-paar">
      <figure><div class="bs-handy bs-kaputt"><p class="bs-kopfzeile"><b>Leihbar</b> <span>Gegenstände</span> <span>Anfragen</span> <span>Profil</span> <span>Abmelden</span></p></div><figcaption>vorher</figcaption></figure>
      <figure><div class="bs-handy"><p class="bs-kopfzeile bs-einzeilig"><b>Leihbar</b> <Menu size={16} aria-label="Menü" /></p></div><figcaption>nachher</figcaption></figure>
    </div>
    <p class="small">Vier Links passen nicht neben das Logo. Am Handy kommt die Navigation hinter einen Menü-Knopf – oder es bleiben nur die zwei wichtigsten.</p>
  </section>
</div>

<style>
  .bs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
  @media (max-width: 720px) { .bs { grid-template-columns: 1fr; } }
  .bs-fall { border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); padding: .9rem 1rem; }
  .bs-fall h3 { margin: 0 0 .6rem; font-size: 1rem; }
  .bs-fall > p { margin: .6rem 0 0; }
  .bs-paar { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .bs-paar figure { margin: 0; min-width: 0; }
  .bs-paar figcaption { font-size: .78rem; color: var(--muted); text-align: center; margin-top: .3rem; }
  .bs-paar figure:last-child figcaption { color: var(--green); font-weight: 600; }
  /* Wie ein echter Bildschirm: Was über den Rand geht, ist abgeschnitten. */
  .bs-handy {
    --app-bg: #fafaf7; --app-card: #ffffff; --app-fg: #16161a; --app-muted: #6b6b76; --app-border: #e6e4de; --app-accent: #e8472b;
    background: var(--app-bg); color: var(--app-fg); border: 2px solid var(--app-fg); border-radius: 10px;
    width: 100%; max-width: 8.5rem; height: 7.5rem; margin: 0 auto; padding: .45rem; box-sizing: border-box;
    font-size: .72rem; line-height: 1.3; overflow: hidden; display: grid; align-content: start; gap: .35rem;
  }
  .bs-handy p { margin: 0; }
  .bs-kaputt { border-color: var(--app-accent); }
  .bs-gross { font-size: 1.35rem; font-weight: 700; line-height: 1.1; white-space: nowrap; }
  .bs-trennen { white-space: normal; hyphens: auto; overflow-wrap: break-word; }
  .bs-text { color: var(--app-muted); }
  .bs-text b { color: var(--app-fg); }
  .bs-winzig { font-size: .6rem; display: flex; gap: .2rem; }
  .bs-winzig span { color: var(--app-accent); text-decoration: underline; }
  .bs-knoepfe { display: grid; gap: .3rem; }
  .bs-knoepfe span { display: grid; place-items: center; min-height: 1.6rem; border: 1px solid var(--app-border); border-radius: 6px; background: var(--app-card); font-weight: 600; }
  .bs-tab { border-collapse: collapse; font-size: .62rem; white-space: nowrap; background: var(--app-card); }
  .bs-tab th, .bs-tab td { border: 1px solid var(--app-border); padding: .1rem .25rem; text-align: left; color: var(--app-fg); background: none; }
  .bs-tab th { font: inherit; font-weight: 700; text-transform: none; letter-spacing: 0; }
  .bs-karte { display: grid; background: var(--app-card); border: 1px solid var(--app-border); border-radius: 6px; padding: .25rem .35rem; }
  .bs-karte span { color: var(--app-muted); }
  .bs-kopfzeile { display: flex; flex-wrap: wrap; gap: .1rem .4rem; align-items: center; border-bottom: 1px solid var(--app-border); padding-bottom: .3rem; }
  .bs-kopfzeile span { font-size: .68rem; }
  .bs-einzeilig { justify-content: space-between; flex-wrap: nowrap; }
</style>
