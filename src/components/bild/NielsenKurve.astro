---
// Kurve nach Nielsen (2000): gefundene Usability-Probleme über der Zahl der Testpersonen, als eigene Zeichnung.
import { gefundenAnteil } from './nielsen';

const B = 520, H = 300, L = 56, U = 44, O = 16, R = 16;
const MAX = 15;
const x = (n: number) => L + (n / MAX) * (B - L - R);
const y = (a: number) => O + (1 - a) * (H - O - U);
const punkte = Array.from({ length: MAX + 1 }, (_, n) => `${x(n).toFixed(1)},${y(gefundenAnteil(n)).toFixed(1)}`).join(' ');
const fuenf = { x: x(5), y: y(gefundenAnteil(5)) };
---
<figure class="nielsen">
  <svg viewBox={`0 0 ${B} ${H}`} role="img" aria-label="Kurve: Anteil gefundener Usability-Probleme steigt mit der Zahl der Testpersonen steil an und flacht ab; bei fünf Personen rund 85 Prozent">
    <line x1={L} y1={y(0)} x2={B - R} y2={y(0)} class="achse" />
    <line x1={L} y1={y(0)} x2={L} y2={O} class="achse" />
    {[0, 0.5, 1].map((a) => <text x={L - 8} y={y(a) + 5} text-anchor="end" class="beschriftung">{Math.round(a * 100)} %</text>)}
    {[0, 5, 10, 15].map((n) => <text x={x(n)} y={y(0) + 22} text-anchor="middle" class="beschriftung">{n}</text>)}
    <text x={(L + B - R) / 2} y={H - 4} text-anchor="middle" class="beschriftung">Testpersonen</text>
    <polyline points={punkte} class="kurve" />
    <line x1={fuenf.x} y1={fuenf.y} x2={fuenf.x} y2={y(0)} class="hilfslinie" />
    <circle cx={fuenf.x} cy={fuenf.y} r="6" class="punkt" />
    <text x={fuenf.x + 12} y={fuenf.y + 26} class="beschriftung stark">5 Personen: rund 85 %</text>
  </svg>
  <figcaption class="small muted">N(1 − (1 − L)ⁿ), L ≈ 31 %. Nach Jakob Nielsen, NN/g (2000).</figcaption>
</figure>

<style>
  .nielsen { margin: 1.25rem 0; max-width: 34rem; }
  .nielsen svg { display: block; width: 100%; height: auto; }
  .achse { stroke: var(--muted); stroke-width: 1.5; }
  .hilfslinie { stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .kurve { fill: none; stroke: var(--accent); stroke-width: 3.5; stroke-linejoin: round; }
  .punkt { fill: var(--accent); }
  .beschriftung { fill: var(--muted); font-size: 15px; }
  .stark { fill: var(--fg); font-weight: 600; }
  .nielsen figcaption { margin-top: .4rem; }
</style>
