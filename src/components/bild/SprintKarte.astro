---
// Eine Artefakt-Karte im Sprint-Kreislauf (nur innerhalb des <svg> von SprintKreislauf.astro; Aussehen dort):
// oben Icon und Name, darunter kompakt die Verpflichtung als gelbe Zeile. x/y = linke obere Ecke im viewBox.
const { x, y, b, oben = 46, unten = 38, name, verpflichtung, Icon, IconVerpfl } = Astro.props as {
  x: number; y: number; b: number; oben?: number; unten?: number;
  name: string; verpflichtung: string; Icon: any; IconVerpfl: any;
};
const h = oben + unten;
---
<rect class="sk-karte-grund" x={x} y={y} width={b} height={h} rx="8" />
<path class="sk-karte-verpfl" d={`M${x} ${y + oben}H${x + b}V${y + h - 8}a8 8 0 0 1 -8 8H${x + 8}a8 8 0 0 1 -8 -8Z`} />
<rect class="sk-karte-rand" x={x} y={y} width={b} height={h} rx="8" />
<Icon class="sk-karte-icon" x={x + 12} y={y + oben / 2 - 13} size={26} aria-hidden="true" />
<text class="sk-karte-name" x={x + 46} y={y + oben / 2 + 8}>{name}</text>
<IconVerpfl class="sk-karte-icon-verpfl" x={x + 14} y={y + oben + unten / 2 - 11} size={22} aria-hidden="true" />
<text class="sk-karte-wert" x={x + 44} y={y + oben + unten / 2 + 7}>{verpflichtung}</text>
