---
// Opportunity Solution Tree (Torres): Outcome → Chancen → Lösungen → Experimente, als Baum mit Linien.
// knoten: Wurzel mit kinder (beliebig tief, die Ebene ergibt sich aus der Tiefe). hervor: Ebene (0 = Outcome),
// die farbig bleibt – die übrigen treten zurück („heute arbeitet ihr hier“).
// Die Äste baut BaumAst.astro (rekursiv); die Stile hier gelten global für den ganzen Baum.
import BaumAst from './BaumAst.astro';
export interface Knoten { t: string; kinder?: Knoten[] }
const { knoten, label, hervor } = Astro.props as { knoten: Knoten; label: string; hervor?: number };
---
<figure class="baum" aria-label={label}>
  <ul class="baum-wurzel"><BaumAst knoten={knoten} hervor={hervor} /></ul>
</figure>

<style is:global>
  /* Klassischer CSS-Baum: jede Ebene eine Reihe, Linien über ::before/::after. Breite Bäume scrollen waagrecht. */
  .baum { margin: 1.5rem 0; overflow-x: auto; padding-bottom: .5rem; }
  .baum ul { list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; }
  .baum-kinder { padding-top: 1.2rem !important; position: relative; }
  .baum-ast { position: relative; display: flex; flex-direction: column; align-items: center; padding: 1.2rem .35rem 0; }
  .baum-wurzel > .baum-ast { padding-top: 0; }
  /* Waagrechte Linie über den Geschwistern, senkrechte zum Knoten. */
  .baum-kinder > .baum-ast::before, .baum-kinder > .baum-ast::after { content: ''; position: absolute; top: 0; height: 1.2rem; border-top: 2px solid var(--border); width: 50%; }
  .baum-kinder > .baum-ast::before { right: 50%; }
  .baum-kinder > .baum-ast::after { left: 50%; border-left: 2px solid var(--border); }
  .baum-kinder > .baum-ast:first-child::before, .baum-kinder > .baum-ast:last-child::after { border-top: 0; }
  .baum-kinder > .baum-ast:only-child::before { display: none; }
  .baum-kinder > .baum-ast:only-child::after { border-top: 0; }
  .baum-kinder > .baum-ast:last-child::before { border-right: 2px solid var(--border); }
  .baum-kinder > .baum-ast:last-child::after { border-left: 0; }
  /* Senkrechte vom Elternknoten nach unten. */
  .baum-kinder::before { content: ''; position: absolute; top: 0; left: 50%; height: 1.2rem; border-left: 2px solid var(--border); }
  .baum-knoten { display: flex; flex-direction: column; gap: .15rem; min-width: 7rem; max-width: 12rem; padding: .45rem .65rem; font-size: .85rem; line-height: 1.3; text-align: center; border: 2px solid var(--farbe); border-radius: var(--radius); background: color-mix(in srgb, var(--farbe) 10%, var(--bg)); }
  .baum-knoten small { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--farbe); }
  .baum-ast.e0 { --farbe: var(--accent); }
  .baum-ast.e1 { --farbe: var(--blue); }
  .baum-ast.e2 { --farbe: var(--green); }
  .baum-ast.e3 { --farbe: var(--purple); }
  .baum-ast.leise > .baum-knoten { --farbe: var(--border); color: var(--muted); }
  .baum-ast.leise > .baum-knoten small { color: var(--muted); }
</style>
