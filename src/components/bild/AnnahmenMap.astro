---
// Annahmen-Map wie im Miro-Frame „T4 · 0 · Annahmen der Idee“ (experiment#map und #beispiel-map): vier Felder mit deren
// Namen, Achsen wie in Torres’ Abbildung (S. 129) – senkrecht Wichtigkeit (oben wichtig), waagrecht Beleg (links viel,
// rechts keiner). Optional Annahmen als Marken (x, y in % von links bzw. oben).
import { ACHSE_X, ACHSE_Y, FELDER } from './annahmen-map';
interface Marke { id: string; x: number; y: number; hervor?: boolean }
const { label, marken = [] } = Astro.props as { label: string; marken?: Marke[] };
---
<figure class="annahmen-map" aria-label={label}>
  <div class="am-zeile">
    <div class="am-y" aria-hidden="true">
      <span class="am-titel-y">{ACHSE_Y.titel}</span>
      <span class="am-pfeil-y"><span>{ACHSE_Y.oben}</span><i></i><span>{ACHSE_Y.unten}</span></span>
    </div>
    <div class="am-flaeche">
      {FELDER.map((f) => <span class:list={['am-feld', f.klasse]}>{f.name}</span>)}
      {marken.map((a) => <span class:list={['am-chip', { hervor: a.hervor }]} style={`left: ${a.x}%; top: ${a.y}%`}>{a.id}</span>)}
    </div>
  </div>
  <div class="am-x" aria-hidden="true">
    <span class="am-pfeil-x"><span>{ACHSE_X.links}</span><i></i><span>{ACHSE_X.rechts}</span></span>
    <span class="am-titel-x">{ACHSE_X.titel}</span>
  </div>
</figure>

<style>
  .annahmen-map { margin: 0; }
  /* Die Achse links bestimmt die Höhe nicht: Sie ist absolut gesetzt und bricht ihren Titel um, so hoch wie die Fläche. */
  .am-zeile { display: flex; gap: .3rem; }
  .am-y { position: relative; flex: none; width: 2.9rem; font-size: .75rem; color: var(--muted); }
  .am-titel-y { position: absolute; left: 0; top: 0; bottom: 0; width: 1.3rem; writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; line-height: 1.15; }
  .am-pfeil-y { position: absolute; left: 1.5rem; top: 0; bottom: 0; width: 1.3rem; display: flex; flex-direction: column; align-items: center; justify-content: space-between; }
  .am-pfeil-y > span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-weight: 600; }
  .am-pfeil-y > i { flex: 1; width: 2px; margin: .25rem 0; background: var(--muted); position: relative; }
  .am-pfeil-y > i::before { content: ''; position: absolute; top: -2px; left: 50%; transform: translateX(-50%); border: 6px solid transparent; border-bottom-color: var(--muted); border-top: 0; }
  .am-flaeche { flex: 1; position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; aspect-ratio: 16 / 10; border: 2px solid var(--border); border-radius: 8px; overflow: hidden; }
  .am-feld { display: flex; align-items: flex-start; padding: .45rem .6rem; font-size: .95rem; font-weight: 600; color: var(--muted); border: 1px dashed var(--border); }
  .am-feld.or { color: var(--fg); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .am-chip { position: absolute; transform: translate(-50%, -50%); padding: .1rem .45rem; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-2, var(--bg)); font-weight: 700; font-size: .95rem; }
  .am-chip.hervor { border-color: var(--accent); background: var(--accent); color: var(--bg); }
  /* Waagrechte Achse unten, unter der Fläche: Pfeil nach rechts mit „viel Beleg“ links und „kein Beleg“ rechts, darunter der Titel. */
  .am-x { margin: .25rem 0 0 3.2rem; font-size: .75rem; color: var(--muted); text-align: center; }
  .am-pfeil-x { display: flex; align-items: center; gap: .35rem; }
  .am-pfeil-x > span { white-space: nowrap; font-weight: 600; }
  .am-pfeil-x > i { flex: 1; height: 2px; background: var(--muted); position: relative; }
  .am-pfeil-x > i::after { content: ''; position: absolute; right: -2px; top: 50%; transform: translateY(-50%); border: 6px solid transparent; border-left-color: var(--muted); border-right: 0; }
</style>
