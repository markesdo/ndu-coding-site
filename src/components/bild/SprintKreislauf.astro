---
// Scrum auf einem Bild: der Sprint-Kreislauf (Daten und Geometrie: ./sprint-kreislauf.ts). Eigene Zeichnung nach der
// Idee „dicker Ring mit Daily-Schleife“ (Sprint-Kreislauf und Artefakte-Fluss im Deck 25/26), Begriffe nach Scrum
// Guide 2020. Am Beamer nur Namen; die Unterzeilen der Events stehen im Handout unter dem Bild und als <title>.
// hervor: ein Teil oder mehrere (product-backlog, planning, sprint-backlog, sprint, daily, inkrement, review, retro),
//   die übrigen werden blass – so läuft dasselbe Bild auf mehreren Folien mit.
// aufdecken: so viele Gruppen sofort (0–6), die übrigen je Gruppe per → (data-schritt, wie die übrigen Folien).
// takt: ersetzt „höchstens ein Monat“ unter „Sprint“, z. B. „ein Sprint, 12.–19.12.“.
import { BadgeCheck, Eye, Flag, Goal, ListChecks, ListOrdered, MessagesSquare, Package, RefreshCw, Target } from '@lucide/astro';
import SprintKarte from './SprintKarte.astro';
import {
  ARTEFAKTE, BALKEN_Y, BOGEN, B_BREITE, B_HOEHE, DAILY, EVENTS, INKREMENT_WINKEL, MITTE, R, RING_B, SCHRITTE, SPRINT,
  WINKELPFEILE, beschreibung, bogen, dailyBeruehrung, dailyMitte, endSpitze, pruefeAufdecken, pruefeHervor, punkt,
  ringPfad, spitze, tangente, winkelpfeil, type Teil,
} from './sprint-kreislauf';

const { id = 'sprint-kreislauf', hervor, aufdecken, takt } = Astro.props as {
  id?: string;
  hervor?: Teil | Teil[];
  aufdecken?: number;
  takt?: string;
};
const an = pruefeHervor(hervor);
pruefeAufdecken(aufdecken);

const ev = Object.fromEntries(EVENTS.map((e) => [e.id, e]));
const art = Object.fromEntries(ARTEFAKTE.map((a) => [a.id, a]));
/** Attribute eines Teils (für hervor). */
const g = (teil: Teil) => ({ 'data-teil': teil, class: an.includes(teil) ? 'sk-an' : undefined });
/** Attribute einer Aufdeck-Gruppe (SCHRITTE[i]); eine Gruppe ist ein Schritt am Beamer, auch wenn sie zwei Teile hat. */
const s = (i: number) => ({ 'data-gruppe': SCHRITTE[i].join(' '), 'data-schritt': aufdecken !== undefined && i >= aufdecken ? '' : undefined });

const ICON = 48;
const ICON_ART = { 'product-backlog': ListOrdered, 'sprint-backlog': ListChecks, inkrement: Package } as const;
const ICON_VERPFL = { 'product-backlog': Flag, 'sprint-backlog': Goal, inkrement: BadgeCheck } as const;
const karte = (teil: 'product-backlog' | 'sprint-backlog' | 'inkrement', x: number, y: number, b: number) =>
  ({ x, y, b, name: art[teil].name, verpflichtung: art[teil].verpflichtung, Icon: ICON_ART[teil], IconVerpfl: ICON_VERPFL[teil] });

// Product Backlog links, sein Name auf Höhe des Planning-Balkens; Sprint Backlog unter dem Balken am Eingang;
// Inkrement rechts am Ausgang.
const pb = karte('product-backlog', 10, BALKEN_Y - 23, 240);
const sb = karte('sprint-backlog', 292, BALKEN_Y + 42, 226);
const ausgang = punkt(INKREMENT_WINKEL, R + RING_B / 2);
const ink = karte('inkrement', 752, ausgang.y - 23, 236);
const planningMitte = (pb.x + pb.b + MITTE.x) / 2 + 8;

const dm = dailyMitte();
const ber = dailyBeruehrung();
const schleife = bogen(ber + 40, ber + 320, DAILY.r, dm);
const schleifeSpitze = (() => {
  const w = ber + 320, p = punkt(w, DAILY.r, dm), t = tangente(w), gr = 22;
  return spitze(p.x + t.x * gr * 0.6, p.y + t.y * gr * 0.6, t.x, t.y, gr);
})();

const pfad = (name: string) => `${id}-${name}`;
const review = punkt(90, R + RING_B / 2 + 34);
const retro = punkt(BOGEN.retro.mitte, R + RING_B / 2 + 40);
const titelId = pfad('titel'), descId = pfad('desc');
---
<figure class="sk" id={id} data-hervor={an.length ? '' : undefined}>
  <div class="sk-rahmen">
    <svg viewBox={`0 0 ${B_BREITE} ${B_HOEHE}`} role="img" aria-labelledby={titelId} aria-describedby={descId}>
      <title id={titelId}>Scrum auf einem Bild: der Sprint-Kreislauf</title>
      <desc id={descId}>{beschreibung(takt)}</desc>
      <defs>
        {/* Textpfade im Uhrzeigersinn: oben liest die Schrift von links nach rechts, links von unten nach oben. */}
        <path id={pfad('t-review')} d={bogen(BOGEN.review.mitte + BOGEN.review.halb, BOGEN.review.mitte - BOGEN.review.halb, R, MITTE, false)} />
        <path id={pfad('t-retro')} d={bogen(BOGEN.retro.mitte + BOGEN.retro.halb, BOGEN.retro.mitte - BOGEN.retro.halb, R, MITTE, false)} />
        <path id={pfad('t-daily')} d={bogen(150, 30, DAILY.r, dm, false)} />
      </defs>

      {/* 1 · Product Backlog mit Produktziel */}
      <g {...s(0)}><g {...g('product-backlog')}>
        <SprintKarte {...pb} />
      </g></g>

      {/* 2 · Sprint Planning als Balken in den Ring, Sprint Backlog mit Sprint-Ziel am Eingang */}
      <g {...s(1)}><g {...g('planning')}>
        <title>{ev.planning.name}: {ev.planning.sub}</title>
        <line class="sk-band" x1={pb.x + pb.b} y1={BALKEN_Y} x2={MITTE.x + 1} y2={BALKEN_Y} />
        <text class="sk-auf-band" x={planningMitte} y={BALKEN_Y} text-anchor="middle">{ev.planning.name}</text>
        <Target class="sk-icon" x={pb.x + pb.b + 12} y={BALKEN_Y - RING_B / 2 - ICON - 6} size={ICON} aria-hidden="true" />
      </g>
      <g {...g('sprint-backlog')}>
        <line class="sk-verbinder" x1={sb.x + sb.b / 2} y1={BALKEN_Y + RING_B / 2} x2={sb.x + sb.b / 2} y2={sb.y - 12} />
        <polygon class="sk-verbinder-spitze" points={spitze(sb.x + sb.b / 2, sb.y - 12, 0, 1, 9)} />
        <SprintKarte {...sb} />
      </g></g>

      {/* 3 · der Sprint als dicker, offener Ring, mit Daily-Schleife außen oben rechts */}
      <g {...s(2)}><g {...g('sprint')}>
        <title>{SPRINT.name}: {takt ?? SPRINT.sub}</title>
        <path class="sk-band" d={ringPfad()} />
        <polygon class="sk-band-spitze" points={endSpitze()} />
        {WINKELPFEILE.map((w) => <polyline class="sk-winkel" points={winkelpfeil(w)} />)}
        <text class="sk-sprint" x={MITTE.x} y={MITTE.y + 4} text-anchor="middle">{SPRINT.name}</text>
        <text class="sk-sprint-sub" x={MITTE.x} y={MITTE.y + 34} text-anchor="middle">{takt ?? SPRINT.sub}</text>
      </g>
      <g {...g('daily')}>
        <title>{ev.daily.name}: {ev.daily.sub}</title>
        <path class="sk-band sk-band-daily" d={schleife} />
        <polygon class="sk-band-spitze" points={schleifeSpitze} />
        <text class="sk-auf-band sk-auf-daily"><textPath href={`#${pfad('t-daily')}`} startOffset="50%" text-anchor="middle">{ev.daily.name}</textPath></text>
        <text class="sk-24" x={dm.x} y={dm.y + 12} text-anchor="middle">24 h</text>
        <MessagesSquare class="sk-icon" x={dm.x + DAILY.r + DAILY.b / 2 + 10} y={dm.y - ICON / 2} size={ICON} aria-hidden="true" />
      </g></g>

      {/* 4 · Inkrement mit Definition of Done am Ausgang */}
      <g {...s(3)}><g {...g('inkrement')}>
        <line class="sk-pfeil" x1={ausgang.x - 4} y1={ausgang.y} x2={ink.x - 22} y2={ausgang.y} />
        <polygon class="sk-pfeil-spitze" points={spitze(ink.x - 22, ausgang.y, 1, 0, 18)} />
        <SprintKarte {...ink} />
      </g></g>

      {/* 5 · Sprint Review oben, 6 · Retrospektive links – Name auf dem Ring, Icon außen */}
      <g {...s(4)}><g {...g('review')}>
        <title>{ev.review.name}: {ev.review.sub}</title>
        <path class="sk-band" d={bogen(BOGEN.review.mitte - BOGEN.review.halb - 2, BOGEN.review.mitte + BOGEN.review.halb + 2)} />
        <text class="sk-auf-band"><textPath href={`#${pfad('t-review')}`} startOffset="50%" text-anchor="middle">{ev.review.name}</textPath></text>
        <Eye class="sk-icon" x={review.x - ICON / 2} y={review.y - ICON / 2} size={ICON} aria-hidden="true" />
      </g></g>
      <g {...s(5)}><g {...g('retro')}>
        <title>{ev.retro.name}: {ev.retro.sub}</title>
        <path class="sk-band" d={bogen(BOGEN.retro.mitte - BOGEN.retro.halb - 2, BOGEN.retro.mitte + BOGEN.retro.halb + 2)} />
        <text class="sk-auf-band"><textPath href={`#${pfad('t-retro')}`} startOffset="50%" text-anchor="middle">{ev.retro.name}</textPath></text>
        <RefreshCw class="sk-icon" x={retro.x - ICON / 2} y={retro.y - ICON / 2} size={ICON} aria-hidden="true" />
      </g></g>

      {/* Legende: gelb = Verpflichtung */}
      <g class="sk-legende">
        <rect class="sk-karte-verpfl sk-legende-feld" x={ink.x} y={B_HOEHE - 34} width="26" height="20" rx="4" />
        <text class="sk-legende-text" x={ink.x + 36} y={B_HOEHE - 18}>Verpflichtung</text>
      </g>
    </svg>
  </div>
  <figcaption class="sk-erklaerung nur-handout">
    <dl>
      {EVENTS.map((e) => <div><dt>{e.name}</dt><dd>{e.sub}</dd></div>)}
      <div><dt>{SPRINT.name}</dt><dd>{takt ?? SPRINT.sub}; der nächste beginnt gleich nach dem vorigen</dd></div>
    </dl>
  </figcaption>
</figure>

<style>
  .sk { margin: 1.25rem 0; container: sk / inline-size; }
  /* Am Handy scrollt das Bild in sich, die Seite nicht. */
  .sk-rahmen { overflow-x: auto; }
  .sk svg { display: block; width: 100%; min-width: 40rem; height: auto; overflow: visible; font-family: var(--font); }

  /* Farben über eigene Variablen: Beim Verblassen (hervor) bekommt jeder Teil flache, hellere Farben statt opacity –
     so dunkeln Stellen, an denen sich zwei Teile überlappen (Balken und Ring), nicht nach. */
  .sk { --sk-akzent: var(--accent); --sk-auf: var(--on-accent); --sk-fg: var(--fg); --sk-gelb: var(--yellow-soft); --sk-gelb-ink: var(--yellow-ink); }
  .sk[data-hervor] [data-teil]:not(.sk-an) {
    --sk-akzent: color-mix(in srgb, var(--accent) 45%, var(--bg));
    --sk-fg: color-mix(in srgb, var(--fg) 45%, var(--bg));
    --sk-gelb: color-mix(in srgb, var(--yellow-soft) 45%, var(--bg));
    --sk-gelb-ink: color-mix(in srgb, var(--yellow-ink) 45%, var(--bg));
  }

  /* Der Ring und alles, was zum Kreislauf gehört: dick, in der Akzentfarbe, Schrift darauf in --on-accent. */
  .sk-band { fill: none; stroke: var(--sk-akzent); stroke-width: 34; stroke-linecap: butt; }
  .sk-band-daily { stroke-width: 28; }
  .sk-band-spitze { fill: var(--sk-akzent); }
  .sk-winkel { fill: none; stroke: var(--sk-auf); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .sk-auf-band { fill: var(--sk-auf); font-size: 21px; font-weight: 700; letter-spacing: .01em; dominant-baseline: central; }
  .sk-auf-daily { font-size: 18px; }
  .sk-pfeil { stroke: var(--sk-akzent); stroke-width: 12; }
  .sk-pfeil-spitze { fill: var(--sk-akzent); }
  .sk-verbinder { stroke: var(--sk-fg); stroke-width: 4; }
  .sk-verbinder-spitze { fill: var(--sk-fg); }

  .sk-icon { color: var(--sk-fg); }
  .sk-sprint { fill: var(--sk-fg); font-family: var(--mono); font-size: 36px; font-weight: 700; }
  .sk-sprint-sub { fill: var(--sk-fg); font-size: 19px; }
  .sk-24 { fill: var(--sk-fg); font-family: var(--mono); font-size: 22px; font-weight: 700; }
  .sk-legende-text { fill: var(--sk-fg); font-size: 17px; }

  /* Artefakt-Karten (SprintKarte.astro). */
  .sk :global(.sk-karte-grund) { fill: var(--bg); }
  .sk :global(.sk-karte-verpfl) { fill: var(--sk-gelb); }
  .sk :global(.sk-karte-rand) { fill: none; stroke: var(--sk-fg); stroke-width: 2.5; }
  .sk :global(.sk-karte-name) { fill: var(--sk-fg); font-size: 22px; font-weight: 700; }
  .sk :global(.sk-karte-wert) { fill: var(--sk-fg); font-size: 19px; font-weight: 700; }
  .sk :global(.sk-karte-icon) { color: var(--sk-fg); }
  .sk :global(.sk-karte-icon-verpfl) { color: var(--sk-gelb-ink); }
  .sk-legende-feld { stroke: var(--sk-gelb-ink); stroke-width: 1.5; }

  /* Hervorhebung: Icons und Kartenrand in der Akzentfarbe. */
  .sk-an .sk-icon, .sk-an :global(.sk-karte-icon) { color: var(--accent-ink); }
  .sk-an :global(.sk-karte-rand) { stroke: var(--accent); stroke-width: 5; }

  /* Im Handout: die Unterzeilen der Events unter dem Bild. */
  .sk-erklaerung dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .4rem 1.2rem; margin: .75rem 0 0; font-size: .9rem; }
  .sk-erklaerung dt { font-weight: 700; }
  .sk-erklaerung dd { margin: 0; color: var(--muted); }

  /* Beamer: so hoch, dass Titel, Kernsatz und Bild in 1280×720 passen. */
  :global(html[data-beamer]) .sk { margin: .25rem 0 0; }
  :global(html[data-beamer]) .sk svg { min-width: 0; max-height: calc(100vh - var(--topbar-h, 48px) - 9.8rem); }

  @media print {
    .sk-rahmen { overflow: visible; }
    .sk svg { min-width: 0; }
    .sk, .sk * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  }
</style>
