---
// Der Arbeitsfluss als Linienplan (Daten und Geometrie: ../arbeitsfluss.ts). Spalten sind Kurstage, Stationen sind
// Ergebnisse, drei Linien laufen durch. Die Linien zeichnet ein Inline-SVG je Spalte über demselben CSS-Raster.
// hier: Kurstag (1–7), Station (ID) oder 'heute' (im Browser: ?tag=N, sonst der letzte Kurstag bis heute, Wien).
// bis: Kurstag, nach dem die Spalten blass werden (Zukunft). Bei hier='heute' derselbe Tag.
// faden: eine Linie hervorheben, die anderen blass. aufdecken: so viele Spalten sofort, die übrigen je Spalte per →
// (data-schritt, wie die übrigen Folien). Im Druck A3 quer: siehe /innolab/arbeitsfluss.
// Fokus (NDU-74): Eine Station zeigt, woher sie nimmt (Ring) und wohin sie gibt (Pfeil), mit einem Strich; der Rest wird
// blass, die Fußzeile sagt es in Worten. Auslöser: Maus oder Tastatur auf der Station (Klick bleibt der Link), Prop
// fokus (fest, ohne Skript), fokusAusAdresse (?station=…), tour (Kurstag: je Station dieses Tags ein Schritt).
// Legende: Knöpfe, die eine Linie allein zeigen (data-faden).
import { ArrowRight, FlaskConical, MapPin, MessageSquareQuote, Star, Target } from '@lucide/astro';
import {
  GEO, HOEHE, LINIE, LINIEN, PUNKT_REM, SPALTEN, STATIONEN, ZEILEN, fokusPfade, fokusText, quellen, spaltenPfade,
  spalteVonTag, station, stationHref, tourStationen, ziele, type Linie,
} from '../arbeitsfluss';
import { rollen } from '../arbeitsfluss-fokus';
import { TAGE } from '../methoden';

const { id = 'arbeitsfluss', hier, bis, faden, aufdecken, legende = true, fokus, tour, fokusAusAdresse = false } = Astro.props as {
  id?: string;
  hier?: number | string;
  bis?: number;
  faden?: Linie;
  aufdecken?: number;
  legende?: boolean;
  /** Station (ID) fest im Fokus – Handout, Druck. */
  fokus?: string;
  /** Kurstag: je Station dieses Tags ein unsichtbarer Schritt; der zuletzt aufgedeckte steht im Fokus. */
  tour?: number;
  /** ?station=… in der Adresse setzt den Fokus (Link „Arbeitsfluss“ im Übergangsstreifen). */
  fokusAusAdresse?: boolean;
};

const heute = hier === 'heute';
const hierStation = typeof hier === 'string' && !heute ? station(hier) : undefined;
if (typeof hier === 'string' && !heute && !hierStation) throw new Error(`Arbeitsfluss: Station „${hier}“ unbekannt`);
if (fokus !== undefined && !station(fokus)) throw new Error(`Arbeitsfluss: Fokus „${fokus}“ unbekannt`);
// Spalten aufdecken und Tour zugleich: Die Schritte kämen durcheinander.
if (tour !== undefined && aufdecken !== undefined) throw new Error('Arbeitsfluss: tour und aufdecken schließen sich aus');
const tourListe = tour !== undefined ? tourStationen(tour) : [];
if (tour !== undefined && tourListe.length === 0) throw new Error(`Arbeitsfluss: Tour für Tag ${tour} ohne Stationen`);
const hierSpalte = typeof hier === 'number' ? spalteVonTag(hier) : hierStation?.spalte;
const bisSpalte = bis !== undefined ? spalteVonTag(bis) : undefined;

const ICON = { beleg: MessageSquareQuote, outcome: Target, annahme: FlaskConical };
const klassen = (n: number) => ({ 'af-hier': n === hierSpalte, 'af-spaeter': bisSpalte !== undefined && n > bisSpalte });

// Kanten und Fokus-Pfade je Station, zur Bauzeit (im Browser keine Geometrie).
const KANTEN = new Map(STATIONEN.map((s) => [s.id, { quellen: quellen(s).map((x) => x.id), ziele: ziele(s).map((x) => x.id) }]));
const PFADE = new Map(STATIONEN.map((s) => [s.id, fokusPfade(s)]));
const rolle = rollen(STATIONEN.map((s) => s.id), fokus, fokus ? KANTEN.get(fokus)! : { quellen: [], ziele: [] });
const fussId = (s: string) => `${id}-fuss-${s}`;
// Umsteigepunkt: je Linie ein Kreisausschnitt in ihrer Farbe.
const mischung = (l: Linie[]) => `--af-mix:conic-gradient(${l.map((x, i) => `var(--af-${x}) ${(i * 100) / l.length}% ${((i + 1) * 100) / l.length}%`).join(', ')})`;
const planStil = [
  `--af-zeilen:${ZEILEN}`, `--af-punkt-x:${GEO.punktX}%`, `--af-punkt:${PUNKT_REM.normal}rem`, `--af-punkt-umstieg:${PUNKT_REM.umstieg}rem`,
  `--af-punkt-ziel:${PUNKT_REM.ziel}rem`, `grid-template-rows:auto ${GEO.oben / 100}fr repeat(${ZEILEN}, 1fr)${GEO.unten ? ` ${GEO.unten / 100}fr` : ''}`,
].join(';');
---
<figure class="af" id={id} data-faden={faden} data-fokus={fokus} data-fokus-an={fokus ? '' : undefined} data-adresse={fokusAusAdresse ? '' : undefined}
  data-heute={heute ? JSON.stringify(TAGE.map((t) => ({ n: t.n, datum: t.datum }))) : undefined}
  aria-label="Arbeitsfluss als Linienplan: Spalten sind Kurstage, Stationen sind Ergebnisse; drei Linien: Beleg, Outcome, Annahme. Maus oder Tastatur auf einer Station zeigt, woher sie kommt und wohin sie geht.">
  {legende && (
    <ul class="af-legende">
      {LINIEN.map((l) => {
        const Icon = ICON[l];
        return (
          <li>
            <button type="button" class={`af-leg af-leg-${l}`} data-faden-knopf={l} aria-pressed={faden === l ? 'true' : 'false'} title={`Nur die Linie ${LINIE[l].name} zeigen (noch einmal: alle)`}>
              <svg class="af-muster" viewBox="0 0 36 10" aria-hidden="true"><path class={`af-l af-l-${l}`} d="M0 5H36" />{l === 'outcome' && <path class="af-innen" d="M0 5H36" />}</svg>
              <Icon size={16} aria-hidden="true" class="af-leg-icon" />
              <span><strong>{LINIE[l].name}</strong><span class="af-leg-text"> – {LINIE[l].text}</span></span>
            </button>
          </li>
        );
      })}
    </ul>
  )}
  <div class="af-scroll">
    <div class="af-plan" style={planStil}>
      {SPALTEN.map((sp) => (
        <div class:list={['af-spalte', klassen(sp.n)]} data-spalte={sp.n} data-schritt={aufdecken !== undefined && sp.n > aufdecken ? '' : undefined}>
          <div class:list={['af-kopf', klassen(sp.n)]} data-spalte={sp.n} style={`grid-column:${sp.n}`}>
            <span class="af-tag">{sp.tag}</span> <span class="af-titel">{sp.titel}</span>
            <span class="af-hier-marke"><MapPin size={14} aria-hidden="true" /> Ihr seid hier</span>
          </div>
          <div class:list={['af-grund', klassen(sp.n)]} data-spalte={sp.n} style={`grid-column:${sp.n}`} aria-hidden="true" />
          <svg class:list={['af-linien', klassen(sp.n)]} data-spalte={sp.n} viewBox={`0 0 ${SPALTEN.length * 100} ${HOEHE}`} preserveAspectRatio="none" aria-hidden="true">
            {LINIEN.map((l) => {
              const p = spaltenPfade(sp.n, l);
              const d = [p.schiene, p.stamm, ...p.aeste].filter(Boolean).join('');
              return d ? (
                <g class={`af-g af-g-${l}`}>
                  <path class={`af-l af-l-${l}`} d={d} />
                  {l === 'outcome' && <path class="af-innen" d={d} />}
                </g>
              ) : null;
            })}
            {STATIONEN.filter((s) => PFADE.get(s.id)![sp.n]).map((s) => (
              <path class:list={['af-fokus-pfad', { 'af-an': s.id === fokus }]} data-fokus-pfad={s.id} d={PFADE.get(s.id)![sp.n]} />
            ))}
          </svg>
          {STATIONEN.filter((s) => s.spalte === sp.n).map((s) => {
            const href = stationHref(s);
            const Tag = href ? 'a' : 'span';
            const r = rolle[s.id];
            return (
              <Tag href={href} tabindex={href ? undefined : 0} data-spalte={sp.n} data-id={s.id}
                data-quellen={KANTEN.get(s.id)!.quellen.join(' ')} data-ziele={KANTEN.get(s.id)!.ziele.join(' ')} aria-describedby={fussId(s.id)}
                class:list={['af-station', klassen(sp.n), `af-haupt-${s.linien[0]}`, ...s.linien.map((l) => `af-auf-${l}`), r && `af-${r}`, { 'af-endet': !!s.endet, 'af-fortsetzung': !!s.fortsetzung, 'af-umstieg': s.linien.length > 1, 'af-stern': s.stern, 'af-diese': s === hierStation }]}
                style={`grid-column:${sp.n};grid-row:${s.zeile + 2}${s.linien.length > 1 ? `;${mischung(s.linien)}` : ''}`}
                title={s.endet ? `${s.kurz} – ${s.endet}` : s.fortsetzung ? `${s.kurz} – Fortsetzung von ${station(s.fortsetzung)?.kurz}` : s.kurz}>
                <span class="af-punkt" aria-hidden="true">{s.stern && <Star size={12} class="af-stern-icon" />}<ArrowRight size={11} class="af-pfeil" /></span>
                <span class="af-name">{s.kurz}{s.stern && <span class="visually-hidden"> (Was bauen wir?)</span>}</span>
              </Tag>
            );
          })}
        </div>
      ))}
    </div>
  </div>
  {tourListe.map((s) => <span class="af-tour" data-schritt data-tour={s.id} aria-hidden="true" />)}
  {hierStation && (
    <div class="af-detail">
      <p><strong>{hierStation.kurz}.</strong> {hierStation.satz}{hierStation.zusatz && <> {hierStation.zusatz}</>}</p>
      <p class="af-weiter">→ {hierStation.gebrauchtIn}</p>
    </div>
  )}
  <figcaption class="af-fuss">
    <span class="af-fuss-legende" hidden={fokus ? true : undefined}>
      Fahrt mit der Maus über eine Station: Ring = kommt daher, Pfeil = geht dorthin. Hohle Punkte enden oder werden ersetzt; gepunktete setzen eine frühere Station fort.<Star size={14} aria-hidden="true" class="af-fuss-stern" /> Der Stern ist die Antwort auf „Was bauen wir?“.
    </span>
    {STATIONEN.map((s) => {
      const t = fokusText(s);
      return (
        <span class="af-fuss-fokus" id={fussId(s.id)} data-fuss={s.id} hidden={s.id === fokus ? undefined : true}>
          <strong>{s.kurz}</strong> <span class="af-fuss-teil"><span class="af-fuss-kopf">Kommt aus</span> {t.aus}</span>
          <ArrowRight size={14} aria-hidden="true" class="af-fuss-pfeil" /><span class="visually-hidden">;</span>
          <span class="af-fuss-teil"><span class="af-fuss-kopf">Geht nach</span> {t.nach}</span>
        </span>
      );
    })}
  </figcaption>
</figure>

<script>
  import { heutigerTag, spalteVonTag } from '../arbeitsfluss-heute';
  import { rollen, stationAusAdresse, tourFokus, type Rolle } from '../arbeitsfluss-fokus';
  import { wienerZeit } from '../jetzt';

  // hier='heute': Markierung im Browser setzen – ?tag=N schlägt das Datum (zum Vorbereiten und Verlinken).
  for (const fig of document.querySelectorAll<HTMLElement>('.af[data-heute]')) {
    const param = Number(new URLSearchParams(location.search).get('tag'));
    const tage = JSON.parse(fig.dataset.heute || '[]') as { n: number; datum?: string }[];
    const tag = spalteVonTag(param) ? param : heutigerTag(wienerZeit(new Date()).datum, tage);
    const sp = tag === undefined ? undefined : spalteVonTag(tag);
    if (sp === undefined) continue;
    for (const el of fig.querySelectorAll<HTMLElement | SVGElement>('[data-spalte]')) {
      const n = Number(el.dataset.spalte);
      el.classList.toggle('af-hier', n === sp);
      el.classList.toggle('af-spaeter', n > sp);
    }
  }

  // Fokus (NDU-74): Rollen aus arbeitsfluss-fokus.ts, Kanten und Pfade stehen schon im HTML.
  const ROLLEN: Rolle[] = ['fokus', 'quelle', 'ziel', 'blass'];
  for (const fig of document.querySelectorAll<HTMLElement>('.af')) {
    const stationen = [...fig.querySelectorAll<HTMLElement>('.af-station[data-id]')];
    const ids = stationen.map((s) => s.dataset.id!);
    const liste = (v?: string) => (v ?? '').split(' ').filter(Boolean);
    const zeige = (fokus: string | undefined) => {
      const el = stationen.find((s) => s.dataset.id === fokus);
      const r = rollen(ids, el ? fokus : undefined, { quellen: liste(el?.dataset.quellen), ziele: liste(el?.dataset.ziele) });
      fig.toggleAttribute('data-fokus-an', !!el);
      for (const s of stationen) for (const x of ROLLEN) s.classList.toggle(`af-${x}`, r[s.dataset.id!] === x);
      for (const p of fig.querySelectorAll<SVGElement>('[data-fokus-pfad]')) p.classList.toggle('af-an', !!el && p.dataset.fokusPfad === fokus);
      for (const f of fig.querySelectorAll<HTMLElement>('[data-fuss]')) f.hidden = !el || f.dataset.fuss !== fokus;
      const legende = fig.querySelector<HTMLElement>('.af-fuss-legende');
      if (legende) legende.hidden = !!el;
    };

    // Grundfokus: Prop fokus, sonst ?station=…, sonst die Tour. Maus und Tastatur überlagern ihn nur, solange sie dort sind.
    let basis: string | undefined = fig.dataset.fokus || undefined;
    if (fig.hasAttribute('data-adresse')) basis = stationAusAdresse(location.search, ids) ?? basis;
    const marker = [...fig.querySelectorAll<HTMLElement>('[data-tour]')];
    if (marker.length) {
      const ausTour = () => tourFokus(marker.map((m) => ({ id: m.dataset.tour!, gezeigt: m.classList.contains('gezeigt') })));
      // ← / → in Layout.astro setzen und nehmen .gezeigt; darauf hört die Tour (auch beim Zurückblättern).
      const beobachter = new MutationObserver(() => { basis = ausTour(); zeige(basis); });
      for (const m of marker) beobachter.observe(m, { attributes: true, attributeFilter: ['class'] });
      basis = ausTour() ?? basis;
    }
    zeige(basis);

    for (const s of stationen) {
      s.addEventListener('mouseenter', () => zeige(s.dataset.id));
      s.addEventListener('focus', () => zeige(s.dataset.id));
      const zurueck = () => {
        const aktiv = document.activeElement;
        zeige(aktiv instanceof HTMLElement && stationen.includes(aktiv) ? aktiv.dataset.id : basis);
      };
      s.addEventListener('mouseleave', zurueck);
      s.addEventListener('blur', () => requestAnimationFrame(zurueck));
    }

    // Legende: eine Linie allein zeigen; derselbe Knopf noch einmal zeigt wieder alle.
    const knoepfe = [...fig.querySelectorAll<HTMLButtonElement>('[data-faden-knopf]')];
    for (const k of knoepfe) {
      k.addEventListener('click', () => {
        const l = k.dataset.fadenKnopf!;
        if (fig.dataset.faden === l) delete fig.dataset.faden;
        else fig.dataset.faden = l;
        for (const x of knoepfe) x.setAttribute('aria-pressed', String(fig.dataset.faden === x.dataset.fadenKnopf));
      });
    }
  }
</script>

<style>
  .af {
    --af-beleg: var(--blue); --af-outcome: var(--accent); --af-annahme: var(--purple);
    --af-h: 40rem; --af-schrift: .85rem;
    margin: 1.25rem 0; max-width: none;
  }
  .af-legende { list-style: none; margin: 0 0 .6rem; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; font-size: .9rem; }
  .af-legende li { margin: 0; }
  .af-leg {
    display: inline-flex; align-items: center; gap: .4rem; font: inherit; color: inherit; text-align: left;
    background: none; border: 1px solid transparent; border-radius: var(--radius); padding: .1rem .35rem; margin: 0 -.35rem; cursor: pointer;
  }
  .af-leg:hover { border-color: var(--border); }
  .af-leg[aria-pressed="true"] { border-color: var(--fg); background: var(--bg-2); }
  .af-muster { width: 2.2rem; height: .7rem; flex: none; }
  .af-leg-icon { flex: none; }
  .af-leg-beleg .af-leg-icon { color: var(--af-beleg); }
  .af-leg-outcome .af-leg-icon { color: var(--af-outcome); }
  .af-leg-annahme .af-leg-icon { color: var(--af-annahme); }

  /* Breiter als die Spalte am Handy: der Plan scrollt in sich, die Seite nicht. */
  .af-scroll { overflow-x: auto; }
  .af-plan {
    position: relative; display: grid; min-width: 46rem; height: var(--af-h);
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2);
  }
  /* Jede Spalte ist eine Gruppe (für data-schritt), legt aber kein eigenes Kästchen ins Raster. */
  .af-spalte { display: contents; }
  .af-kopf {
    grid-row: 1; padding: .45rem .55rem .35rem; border-bottom: 1px solid var(--border);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .4rem; line-height: 1.25;
  }
  .af-tag { font-family: var(--mono); font-weight: 700; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
  .af-titel { font-size: .85rem; color: var(--muted); }
  .af-hier-marke {
    display: none; align-items: center; gap: .2rem; font-size: .75rem; font-weight: 700; color: var(--on-accent);
    background: var(--accent); border-radius: 999px; padding: .05rem .45rem; margin-left: auto;
  }
  .af-kopf.af-hier .af-hier-marke { display: inline-flex; }
  .af-kopf.af-hier { background: color-mix(in srgb, var(--accent) 14%, var(--bg-2)); }
  .af-grund { grid-row: 2 / -1; }
  .af-grund.af-hier { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .af-grund + .af-grund, .af-spalte + .af-spalte .af-grund { border-left: 1px dashed var(--border); }

  .af-linien { grid-column: 1 / -1; grid-row: 2 / -1; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .af-l { fill: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
  .af-l-beleg { stroke: var(--af-beleg); stroke-width: 3; }
  .af-l-outcome { stroke: var(--af-outcome); stroke-width: 5; }
  .af-l-annahme { stroke: var(--af-annahme); stroke-width: 3; stroke-dasharray: 7 5; stroke-linecap: butt; }
  /* Outcome doppelt: breiter Strich, innen in der Grundfarbe ausgespart. */
  .af-innen { fill: none; vector-effect: non-scaling-stroke; stroke: var(--bg-2); stroke-width: 1.5; }
  /* Fokus: ein Strich in Textfarbe, nur für die Station im Fokus. */
  .af-fokus-pfad { fill: none; vector-effect: non-scaling-stroke; stroke: var(--fg); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; display: none; }
  .af-fokus-pfad.af-an { display: inline; }

  .af-station {
    position: relative; z-index: 1; display: flex; align-items: center; min-width: 0;
    padding: 0 .3rem 0 calc(var(--af-punkt-x) + .75rem); color: var(--fg); text-decoration: none;
    font-size: var(--af-schrift); line-height: 1.1; font-weight: 600;
  }
  a.af-station:hover .af-name { text-decoration: underline; }
  .af-station:focus-visible { outline: none; }
  .af-station:focus-visible .af-name { outline: 2px solid var(--fg); outline-offset: 2px; border-radius: 3px; }
  .af-name { overflow-wrap: break-word; }
  /* Punkt in der Farbe der Hauptlinie: Die Linie einer Station ist am Punkt lesbar, ohne Ast. */
  .af-haupt-beleg { --af-farbe: var(--af-beleg); }
  .af-haupt-outcome { --af-farbe: var(--af-outcome); }
  .af-haupt-annahme { --af-farbe: var(--af-annahme); }
  .af-punkt {
    position: absolute; left: var(--af-punkt-x); top: 50%; transform: translate(-50%, -50%);
    width: var(--af-punkt); height: var(--af-punkt); border-radius: 50%; box-sizing: border-box;
    background: var(--af-farbe); border: 3px solid var(--af-farbe); color: var(--bg-2);
    display: grid; place-items: center;
  }
  .af-punkt > :global(svg) { grid-area: 1 / 1; }
  /* Endet hier oder wird ersetzt: hohl. */
  .af-station.af-endet .af-punkt { background: var(--bg-2); }
  /* Fortsetzung einer Station von einem früheren Tag: gepunkteter Ring (ein Umsteigepunkt behält sein Aussehen). */
  .af-station.af-fortsetzung:not(.af-umstieg) .af-punkt { background: var(--bg-2); border-style: dotted; }
  .af-fortsetzung:not(.af-umstieg) .af-name { font-weight: 500; font-style: italic; }
  /* Umsteigepunkt: größer, je Linie ein Ausschnitt in ihrer Farbe, Rand in Textfarbe. */
  .af-station.af-umstieg .af-punkt { width: var(--af-punkt-umstieg); height: var(--af-punkt-umstieg); background: var(--af-mix); border: 2px solid var(--fg); }
  .af-endet .af-name { color: var(--muted); font-weight: 500; }
  .af-station.af-stern .af-punkt { width: 1.5rem; height: 1.5rem; background: var(--yellow-soft); border: 2px solid var(--yellow); color: var(--yellow-ink); }
  .af-station.af-stern .af-punkt :global(.af-stern-icon) { fill: currentColor; }
  .af-station.af-stern .af-name { font-weight: 700; }
  .af-station.af-diese .af-name { background: var(--accent-soft); box-shadow: 0 0 0 .2rem var(--accent-soft); border-radius: 3px; }

  /* Zukunft blass; Faden: andere Linien und Stationen ohne diese Linie blass. */
  .af-spaeter:is(.af-kopf, .af-station, .af-linien) { opacity: .35; }
  .af[data-faden] .af-g { opacity: .15; }
  .af[data-faden="beleg"] .af-g-beleg, .af[data-faden="outcome"] .af-g-outcome, .af[data-faden="annahme"] .af-g-annahme { opacity: 1; }
  .af[data-faden="beleg"] .af-station:not(.af-auf-beleg),
  .af[data-faden="outcome"] .af-station:not(.af-auf-outcome),
  .af[data-faden="annahme"] .af-station:not(.af-auf-annahme) { opacity: .3; }

  /* Fokus: Linien und unbeteiligte Stationen blass; Quelle mit Ring, Ziel mit Pfeil im Punkt, die Station markiert.
     Gilt vor dem Faden – im Fokus zählt die Station. */
  .af[data-fokus-an] .af-g { opacity: .15; }
  .af[data-fokus-an] .af-station.af-blass { opacity: .3; }
  .af[data-fokus-an] .af-station:is(.af-quelle, .af-ziel, .af-fokus) { opacity: 1; }
  .af-pfeil { display: none; }
  .af-station.af-quelle .af-punkt { box-shadow: 0 0 0 2px var(--bg-2), 0 0 0 4.5px var(--fg); }
  .af-station.af-ziel .af-punkt {
