---
// Abschnitt „Prüfen“ auf Methodenseiten: erst die Prüfliste der Methode (methoden.ts) zum Abhaken, dann derselbe Text
// als Prompt für Claude. Claude prüft nur, schreibt nichts um und ändert keine Datei. Die Punkte sind reiner Text –
// die Checkliste würde HTML darstellen, der Prompt nicht (methoden.test.ts prüft das).
// Liegt das Ergebnis in der Werkstatt, geht der Prompt an Claude mit dem Werkstatt-Connector (artefakt_pruefen), sonst
// an Claude Code im Projekt-Repo, das die Werkstatt-Vorarbeit über denselben Connector liest. Darunter, zugeklappt, der
// Ausweichweg ohne Claude Code: Ergebnis als Text in Claude einfügen (nur für Ergebnisse in Dateien).
import Checklist from './Checklist.astro';
import ClaudeCodeWerkstatt from './ClaudeCodeWerkstatt.astro';
import Prompt from './Prompt.astro';
import { METHODEN, einfuegenHinweis, einfuegenMoeglich, pruefChecklisteId, pruefPrompt, pruefungInWerkstatt, werkstattVorarbeit } from './methoden';

// pfad: wenn nur ein Teil des Artefakts geprüft wird (z. B. ein Transkript statt aller Interview-Dateien).
const { slug, pfad } = Astro.props as { slug: string; pfad?: string };
const m = METHODEN.find((x) => x.slug === slug);
if (!m?.pruefliste) throw new Error(`ClaudePruefung: Methode „${slug}“ hat keine Prüfliste`);
const text = pruefPrompt(m, pfad);
const werkstatt = pruefungInWerkstatt(m, pfad);
const ausWerkstatt = werkstattVorarbeit(m).length > 0;
const label = werkstatt ? 'Prüfen lassen · Claude mit der Werkstatt' : 'Prüfen lassen · Claude Code';
const einfuegen = einfuegenMoeglich(m, pfad) ? pruefPrompt(m, pfad, 'einfuegen') : null;
---
<Checklist id={pruefChecklisteId(m)} items={m.pruefliste.map((p) => p.text)} ids={m.pruefliste.map((p) => p.id)} />
<Prompt label={label} note="Erst nachdem ihr die Prüfliste selbst durchgegangen seid. Claude findet, ihr entscheidet."><Fragment set:text={text} /></Prompt>
{!werkstatt && ausWerkstatt && (
  <ClaudeCodeWerkstatt />
)}
{einfuegen && (
  <details class="fallback">
    <summary>Ohne Claude Code: Text in Claude einfügen</summary>
    <Prompt label="Prüfen lassen · Claude mit Text zum Einfügen" note={einfuegenHinweis(m, pfad)}><Fragment set:text={einfuegen} /></Prompt>
    {ausWerkstatt && <p class="small muted">Was in der Werkstatt liegt, liest Claude mit dem <a href="/innolab/werkstatt/claude">Werkstatt-Connector</a> selbst; ohne Connector fügt ihr auch diese Texte ein, je aus „Für Claude kopieren“ im Editor.</p>}
  </details>
)}
{werkstatt && (
  <p class="small muted">Dafür braucht Claude den Werkstatt-Connector: <a href="/innolab/werkstatt/claude">Claude mit der Werkstatt verbinden</a>. Der Prompt geht auch in Claude Code: <a href="/innolab/werkstatt/claude#claude-code">Claude Code mit der Werkstatt verbinden</a>. Ohne Connector fügt ihr den Prompt oben in ein Gespräch mit Claude ein und darunter jeden Text, den der Prompt nennt, je aus „Für Claude kopieren“ im Editor. Der kopierte Text allein reicht nicht: Dann schreibt Claude euer Artefakt um, statt es zu prüfen.</p>
)}
