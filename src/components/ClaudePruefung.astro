---
// Abschnitt „Prüfen“ auf Methodenseiten: erst die Prüfliste der Methode (methoden.ts) zum Abhaken, dann derselbe Text
// als Prompt für Claude. Claude prüft nur, schreibt nichts um und ändert keine Datei. Die Punkte sind reiner Text –
// die Checkliste würde HTML darstellen, der Prompt nicht (methoden.test.ts prüft das).
// Liegt das Ergebnis in der Werkstatt, geht der Prompt an Claude mit dem Werkstatt-Connector (artefakt_pruefen), sonst
// an Claude Code im Projekt-Repo, das die Werkstatt-Vorarbeit über denselben Connector liest. Darunter, zugeklappt, der
// Ausweichweg ohne Claude Code: Ergebnis als Text in Claude einfügen (nur für Ergebnisse in Dateien). Liegt das Ergebnis
// nur auf Miro (Experience Map, Baum), geht der Prompt mit einem Bild des Frames an Claude mit dem Werkstatt-Connector.
// Direkt unter dem Prompt „Danach“: was ihr mit den Befunden macht (danachEntscheiden in methoden.ts; Nachfragen nach
// Belegen nur beim Prüfen auf Miro).
import Checklist from './Checklist.astro';
import ClaudeCodeWerkstatt from './ClaudeCodeWerkstatt.astro';
import Prompt from './Prompt.astro';
import { METHODEN, artefakt, danachEntscheiden, einfuegenHinweis, einfuegenMoeglich, miroBildAusschnitt, miroVorarbeitArtefakte, pruefChecklisteId, pruefPrompt, pruefungAufMiro, pruefungInWerkstatt, werkstattVorarbeit } from './methoden';

// pfad: wenn nur ein Teil des Artefakts geprüft wird (z. B. ein Transkript statt aller Interview-Dateien).
const { slug, pfad } = Astro.props as { slug: string; pfad?: string };
const m = METHODEN.find((x) => x.slug === slug);
if (!m?.pruefliste) throw new Error(`ClaudePruefung: Methode „${slug}“ hat keine Prüfliste`);
const text = pruefPrompt(m, pfad);
const werkstatt = pruefungInWerkstatt(m, pfad);
const miro = pruefungAufMiro(m, pfad);
const ausWerkstatt = werkstattVorarbeit(m).length > 0;
const label = werkstatt ? 'Prüfen lassen · Claude mit der Werkstatt' : miro ? 'Prüfen lassen · Claude mit Bild aus Miro' : 'Prüfen lassen · Claude Code';
const einfuegen = einfuegenMoeglich(m, pfad) ? pruefPrompt(m, pfad, 'einfuegen') : null;
// Miro: was aufs Bild kommt (eigene Spalte oder eigener Frame), und ein zweites Bild nur, wenn der Prompt es ankündigt.
const miroBild = miro ? miroBildAusschnitt(artefakt(m.ergibt[0])!) : '';
const miroZweit = miro ? miroVorarbeitArtefakte(m) : [];
---
<Checklist id={pruefChecklisteId(m)} items={m.pruefliste.map((p) => p.text)} ids={m.pruefliste.map((p) => p.id)} />
{miro && (
  <div class="so-gehts">
    <p><strong>So geht’s (5 Minuten):</strong></p>
    <ol>
      <li>Die Prüfliste oben selbst abhaken.</li>
      <li>Unten beim Prompt „{label}“ auf „Kopieren“ klicken.</li>
      <li>In claude.ai ein neues Gespräch öffnen und prüfen, dass der Werkstatt-Connector an ist (über „+“ → Connectors; eingerichtet unter <a href="/innolab/werkstatt/claude">Claude mit der Werkstatt verbinden</a>). Den Prompt mit Cmd+V einfügen, noch nicht senden.</li>
      <li>Auf Miro {miroBild} so heranzoomen, dass jede Karte lesbar ist. Bildschirmfoto in die Zwischenablage: Cmd+Ctrl+Shift+4, Bereich aufziehen. Ein großer Frame darf zwei Bilder brauchen.</li>
      <li>In claude.ai Cmd+V – das Bild hängt unter dem Prompt.{miroZweit.map((z) => ` Dazu ein zweites Bild zum Abgleich: ${miroBildAusschnitt(z)}, ebenso fotografieren und einfügen.`).join('')} Dann absenden.</li>
      <li>Claude nennt höchstens drei Befunde, je mit Zitat und Frage. Dann weiter wie unten unter „Danach entscheidet ihr“.</li>
    </ol>
    <p class="small muted">Die Werkstatt liest Claude mit dem Connector selbst; ohne Connector fügt ihr diese Texte ein, je aus „Für Claude kopieren“ im Editor, dort ohne Häkchen bei „Prüf-Prompt mitkopieren“.</p>
  </div>
)}
<Prompt label={label} note="Erst nachdem ihr die Prüfliste selbst durchgegangen seid. Claude findet, ihr entscheidet."><Fragment set:text={text} /></Prompt>
<div class="danach">
  <p><strong>Danach entscheidet ihr</strong> – Claude schreibt nichts um:</p>
  <ol>
    {danachEntscheiden(m, pfad).map((t) => <li set:html={t} />)}
  </ol>
</div>
{!werkstatt && !miro && ausWerkstatt && (
  <ClaudeCodeWerkstatt />
)}
{einfuegen && (
  <details class="fallback">
    <summary>Ohne Claude Code: Text in Claude einfügen</summary>
    <Prompt label="Prüfen lassen · Claude mit Text zum Einfügen" note={einfuegenHinweis(m, pfad)}><Fragment set:text={einfuegen} /></Prompt>
    {ausWerkstatt && <p class="small muted">Was in der Werkstatt liegt, liest Claude mit dem <a href="/innolab/werkstatt/claude">Werkstatt-Connector</a> selbst; ohne Connector fügt ihr auch diese Texte ein, je aus „Für Claude kopieren“ im Editor, dort ohne Häkchen bei „Prüf-Prompt mitkopieren“.</p>}
  </details>
)}
{werkstatt && (
  <p class="small muted">Dafür braucht Claude den Werkstatt-Connector: <a href="/innolab/werkstatt/claude">Claude mit der Werkstatt verbinden</a>. Der Prompt geht auch in Claude Code: <a href="/innolab/werkstatt/claude#claude-code">Claude Code mit der Werkstatt verbinden</a>. Ohne Connector reicht ein Kopieren: „Für Claude kopieren“ im Editor, mit Häkchen bei „Prüf-Prompt mitkopieren“ (so steht es am Anfang). Das kopiert diesen Prompt, darunter euer Artefakt und jeden Text, den der Prompt zum Abgleich nennt; ihr fügt alles in ein neues Gespräch mit Claude ein. Ohne den Prompt reicht der Text nicht: Dann schreibt Claude euer Artefakt um, statt es zu prüfen.</p>
)}

<style>
  .danach { margin: .75rem 0 1rem; }
  .danach p { margin: 0 0 .3rem; }
  .danach ol { margin: 0; padding-left: 1.4rem; }
  .danach li + li { margin-top: .2rem; }
  .so-gehts { margin: .75rem 0 1rem; }
  .so-gehts p { margin: 0 0 .3rem; }
  .so-gehts ol { margin: 0 0 .5rem; padding-left: 1.4rem; }
  .so-gehts li + li { margin-top: .2rem; }
</style>
