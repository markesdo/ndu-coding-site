---
// Prompt-Karte mit Copy-Button. Inhalt als Slot (Text wird 1:1 kopiert).
import { Check, Copy, Info, SquareTerminal } from '@lucide/astro';
import { lueckenMarkieren } from './luecken';
const { label = 'Prompt für Claude Code', note } = Astro.props;
// [Lücken] wie „[Nummer]“ farbig markieren, damit man sieht, was zu ersetzen ist. Kopiert wird weiter der Text
// (innerText) – die Klammern bleiben darin, <mark> ändert nur die Darstellung.
const html = lueckenMarkieren(await Astro.slots.render('default'));
const hatLuecken = html.includes('class="luecke"');
---
<div class="prompt">
  <div class="label">
    <span class="label-text"><SquareTerminal size={14} aria-hidden="true" />{label}</span>
    <button class="copy" type="button">
      <Copy class="ico-copy" size={14} aria-hidden="true" />
      <Check class="ico-done" size={14} stroke-width={2.5} aria-hidden="true" />
      <span class="copy-text" aria-live="polite">Kopieren</span>
    </button>
  </div>
  <pre set:html={html}></pre>
  {hatLuecken && <p class="luecken-hinweis">Gelbe Lücken anklicken und ausfüllen – Kopieren nimmt eure Eingaben mit. <a href="/prompts-ausfuellen">Wie?</a></p>}
</div>
{/* Hinweis außerhalb der grauen Karte: Die Karte ist genau das, was kopiert wird. */}
{note && <p class="prompt-note"><Info size={14} aria-hidden="true" /><span><strong>Hinweis</strong> {note}</span></p>}
<script>
  import { lueckeNachEingabe } from './luecken-eingabe';

  // Lücken direkt in der Karte ausfüllen: Klick markiert den Platzhalter, Tippen ersetzt ihn.
  // Kopieren liest weiter innerText des <pre> – Eingaben sind damit automatisch dabei.
  document.querySelectorAll<HTMLElement>('.prompt mark.luecke').forEach(m => {
    if (m.dataset.platzhalter) return;
    const platzhalter = m.textContent ?? '';
    m.dataset.platzhalter = platzhalter;
    m.contentEditable = 'plaintext-only';
    if (m.contentEditable !== 'plaintext-only') m.contentEditable = 'true';
    m.spellcheck = false;
    m.setAttribute('role', 'textbox');
    m.setAttribute('aria-label', `Lücke ${platzhalter} ausfüllen`);
    m.title = 'Anklicken und ausfüllen';
    m.addEventListener('focus', () => {
      if (m.classList.contains('gefuellt')) return;
      const r = document.createRange(); r.selectNodeContents(m);
      const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(r);
    });
    m.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); m.blur(); } });
    m.addEventListener('paste', e => {
      if (m.contentEditable === 'plaintext-only') return;
      e.preventDefault();
      document.execCommand('insertText', false, e.clipboardData?.getData('text/plain') ?? '');
    });
    m.addEventListener('blur', () => {
      const { text, gefuellt } = lueckeNachEingabe(m.textContent ?? '', platzhalter);
      if (m.textContent !== text) m.textContent = text;
      m.classList.toggle('gefuellt', gefuellt);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.prompt .copy').forEach(btn => {
    if (btn.dataset.bound) return; btn.dataset.bound = '1';
    const text = btn.querySelector('.copy-text')!;
    btn.addEventListener('click', async () => {
      (document.activeElement as HTMLElement | null)?.blur?.();
      const txt = btn.closest('.prompt')?.querySelector('pre')?.innerText ?? '';
      try { await navigator.clipboard.writeText(txt.trim()); } catch {}
      text.textContent = 'Kopiert'; btn.classList.add('done');
      setTimeout(() => { text.textContent = 'Kopieren'; btn.classList.remove('done'); }, 1800);
    });
  });
</script>
