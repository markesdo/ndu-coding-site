---
// Vorschau, wenn ein Link in WhatsApp, Teams, Slack & Co. geteilt wird (Open Graph).
// Die Vorschau-Dienste sind nicht angemeldet: Für jede Kursseite landen sie über das Kurspasswort auf /login –
// darum tragen nur /login und /start die Vorschau (Kursseiten bekämen die Tags nie zu sehen). /og.png ist in
// middleware.ts vom Passwort ausgenommen, robots.txt erlaubt alle drei. Absolute Adressen aus `site` in astro.config.mjs.
// Ohne mitUrl kein og:url: /login steht für jede geteilte Kursseite, ein og:url würde sie alle auf /login umbiegen.
const {
  mitUrl = false,
  title = 'Programmieren mit AI · NDU Coding 2026',
  description = 'In drei Tagen zum eigenen, öffentlich erreichbaren Prototyp – ohne eine Zeile Code selbst zu schreiben. NDU, MSc Management by Innovation, Oktober 2026.',
} = Astro.props as { mitUrl?: boolean; title?: string; description?: string };
const bild = new URL('/og.png', Astro.site).href;
// Ohne Schrägstrich am Ende, wie Vercel die Seiten ausliefert (trailingSlash: false in vercel.json).
const adresse = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href;
---
<meta property="og:type" content="website" />
<meta property="og:site_name" content="NDU Coding 2026" />
<meta property="og:locale" content="de_AT" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{mitUrl && <meta property="og:url" content={adresse} />}
<meta property="og:image" content={bild} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Programmieren mit AI – NDU, Oktober 2026: Tag 1 Do 8.10., Tag 2 Fr 9.10., Tag 3 Do 15.10." />
<meta name="twitter:card" content="summary_large_image" />
