---
import { Brain, Info, Lightbulb, TriangleAlert } from '@lucide/astro';
const { type = 'info', title } = Astro.props as { type?: 'tip' | 'warn' | 'info' | 'concept'; title?: string };
const Icon = { tip: Lightbulb, warn: TriangleAlert, info: Info, concept: Brain }[type];
---
<div class={`callout ${type}`}>
  {title && <div class="t"><Icon class="callout-icon" size={20} aria-hidden="true" /> {title}</div>}
  <slot />
</div>
