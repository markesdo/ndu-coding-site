---
// Umschalter macOS / Windows. Inhalte mit data-nur="mac" bzw. data-nur="windows" werden je nach Wahl ausgeblendet.
// Die Wahl gilt für die ganze Seite (Attribut data-os auf <html>) und bleibt im Browser gespeichert.
// Ohne JavaScript bleibt data-os leer – dann sind beide Varianten sichtbar.
import { Apple, Monitor } from '@lucide/astro';
---
<div class="os-wahl" role="group" aria-label="Betriebssystem wählen">
  <span class="small muted">Anleitung für:</span>
  <button type="button" data-os-wahl="mac" aria-pressed="false"><Apple size={16} aria-hidden="true" /> macOS</button>
  <button type="button" data-os-wahl="windows" aria-pressed="false"><Monitor size={16} aria-hidden="true" /> Windows</button>
</div>

<script is:inline>
  // Läuft sofort (inline), damit beim Laden nicht kurz beide Varianten aufblitzen.
  (function () {
    var gespeichert = null;
    try { gespeichert = localStorage.getItem('ndu-os'); } catch (e) {}
    var os = gespeichert === 'mac' || gespeichert === 'windows' ? gespeichert : (/Windows/i.test(navigator.userAgent) ? 'windows' : 'mac');
    function setze(wert) {
      document.documentElement.dataset.os = wert;
      document.querySelectorAll('[data-os-wahl]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.osWahl === wert)); });
    }
    setze(os);
    document.querySelectorAll('[data-os-wahl]').forEach(function (b) {
      b.addEventListener('click', function () {
        setze(b.dataset.osWahl);
        try { localStorage.setItem('ndu-os', b.dataset.osWahl); } catch (e) {}
      });
    });
  })();
</script>
