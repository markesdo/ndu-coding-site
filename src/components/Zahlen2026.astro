---
// Zwei Zahlen für Konzept 9: „Gefühlt vs. gemessen“ (METR-Studie 2025) und „Wie lang darf die Aufgabe sein?“
// (METR, Mai 2026). Reines HTML/CSS, Balken mit direkter Beschriftung – Farbe trägt nie allein die Bedeutung.
// Farben mit dem dataviz-Validator geprüft (hell auf #ffffff, dunkel auf #1b1b21).
const stunden = [
  { t: 'klappt in der Hälfte der Fälle', h: 12, wert: 'rund 12 Stunden' },
  { t: 'klappt in 4 von 5 Fällen', h: 1.5, wert: 'rund 1,5 Stunden' },
];
---
<div class="zahlen">
  <figure class="panel" aria-labelledby="z-gefuehlt-titel">
    <figcaption id="z-gefuehlt-titel"><strong>Gefühlt vs. gemessen</strong><span>Erfahrene Entwickler*innen, eigene Projekte, mit und ohne KI (METR, 2025)</span></figcaption>
    <div class="divergent" aria-hidden="true">
      <div class="zeile">
        <span class="name">Geschätzt: <span class="wert">20 % schneller</span></span>
        <div class="spur"><span class="mitte"></span><span class="balken rechts gefuehlt" style="--w: 80%" title="Geschätzt: 20 % schneller"></span></div>
      </div>
      <div class="zeile">
        <span class="name">Gemessen: <span class="wert">19 % langsamer</span></span>
        <div class="spur"><span class="mitte"></span><span class="balken links gemessen" style="--w: 76%" title="Gemessen: 19 % langsamer"></span></div>
      </div>
      <div class="achse"><span>langsamer</span><span>schneller</span></div>
    </div>
    <table class="sr-only">
      <tr><th>Wert</th><th>Ergebnis</th></tr>
      <tr><td>Geschätzt</td><td>20 % schneller</td></tr>
      <tr><td>Gemessen</td><td>19 % langsamer</td></tr>
    </table>
  </figure>

  <figure class="panel" aria-labelledby="z-stunden-titel">
    <figcaption id="z-stunden-titel"><strong>Wie lang darf die Aufgabe sein?</strong><span>Arbeitszeit, die ein Profi dafür bräuchte – beste Modelle, Frühjahr 2026 (METR)</span></figcaption>
    <div class="stunden" aria-hidden="true">
      {stunden.map((s) => (
        <div class="zeile">
          <span class="name">{s.t}: <span class="wert">{s.wert}</span></span>
          <div class="spur"><span class="balken stunde" style={`--w: ${(s.h / 12) * 100}%`} title={`${s.t}: ${s.wert}`}></span></div>
        </div>
      ))}
    </div>
    <table class="sr-only">
      <tr><th>Verlässlichkeit</th><th>Aufgabenlänge</th></tr>
      {stunden.map((s) => <tr><td>{s.t}</td><td>{s.wert}</td></tr>)}
    </table>
  </figure>
</div>

<style>
  .zahlen { --z-gefuehlt: #2457d6; --z-gemessen: #d6401f; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1.5rem 0; }
  :global(:root[data-theme="dark"]) .zahlen { --z-gefuehlt: #5b86f0; --z-gemessen: #ec5434; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .zahlen { --z-gefuehlt: #5b86f0; --z-gemessen: #ec5434; }
  }
  .panel { margin: 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); display: flex; flex-direction: column; gap: 1rem; }
  figcaption { display: flex; flex-direction: column; gap: .2rem; }
  figcaption span { font-size: .85rem; color: var(--muted); line-height: 1.4; }
  .zeile { display: flex; flex-direction: column; gap: .35rem; }
  .name { font-size: .85rem; color: var(--muted); }
  .wert { font-size: .95rem; font-weight: 600; color: var(--fg); }
  .divergent, .stunden { display: flex; flex-direction: column; gap: .9rem; }
  .spur { position: relative; height: 22px; }
  .mitte { position: absolute; left: 50%; top: -4px; bottom: -4px; width: 1px; background: var(--muted); }
  .balken { position: absolute; top: 0; height: 100%; }
  .balken.rechts { left: calc(50% + 1px); width: calc(var(--w) / 2); border-radius: 0 4px 4px 0; }
  .balken.links { right: calc(50% + 1px); width: calc(var(--w) / 2); border-radius: 4px 0 0 4px; }
  .balken.stunde { left: 0; width: var(--w); min-width: 6px; border-radius: 0 4px 4px 0; background: var(--z-gefuehlt); }
  .gefuehlt { background: var(--z-gefuehlt); }
  .gemessen { background: var(--z-gemessen); }
  .achse { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (max-width: 700px) { .zahlen { grid-template-columns: 1fr; } }
</style>
