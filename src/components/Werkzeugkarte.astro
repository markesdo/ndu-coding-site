---
// „Eure Werkzeuge auf einen Blick“: zwei Zonen (Mac, Internet) × sechs Aufgaben, Linien je Ebene, Erklärung per Antippen.
// Daten: werkzeuge.ts. Die Linien zeichnet das Skript unten aus den echten Positionen – so passen sie bei jeder Breite.
// Die Erklärung klebt am unteren Bildschirmrand, solange ein Werkzeug gewählt ist – niemand muss dafür scrollen.
import {
  Bot, Cloud, Database, FileText, FolderGit2, GitPullRequest, KeyRound, Laptop, ListTodo, Monitor, Palette, PenTool,
  Sparkles, SquareTerminal, Triangle, X,
} from '@lucide/astro';
import { EBENEN, REIHEN, VERBINDUNGEN, WERKZEUGE, besteEbenen, verbindungenVon, type IconName } from './werkzeuge';

// Record<IconName, …>: Fehlt eine Ikone aus ICON_NAMEN, meldet es die Typprüfung.
const ICONS: Record<IconName, any> = {
  Bot, Database, FileText, FolderGit2, GitPullRequest, KeyRound, ListTodo, Monitor, Palette, PenTool, Sparkles, SquareTerminal, Triangle,
};
const name = (id: string) => WERKZEUGE.find((w) => w.id === id)!.name;
const ebeneName = (id: string) => EBENEN.find((e) => e.id === id)!.t;
// Was das Skript zum Umschalten braucht – aus den Daten, nicht aus Knopftexten gelesen.
const meta = {
  beste: besteEbenen(),
  ebenen: Object.fromEntries(EBENEN.map((e) => [e.id, e.t])),
  namen: Object.fromEntries(WERKZEUGE.map((w) => [w.id, w.name])),
};
---
<figure class="wk" data-ebene="code" aria-label="Eure Werkzeuge: was auf eurem Mac läuft, was im Internet, und wie sie zusammenhängen">
  <div class="wk-ebenen" role="radiogroup" aria-label="Welche Verbindungen zeigen">
    {EBENEN.map((e, i) => (
      <button type="button" role="radio" class:list={['wk-ebene', `wk-ebene-${e.id}`]} data-ebene={e.id}
        aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="wk-strich" aria-hidden="true" />{e.t}
      </button>
    ))}
  </div>
  {EBENEN.map((e) => <p class="wk-ebene-text" data-fuer={e.id}>{e.erklaerung}</p>)}

  <div class="wk-feld">
    <svg class="wk-linien" aria-hidden="true">
      <defs>
        {EBENEN.map((e) => (
          <marker id={`wk-pfeil-${e.id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" class={`wk-pfeil-${e.id}`} />
          </marker>
        ))}
      </defs>
    </svg>
    <svg class="wk-schrift" aria-hidden="true" />
    <div class="wk-raster">
      <div class="wk-ecke" />
      <div class="wk-kopf wk-mac"><Laptop size={16} aria-hidden="true" /> Auf eurem Mac</div>
      <div class="wk-kopf wk-netz"><Cloud size={16} aria-hidden="true" /> Im Internet – eure Konten</div>
      {REIHEN.map((r, ri) => (
        <>
          <div class="wk-reihe">{r.t}</div>
          {(['mac', 'netz'] as const).map((zone) => {
            const hier = WERKZEUGE.filter((w) => w.reihe === r.id && w.zone === zone);
            return (
              <div class:list={['wk-zelle', `wk-${zone}`, { 'wk-letzte': ri === REIHEN.length - 1 }]}>
                {hier.length === 0 && <span class="wk-leer">nur im Browser</span>}
                {hier.map((w) => {
                  const Icon = ICONS[w.icon];
                  if (!Icon) throw new Error(`Werkzeugkarte: Ikone ${w.icon} fehlt in ICONS`);
                  return (
                    <button type="button" class="wk-knoten" data-id={w.id} data-zone={w.zone} data-reihe={ri}
                      aria-expanded="false" aria-controls="wk-detail">
                      <Icon size={18} aria-hidden="true" /> <span>{w.name}</span>
                    </button>
                  );
                })}
              </div>
            );
          })}
        </>
      ))}
    </div>
  </div>

  <div class="wk-detail" id="wk-detail" aria-live="polite">
    <p class="wk-hinweis">Tippt ein Werkzeug an: Ihr seht, was es tut, wann ihr dort seid und womit ihr angemeldet seid.</p>
    <button type="button" class="wk-zu" aria-label="Schließen" hidden><X size={18} aria-hidden="true" /></button>
    <p class="wk-wechsel" hidden></p>
    {WERKZEUGE.map((w) => {
      const alle = verbindungenVon(w.id);
      return (
        <section data-detail={w.id} hidden>
          <h3>{w.name}</h3>
          <p class="wk-rolle">{w.rolle}</p>
          <dl>
            <dt>Wann ihr dort seid</dt><dd>{w.wann}</dd>
            <dt>Angemeldet mit</dt><dd>{w.konto}</dd>
          </dl>
          {/* Verbindungen der gezeigten Ebene – welche sichtbar sind, schaltet das Skript. */}
          <ul class="wk-verbunden">
            {alle.map((v) => <li data-ebene={v.ebene}><strong>{name(v.von)} → {name(v.nach)}:</strong> {v.text}</li>)}
          </ul>
          <p class="wk-keine" hidden>Auf dieser Ebene keine Verbindung. <button type="button" class="wk-zeigen"></button></p>
          <details class="wk-alle">
            <summary>Alle Verbindungen ({alle.length})</summary>
            <ul>
              {alle.map((v) => (
                <li><span class={`wk-tag wk-tag-${v.ebene}`}>{ebeneName(v.ebene)}</span> <strong>{name(v.von)} → {name(v.nach)}:</strong> {v.text}</li>
              ))}
            </ul>
          </details>
          {w.link && <p class="wk-mehr"><a href={w.link.href} target={w.link.href.startsWith('http') ? '_blank' : undefined} rel={w.link.href.startsWith('http') ? 'noopener' : undefined}>{w.link.t}</a></p>}
        </section>
      );
    })}
  </div>
  <script type="application/json" class="wk-meta" set:html={JSON.stringify(meta)} />
  <script type="application/json" class="wk-daten" set:html={JSON.stringify(VERBINDUNGEN.map(({ von, nach, ebene, kurz }) => ({ von, nach, ebene, kurz })))} />
</figure>

<script>
  type V = { von: string; nach: string; ebene: string; kurz: string };
  type R = DOMRect;
  const NS = 'http://www.w3.org/2000/svg';

  // Punkt auf der kubischen Kurve P0 (x1,y1) → P1 (mx,y1) → P2 (mx,y2) → P3 (x2,y2).
  function aufKurve(t: number, x1: number, y1: number, x2: number, y2: number): [number, number] {
    const mx = (x1 + x2) / 2;
    const u = 1 - t;
    const x = u * u * u * x1 + 3 * u * u * t * mx + 3 * u * t * t * mx + t * t * t * x2;
    const y = u * u * u * y1 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y2;
    return [x, y];
  }

  for (const karte of document.querySelectorAll<HTMLElement>('.wk')) {
    const daten: V[] = JSON.parse(karte.querySelector('.wk-daten')!.textContent || '[]');
    const meta: { beste: Record<string, string>; ebenen: Record<string, string>; namen: Record<string, string> } =
      JSON.parse(karte.querySelector('.wk-meta')!.textContent || '{}');
    const feld = karte.querySelector<HTMLElement>('.wk-feld')!;
    const svg = karte.querySelector<SVGSVGElement>('.wk-linien')!;
    const schrift = karte.querySelector<SVGSVGElement>('.wk-schrift')!;
    const panel = karte.querySelector<HTMLElement>('.wk-detail')!;
    const zu = karte.querySelector<HTMLButtonElement>('.wk-zu')!;
    const wechsel = karte.querySelector<HTMLElement>('.wk-wechsel')!;
    const kopfMac = karte.querySelector<HTMLElement>('.wk-kopf.wk-mac')!;
    const kopfNetz = karte.querySelector<HTMLElement>('.wk-kopf.wk-netz')!;
    const knoten = new Map([...karte.querySelectorAll<HTMLElement>('.wk-knoten')].map((k) => [k.dataset.id!, k]));
    const ebenenKnoepfe = [...karte.querySelectorAll<HTMLButtonElement>('.wk-ebene')];
    let auswahl = '';
    // Hat jemand eine Ebene selbst gewählt, schaltet das Antippen nicht mehr um.
    let bewusst = false;
    // Ebene vor einem automatischen Wechsel – beim Schließen kehrt die Karte dorthin zurück.
    let zurueck: HTMLButtonElement | null = null;

    const zeichnen = () => {
      const ebene = karte.dataset.ebene!;
      svg.querySelectorAll('.wk-linie').forEach((e) => e.remove());
      schrift.replaceChildren();
      // Erst alle Positionen lesen, dann zeichnen – sonst rechnet der Browser das Layout pro Linie neu.
      const f = feld.getBoundingClientRect();
      const rects = new Map<string, R>([...knoten].map(([id, k]) => [id, k.getBoundingClientRect()]));
      const zellen = new Map<string, R>([...knoten].map(([id, k]) => [id, k.parentElement!.getBoundingClientRect()]));
      const zonen = { mac: kopfMac.getBoundingClientRect(), netz: kopfNetz.getBoundingClientRect() };
      for (const s of [svg, schrift]) s.setAttribute('viewBox', `0 0 ${f.width} ${f.height}`);
      const X = (x: number) => x - f.left;
      const Y = (y: number) => y - f.top;
      const linien = daten.filter((d) => d.ebene === ebene);
      const gegen = (v: V) => linien.some((g) => g.von === v.nach && g.nach === v.von);
      // Innerhalb eines Kastens bleiben, mit etwas Abstand zum Rand (die Pfeilspitze ist ~12 px hoch).
      const innen = (y: number, r: R) => Math.min(Math.max(y, r.top + 6), r.bottom - 6);

      // Art jeder Linie, einmal bestimmt: übereinander (senkrecht), nebeneinander (seitlich) oder am Rand der Zone
      // entlang (Bus) – wenn die Linie sonst hinter anderen Kästen verschwände.
      const art = new Map<V, 'senkrecht' | 'seitlich' | 'bus'>();
      for (const v of linien) {
        const ka = knoten.get(v.von)!, kb = knoten.get(v.nach)!;
        const a = rects.get(v.von)!, b = rects.get(v.nach)!;
        const links = Math.max(a.left, b.left), rechts = Math.min(a.right, b.right);
        if (ka.dataset.zone === kb.dataset.zone && Math.abs(Number(ka.dataset.reihe) - Number(kb.dataset.reihe)) > 1) art.set(v, 'bus');
        else if (links >= rechts) art.set(v, 'seitlich');
        else {
          // Senkrecht – außer ein dritter Kasten liegt dazwischen (am Handy brechen Kästen einer Reihe um).
          const oben = Math.min(a.bottom, b.bottom), unten = Math.max(a.top, b.top), x = (links + rechts) / 2;
          const verdeckt = [...rects].some(([id, r]) => id !== v.von && id !== v.nach && r.left < x && r.right > x && r.top < unten && r.bottom > oben);
          art.set(v, verdeckt ? 'bus' : 'senkrecht');
        }
      }
      const istMac = (id: string) => knoten.get(id)!.dataset.zone === 'mac';
      // Seite, an der eine Linie den Start- bzw. Zielkasten berührt.
      const ausSeite = (v: V) => (art.get(v) === 'bus' ? 'bus' : rects.get(v.nach)!.left > rects.get(v.von)!.left ? 'r' : 'l');
      const einSeite = (v: V) => (art.get(v) === 'bus' ? (istMac(v.von) ? 'l' : 'r') : rects.get(v.nach)!.left > rects.get(v.von)!.left ? 'l' : 'r');
      // Gruppen zum Auffächern: mehrere Linien aus derselben Seite eines Kastens, mehrere Pfeile in dieselbe Seite.
      const gruppe = (schluessel: (v: V) => string, sortiere: (v: V) => number) => {
        const m = new Map<string, V[]>();
        for (const v of linien) if (art.get(v) !== 'senkrecht') m.set(schluessel(v), [...(m.get(schluessel(v)) ?? []), v]);
        for (const l of m.values()) l.sort((p, q) => sortiere(p) - sortiere(q));
        return m;
      };
      const raus = gruppe((v) => `${v.von}|${ausSeite(v)}`, (v) => rects.get(v.nach)!.top);
      const rein = gruppe((v) => `${v.nach}|${einSeite(v)}`, (v) => rects.get(v.von)!.top);
      const platz = (m: Map<string, V[]>, k: string, v: V, r: R) => {
        const l = m.get(k)!;
        return r.top + (r.height * (l.indexOf(v) + 1)) / (l.length + 1);
      };

      const halo = (x: number) => {
        const ax = x + f.left;
        if (ax >= zonen.mac.left && ax <= zonen.mac.right) return 'mac';
        if (ax >= zonen.netz.left && ax <= zonen.netz.right) return 'netz';
        return 'aussen';
      };

      for (const v of linien) {
        const a = rects.get(v.von)!, b = rects.get(v.nach)!;
        const beteiligt = !auswahl || v.von === auswahl || v.nach === auswahl;
        let d = '';
        let etikett: { x: number; y: number; seite: boolean } | null = null;
        const was = art.get(v)!;
        if (was === 'bus') {
          const mac = istMac(v.von);
          const runter = b.top > a.top;
          const geschwister = raus.get(`${v.von}|bus`)!;
          const i = geschwister.indexOf(v);
          // Jede Linie eines Kastens bekommt ihre eigene Spur am Zonenrand (5 px, 10 px …).
          const busX = X(mac ? zonen.mac.left + 5 + i * 5 : zonen.netz.right - 5 - i * 5);
          const zielX = X(mac ? b.left : b.right);
          const zielY = Y(innen(platz(rein, `${v.nach}|${einSeite(v)}`, v, b), b));
          // Liegt zwischen Kasten und Zonenrand nichts, direkt zur Seite hinaus …
          const frei = ![...rects].some(([id, r]) => id !== v.von && r.top < a.bottom && r.bottom > a.top && (mac ? r.right <= a.left : r.left >= a.right));
          if (frei) {
            const ausY = Y(innen(a.top + (a.height * (i + 1)) / (geschwister.length + 1), a));
            d = `M ${X(mac ? a.left : a.right)} ${ausY} H ${busX} V ${zielY} H ${zielX}`;
          } else {
            // … sonst unten (oben) hinaus in den Rand der Zelle, unter den Nachbarn hindurch zum Zonenrand.
            const zelle = zellen.get(v.von)!;
            const ausX = X(mac ? a.left + 12 + i * 6 : a.right - 12 - i * 6);
            const ausY = Y(runter ? a.bottom : a.top);
            const zwischen = Y(runter ? zelle.bottom - 3 - i * 3 : zelle.top + 3 + i * 3);
            d = `M ${ausX} ${ausY} V ${zwischen} H ${busX} V ${zielY} H ${zielX}`;
          }
        } else if (was === 'senkrecht') {
          const runter = b.top > a.top;
          let x = X((Math.max(a.left, b.left) + Math.min(a.right, b.right)) / 2);
          // Hin und zurück zwischen denselben beiden Kästen: leicht versetzt.
          if (gegen(v)) x += runter ? 10 : -10;
          const y1 = Y(runter ? a.bottom : a.top), y2 = Y(runter ? b.top : b.bottom);
          d = `M ${x} ${y1} L ${x} ${y2}`;
          // Senkrechte Linien sind kurz: Beschriftung daneben statt darauf.
          etikett = { x: x + 8, y: (y1 + y2) / 2, seite: true };
        } else {
          const rechts = b.left > a.left;
          let y1 = platz(raus, `${v.von}|${ausSeite(v)}`, v, a);
          let y2 = platz(rein, `${v.nach}|${einSeite(v)}`, v, b);
          // Hin und zurück (push/pull): 26 px auseinander, Beschriftungen bei 35 % ihres eigenen Wegs –
          // so stehen „push“ und „pull“ an verschiedenen Stellen statt übereinander.
          const paar = gegen(v);
          if (paar) { const s = rechts ? -13 : 13; y1 += s; y2 += s; }
          y1 = Y(innen(y1, a)); y2 = Y(innen(y2, b));
          const x1 = X(rechts ? a.right : a.left), x2 = X(rechts ? b.left : b.right);
          const mx = (x1 + x2) / 2;
          d = `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
          const [ex, ey] = aufKurve(paar ? 0.35 : 0.5, x1, y1, x2, y2);
          etikett = { x: ex, y: ey, seite: false };
        }
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('d', d);
        p.setAttribute('class', `wk-linie wk-linie-${ebene}${beteiligt ? '' : ' wk-blass'}`);
        p.setAttribute('marker-end', `url(#wk-pfeil-${ebene})`);
        svg.appendChild(p);
        // Kurze Beschriftung nur, wo wenige Linien sind (Weg des Codes, App) – bei Claude stünden sie übereinander.
        // Sie liegt in einer eigenen Ebene über den Kästen, damit sie nie darunter verschwindet.
        if (etikett && ebene !== 'claude') {
          const t = document.createElementNS(NS, 'text');
          t.textContent = v.kurz;
          t.setAttribute('x', String(etikett.x));
          t.setAttribute('y', String(etikett.y));
          t.setAttribute('text-anchor', etikett.seite ? 'start' : 'middle');
          t.setAttribute('class', `wk-etikett wk-etikett-${ebene} wk-halo-${halo(etikett.x)}${beteiligt ? '' : ' wk-blass'}`);
          schrift.appendChild(t);
        }
      }
    };

    const markieren = () => {
      // Partner nur auf der gezeigten Ebene – sonst leuchten Kästen ohne sichtbare Linie.
      const ebene = karte.dataset.ebene!;
      const partner = new Set(daten.filter((d) => d.ebene === ebene && (d.von === auswahl || d.nach === auswahl)).flatMap((d) => [d.von, d.nach]));
      for (const [id, k] of knoten) {
        k.setAttribute('aria-expanded', String(id === auswahl));
        k.classList.toggle('wk-partner', !!auswahl && id !== auswahl && partner.has(id));
        k.classList.toggle('wk-blass', !!auswahl && !partner.has(id) && id !== auswahl);
      }
      for (const s of panel.querySelectorAll<HTMLElement>('section[data-detail]')) {
        s.hidden = s.dataset.detail !== auswahl;
        if (s.hidden) continue;
        let sichtbar = 0;
        for (const li of s.querySelectorAll<HTMLElement>('.wk-verbunden li')) {
          li.hidden = li.dataset.ebene !== ebene;
          if (!li.hidden) sichtbar++;
        }
        s.querySelector<HTMLElement>('.wk-keine')!.hidden = sichtbar > 0;
        const zeigen = s.querySelector<HTMLButtonElement>('.wk-zeigen')!;
        zeigen.dataset.ebene = meta.beste[auswahl];
        zeigen.textContent = `Zeigen: „${meta.ebenen[meta.beste[auswahl]]}“`;
      }
      panel.toggleAttribute('data-offen', !!auswahl);
      panel.querySelector<HTMLElement>('.wk-hinweis')!.hidden = !!auswahl;
      zu.hidden = !auswahl;
      zeichnen();
    };

    // Ebene umschalten, ohne neu zu zeichnen (das macht markieren()).
    const ebeneAnzeigen = (b: HTMLButtonElement) => {
      karte.dataset.ebene = b.dataset.ebene;
      for (const o of ebenenKnoepfe) {
        o.setAttribute('aria-checked', String(o === b));
        o.tabIndex = o === b ? 0 : -1;
      }
    };
    const knopfFuer = (ebene: string) => ebenenKnoepfe.find((b) => b.dataset.ebene === ebene)!;
    const hatVerbindung = (id: string, ebene: string) => daten.some((d) => d.ebene === ebene && (d.von === id || d.nach === id));

    const schliessen = () => {
      if (!auswahl) return;
      const vorher = knoten.get(auswahl)!;
      auswahl = '';
      wechsel.hidden = true;
      // Automatisch gewechselt? Zurück zur Ebene davor.
      if (zurueck) { ebeneAnzeigen(zurueck); zurueck = null; }
      markieren();
      vorher.focus();
    };

    const waehlen = (id: string) => {
      if (auswahl === id) return schliessen();
      auswahl = id;
      wechsel.hidden = true;
      // Hat das Werkzeug auf der gezeigten Ebene keine Verbindung, zur Ebene mit den meisten wechseln – sonst bliebe
      // die Grafik leer. Nicht, wenn jemand die Ebene selbst gewählt hat: Dann bietet die Erklärung den Wechsel an.
      if (!bewusst && !hatVerbindung(id, karte.dataset.ebene!)) {
        zurueck ??= knopfFuer(karte.dataset.ebene!);
        ebeneAnzeigen(knopfFuer(meta.beste[id]));
        wechsel.textContent = `Gezeigt wird jetzt „${meta.ebenen[meta.beste[id]]}“ – dort liegen die meisten Verbindungen von ${meta.namen[id]}.`;
        wechsel.hidden = false;
      }
      // Neue Auswahl: Erklärung von oben, „Alle Verbindungen“ wieder zu.
      panel.querySelector(`section[data-detail="${CSS.escape(id)}"] details`)?.removeAttribute('open');
      markieren();
      panel.scrollTop = 0;
      // Liegt der gewählte Kasten unter der Erklärung, ein Stück hochscrollen.
      const r = knoten.get(id)!.getBoundingClientRect();
      const frei = innerHeight - panel.offsetHeight - 16;
      if (r.bottom > frei) window.scrollBy({ top: r.bottom - frei, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };

    // Ebene, die jemand selbst wählt (Knopf oben oder „Zeigen: …“ in der Erklärung).
    const ebeneSetzen = (b: HTMLButtonElement) => {
      bewusst = true;
      zurueck = null;
      ebeneAnzeigen(b);
      wechsel.hidden = true;
      markieren();
    };
    panel.addEventListener('click', (e) => {
      const zeigen = (e.target as HTMLElement).closest<HTMLButtonElement>('.wk-zeigen');
      if (zeigen) ebeneSetzen(knopfFuer(zeigen.dataset.ebene!));
    });
    ebenenKnoepfe.forEach((b, i) => {
      b.addEventListener('click', () => ebeneSetzen(b));
      // Radiogruppe: Pfeiltasten wechseln die Ebene.
      b.addEventListener('keydown', (e) => {
        const schritt = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!schritt) return;
        e.preventDefault();
        const n = ebenenKnoepfe[(i + schritt + ebenenKnoepfe.length) % ebenenKnoepfe.length];
        ebeneSetzen(n);
        n.focus();
      });
    });
    for (const [id, k] of knoten) k.addEventListener('click', () => waehlen(id));
    zu.addEventListener('click', schliessen);
    // Escape auf der ganzen Seite, solange etwas gewählt ist – Safari fokussiert Knöpfe beim Klicken nicht.
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && auswahl) schliessen(); });

    new ResizeObserver(zeichnen).observe(feld);
    document.fonts?.ready.then(zeichnen);
    zeichnen();
  }
</script>

<style>
  .wk { margin: 1.5rem 0 2rem; --lc: var(--blue); }
  .wk[data-ebene="app"] { --lc: var(--green); }
  .wk[data-ebene="claude"] { --lc: var(--accent); }
  .wk-ebenen { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
