---
// Eine Folie: ein Gedanke pro Bildschirm. Im Beamer füllt sie die Höhe unter der Kopfleiste, ← / → blättern
// Folie für Folie (folien.ts, Handler in Layout.astro); sonst ist sie ein normaler Abschnitt des Handouts.
// Überschriften gehören in den Slot (<h2 id> im Seitenquelltext), sonst findet gliederung.ts sie nicht.
// Innerhalb: data-schritt deckt Elemente im Beamer nacheinander auf; .nur-handout fehlt im Beamer.
// weiter: → am Ende dieser Folie führt dorthin (Pfad mit #anker oder #anker auf derselben Seite) statt zur nächsten Folie
// oder Seite – so kann eine Seite Folien für später im Tag tragen (Tag 4: Arbeitsfluss um 9:00, Abschluss um 17:15).
// ende: → am Ende dieser Folie tut nichts mehr; unten rechts steht „Ende“ (beamer.css). Für die letzte Folie eines Kurstags.
const { weiter, ende = false } = Astro.props as { weiter?: string; ende?: boolean };
if (weiter && ende) throw new Error('Folie: weiter und ende schließen sich aus');
---
<section class="folie" data-folie data-weiter={weiter} data-ende={ende ? '' : undefined}><slot /></section>
