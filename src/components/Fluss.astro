---
// Kleines Ablauf-Diagramm aus Kästen und Pfeilen (z. B. Branch → PR → main). Nebeneinander, am Handy untereinander.
// knoten[].icon: eine Lucide-Komponente; knoten[].sub: kurze Zeile darunter (HTML erlaubt).
// beide: Pfeile in beide Richtungen (⇄), z. B. Laptop ⇄ GitHub ⇄ Codespace.
// hervor: Index eines Knotens, der farbig markiert wird (z. B. „eure Rolle“).
const { knoten, label, beide = false, hervor = [] } = Astro.props as {
  knoten: { t: string; sub?: string; icon?: any }[];
  label: string;
  beide?: boolean;
  hervor?: number[];
};
---
<figure class="fluss" aria-label={label}>
  <ol class:list={['fluss-reihe', { beide }]}>
    {knoten.map((k, i) => {
      const Icon = k.icon;
      return (
        <li class:list={{ hervor: hervor.includes(i) }}>
          {Icon && <Icon size={22} aria-hidden="true" class="fluss-icon" />}
          <span class="fluss-text">
            <strong>{k.t}</strong>
            {k.sub && <span class="fluss-sub" set:html={k.sub} />}
          </span>
        </li>
      );
    })}
  </ol>
</figure>

<style>
  .fluss { margin: 1.5rem 0; }
  .fluss-reihe { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1rem 2.25rem; }
  .fluss-reihe li { position: relative; flex: 1 1 8.5rem; display: flex; flex-direction: column; align-items: center; gap: .3rem; text-align: center; padding: .9rem .75rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); }
  .fluss-reihe li.hervor { border-color: var(--accent); }
  .fluss-icon { color: var(--accent); flex: none; }
  .fluss-text { display: flex; flex-direction: column; gap: .3rem; }
  .fluss-reihe strong { font-size: .95rem; line-height: 1.25; }
  .fluss-sub { font-size: .85rem; line-height: 1.4; color: var(--muted); }
  .fluss-reihe li + li::before { content: '→'; position: absolute; left: -1.7rem; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 1.2rem; }
  .fluss-reihe.beide li + li::before { content: '⇄'; }
  @media (max-width: 600px) {
    .fluss-reihe { flex-direction: column; gap: 1.6rem; }
    .fluss-reihe li { flex: none; flex-direction: row; align-items: center; gap: .75rem; text-align: left; padding: .6rem .8rem; }
    .fluss-text { gap: .1rem; }
    .fluss-reihe li + li::before { left: 50%; top: -1.45rem; transform: translateX(-50%); content: '↓'; }
    .fluss-reihe.beide li + li::before { content: '⇅'; }
  }
</style>
