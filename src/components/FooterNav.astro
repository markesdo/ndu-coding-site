---
const { prev, next } = Astro.props as { prev?: { href: string; t: string }; next?: { href: string; t: string } };
---
<nav class="footer-nav" aria-label="Zurück und weiter">
  {prev && <a class="prev" href={prev.href}><span class="fn-cap">Zurück</span><span>← {prev.t}</span></a>}
  {next && <a class="next" href={next.href}><span class="fn-cap">Weiter</span><span>{next.t} →</span></a>}
</nav>
