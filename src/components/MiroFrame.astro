---
// Hinweis auf der Aufgaben-Folie: In welchem Frame des Team-Boards gearbeitet wird. Der Name steht genau so im
// Frame-Titel auf dem Board (Nummer = Reihenfolge der Frames am Tag, T1 · 3 = Tag 1, dritter Frame; nicht jede Aufgabe hat einen).
// Mit gültiger MIRO_BOARD_URL (nur auf Vercel, Seiten hinter dem Kurspasswort) und bekanntem Frame wird die Pille ein
// Link direkt auf den Frame; sonst bleibt sie Text.
import { LayoutGrid } from '@lucide/astro';
import { MIRO_BOARD_URL } from 'astro:env/server';
import { miroBoard, miroFrameLink } from '../lib/miro-board';
import { MIRO_FRAMES } from './miro-frames';
const { name } = Astro.props as { name: string };
const board = miroBoard(MIRO_BOARD_URL);
const frameId = Object.hasOwn(MIRO_FRAMES, name) ? MIRO_FRAMES[name] : undefined;
const link = board && frameId ? miroFrameLink(board, frameId) : null;
---
{link ? (
  <p class="miro-frame"><a href={link} target="_blank" rel="noopener"><LayoutGrid size={18} aria-hidden="true" /> Miro: <strong>{name}</strong></a></p>
) : (
  <p class="miro-frame"><LayoutGrid size={18} aria-hidden="true" /> Miro: <strong>{name}</strong></p>
)}

<style>
  .miro-frame { display: inline-flex; align-items: center; gap: .4rem; margin: .25rem 0 .75rem; padding: .2rem .7rem; border: 1px solid var(--border); border-radius: 999px; font-size: .95rem; color: var(--muted); }
  .miro-frame strong { color: var(--fg); font-weight: 600; }
  /* Als Link: dieselbe Pille, nur der Name in Linkfarbe. */
  .miro-frame a { display: inline-flex; align-items: center; gap: .4rem; color: inherit; }
  /* Unterstrichen nur der Name – auch im Beamer, der sonst jeden Link ganz unterstreicht (beamer.css). */
  .miro-frame a, :global(html[data-beamer] .content) .miro-frame a { text-decoration: none; }
  .miro-frame a strong { color: var(--blue); text-decoration: underline; text-underline-offset: .15em; }
  .miro-frame:has(a:hover) { border-color: var(--blue); }
  /* Im Beamer oben rechts in der Folie (beamer.css: .folie ist position: relative) – kostet keine Höhe. */
  :global(html[data-beamer] .folie) > .miro-frame { position: absolute; top: .9rem; right: 0; margin: 0; }
</style>
