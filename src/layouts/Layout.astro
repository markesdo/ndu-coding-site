---
import { ArrowRight, Menu, NotebookPen, PanelLeftClose, PanelLeftOpen, Presentation } from '@lucide/astro';
// Schriften liegen auf unserem Server (fontsource), nicht bei Google: keine IP-Weitergabe an Dritte (DSGVO).
// Die CSS-Dateien deklarieren mehrere Zeichensätze; der Browser lädt per unicode-range nur, was die Seite nutzt (hier latin, ggf. latin-ext).
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
// Fließtext-Schrift vorladen, damit der erste Text nicht in der Ersatzschrift aufblitzt.
import textSchrift from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import BeamerStart from '../components/BeamerStart.astro';
import Marke from '../components/Marke.astro';
import NeuLaden from '../components/NeuLaden.astro';
import { BUILD } from '../lib/build';
import { ABMELDEN } from '../lib/kurszugang';
import { BEREICHE, NAV, bereichVon, nachbarn } from '../lib/navigation';
import { MAPPE_PFAD, NAV_MAPPE, NAV_ROLLE_SKRIPT } from '../lib/nav-rolle';
import { pfadOhneSchraegstrich } from '../components/abschnitt';
import '../styles/global.css';
import '../styles/beamer.css';
const path = pfadOhneSchraegstrich(Astro.url.pathname);
// Zwei Kurse auf einer Website: Menü, Logo, Titel und Blättern gelten nur für den Kurs dieser Seite (lib/navigation.ts).
const bereich = bereichVon(path);
const kurs = BEREICHE[bereich];
const anderer = BEREICHE[bereich === 'innolab' ? 'coding' : 'innolab'];
const nav = NAV[bereich];
const { title, description = kurs.beschreibung } = Astro.props;
// Ersatz-Reihenfolge fürs Blättern im Beamer-Modus, wenn eine Seite keinen FooterNav hat: die Menü-Reihenfolge des Kurses.
const { vorher, danach } = nachbarn(path);
// Einträge zur Mappe markieren: Für Lehrende setzt NAV_ROLLE_SKRIPT dort „Mappen der Kohorte“ (Menü und „Weiter: …“).
const zurMappe = (href?: string) => (href === MAPPE_PFAD ? { [NAV_MAPPE]: '' } : {});
---
<!doctype html>
<html lang="de" data-bereich={bereich}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {kurs.titel}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="ndu-build" content={BUILD} />
    <link rel="preload" href={textSchrift} as="font" type="font/woff2" crossorigin />
    <BeamerStart />
    <script is:inline>
      // Eingeklappte Seitenleiste (Desktop) vor dem ersten Zeichnen.
      try { if (localStorage.getItem('ndu-seitenleiste') === 'zu') document.documentElement.setAttribute('data-leiste-zu', ''); } catch (e) {}
    </script>
    <link rel="icon" href={kurs.favicon ?? '/favicon.svg'} type="image/svg+xml" />
  </head>
  <body>
    <div class="topbar">
      <strong class="topbar-brand"><Marke einzeilig name={kurs.marke} zeichen={kurs.zeichen} /></strong>
      <div class="topbar-actions">
        <a class="beamer-weiter" hidden data-fallback-next={danach?.href} data-fallback-next-t={danach?.t} {...zurMappe(danach?.href)} data-fallback-prev={vorher?.href} title="Nächste Seite (Taste →, zurück mit ←)"><span>Weiter: <b></b></span><ArrowRight size={16} aria-hidden="true" /></a>
        <!-- „Wo ist Markus?“: nur sichtbar, wo der Präsentator-Schlüssel liegt (wo-ist.ts) -->
        <button type="button" class="beamer-toggle praesentator" data-praesentator hidden aria-pressed="true"><span class="live-punkt" aria-hidden="true"></span><span data-praesentator-text>Live</span></button>
        <button type="button" class="beamer-toggle" data-beamer-toggle data-nur-praesentator aria-pressed="false" title="Beamer-Modus: größere Schrift, helles Thema, ohne Seitenleiste (Taste B). Blättern mit ← / →"><Presentation size={18} aria-hidden="true" /> Beamer</button>
        {/* Begleiter (Notizen zur Folie) in einem neuen Tab, damit die projizierte Seite stehen bleibt. Nur im Innolab und nur beim
            Präsentator (data-nur-praesentator, beamer.css); steht überall, wo die Kopfleiste steht (Beamer-Modus, Tablet), nur am Handy nicht. */}
        {bereich === 'innolab' && (
          <a class="begleiter-knopf" href="/innolab/begleiter" target="_blank" rel="noopener" data-nur-praesentator aria-label="Begleiter öffnen" title="Begleiter öffnen (neuer Tab)"><NotebookPen size={18} aria-hidden="true" /></a>
        )}
        <button id="menu-btn" aria-label="Menü öffnen"><Menu size={18} aria-hidden="true" /> Menü</button>
      </div>
    </div>
    <div class="shell">
      <!-- Seitenleiste einklappen (Desktop, global.css): offen ein Griff neben der Leiste; eingeklappt eine Gruppe links oben
           mit Ausklappen – und nur beim Präsentator (wo-ist.ts) Live und Beamer, die sonst in der Leiste stehen. -->
      <button type="button" class="leiste-griff" data-leiste aria-controls="sidebar" aria-expanded="true" aria-label="Seitenleiste einklappen" title="Seitenleiste einklappen – mehr Platz für den Inhalt (Taste [)"><PanelLeftClose size={16} aria-hidden="true" /></button>
      <div class="leiste-gruppe">
        <button type="button" class="leiste-auf" data-leiste aria-controls="sidebar" aria-expanded="false" aria-label="Seitenleiste ausklappen" title="Seitenleiste ausklappen (Taste [)"><PanelLeftOpen size={20} aria-hidden="true" /></button>
        <button type="button" class="beamer-toggle praesentator" data-praesentator hidden aria-pressed="true"><span class="live-punkt" aria-hidden="true"></span><span data-praesentator-text>Live</span></button>
        <button type="button" class="beamer-toggle" data-beamer-toggle data-nur-praesentator aria-pressed="false" title="Beamer-Modus (Taste B)"><Presentation size={18} aria-hidden="true" /> Beamer</button>
      </div>
      <aside class="sidebar" id="sidebar">
        <a class="brand" href={kurs.start} aria-label={`${kurs.kurz} – Übersicht`}><Marke name={kurs.marke} zeichen={kurs.zeichen} /></a>
        <nav>
          {nav.map(g => (
            <div class="group">
              <h4>{g.h}</h4>
              {g.items.map(i => <a href={i.href} class={path === i.href ? 'active' : ''} {...zurMappe(i.href)}>{i.t}</a>)}
            </div>
          ))}
        </nav>
        {/* Lehrende: „Mappen der Kohorte“ statt „Meine Mappe“, gleich nach dem Menü, vor dem ersten Zeichnen (lib/nav-rolle.ts). */}
        <script is:inline set:html={NAV_ROLLE_SKRIPT} />
        <button type="button" class="beamer-toggle" data-beamer-toggle data-nur-praesentator aria-pressed="false" title="Beamer-Modus: größere Schrift, ohne Seitenleiste (Taste B)"><Presentation size={18} aria-hidden="true" /> Beamer <kbd>B</kbd></button>
        <button type="button" class="beamer-toggle praesentator" data-praesentator hidden aria-pressed="true"><span class="live-punkt" aria-hidden="true"></span><span data-praesentator-text>Live</span></button>
        <p class="small muted" style="margin-top:2rem">NDU · MSc Management by Innovation<br/>{kurs.termine}</p>
        <p class="small kurswechsel"><a href={anderer.start}>Zum Kurs {anderer.kurz} →</a></p>
        {/* Abmelden: nur auf Vercel wirksam (middleware.ts); /start und /login haben eigene Seiten ohne dieses Layout. Es löscht
            nur die Cookies (Kurszugang, Werkstatt-Sitzung), nicht localStorage: Präsentator-Schlüssel und Werkstatt-Entwürfe
            bleiben absichtlich, Entwürfe gingen sonst verloren. */}
        <p class="small abmelden"><a href={ABMELDEN}>Abmelden</a></p>
      </aside>
      <main class="content">
        <div class="inner">
          <slot />
        </div>
      </main>
    </div>
    <script>
      import { beamerSchalten } from '../lib/beamer';
      import { aktuelleFolie, tasteSteuertFolien, tastenZiel, timerFuerT, weiter as folieWeiter, zurueck as folieZurueck } from '../components/folien';
      const btn = document.getElementById('menu-btn');
      const sb = document.getElementById('sidebar');
      btn?.addEventListener('click', () => sb?.classList.toggle('open'));
      document.addEventListener('click', (e) => {
        if (sb?.classList.contains('open') && !sb.contains(e.target as Node) && !btn?.contains(e.target as Node)) sb.classList.remove('open');
      });

      // Beamer-Modus: Knöpfe und Taste B schalten html[data-beamer] um; den Anfangszustand setzt das Skript im <head>.
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-beamer-toggle]');
      const sync = () => toggles.forEach((t) => t.setAttribute('aria-pressed', String(root.hasAttribute('data-beamer'))));
      const setBeamer = (an: boolean) => {
        // Nur der Präsentator schaltet ein (lib/beamer.ts, Regel in BeamerStart.astro); ausschalten geht immer.
        if (!beamerSchalten(root, an)) return;
        sb?.classList.remove('open');
      };
      // aria-pressed und Kopfleistenhöhe folgen dem Attribut – egal, wer umschaltet (auch PraesentatorEinstieg, wo-ist.ts).
      new MutationObserver(() => { sync(); hoeheMessen(); }).observe(root, { attributes: true, attributeFilter: ['data-beamer'] });

      // Klebende Kopfleiste: Höhe für Schrittleiste und Sprungziele (beamer.css, --topbar-h).
      const topbar = document.querySelector<HTMLElement>('.topbar');
      const hoeheMessen = () => { if (topbar) root.style.setProperty('--topbar-h', `${Math.round(topbar.getBoundingClientRect().height)}px`); };
      if (topbar) new ResizeObserver(hoeheMessen).observe(topbar);

      // Blättern: Ziel ist der FooterNav der Seite (Lernreihenfolge); ohne FooterNav die Menü-Reihenfolge.
      const weiter = document.querySelector<HTMLAnchorElement>('.beamer-weiter');
      const fnNext = document.querySelector<HTMLAnchorElement>('.footer-nav a.next');
      const fnPrev = document.querySelector<HTMLAnchorElement>('.footer-nav a.prev');
      const nextHref = fnNext?.getAttribute('href') ?? weiter?.dataset.fallbackNext;
      const prevHref = fnPrev?.getAttribute('href') ?? weiter?.dataset.fallbackPrev;
      const nextTitel = fnNext ? fnNext.querySelector('span:last-child')?.textContent?.replace(/\s*→\s*$/, '') : weiter?.dataset.fallbackNextT;
      if (weiter && nextHref) {
        weiter.href = nextHref;
        weiter.querySelector('b')!.textContent = nextTitel ?? '';
        weiter.hidden = false;
      }
      sync();
      toggles.forEach((t) => t.addEventListener('click', () => setBeamer(!root.hasAttribute('data-beamer'))));

      // Seitenleiste einklappen (Desktop): Griff neben der Leiste bzw. Gruppe links oben, Taste [. Die Wahl merkt sich der Browser
      // (auch für andere offene Tabs, über das storage-Ereignis).
      const sidebarEl = document.getElementById('sidebar');
      const setLeiste = (zu: boolean, speichern = true) => {
        // Fokus nicht in der verschwindenden Leiste lassen (sonst landet er auf <body>).
        const fokusInLeiste = zu && sidebarEl?.contains(document.activeElement);
        root.toggleAttribute('data-leiste-zu', zu);
        document.querySelectorAll('[data-leiste]').forEach((b) => b.setAttribute('aria-expanded', String(!zu)));
        if (speichern) try { if (zu) localStorage.setItem('ndu-seitenleiste', 'zu'); else localStorage.removeItem('ndu-seitenleiste'); } catch {}
        if (fokusInLeiste) document.querySelector<HTMLButtonElement>('.leiste-auf')?.focus();
      };
      setLeiste(root.hasAttribute('data-leiste-zu'), false);
      document.querySelectorAll('[data-leiste]').forEach((b) => b.addEventListener('click', () => setLeiste(!root.hasAttribute('data-leiste-zu'))));
      addEventListener('storage', (e) => { if (e.key === 'ndu-seitenleiste') setLeiste(e.newValue === 'zu', false); });
      // Tastenkürzel nicht beim Tippen, nicht bei gehaltener Taste, und nicht solange ein Dialog (Screenshot-Präsentation)
      // oder ein Vollbild die Tasten hat. defaultPrevented: Die SOTA-Bühne nimmt ←/→ selbst, solange sie den Fokus hat.
      const tastenFrei = (e: KeyboardEvent) =>
        tasteSteuertFolien({
          schonBehandelt: e.defaultPrevented, wiederholt: e.repeat,
          dialogOffen: !!document.querySelector('dialog[open]'), vollbild: !!document.fullscreenElement,
          ziel: tastenZiel((e.composedPath()[0] ?? e.target) as HTMLElement | null),
        });
      document.addEventListener('keydown', (e) => {
        // „[“ braucht auf deutscher Tastatur Wahl (Mac: ⌥5) bzw. AltGr (Windows: meldet Strg+Alt) – das zählt nicht als Kürzel.
        if (e.key !== '[' || e.metaKey || (e.ctrlKey && !e.altKey) || !tastenFrei(e)) return;
        if (root.hasAttribute('data-beamer') || !matchMedia('(min-width: 901px)').matches) return;
        setLeiste(!root.hasAttribute('data-leiste-zu'));
      });
      // Folien (Folie.astro): Was ← / → tut, entscheidet folien.ts; hier nur das DOM. false = zur Nachbarseite.
      const folieJetzt = () => {
        const folien = [...document.querySelectorAll<HTMLElement>('[data-folie]')];
        const oben = topbar?.getBoundingClientRect().height ?? 0;
        const i = aktuelleFolie(folien.map((f) => f.getBoundingClientRect().top), oben);
        return { folien, i, oben };
      };
      // Schritte einer Folie: in einer noch verborgenen Auflösung zählen sie erst, wenn sie offen ist; im Handout-Teil nie
      // (der fehlt im Beamer, ein Schritt dort wäre ein unsichtbarer Tastendruck).
      const schritteVon = (folie: HTMLElement) =>
        [...folie.querySelectorAll<HTMLElement>('[data-schritt]')].filter((s) => !s.closest('[hidden], .nur-handout'));
      // Hinweis unten rechts im Beamer (beamer.css): „→ 4 Schritte“, dann „→ 2 / 4“, am Ende „4 / 4“.
      const schritteAnzeigen = () => document.querySelectorAll<HTMLElement>('[data-folie]').forEach((f) => {
        const s = schritteVon(f);
        const g = s.filter((x) => x.classList.contains('gezeigt')).length;
        if (!s.length) { f.removeAttribute('data-schritte'); f.removeAttribute('data-schritte-offen'); return; }
        f.dataset.schritte = g === 0 ? `→ ${s.length} ${s.length === 1 ? 'Schritt' : 'Schritte'}` : g < s.length ? `→ ${g} / ${s.length}` : `${g} / ${s.length}`;
        f.toggleAttribute('data-schritte-offen', g < s.length);
      });
      schritteAnzeigen();
      // Eine Auflösung öffnet sich per Klick (Aufloesung.astro) und bringt eigene Schritte mit.
      document.addEventListener('click', () => requestAnimationFrame(schritteAnzeigen));
      // … oder von selbst, wenn ihre Uhrzeit erreicht ist (Aufloesung.astro).
      document.addEventListener('aufloesung-offen', () => requestAnimationFrame(schritteAnzeigen));
      // Sofort statt weich scrollen: Beim schnellen Weiterdrücken soll die aktuelle Folie nicht mitten im Scrollen gemessen werden.
      const springe = (f: HTMLElement) => f.scrollIntoView({ behavior: 'instant' as ScrollBehavior });
      const folienBlaettern = (vor: boolean): boolean => {
        const { folien, i, oben } = folieJetzt();
        if (i < 0) return false;
        const folie = folien[i];
        const rand = folie.getBoundingClientRect();
        const schritte = schritteVon(folie);
        const gezeigt = schritte.filter((s) => s.classList.contains('gezeigt'));
        if (vor) {
          const knopf = folie.querySelector<HTMLButtonElement>('[data-aufloesung-zeigen]');
          const tun = folieWeiter({
            vorDerFolie: rand.top > oben + 4, restUnten: rand.bottom > innerHeight + 4,
            versteckteSchritte: schritte.length - gezeigt.length, offeneAufloesung: !!knopf, naechsteFolie: i < folien.length - 1,
          });
          if (tun === 'hierhin') springe(folie);
          else if (tun === 'runter') scrollBy({ top: innerHeight - oben - 48, behavior: 'instant' as ScrollBehavior });
          else if (tun === 'schritt') schritte.find((s) => !s.classList.contains('gezeigt'))?.classList.add('gezeigt');
          else if (tun === 'aufloesung') knopf?.click();
          else if (tun === 'folie') springe(folien[i + 1]);
          return tun !== 'seite';
        }
        const tun = folieZurueck({ gezeigteSchritte: gezeigt.length, vorherigeFolie: i > 0, kopfDarueber: scrollY > 0 });
        if (tun === 'schritt') gezeigt.at(-1)?.classList.remove('gezeigt');
        else if (tun === 'folie') springe(folien[i - 1]);
        else if (tun === 'anfang') scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        return tun !== 'seite';
      };
      // T startet/pausiert den Timer der aktuellen Folie (Timer.astro), nur im Beamer. Welcher, entscheidet timerFuerT
      // (folien.ts): der letzte sichtbare. Sichtbar über checkVisibility – verdeckte Schritte sind visibility: hidden.
      const sichtbar = (el: HTMLElement) =>
        typeof el.checkVisibility === 'function' ? el.checkVisibility({ visibilityProperty: true }) : el.offsetParent !== null && !el.closest('[data-schritt]:not(.gezeigt)');
      document.addEventListener('keydown', (e) => {
        if ((e.key !== 't' && e.key !== 'T') || e.ctrlKey || e.metaKey || e.altKey || !tastenFrei(e)) return;
        if (!root.hasAttribute('data-beamer')) return;
        const { folien, i } = folieJetzt();
        const knoepfe = [...(folien[i]?.querySelectorAll<HTMLButtonElement>('[data-timer-knopf]') ?? [])];
        const tun = timerFuerT(knoepfe.map((k) => ({ sichtbar: sichtbar(k), laeuft: !!k.closest('.laeuft') })));
        if (!tun) return;
        tun.pausieren.forEach((j) => knoepfe[j].click());
        knoepfe[tun.klick].click();
      });
      document.addEventListener('keydown', (e) => {
        const blaettern = e.key === 'ArrowRight' || e.key === 'ArrowLeft';
        if (e.key !== 'b' && e.key !== 'B' && !blaettern) return;
        if (e.ctrlKey || e.metaKey || e.altKey || (blaettern && e.shiftKey) || !tastenFrei(e)) return;
        if (!blaettern) { if (root.hasAttribute('data-ist-praesentator')) setBeamer(!root.hasAttribute('data-beamer')); return; }
        // ← / → blättern nur im Beamer-Modus; sonst bleiben die Pfeile beim Browser (waagrecht scrollen).
        if (!root.hasAttribute('data-beamer')) return;
        // Seiten mit Folien: erst innerhalb der Seite blättern (Schritte, Auflösung, Folien), dann zur nächsten Seite.
        if (folienBlaettern(e.key === 'ArrowRight')) { e.preventDefault(); schritteAnzeigen(); return; }
        const ziel = e.key === 'ArrowRight' ? nextHref : prevHref;
        if (!ziel) return;
        e.preventDefault();
        location.href = ziel;
      });
    </script>
    <script>
      // Zurück-Knopf: Wer aus einem Abschnitt (z. B. Tag 1 · Übung 1 b) auf einen Link zu einer anderen Seite klickt,
      // bekommt dort unten links „← Zurück zu …“ und landet damit wieder an genau der Scroll-Position.
      // Nicht für Menü, Kopfleiste, Weiter/Zurück, Schrittleiste und Inhaltsverzeichnis.
      import { kuerzen, seitenName, ueberschriftVon } from '../components/abschnitt';
      const KEY = 'ndu-zurueck';
      const POS = 'ndu-zurueck-pos';
      type Ruecksprung = { to: string; from: string; y: number; seite: string; abschnitt: string; len: number };
      const lies = (k: string) => { try { return JSON.parse(sessionStorage.getItem(k) || 'null'); } catch { return null; } };
      const weg = (k: string) => { try { sessionStorage.removeItem(k); } catch {} };

      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        if (!a || a.origin !== location.origin || a.pathname === location.pathname) return;
        if (a.closest('.sidebar, .topbar, .footer-nav, .stepbar, .toc, .zurueck, .wo-ist')) { weg(KEY); return; }
        const hs = [...document.querySelectorAll<HTMLElement>('.inner :is(h2, h3)[id]')];
        const h = hs.filter((x) => x.compareDocumentPosition(a) & Node.DOCUMENT_POSITION_FOLLOWING).pop();
        if (!h) { weg(KEY); return; }
        const r: Ruecksprung = {
          to: a.pathname, from: location.pathname, y: Math.round(scrollY),
          seite: seitenName(document.title), abschnitt: kuerzen(ueberschriftVon(h).replace(/^[a-z]\)\s*/, '')),
          len: history.length + 1,
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(r)); } catch {}
      }, true);

      // Zurück auf der Ursprungsseite: an die gemerkte Stelle scrollen (Fallback, wenn history.back nicht passt).
      const pos = lies(POS) as { path: string; y: number } | null;
      if (pos && pos.path === location.pathname) {
        weg(POS);
        addEventListener('load', () => scrollTo({ top: pos.y, behavior: 'instant' as ScrollBehavior }), { once: true });
      }

      const zeigen = () => {
        const r = lies(KEY) as Ruecksprung | null;
        if (!r || document.querySelector('.zurueck')) return;
        if (r.to !== location.pathname) { weg(KEY); return; }
        const box = document.createElement('div');
        box.className = 'zurueck';
        const link = document.createElement('a');
        link.href = r.from;
        link.textContent = `← Zurück zu ${r.seite} · ${r.abschnitt}`;
        link.setAttribute('aria-label', `Zurück zu ${r.seite}, Abschnitt ${r.abschnitt}`);
        const zu = document.createElement('button');
        zu.type = 'button';
        zu.textContent = '×';
        zu.setAttribute('aria-label', 'Zurück-Hinweis schließen');
        link.addEventListener('click', (e) => {
          weg(KEY);
          // Ohne Umwege seit der Ankunft: echtes „Zurück“ – der Browser stellt die Scroll-Position selbst wieder her.
          const direkt = document.referrer && new URL(document.referrer).pathname === r.from && history.length === r.len;
          if (direkt) { e.preventDefault(); history.back(); return; }
          try { sessionStorage.setItem(POS, JSON.stringify({ path: r.from, y: r.y })); } catch {}
        });
        zu.addEventListener('click', () => { weg(KEY); box.remove(); });
        box.append(link, zu);
        document.body.append(box);
      };
      zeigen();
      addEventListener('pageshow', zeigen);
    </script>
    <script>
      import '../components/wo-ist';
    </script>
    <script>
      import '../components/kopier-knopf';
    </script>
    <NeuLaden />
  </body>
</html>
