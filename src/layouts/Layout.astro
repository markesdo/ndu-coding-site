---
import { ArrowRight, Menu, Presentation } from '@lucide/astro';
// Schriften liegen auf unserem Server (fontsource), nicht bei Google: keine IP-Weitergabe an Dritte (DSGVO).
// Die CSS-Dateien deklarieren mehrere Zeichensätze; der Browser lädt per unicode-range nur, was die Seite nutzt (hier latin, ggf. latin-ext).
import LinkVorschau from '../components/LinkVorschau.astro';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
// Fließtext-Schrift vorladen, damit der erste Text nicht in der Ersatzschrift aufblitzt.
import textSchrift from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/beamer.css';
const { title, description = 'Programmieren mit AI – Kurs für den MSc Management by Innovation, NDU, Oktober 2026' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { h: 'Start', items: [
    { href: '/', t: 'Übersicht' },
    { href: '/setup', t: 'Setup & Accounts' },
    { href: '/hilfe', t: 'Hilfe holen' },
  ]},
  { h: 'Kurstage', items: [
    { href: '/tag-1', t: 'Tag 1 · Verstehen & Starten' },
    { href: '/tag-2', t: 'Tag 2 · Bauen wie ein Profi' },
    { href: '/zwischenwoche', t: 'Zwischenwoche' },
    { href: '/tag-3', t: 'Tag 3 · Shippen' },
  ]},
  { h: 'Konzepte', items: [
    { href: '/konzepte/app-anatomie', t: 'Anatomie einer App' },
    { href: '/konzepte/llm', t: 'Was ein Sprachmodell tut' },
    { href: '/konzepte/coding-agent', t: 'Wie ein Coding-Agent arbeitet' },
    { href: '/konzepte/prompting', t: 'Prompt Engineering' },
    { href: '/konzepte/git', t: 'Git – der Undo-Knopf' },
    { href: '/konzepte/spezifikation', t: 'Von der Idee zur Spezifikation' },
    { href: '/konzepte/daten-backend', t: 'Daten & Backend' },
    { href: '/konzepte/mcp', t: 'MCP-Server' },
    { href: '/konzepte/verifizieren', t: 'Verifizieren & Debuggen' },
    { href: '/konzepte/agenten-steuern', t: 'Agenten steuern' },
    { href: '/konzepte/qualitaet', t: 'Vom Prototyp zum Produkt' },
    { href: '/konzepte/design-system', t: 'Design-System' },
    { href: '/konzepte/ausblick', t: 'Ausblick 2026' },
  ]},
  { h: 'Werkzeuge', items: [
    { href: '/prompts', t: 'Prompt-Bibliothek' },
    { href: '/ideen', t: 'Projektideen' },
    { href: '/bekannte-probleme', t: 'Bekannte Probleme' },
    { href: '/bewertung', t: 'Bewertung' },
  ]},
];
// Ersatz-Reihenfolge fürs Blättern im Beamer-Modus, wenn eine Seite keinen FooterNav hat: die Menü-Reihenfolge.
const flach = nav.flatMap((g) => g.items);
const hier = flach.findIndex((i) => i.href === path);
const vorher = hier > 0 ? flach[hier - 1] : undefined;
const danach = hier >= 0 && hier < flach.length - 1 ? flach[hier + 1] : undefined;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NDU Coding 2026</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <LinkVorschau title={`${title} · NDU Coding 2026`} description={description} />
    <link rel="preload" href={textSchrift} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Beamer-Modus vor dem ersten Zeichnen setzen, sonst blitzt die normale Ansicht auf.
      // ?beamer (oder ?beamer=1) schaltet ein, ?beamer=0 aus; die Wahl merkt sich der Browser.
      (function () {
        var q = new URLSearchParams(location.search).get('beamer');
        var an = false;
        try { an = localStorage.getItem('ndu-beamer') === '1'; } catch (e) {}
        if (q !== null) {
          an = q !== '0';
          try { if (an) localStorage.setItem('ndu-beamer', '1'); else localStorage.removeItem('ndu-beamer'); } catch (e) {}
        }
        // Beamer heißt auch helles Thema: Dunkel wird am Projektor grau auf grau.
        if (an) { document.documentElement.setAttribute('data-beamer', ''); document.documentElement.setAttribute('data-theme', 'light'); }
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="topbar">
      <strong class="topbar-brand"><span class="brand-mark" aria-hidden="true">›<i></i></span><span>programmieren_mit_ai</span></strong>
      <div class="topbar-actions">
        <a class="beamer-weiter" hidden data-fallback-next={danach?.href} data-fallback-next-t={danach?.t} data-fallback-prev={vorher?.href} title="Nächste Seite (Taste →, zurück mit ←)"><span>Weiter: <b></b></span><ArrowRight size={16} aria-hidden="true" /></a>
        <button type="button" class="beamer-toggle" data-beamer-toggle aria-pressed="false" title="Beamer-Modus: größere Schrift, helles Thema, ohne Seitenleiste (Taste B). Blättern mit ← / →"><Presentation size={18} aria-hidden="true" /> Beamer</button>
        <button id="menu-btn" aria-label="Menü öffnen"><Menu size={18} aria-hidden="true" /> Menü</button>
      </div>
    </div>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <a class="brand" href="/" aria-label="Programmieren mit AI – Übersicht"><span class="brand-mark" aria-hidden="true">›<i></i></span>programmieren_mit_ai</a>
        <nav>
          {nav.map(g => (
            <div class="group">
              <h4>{g.h}</h4>
              {g.items.map(i => <a href={i.href} class={path === i.href ? 'active' : ''}>{i.t}</a>)}
            </div>
          ))}
        </nav>
        <button type="button" class="beamer-toggle" data-beamer-toggle aria-pressed="false" title="Beamer-Modus: größere Schrift, ohne Seitenleiste (Taste B)"><Presentation size={18} aria-hidden="true" /> Beamer <kbd>B</kbd></button>
        <p class="small muted" style="margin-top:2rem">NDU · MSc Management by Innovation<br/>8. / 9. / 15. Oktober 2026</p>
      </aside>
      <main class="content">
        <div class="inner">
          <slot />
        </div>
      </main>
    </div>
    <script>
      const btn = document.getElementById('menu-btn');
      const sb = document.getElementById('sidebar');
      btn?.addEventListener('click', () => sb?.classList.toggle('open'));
      document.addEventListener('click', (e) => {
        if (sb?.classList.contains('open') && !sb.contains(e.target as Node) && !btn?.contains(e.target as Node)) sb.classList.remove('open');
      });

      // Beamer-Modus: Knöpfe und Taste B schalten html[data-beamer] um; den Anfangszustand setzt das Skript im <head>.
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-beamer-toggle]');
      const sync = () => toggles.forEach((t) => t.setAttribute('aria-pressed', String(root.hasAttribute('data-beamer'))));
      const setBeamer = (an: boolean) => {
        root.toggleAttribute('data-beamer', an);
        if (an) root.setAttribute('data-theme', 'light'); else root.removeAttribute('data-theme');
        try { if (an) localStorage.setItem('ndu-beamer', '1'); else localStorage.removeItem('ndu-beamer'); } catch {}
        sb?.classList.remove('open');
        sync();
        hoeheMessen();
      };

      // Klebende Kopfleiste: Höhe für Schrittleiste und Sprungziele (beamer.css, --topbar-h).
      const topbar = document.querySelector<HTMLElement>('.topbar');
      const hoeheMessen = () => { if (topbar) root.style.setProperty('--topbar-h', `${Math.round(topbar.getBoundingClientRect().height)}px`); };
      if (topbar) new ResizeObserver(hoeheMessen).observe(topbar);

      // Blättern: Ziel ist der FooterNav der Seite (Lernreihenfolge); ohne FooterNav die Menü-Reihenfolge.
      const weiter = document.querySelector<HTMLAnchorElement>('.beamer-weiter');
      const fnNext = document.querySelector<HTMLAnchorElement>('.footer-nav a.next');
      const fnPrev = document.querySelector<HTMLAnchorElement>('.footer-nav a.prev');
      const nextHref = fnNext?.getAttribute('href') ?? weiter?.dataset.fallbackNext;
      const prevHref = fnPrev?.getAttribute('href') ?? weiter?.dataset.fallbackPrev;
      const nextTitel = fnNext ? fnNext.querySelector('span:last-child')?.textContent?.replace(/\s*→\s*$/, '') : weiter?.dataset.fallbackNextT;
      if (weiter && nextHref) {
        weiter.href = nextHref;
        weiter.querySelector('b')!.textContent = nextTitel ?? '';
        weiter.hidden = false;
      }
      sync();
      toggles.forEach((t) => t.addEventListener('click', () => setBeamer(!root.hasAttribute('data-beamer'))));
      document.addEventListener('keydown', (e) => {
        const blaettern = e.key === 'ArrowRight' || e.key === 'ArrowLeft';
        if (e.key !== 'b' && e.key !== 'B' && !blaettern) return;
        // defaultPrevented: Die SOTA-Bühne nimmt ←/→ selbst, solange sie den Fokus hat.
        if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || e.repeat || (blaettern && e.shiftKey)) return;
        const t = e.target as HTMLElement | null;
        // Nicht beim Tippen, und nicht solange ein Dialog (Screenshot-Präsentation) oder ein Vollbild die Tasten hat.
        if (t && (t.isContentEditable || t.closest('input, textarea, select, [contenteditable]'))) return;
        if (document.querySelector('dialog[open]') || document.fullscreenElement) return;
        if (!blaettern) { setBeamer(!root.hasAttribute('data-beamer')); return; }
        // ← / → blättern nur im Beamer-Modus; sonst bleiben die Pfeile beim Browser (waagrecht scrollen).
        if (!root.hasAttribute('data-beamer')) return;
        const ziel = e.key === 'ArrowRight' ? nextHref : prevHref;
        if (!ziel) return;
        e.preventDefault();
        location.href = ziel;
      });
    </script>
    <script>
      // Zurück-Knopf: Wer aus einem Abschnitt (z. B. Tag 1 · Übung 1 b) auf einen Link zu einer anderen Seite klickt,
      // bekommt dort unten links „← Zurück zu …“ und landet damit wieder an genau der Scroll-Position.
      // Nicht für Menü, Kopfleiste, Weiter/Zurück, Schrittleiste und Inhaltsverzeichnis.
      const KEY = 'ndu-zurueck';
      const POS = 'ndu-zurueck-pos';
      type Ruecksprung = { to: string; from: string; y: number; seite: string; abschnitt: string; len: number };
      const lies = (k: string) => { try { return JSON.parse(sessionStorage.getItem(k) || 'null'); } catch { return null; } };
      const weg = (k: string) => { try { sessionStorage.removeItem(k); } catch {} };
      // Abschnittsname kurz halten: an einer Wortgrenze kürzen, nicht mitten im Wort.
      const kuerzen = (t: string, max = 28) => (t.length <= max ? t : `${t.slice(0, t.lastIndexOf(' ', max)).replace(/[\s–-]+$/, '')} …`);

      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        if (!a || a.origin !== location.origin || a.pathname === location.pathname) return;
        if (a.closest('.sidebar, .topbar, .footer-nav, .stepbar, .toc, .zurueck')) { weg(KEY); return; }
        const hs = [...document.querySelectorAll<HTMLElement>('.inner :is(h2, h3)[id]')];
        const h = hs.filter((x) => x.compareDocumentPosition(a) & Node.DOCUMENT_POSITION_FOLLOWING).pop();
        if (!h) { weg(KEY); return; }
        const k = h.cloneNode(true) as HTMLElement;
        k.querySelectorAll('.pill').forEach((p) => p.remove());
        const r: Ruecksprung = {
          to: a.pathname, from: location.pathname, y: Math.round(scrollY),
          seite: document.title.split(' · ')[0], abschnitt: kuerzen((k.textContent ?? '').replace(/\s+/g, ' ').replace(/\s*\(\d+\s*min\)\s*$/, '').replace(/^[a-z]\)\s*/, '').trim()),
          len: history.length + 1,
        };
        try { sessionStorage.setItem(KEY, JSON.stringify(r)); } catch {}
      }, true);

      // Zurück auf der Ursprungsseite: an die gemerkte Stelle scrollen (Fallback, wenn history.back nicht passt).
      const pos = lies(POS) as { path: string; y: number } | null;
      if (pos && pos.path === location.pathname) {
        weg(POS);
        addEventListener('load', () => scrollTo({ top: pos.y, behavior: 'instant' as ScrollBehavior }), { once: true });
      }

      const zeigen = () => {
        const r = lies(KEY) as Ruecksprung | null;
        if (!r || document.querySelector('.zurueck')) return;
        if (r.to !== location.pathname) { weg(KEY); return; }
        const box = document.createElement('div');
        box.className = 'zurueck';
        const link = document.createElement('a');
        link.href = r.from;
        link.textContent = `← Zurück zu ${r.seite} · ${r.abschnitt}`;
        link.setAttribute('aria-label', `Zurück zu ${r.seite}, Abschnitt ${r.abschnitt}`);
        const zu = document.createElement('button');
        zu.type = 'button';
        zu.textContent = '×';
        zu.setAttribute('aria-label', 'Zurück-Hinweis schließen');
        link.addEventListener('click', (e) => {
          weg(KEY);
          // Ohne Umwege seit der Ankunft: echtes „Zurück“ – der Browser stellt die Scroll-Position selbst wieder her.
          const direkt = document.referrer && new URL(document.referrer).pathname === r.from && history.length === r.len;
          if (direkt) { e.preventDefault(); history.back(); return; }
          try { sessionStorage.setItem(POS, JSON.stringify({ path: r.from, y: r.y })); } catch {}
        });
        zu.addEventListener('click', () => { weg(KEY); box.remove(); });
        box.append(link, zu);
        document.body.append(box);
      };
      zeigen();
      addEventListener('pageshow', zeigen);
    </script>
  </body>
</html>
