---
import { Menu, Presentation } from '@lucide/astro';
// Schriften liegen auf unserem Server (fontsource), nicht bei Google: keine IP-Weitergabe an Dritte (DSGVO).
// Die CSS-Dateien laden je Schrift nur die Teilmengen, die die Seite braucht (unicode-range: latin, latin-ext).
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
// Fließtext-Schrift vorladen, damit der erste Text nicht in der Ersatzschrift aufblitzt.
import textSchrift from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/beamer.css';
const { title, description = 'Programmieren mit AI – Kurs für den MSc Management by Innovation, NDU, Oktober 2026' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { h: 'Start', items: [
    { href: '/', t: 'Übersicht' },
    { href: '/setup', t: 'Setup & Accounts' },
    { href: '/hilfe', t: 'Hilfe holen' },
  ]},
  { h: 'Kurstage', items: [
    { href: '/tag-1', t: 'Tag 1 · Verstehen & Starten' },
    { href: '/tag-2', t: 'Tag 2 · Bauen wie ein Profi' },
    { href: '/zwischenwoche', t: 'Zwischenwoche' },
    { href: '/tag-3', t: 'Tag 3 · Shippen' },
  ]},
  { h: 'Konzepte', items: [
    { href: '/konzepte/app-anatomie', t: 'Anatomie einer App' },
    { href: '/konzepte/llm', t: 'Was ein Sprachmodell tut' },
    { href: '/konzepte/coding-agent', t: 'Wie ein Coding-Agent arbeitet' },
    { href: '/konzepte/prompting', t: 'Prompt Engineering' },
    { href: '/konzepte/git', t: 'Git – der Undo-Knopf' },
    { href: '/konzepte/spezifikation', t: 'Von der Idee zur Spezifikation' },
    { href: '/konzepte/daten-backend', t: 'Daten & Backend' },
    { href: '/konzepte/mcp', t: 'MCP-Server' },
    { href: '/konzepte/verifizieren', t: 'Verifizieren & Debuggen' },
    { href: '/konzepte/agenten-steuern', t: 'Agenten steuern' },
    { href: '/konzepte/qualitaet', t: 'Vom Prototyp zum Produkt' },
    { href: '/konzepte/design-system', t: 'Design-System' },
    { href: '/konzepte/ausblick', t: 'Ausblick 2026' },
  ]},
  { h: 'Werkzeuge', items: [
    { href: '/prompts', t: 'Prompt-Bibliothek' },
    { href: '/ideen', t: 'Projektideen' },
    { href: '/bekannte-probleme', t: 'Bekannte Probleme' },
    { href: '/bewertung', t: 'Bewertung' },
  ]},
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NDU Coding 2026</title>
    <meta name="description" content={description} />
    <link rel="preload" href={textSchrift} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Beamer-Modus vor dem ersten Zeichnen setzen, sonst blitzt die normale Ansicht auf.
      // ?beamer (oder ?beamer=1) schaltet ein, ?beamer=0 aus; die Wahl merkt sich der Browser.
      (function () {
        var q = new URLSearchParams(location.search).get('beamer');
        var an = false;
        try { an = localStorage.getItem('ndu-beamer') === '1'; } catch (e) {}
        if (q !== null) {
          an = q !== '0';
          try { if (an) localStorage.setItem('ndu-beamer', '1'); else localStorage.removeItem('ndu-beamer'); } catch (e) {}
        }
        if (an) document.documentElement.setAttribute('data-beamer', '');
      })();
    </script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23e8472b'/></svg>" />
  </head>
  <body>
    <div class="topbar">
      <strong>NDU Coding 2026</strong>
      <div class="topbar-actions">
        <button type="button" class="beamer-toggle" data-beamer-toggle aria-pressed="false" title="Beamer-Modus: größere Schrift, ohne Seitenleiste (Taste B)"><Presentation size={18} aria-hidden="true" /> Beamer</button>
        <button id="menu-btn" aria-label="Menü öffnen"><Menu size={18} aria-hidden="true" /> Menü</button>
      </div>
    </div>
    <div class="shell">
      <aside class="sidebar" id="sidebar">
        <a class="brand" href="/"><span class="dot"></span> Programmieren mit AI</a>
        <nav>
          {nav.map(g => (
            <div class="group">
              <h4>{g.h}</h4>
              {g.items.map(i => <a href={i.href} class={path === i.href ? 'active' : ''}>{i.t}</a>)}
            </div>
          ))}
        </nav>
        <button type="button" class="beamer-toggle" data-beamer-toggle aria-pressed="false" title="Beamer-Modus: größere Schrift, ohne Seitenleiste (Taste B)"><Presentation size={18} aria-hidden="true" /> Beamer <kbd>B</kbd></button>
        <p class="small muted" style="margin-top:2rem">NDU · MSc Management by Innovation<br/>8. / 9. / 15. Oktober 2026</p>
      </aside>
      <main class="content">
        <div class="inner">
          <slot />
        </div>
      </main>
    </div>
    <script>
      const btn = document.getElementById('menu-btn');
      const sb = document.getElementById('sidebar');
      btn?.addEventListener('click', () => sb?.classList.toggle('open'));
      document.addEventListener('click', (e) => {
        if (sb?.classList.contains('open') && !sb.contains(e.target as Node) && !btn?.contains(e.target as Node)) sb.classList.remove('open');
      });

      // Beamer-Modus: Knöpfe und Taste B schalten html[data-beamer] um; den Anfangszustand setzt das Skript im <head>.
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-beamer-toggle]');
      const sync = () => toggles.forEach((t) => t.setAttribute('aria-pressed', String(root.hasAttribute('data-beamer'))));
      const setBeamer = (an: boolean) => {
        root.toggleAttribute('data-beamer', an);
        try { if (an) localStorage.setItem('ndu-beamer', '1'); else localStorage.removeItem('ndu-beamer'); } catch {}
        sb?.classList.remove('open');
        sync();
      };
      sync();
      toggles.forEach((t) => t.addEventListener('click', () => setBeamer(!root.hasAttribute('data-beamer'))));
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'b' && e.key !== 'B') return;
        if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey || e.repeat) return;
        const t = e.target as HTMLElement | null;
        // Nicht beim Tippen, und nicht solange ein Dialog (Screenshot-Präsentation) oder ein Vollbild die Tasten hat.
        if (t && (t.isContentEditable || t.closest('input, textarea, select, [contenteditable]'))) return;
        if (document.querySelector('dialog[open]') || document.fullscreenElement) return;
        setBeamer(!root.hasAttribute('data-beamer'));
      });
    </script>
  </body>
</html>
