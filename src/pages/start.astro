---
// Startseite vor dem Login: öffentlich (Middleware lässt /start ohne Kurspasswort durch), ohne Navigation,
// eine dunkle Bühne über den ganzen Bildschirm – die Fortsetzung der NDU-Live-Leinwand. Von NDU Live aus kommen
// Handys hierher, der Beamer mit ?beamer. „› weiter“ führt zur Übersicht (/) – ohne Anmeldung leitet die Middleware
// von dort zum Kurspasswort. Nie automatisch weiter: Wer hier ist, entscheidet selbst, wann es losgeht.
// Aufbau: Der Endzustand (Titel, Einleitung, Tage, „› weiter“) ist statisches HTML. Die Animation
// („Der Cursor läuft“, src/components/auftakt-start.ts, GSAP) bespielt nur diese Bühne und endet genau hier.
import LinkVorschau from '../components/LinkVorschau.astro';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/beamer.css';
import '../styles/auftakt.css';
---
<!doctype html>
<html lang="de" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#121216" />
    <title>Programmieren mit AI · NDU Coding 2026</title>
    <LinkVorschau />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Vor dem ersten Zeichnen: Beamer-Modus wie in Layout.astro (?beamer an, ?beamer=0 aus, sonst gemerkte Wahl)
      // und die Animation scharf schalten – außer bei reduzierter Bewegung (dann sofort der Endzustand).
      (function () {
        var root = document.documentElement;
        var q = new URLSearchParams(location.search).get('beamer');
        var an = false;
        try { an = localStorage.getItem('ndu-beamer') === '1'; } catch (e) {}
        if (q !== null) {
          an = q !== '0';
          try { if (an) localStorage.setItem('ndu-beamer', '1'); else localStorage.removeItem('ndu-beamer'); } catch (e) {}
        }
        if (an) root.setAttribute('data-beamer', '');
        try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.setAttribute('data-auftakt', ''); } catch (e) {}
      })();
    </script>
  </head>
  <body class="start-body">
    <div class="start-licht" aria-hidden="true"></div>
    <div class="start-blitz" aria-hidden="true"></div>
    <main class="start">
      <p class="start-marke"><span class="brand-mark" aria-hidden="true">›<i></i></span>programmieren_mit_ai</p>

      <section id="auftakt-buehne" class="hero" data-hero aria-labelledby="start-titel">
        <span class="eyebrow">NDU · MSc Management by Innovation · Oktober 2026</span>
        <h1 id="start-titel">Programmieren mit <span style="white-space:nowrap">AI<span class="cursor" aria-hidden="true"></span></span></h1>
        <p class="lead">In drei Tagen von „Ich kann nicht programmieren“ zu einem eigenen, öffentlich erreichbaren Prototyp – ohne eine Zeile Code selbst zu schreiben.</p>
        <div class="days">
          <div class="day"><div class="n">Tag 1 · Do 8.10.</div><h3>Verstehen & Starten</h3><p>Umgebung läuft, erste eigene Änderungen, von der Idee zur Spezifikation.</p></div>
          <div class="day"><div class="n">Tag 2 · Fr 9.10.</div><h3>Bauen wie ein Profi</h3><p>Echte Daten, Login, Fehler finden, Agenten steuern, öffentliche URL.</p></div>
          <div class="day"><div class="n">Tag 3 · Do 15.10.</div><h3>Shippen & selbständig werden</h3><p>Eigener Prototyp, Qualität beurteilen, Ausblick, Demos.</p></div>
        </div>
      </section>

      <p class="start-aktion">
        <a class="start-weiter" href="/" data-weiter aria-label="Weiter zur Übersicht"><span class="start-weiter-chev" aria-hidden="true">›</span> weiter<span class="cursor" aria-hidden="true"></span></a>
        <span class="start-hinweis">Enter oder Tippen · zur Übersicht</span>
      </p>
    </main>

    <script is:inline>
      // „Weiter“ behält den Beamer-Modus (Spiegelbild von weiterZiel() in src/components/auftakt-zeitplan.ts).
      // Gilt auch ohne das Animationsskript: Der Link funktioniert immer.
      (function () {
        var b = new URLSearchParams(location.search).get('beamer');
        if (b !== null && b !== '0') document.querySelector('[data-weiter]').setAttribute('href', '/?beamer');
      })();
    </script>
    <script>
      // Die Animation (austauschbar): bespielt nur die Bühne und endet im statischen Endzustand.
      import '../components/auftakt-start';
    </script>
  </body>
</html>
