---
// Startseite vor dem Login: öffentlich (Middleware lässt /start ohne Kurspasswort durch; wer ohne Anmeldung / aufruft,
// landet hier), ohne Navigation, eine dunkle Bühne über den ganzen Bildschirm. Zwei Kurse zur Wahl; das Innolab ist
// ausgegraut, bis der Coding-Kurs vorbei ist (lib/kurswahl.ts). Die Karten führen über die Login-Seite des Kurses (kursLink): ohne
// Anmeldung erst das Kurspasswort, mit Anmeldung direkt weiter. Von NDU Live kommt der Beamer mit ?beamer (wirkt nur beim Präsentator,
// siehe BeamerStart.astro); die Kurs-Links behalten ihn.
import BeamerStart from '../components/BeamerStart.astro';
import Marke from '../components/Marke.astro';
import LinkVorschau from '../components/LinkVorschau.astro';
import { TAGE } from '../components/methoden';
import { innolabOffen, kursLink } from '../lib/kurswahl';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/beamer.css';
import '../styles/start.css';

const datumKurz = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-AT', { weekday: 'short', day: 'numeric', month: 'numeric', timeZone: 'Europe/Vienna' });
const coding = [
  { n: 1, datum: '2026-10-08', t: 'Verstehen & Starten' },
  { n: 2, datum: '2026-10-09', t: 'Bauen wie ein Profi' },
  { n: 3, datum: '2026-10-15', t: 'Shippen & selbständig werden' },
].map((t) => ({ ...t, d: datumKurz(t.datum) }));
const innolab = TAGE.map((t) => ({ n: t.n, d: t.datum ? datumKurz(t.datum) : 'Termin folgt', t: t.titel }));
// Zur Bauzeit entschieden; das Skript unten schaltet zur Laufzeit frei, falls die Seite vor dem Stichtag gebaut wurde.
const offen = innolabOffen(new Date());
---
<!doctype html>
<html lang="de" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#121216" />
    <title>NDU · MSc Management by Innovation 2026</title>
    <LinkVorschau mitUrl title="NDU · MSc Management by Innovation 2026" description="Programmieren mit AI (Oktober 2026) und Innolab (Oktober 2026 – Jänner 2027): vom eigenen Prototyp zum eigenen Produkt." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <BeamerStart hell={false} />
  </head>
  <body class="start-body">
    <div class="start-licht" aria-hidden="true"></div>
    <main class="start">
      <p class="start-marke"><Marke name="ndu_mbi_2026" /></p>

      <section class="hero" aria-labelledby="start-titel">
        <span class="eyebrow">NDU · MSc Management by Innovation · 2026/27</span>
        <h1 id="start-titel">Eure Kurse<span class="cursor" aria-hidden="true"></span></h1>
        <p class="lead">Im Oktober lernt ihr, Software mit AI bauen zu lassen. Im Innolab entwickelt ihr daraus ein eigenes Produkt – vom Interview bis zur Präsentation.</p>
      </section>

      <div class="kurse">
        <a class="kurs" href={kursLink('/', '')} data-kurs="/">
          <span class="kurs-zeit">Oktober 2026 · 3 Tage</span>
          <h2><span class="kurs-chev" aria-hidden="true">›</span> Programmieren mit AI</h2>
          <ol class="kurs-tage">{coding.map((t) => <li><span>Tag {t.n} · {t.d}</span> {t.t}</li>)}</ol>
        </a>
        <a class:list={['kurs', { gesperrt: !offen }]} href={offen ? kursLink('/innolab', '') : undefined} data-kurs="/innolab" role={offen ? undefined : 'link'} aria-disabled={offen ? undefined : 'true'}>
          <span class="kurs-zeit">Oktober 2026 – Jänner 2027 · 7 Tage</span>
          <h2><span class="kurs-chev" aria-hidden="true">›</span> Innolab</h2>
          <ol class="kurs-tage">{innolab.map((t) => <li><span>Tag {t.n} · {t.d}</span> {t.t}</li>)}</ol>
          <span class="kurs-hinweis" data-hinweis hidden={offen}>Öffnet nach dem Coding-Kurs, am 16. Oktober.</span>
        </a>
      </div>
    </main>

    <script>
      import { innolabOffen, kursLink } from '../lib/kurswahl';
      // Innolab freischalten, sobald der Stichtag erreicht ist; alle Ziele behalten den Beamer-Modus.
      const innolab = document.querySelector<HTMLAnchorElement>('[data-kurs="/innolab"]')!;
      if (innolabOffen(new Date())) {
        innolab.classList.remove('gesperrt');
        innolab.removeAttribute('aria-disabled');
        innolab.removeAttribute('role');
        innolab.querySelector<HTMLElement>('[data-hinweis]')!.hidden = true;
      }
      for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-kurs]')) {
        if (!a.classList.contains('gesperrt')) a.href = kursLink(a.dataset.kurs!, location.search);
      }
    </script>
  </body>
</html>
