---
import Layout from '../layouts/Layout.astro';
import Fluss from '../components/Fluss.astro';
import { Cloud, FolderGit2, Laptop } from '@lucide/astro';
import Callout from '../components/Callout.astro';
import Tasten from '../components/Tasten.astro';
import Checklist from '../components/Checklist.astro';
import Prompt from '../components/Prompt.astro';
import Schritte from '../components/Schritte.astro';
import UmgebungWahl from '../components/UmgebungWahl.astro';
import { bild } from '../components/anleitung-bilder';
// Screenshots vom Durchgang mit einem frischen Konto (5.10.2026). Markierungen in Pixeln des jeweiligen Bildes.
---
<Layout title="Setup & Accounts">
  <span class="eyebrow">Tag 1 · 09:30–10:45 · gemeinsam</span>
  <h1>Setup & Accounts</h1>
  <p class="lead">Chrome vorab, dann neun Schritte – sonst nichts zu installieren. Am Ende läuft eure App im Browser und Claude Code wartet auf den ersten Auftrag.</p>

  <Callout type="info" title="Wir machen das gemeinsam">
    <p>Wir gehen die Schritte zusammen durch, einen nach dem anderen am Beamer. Niemand muss vorauslaufen. Hängt etwas, meldet euch – wir warten, bis alle so weit sind, und gehen dann gemeinsam zum nächsten Schritt.</p>
  </Callout>

  <h2>Checkliste</h2>
  {/* id „setup3“: Häkchen werden nach Position gespeichert – ändert sich, was ein Punkt verlangt (zuletzt: Pro gleich kündigen), neue id, sonst gelten alte Häkchen weiter. */}
  <Checklist id="setup3" items={[
    '<strong>Google Chrome</strong> installiert und aktuell – <a href="#chrome">Schritt 0</a>',
    '<strong>GitHub-Account</strong> mit der NDU-Adresse angelegt (oder NDU-Adresse im bestehenden Konto ergänzt) – <a href="#github">Schritt 1</a>',
    '<strong>Claude Pro</strong> abgeschlossen (claude.ai → Pro, <em>Monthly</em>; Kredit- oder Debitkarte) und gleich wieder gekündigt – läuft trotzdem bis zum Ende des bezahlten Monats. Wer schon Pro oder Max hat: nichts tun – <a href="#claude-pro">Schritt 2</a>',
    '<strong>Eigenes Repo</strong> aus dem Template erstellt („Use this template“) – <a href="#repo">Schritt 3</a>',
    '<strong>Codespace</strong> gestartet, Ordner als vertrauenswürdig bestätigt – <a href="#codespace">Schritt 4</a>',
    '<code>claude</code> im Terminal gestartet und angemeldet – <a href="#claude-code">Schritt 5</a>',
    'App läuft und ist im eigenen Browser-Tab geöffnet – <a href="#app">Schritt 6</a>',
    '<code>/ndu-explain</code> ausgeführt und die Antwort gelesen – <a href="#explain">Schritt 7</a>',
    'Markus als Collaborator eingeladen (<code>markesdo</code>) – <a href="#collaborator">Schritt 8</a>',
    'Optional: <strong>GitHub Education</strong> beantragt – <a href="#education">Schritt 9</a>',
  ]} />

  <p class="small muted">Die Screenshots stammen von einem Testdurchgang mit einem neuen Konto am 5.10.2026. Die Oberflächen der Anbieter ändern sich laufend; wenn ein Button anders heißt oder woanders sitzt, sucht nach dem Wort aus der Anleitung. Klick auf ein Bild zeigt den ganzen Bildschirm; „Als Präsentation zeigen“ blättert mit den Pfeiltasten durch die Schritte.</p>

  <nav class="stepbar" aria-label="Schritte des Setups">
    {[['chrome', '0'], ['github', '1'], ['claude-pro', '2'], ['repo', '3'], ['codespace', '4'], ['claude-code', '5'], ['app', '6'], ['explain', '7'], ['collaborator', '8'], ['education', '9'], ['orientierung', 'Codespace'], ['devtools', 'DevTools'], ['stoppen', 'Stoppen'], ['lokal', 'Lokal']].map(([id, t]) => (
      <a href={`#${id}`} data-step={id}>{t}</a>
    ))}
  </nav>
  <script>
    // Markiert in der Schrittleiste den Abschnitt, der gerade oben im Fenster steht. Ohne JS bleiben es einfache Links.
    const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.stepbar a')].map((a) => [a.dataset.step!, a]));
    const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    const mark = () => {
      const y = 140;
      let current = sections[0];
      for (const h of sections) if (h.getBoundingClientRect().top < y) current = h;
      links.forEach((a, id) => (id === current.id ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  </script>

  <h2 id="chrome">0 · Google Chrome – am besten vor dem Kurs</h2>
  <p>Wir arbeiten im Kurs mit <strong>Google Chrome</strong>. Die Anleitungen und Screenshots auf dieser Website zeigen Chrome, die Entwicklertools für die Fehlersuche sind dort eingebaut, und Claude in Chrome (ab Tag 2, optional) läuft nur dort. Andere Browser gehen oft auch – aber dann sieht manches anders aus als hier.</p>
  <p><strong>Chrome schon installiert?</strong> Kurz aktualisieren: oben rechts <em>⋮</em> → <em>Hilfe</em> → <em>Über Google Chrome</em>. Dann weiter mit Schritt 1.</p>
  <Schritte id="chrome" nummer="0" steps={[
    { img: bild('setup/chrome-1-download'), alt: 'Download-Seite von Google Chrome mit dem Button „Chrome herunterladen“ und dem Cookie-Hinweis unten', text: 'Auf <a href="https://www.google.com/chrome/" target="_blank" rel="noopener">google.com/chrome</a> auf <em>Chrome herunterladen</em> klicken (1). Die Seite erkennt selbst, ob ihr Mac oder Windows habt. Den Cookie-Hinweis unten schließt ihr mit <em>Ok</em> (2).', marks: [{ x: 606, y: 309, w: 244, h: 54, n: 1 }, { x: 1368, y: 790, w: 82, h: 42, n: 2 }] },
  ]} />
  <ul>
    <li><strong>Mac:</strong> Die Datei <code>googlechrome.dmg</code> aus den Downloads öffnen, das Chrome-Symbol in den Ordner <em>Programme</em> ziehen, Chrome dort starten.</li>
    <li><strong>Windows:</strong> Die Datei <code>ChromeSetup.exe</code> aus den Downloads öffnen und die Rückfrage mit <em>Ja</em> bestätigen. Chrome installiert sich und startet von selbst.</li>
    <li>Beim ersten Start fragt Chrome, ob es Standardbrowser werden soll und ob ihr euch anmelden wollt. Beides ist für den Kurs egal.</li>
  </ul>

  <h2 id="github">1 · GitHub-Account mit eurer NDU-Adresse</h2>
  <p>GitHub speichert euren Code und startet später euren Codespace. <strong>Registriert euch mit eurer NDU-E-Mail-Adresse.</strong> Mit ihr könnt ihr zusätzlich GitHub Education beantragen (<a href="#education">Schritt 9</a>, optional): Studierende bekommen unter anderem mehr Codespaces-Kontingent – 180 statt 120 Core-Stunden pro Monat, auf der 2-Kern-Maschine also 90 statt 60 Stunden.</p>
  <Schritte id="github" nummer="1" steps={[
    { img: bild('setup/github-1-formular'), alt: 'GitHub-Registrierungsformular mit den Feldern Email, Password, Username und dem Button „Create account“', text: 'Auf <a href="https://github.com/signup" target="_blank" rel="noopener">github.com/signup</a> eure NDU-Adresse eintragen (1). Ein Passwort wählen (2) – mindestens 15 Zeichen, oder 8 mit Zahl und Kleinbuchstaben – und im Passwortmanager speichern. Benutzername (3): Er ist öffentlich und steht später in jeder Adresse eures Projekts, also etwas Professionelles. <em>Create account</em> (4), dann das Bilderrätsel lösen und den Code eingeben, den GitHub an eure NDU-Adresse schickt.', marks: [{ x: 916, y: 259, w: 412, h: 40, n: 1 }, { x: 916, y: 331, w: 412, h: 38, n: 2 }, { x: 916, y: 438, w: 412, h: 38, n: 3 }, { x: 916, y: 687, w: 412, h: 44, n: 4 }] },
    { img: bild('setup/github-5-dashboard'), alt: 'GitHub-Startseite mit „Welcome to GitHub“', text: 'Geschafft: Die Startseite begrüßt euch mit eurem Benutzernamen. Zwei-Faktor-Anmeldung verlangt GitHub erst einige Wochen später – richtet sie dann mit der Handy-App ein.', marks: [{ x: 494, y: 92, w: 390, h: 36 }] },
  ]} />
  <Callout type="tip" title="Ihr habt schon ein GitHub-Konto?">
    <p>Dann legt kein zweites an. Tragt eure NDU-Adresse zusätzlich ein: Profilbild oben rechts → <em>Settings</em> → <em>Emails</em> → <em>Add email address</em>, dann den Link in der Bestätigungsmail anklicken. Danach könnt ihr Education mit diesem Konto beantragen.</p>
  </Callout>
  <Schritte id="github" nummer="1" start={3} steps={[
    { img: bild('setup/edu-1-unverified'), alt: 'Settings → Emails: die neu eingetragene Hochschuladresse steht auf „Unverified“', text: 'Nach <em>Add</em> steht die NDU-Adresse auf „Unverified“ und GitHub schickt eine Mail mit dem Betreff „Please verify your email address“. (Adressen hier unkenntlich gemacht.)', marks: [{ x: 470, y: 374, w: 310, h: 34 }] },
    { img: bild('setup/edu-2-verified'), alt: 'Die Hochschuladresse steht auf „Verified“', text: 'Nach dem Klick auf den Link in der Mail: „Verified“.', marks: [{ x: 470, y: 322, w: 300, h: 34 }] },
  ]} />

  <h2 id="claude-pro">2 · Claude Pro</h2>
  <p>Claude Code ist im Tarif <em>Pro</em> enthalten. Ohne Pro funktioniert die Anmeldung in <a href="#claude-code">Schritt 5</a> nicht. Pro kostet in Österreich <strong>21,60 € im Monat</strong> (18 € plus Umsatzsteuer) und ist monatlich kündbar; nach dem Kündigen läuft es bis zum Ende des bezahlten Monats. Wer schon Pro oder Max hat, überspringt diesen Schritt.</p>
  <Schritte id="claude-pro" nummer="2" steps={[
    { img: bild('setup/pro-1-login'), alt: 'Anmeldeseite von claude.ai mit „Continue with Google“, „Continue with Apple“ und E-Mail-Feld', text: 'Auf <a href="https://claude.ai" target="_blank" rel="noopener">claude.ai</a> <em>Continue with Google</em> wählen und euer Google-Konto aussuchen; Google fragt noch einmal nach, <em>Continue</em>. Ohne Google-Konto geht es auch mit der E-Mail-Adresse.', marks: [{ x: 240, y: 351, w: 355, h: 36 }] },
    { img: bild('setup/pro-2-konto'), alt: 'Seite „Let’s create your account“ mit zwei Häkchen und dem Button „Create account“', text: 'Das erste Häkchen (Nutzungsbedingungen) ist Pflicht (1), das zweite (Werbe-Mails) könnt ihr leer lassen. <em>Create account</em> (2).', marks: [{ x: 560, y: 366, w: 362, h: 40, n: 1 }, { x: 563, y: 469, w: 368, h: 36, n: 2 }] },
    { img: bild('setup/pro-3-geburtstag'), alt: 'Seite „When is your birthday?“ mit Datumsfeld mm/dd/yyyy', text: 'Geburtsdatum <strong>im US-Format</strong>: erst Monat, dann Tag, dann Jahr (1). Der 24. März 2002 ist also <code>03/24/2002</code>. <em>Continue</em> (2).', marks: [{ x: 544, y: 403, w: 406, h: 37, n: 1 }, { x: 544, y: 451, w: 406, h: 36, n: 2 }] },
    { img: bild('setup/pro-4-yearly'), alt: 'Tarifübersicht Free, Pro, Max; bei Pro ist „Yearly“ ausgewählt, 15 € pro Monat, jährlich 180 € abgerechnet', text: '<strong>Achtung, Falle:</strong> Bei Pro ist die <em>jährliche</em> Zahlung vorausgewählt – 180 € auf einmal (1). Klickt auf <em>Monthly</em> (2).', marks: [{ x: 603, y: 315, w: 185, h: 33, n: 1 }, { x: 722, y: 186, w: 60, h: 23, n: 2 }] },
    { img: bild('setup/pro-5-monthly'), alt: 'Tarifübersicht, bei Pro ist jetzt „Monthly“ ausgewählt, 18 € pro Monat', text: 'Jetzt steht dort „billed monthly“ (1). <em>Get Pro plan</em> (2).', marks: [{ x: 603, y: 315, w: 160, h: 33, n: 1 }, { x: 605, y: 364, w: 287, h: 36, n: 2 }] },
    { img: bild('setup/pro-6-checkout'), alt: 'Bezahlseite „Pro plan“: Rechnungsadresse, Kartendaten, Gesamtbetrag 21,60 €, Häkchen zur monatlichen Abbuchung, Button „Subscribe and Pay“', text: 'Oben muss <em>Pro · Monthly</em> stehen. Name und Adresse eintragen (1), dann die Kartendaten (2). Rechts seht ihr den echten Betrag mit Steuer und das Datum der automatischen Verlängerung. Häkchen setzen (3), <em>Subscribe and Pay</em> (4). <strong>Das Geld bekommt ihr von der NDU zurück</strong> – für diesen Monat und den Monat fürs Innolab. Hebt die Rechnung auf, die Anthropic per E-Mail schickt.', marks: [{ x: 297, y: 178, w: 431, h: 184, n: 1 }, { x: 297, y: 610, w: 431, h: 118, n: 2 }, { x: 795, y: 358, w: 378, h: 148, n: 3 }, { x: 800, y: 524, w: 369, h: 36, n: 4 }] },
  ]} />
  <Callout type="tip" title="Gleich kündigen, fürs Innolab neu abschließen">
    <p>Wer schon vorher Pro oder Max hatte, kündigt nichts. Alle anderen:</p>
    <ul>
      <li><strong>Gleich nach dem Bezahlen kündigen:</strong> unten links auf euren Namen → <em>Settings</em> → <em>Billing</em>. Pro verlängert sich sonst jeden Monat von selbst.</li>
      <li><strong>Ihr verliert nichts:</strong> Pro läuft bis zum Ende des bezahlten Monats weiter – über alle drei Kurstage und die Zwischenwoche.</li>
      <li><strong>Nur kündigen, keine Erstattung anfordern:</strong> Eine Erstattung beendet Pro sofort, und Claude Code meldet sich ab.</li>
      <li><strong>Innolab (28.11.–19.12.):</strong> Pro mit demselben Konto neu abschließen – Chats und Einstellungen bleiben – und wieder gleich kündigen. Auch diesen Monat erstattet die NDU; Rechnung aus der E-Mail aufheben.</li>
    </ul>
  </Callout>

  <h2 id="repo">3 · Eigenes Repo aus dem Template</h2>
  <p>Ein Repository (kurz Repo) ist der Ordner eures Projekts samt seiner Versionsgeschichte. Das Template ist eine Vorlage: Ihr bekommt eine eigene Kopie, in der ihr alles ändern dürft.</p>
  <Schritte id="repo" nummer="3" steps={[
    { img: bild('setup/repo-1-template'), alt: 'Template-Repository ndu-coding-2026 mit grünem Button „Use this template“', text: 'Öffnet das Template <a href="https://github.com/markesdo/ndu-coding-2026" target="_blank" rel="noopener">markesdo/ndu-coding-2026</a> und klickt oben rechts auf <em>Use this template</em>.', marks: [{ x: 1168, y: 104, w: 128, h: 32 }] },
    { img: bild('setup/repo-2-menue'), alt: 'Menü mit „Create a new repository“ und „Open in a codespace“', text: '<em>Create a new repository</em> wählen – nicht „Open in a codespace“, sonst habt ihr kein eigenes Repo.', marks: [{ x: 1122, y: 143, w: 170, h: 30 }] },
    { img: bild('setup/repo-3-formular'), alt: 'Formular „Create a new repository“ mit Namensfeld, Sichtbarkeit Public und Button „Create repository“', text: 'Name <code>leihbar</code> eintragen (1). Sichtbarkeit <em>Public</em> lassen (2). <em>Create repository</em> (3). Nach ein paar Sekunden seht ihr euer eigenes Repo.', marks: [{ x: 598, y: 356, w: 468, h: 36, n: 1 }, { x: 946, y: 586, w: 105, h: 36, n: 2 }, { x: 934, y: 653, w: 133, h: 35, n: 3 }] },
  ]} />

  <h2 id="codespace">4 · Codespace starten</h2>
  <p>Ein Codespace ist ein Rechner in der Cloud mit VS Code im Browser. Alles, was das Projekt braucht, ist dort schon installiert.</p>
  <Schritte id="codespace" nummer="4" steps={[
    { img: bild('setup/cs-1-repo'), alt: 'Euer Repo mit grünem Button „Code“', text: 'In <strong>eurem</strong> Repo (oben links steht euer Benutzername) auf den grünen Button <em>Code</em> klicken.', marks: [{ x: 913, y: 170, w: 103, h: 35 }] },
    { img: bild('setup/cs-2-tab'), alt: 'Code-Menü mit Tab „Codespaces“ und Button „Create codespace on main“', text: 'Das Menü öffnet sich auf dem Tab <em>Local</em>. Wechselt auf <em>Codespaces</em> (1), dann <em>Create codespace on main</em> (2).', marks: [{ x: 715, y: 210, w: 92, h: 34, n: 1 }, { x: 740, y: 414, w: 188, h: 35, n: 2 }] },
    { img: bild('setup/cs-3-baut'), alt: 'VS Code im Browser, unten rechts „Building codespace…“', text: 'VS Code öffnet sich im Browser und baut die Umgebung. Beim ersten Mal dauert das 2–4 Minuten.', marks: [{ x: 1086, y: 750, w: 405, h: 32 }] },
    { img: bild('setup/cs-4-trust'), alt: 'Dialog „Do you trust the authors of the files in this folder?“ mit Button „Trust Folder & Continue“', text: 'VS Code fragt: „Do you trust the authors of the files in this folder?“ Die Dateien stammen aus dem Kurs-Template, also <em>Trust Folder & Continue</em>. <strong>Ohne diese Bestätigung startet kein Terminal.</strong>', marks: [{ x: 806, y: 474, w: 136, h: 26 }] },
    { img: bild('setup/cs-5-bereit'), alt: 'Fertiger Codespace: links Dateien, unten Terminal, rechts ein Chat-Fenster von GitHub Copilot', text: 'Fertig: links die Dateien, unten das Terminal (1). Rechts öffnet sich ein Chat („Build with Agent“, 2) – <strong>das ist GitHub Copilot, nicht Claude</strong>. Ihr könnt ihn mit dem ✕ oben rechts schließen. Auch den Hinweis „Type copilot …“ im Terminal ignoriert ihr – ihr startet gleich Claude.', marks: [{ x: 318, y: 548, w: 906, h: 40, n: 1 }, { x: 1233, y: 36, w: 258, h: 742, n: 2 }] },
  ]} />

  <h2 id="claude-code">5 · Claude Code starten und anmelden</h2>
  <Callout type="warn" title="Erst warten, dann tippen">
    <p>Direkt nach dem Start richtet der Codespace im Hintergrund noch Claude Code ein. Wartet, bis links in der Leiste das Claude-Symbol (✳) erscheint, bevor ihr <code>claude</code> eintippt. Sonst seht ihr ein Warnsymbol am Terminal und das Einrichtungsprotokoll schiebt sich davor.</p>
  </Callout>
  <h3 id="claude-code-start">Im Terminal starten</h3>
  <Schritte id="claude-code" nummer="5" steps={[
    { img: bild('setup/claude-1-eintippen'), alt: 'Terminal mit eingetipptem Befehl claude', text: 'Ins Terminal klicken, <code>claude</code> eintippen, <kbd>Enter</kbd>.', marks: [{ x: 330, y: 554, w: 325, h: 18 }] },
    { img: bild('setup/claude-2-theme'), alt: 'Claude Code fragt nach dem Farbschema, Dark mode ist ausgewählt', text: 'Claude fragt nach dem Farbschema. <kbd>Enter</kbd> übernimmt die Vorauswahl.', marks: [{ x: 336, y: 618, w: 200, h: 40 }] },
    { img: bild('setup/claude-3-methode'), alt: 'Auswahl der Login-Methode, Punkt 1 „Claude account with subscription“', text: 'Login-Methode: <em>1. Claude account with subscription</em> ist vorausgewählt – <kbd>Enter</kbd>.', marks: [{ x: 336, y: 630, w: 440, h: 16 }] },
  ]} />
  <h3 id="claude-code-browser">Im Browser anmelden</h3>
  <Schritte id="claude-code" nummer="5" start={4} steps={[
    { img: bild('setup/claude-4-open'), alt: 'VS Code fragt „Do you want Code to open the external website?“ mit Button „Open“', text: 'VS Code fragt, ob es die Anmeldeseite öffnen darf: <em>Open</em>.', marks: [{ x: 1374, y: 450, w: 46, h: 28 }] },
    { img: bild('setup/claude-5-login'), alt: 'Anmeldeseite von Claude mit „Continue with Google“', text: 'Mit demselben Konto anmelden, mit dem ihr Claude Pro abgeschlossen habt.', marks: [{ x: 584, y: 362, w: 328, h: 42 }] },
    { img: bild('setup/claude-6-authorize'), alt: 'Seite „Claude Code would like to connect to your Claude chat account“ mit Button „Authorize“', text: '<em>Authorize</em>. Danach erscheint fast immer eine Fehlerseite „Diese Website ist nicht erreichbar“ (<code>localhost</code>). <strong>Das ist normal</strong> – die Anmeldung versucht, euren eigenen Rechner zu erreichen, Claude läuft aber im Codespace. Tab schließen und zurück zum Codespace.', marks: [{ x: 517, y: 599, w: 462, h: 40 }] },
    { img: bild('setup/claude-7-code'), alt: 'Seite „Authentication code“ mit Button „Copy code“ (Code unkenntlich gemacht)', text: 'Im Terminal steht jetzt „Browser didn’t open? Use the url below…“ und darunter <code>Paste code here if prompted &gt;</code>. Öffnet den langen Link mit <kbd>Cmd</kbd>-Klick (Mac) bzw. <kbd>Strg</kbd>-Klick (Windows) – oder drückt <kbd>c</kbd>, um ihn zu kopieren, und fügt ihn in einen neuen Tab ein. Nach <em>Authorize</em> zeigt diese Seite einen Code: <em>Copy code</em>, zurück ins Terminal, einfügen, <kbd>Enter</kbd>.', marks: [{ x: 694, y: 455, w: 109, h: 33 }] },
  ]} />
  <h3 id="claude-code-terminal">Zurück im Terminal: einrichten</h3>
  <Schritte id="claude-code" nummer="5" start={8} steps={[
    { img: bild('setup/claude-8-hinweise'), alt: 'Claude Code zeigt Sicherheitshinweise und „Press Enter to continue“', text: 'Angemeldet. Claude zeigt zwei Sicherheitshinweise – lesen, <kbd>Enter</kbd>.', marks: [{ x: 336, y: 692, w: 160, h: 16 }] },
    { img: bild('setup/claude-9-terminal'), alt: 'Frage „Use Claude Code’s terminal setup?“ mit Vorauswahl „Yes, use recommended settings“', text: 'Empfohlene Terminal-Einstellungen: <kbd>Enter</kbd> übernimmt „Yes“.', marks: [{ x: 336, y: 643, w: 222, h: 16 }] },
    { img: bild('setup/claude-10-trust'), alt: 'Frage „Is this a project you created or one you trust?“ mit der Liste der vorab erlaubten Befehle, vorausgewählt ist „No, exit“', text: '<strong>Achtung, hier nicht einfach Enter drücken:</strong> Vorausgewählt ist <em>No, exit</em> – das beendet Claude. Erst mit <kbd>↓</kbd> auf <em>Yes, I trust this folder</em> gehen, dann <kbd>Enter</kbd>. Darüber listet Claude die Befehle, die das Kurs-Template vorab erlaubt (etwa <code>npm run lint</code> oder <code>git status</code>) – das ist so gewollt.', marks: [{ x: 336, y: 718, w: 175, h: 15 }] },
    { img: bild('setup/claude-11-bereit'), alt: 'Claude Code ist bereit, unten die Eingabezeile', text: 'Claude Code ist bereit (1). Bei euch steht dort „Claude Pro“. Unten ist die Eingabezeile (2) – hier schreibt ihr eure Aufträge, auf Deutsch und in ganzen Sätzen. Die Anmeldung gilt für diesen Codespace; ihr macht sie nur einmal.', marks: [{ x: 333, y: 553, w: 240, h: 44, n: 1 }, { x: 331, y: 691, w: 1150, h: 20, n: 2 }] },
  ]} />

  <h2 id="app">6 · App starten und ansehen</h2>
  <Prompt label="Erster Prompt in Claude Code">Starte die App und sag mir in einfachen Worten, wie ich sie im Browser öffne.</Prompt>
  <Schritte id="app" nummer="6" steps={[
    { img: bild('setup/app-1-vorschau'), alt: 'Leere Vorschau im Editor mit Symbol einer kaputten Seite, oben rechts das Symbol „In neuem Tab öffnen“', text: 'Claude startet die App und öffnet oft eine Vorschau im Editor („Simple Browser“). Bleibt sie leer wie hier, klickt oben rechts auf das Symbol <em>In neuem Tab öffnen</em>. Alternativ: unten der Reiter <em>Ports</em> → Zeile <em>Leihbar (npm run dev)</em> mit Port 3000 → Globus-Symbol. Nennt Claude euch <code>localhost:3000</code>, gilt das nur auf dem eigenen Laptop – im Codespace nehmt ihr einen dieser beiden Wege.', marks: [{ x: 1452, y: 62, w: 30, h: 28 }] },
    { img: bild('setup/app-2-tab'), alt: 'Startseite der App in einem eigenen Browser-Tab', text: 'Eure App in einem eigenen Tab. Die Adresse endet auf <code>-3000.app.github.dev</code> und funktioniert nur, solange ihr bei GitHub angemeldet seid – zum Teilen kommt an Tag 2 Vercel.' },
  ]} />

  <h2 id="explain">7 · Projekt erklären lassen</h2>
  <Prompt label="Zweiter Prompt – Projekt verstehen">/ndu-explain</Prompt>
  <Schritte id="explain" nummer="7" steps={[
    { img: bild('setup/explain-1'), alt: 'Eingabezeile mit /ndu-explain und Vorschlag „Erklärt das Projekt oder eine Datei für Nicht-Programmierer*innen“', text: 'Sobald ihr <code>/</code> tippt, schlägt Claude passende Befehle vor. <code>/ndu-explain</code> ist einer der drei Kurs-Befehle aus dem Template. <kbd>Enter</kbd>.', marks: [{ x: 331, y: 629, w: 686, h: 44 }] },
    { img: bild('setup/explain-2'), alt: 'Antwort von Claude: das Projekt als Gastraum, Vorratskammer, Küche, Kellner und Gebäude erklärt', text: 'Claude erklärt das Projekt mit den Begriffen aus Konzept 1. Lest die Antwort – sie ist eure Landkarte für den Nachmittag.' },
  ]} />

  <h2 id="collaborator">8 · Markus als Collaborator einladen</h2>
  <p>Damit Markus euer Repo sehen und bei Problemen helfen kann: In eurem Repo oben <em>Settings</em> → links <em>Collaborators</em>.</p>
  <Schritte id="collaborator" nummer="8" steps={[
    { img: bild('setup/collab-1'), alt: 'Repo-Einstellungen, Seite „Collaborators and teams“ mit Button „Add people“', text: '<em>Add people</em>.', marks: [{ x: 829, y: 522, w: 97, h: 34 }] },
