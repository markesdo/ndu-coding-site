  .brief dl { display: grid; grid-template-columns: 11rem 1fr; gap: .4rem 1rem; margin: .75rem 0 0; }
  .brief dt { font-weight: 600; }
  .brief dd { margin: 0; }
  @media (max-width: 600px) { .brief dl { grid-template-columns: 1fr; } .brief dd { margin-bottom: .5rem; } }
</style>
