---
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import FooterNav from '../../components/FooterNav.astro';
---
<Layout title="Daten & Backend">
  <span class="eyebrow">Konzept 4 · Tag 2</span>
  <h1>Daten & Backend</h1>
  <p class="lead">Solange eure App nichts speichert, ist sie eine Broschüre. Sobald sie speichert, braucht sie eine Datenbank, Regeln, wer was darf – und einen Ort für Geheimnisse.</p>

  <h2>Datenbank in fünf Begriffen</h2>
  <div class="widget" id="db" data-zeige="beziehung">
    <p class="hint">Ein Ausschnitt aus der Datenbank von Leihbar. Klickt auf einen Begriff, um zu sehen, wo er steckt.</p>
    <div class="db-chips" role="group" aria-label="Begriff zeigen">
      <button type="button" data-begriff="tabelle" aria-pressed="false">Tabelle</button>
      <button type="button" data-begriff="zeile" aria-pressed="false">Zeile</button>
      <button type="button" data-begriff="spalte" aria-pressed="false">Spalte</button>
      <button type="button" data-begriff="id" aria-pressed="false">ID</button>
      <button type="button" data-begriff="beziehung" aria-pressed="true">Beziehung</button>
    </div>
    <p class="loop-detail db-erklaerung" id="db-erklaerung" aria-live="polite"><strong>Beziehung.</strong> Zeile 1 in <code>requests</code> zeigt auf Gegenstand 42 und auf Nutzerin 7: Mara möchte den Samtsessel ausleihen. Titel und Namen stehen nur einmal in der Datenbank – <code>requests</code> speichert bloß die IDs.</p>
    <div class="db-tabellen">
      <table data-t="items">
        <caption><code>items</code></caption>
        <tr><th scope="col" data-col="id">id</th><th scope="col">titel</th><th scope="col">preis_pro_tag</th><th scope="col" data-col="ort">ort</th></tr>
        <tr><td data-col="id">41</td><td>Akkuschrauber</td><td>3</td><td data-col="ort">Wiener Straße</td></tr>
        <tr data-row="samtsessel"><td data-col="id" data-rel>42</td><td>Samtsessel</td><td>8</td><td data-col="ort">Herzogenburger Str.</td></tr>
      </table>
      <table data-t="profiles">
        <caption><code>profiles</code></caption>
        <tr><th scope="col" data-col="id">id</th><th scope="col">name</th></tr>
        <tr><td data-col="id" data-rel>7</td><td>Mara</td></tr>
        <tr><td data-col="id">8</td><td>Jonas</td></tr>
      </table>
      <table data-t="requests">
        <caption><code>requests</code></caption>
        <tr><th scope="col" data-col="id">id</th><th scope="col">item_id</th><th scope="col">user_id</th></tr>
        <tr><td data-col="id">1</td><td data-rel>42</td><td data-rel>7</td></tr>
        <tr><td data-col="id">2</td><td>42</td><td>8</td></tr>
        <tr><td data-col="id">3</td><td>41</td><td>8</td></tr>
      </table>
    </div>
    <script>
      const texte: Record<string, string> = {
        tabelle: '<strong>Tabelle.</strong> Eine Tabelle sammelt einen Objekttyp – hier alle Gegenstände. Jede Tabelle hat feste Spalten.',
        zeile: '<strong>Zeile.</strong> Eine Zeile ist ein einzelner Eintrag: der Gegenstand „Samtsessel“ mit all seinen Werten.',
        spalte: '<strong>Spalte.</strong> Eine Spalte ist eine Eigenschaft, die jede Zeile hat – hier der Ort. Alle Werte darin haben denselben Datentyp.',
        id: '<strong>ID.</strong> Jede Zeile hat eine eindeutige Nummer. Sie wird beim Anlegen vergeben und ändert sich nie.',
        beziehung: document.getElementById('db-erklaerung')!.innerHTML,
      };
      const root = document.getElementById('db')!;
      const erklaerung = document.getElementById('db-erklaerung')!;
      const chips = root.querySelectorAll<HTMLButtonElement>('.db-chips button');
      // Platz für den längsten Text reservieren, sonst springen die Tabellen darunter bei jedem Begriff.
      function hoeheFestlegen() {
        const aktuell = erklaerung.innerHTML;
        erklaerung.style.minHeight = '';
        let max = 0;
        for (const t of Object.values(texte)) {
          erklaerung.innerHTML = t;
          max = Math.max(max, erklaerung.offsetHeight);
        }
        erklaerung.innerHTML = aktuell;
        erklaerung.style.minHeight = `${max}px`;
      }
      hoeheFestlegen();
      // Nur bei geänderter Breite neu messen – die eigene Höhenänderung soll keine Schleife auslösen.
      let breite = root.clientWidth;
      new ResizeObserver(() => {
        if (root.clientWidth === breite) return;
        breite = root.clientWidth;
        hoeheFestlegen();
      }).observe(root);
      chips.forEach((b) => b.addEventListener('click', () => {
        const begriff = b.dataset.begriff!;
        root.dataset.zeige = begriff;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
        erklaerung.innerHTML = texte[begriff];
      }));
    </script>
  </div>
  <table>
    <tr><th>Begriff</th><th>Heißt</th><th>In Leihbar</th></tr>
    <tr><td>Tabelle</td><td>Ein Objekttyp, z. B. Gegenstände – mit festen Spalten und Datentypen</td><td><code>items</code>, <code>requests</code>, <code>profiles</code></td></tr>
    <tr><td>Zeile</td><td>Ein einzelner Eintrag</td><td>„Samtsessel, 8 € pro Tag, Herzogenburger Straße“</td></tr>
    <tr><td>Spalte</td><td>Eine Eigenschaft</td><td><code>titel</code>, <code>preis_pro_tag</code>, <code>ort</code></td></tr>
    <tr><td>ID</td><td>Eindeutige Nummer pro Zeile</td><td>Gegenstand 42</td></tr>
    <tr><td>Beziehung</td><td>Eine Zeile zeigt auf eine andere</td><td>Anfrage → Gegenstand 42, → Nutzerin Mara</td></tr>
  </table>
  <p>CRUD – Create, Read, Update, Delete – sind die vier Dinge, die man mit Zeilen tun kann. Fast jede App ist CRUD mit schöner Oberfläche. Wenn ihr ein Issue schreibt, fragt euch: Welche Tabelle, welche Operation?</p>

  <h2>Der Weg einer Anfrage</h2>
  <div class="widget" id="req">
    <p class="hint">Klickt euch durch, was passiert, wenn Mara einen Gegenstand anbietet.</p>
    <div class="loop">
      <button type="button" data-step="0" class="active">Frontend</button>
      <button type="button" data-step="1">API-Route</button>
      <button type="button" data-step="2">Datenbank</button>
      <button type="button" data-step="3">Antwort</button>
    </div>
    <div class="loop-detail" id="req-detail"></div>
    <script>
      const s = [
        ['Frontend', 'Mara füllt das Formular aus und klickt „Speichern“. Der Browser prüft Pflichtfelder (schnelles Feedback) und schickt <code>POST /api/items</code> mit den Daten.', 'Was hier geprüft wird, kann jeder umgehen. Deshalb prüft das Backend noch einmal.'],
        ['API-Route', 'Die Datei <code>src/app/api/items/route.ts</code> nimmt die Anfrage an. Sie prüft: Ist Mara angemeldet? Ist der Preis nicht negativ? Ist der Titel nicht leer? Erst dann geht es weiter.', 'Das ist das Backend – es läuft auf dem Server, Mara sieht den Code nie.'],
        ['Datenbank', 'Supabase bekommt <code>INSERT INTO items …</code>. Vorher prüft Row Level Security: Darf diese Nutzerin in diese Tabelle schreiben? Ja → neue Zeile mit ID 43.', 'RLS ist die letzte Verteidigungslinie – selbst wenn das Backend einen Fehler hat.'],
        ['Antwort', 'Die Datenbank meldet „Zeile 43 angelegt“, die API antwortet mit <code>201 Created</code> und dem Gegenstand, das Frontend zeigt ihn in der Liste – ohne Reload.', 'Fehler auf dem Rückweg (<code>400</code>, <code>401</code>, <code>500</code>) sind die Zahlen, die ihr in Fehlermeldungen sehen werdet.'],
      ];
      const d = document.getElementById('req-detail')!;
      const bs = document.querySelectorAll<HTMLButtonElement>('#req .loop button');
      const show = (i: number) => { bs.forEach((b, j) => b.classList.toggle('active', i === j)); d.innerHTML = `<p><strong>${s[i][0]}.</strong> ${s[i][1]}</p><p class="muted">${s[i][2]}</p>`; };
      bs.forEach(b => b.addEventListener('click', () => show(Number(b.dataset.step))));
      show(0);
    </script>
  </div>

  <h2 id="rls">Warum das Formular nicht reicht</h2>
  <p>Das Formular prüft, ob jemand angemeldet ist und ob der Titel ausgefüllt ist. Das ist Komfort: schnelle Rückmeldung, bevor etwas abgeschickt wird. Schutz ist es nicht. Die Adresse eurer Datenbank und der Publishable Key stehen im Browser – jede*r kann sie in den DevTools im Netzwerk-Tab ablesen und damit direkt mit eurer Datenbank sprechen, an eurem Formular vorbei.</p>
  <table>
    <tr><th>Weg</th><th>Was geprüft wird</th><th>Ergebnis</th></tr>
    <tr><td>Mara füllt das Formular aus</td><td>Formular, dann <strong>RLS</strong> in der Datenbank</td><td>Angemeldet: Zeile wird angelegt</td></tr>
    <tr><td>Jemand schickt mit dem Publishable Key selbst eine Anfrage, ohne Login</td><td>Kein Formular – nur <strong>RLS</strong></td><td>Mit Regel: abgelehnt. Ohne Regel: angelegt</td></tr>
  </table>
  <p>Deshalb sitzt die Regel, die wirklich schützt, in der Datenbank selbst: <strong>Row Level Security</strong>. Sie gilt für jeden Weg hinein – Formular, Skript oder einen Fehler im eigenen Code. RLS verschlüsselt nichts und ersetzt die Prüfung im Formular nicht: Das Formular bleibt für die schnelle Rückmeldung, RLS entscheidet, was gespeichert wird.</p>
  <Callout type="tip" title="So prüft ihr, ob die Regel hält">
    <p>Lasst Claude über den Supabase-MCP versuchen, ohne Login eine Zeile anzulegen oder eine fremde zu ändern. Meldet die Datenbank „violates row-level security policy“ oder ändert sich keine Zeile, hält die Regel.</p>
  </Callout>

  <h2 id="supabase">Supabase – die gemietete Küche</h2>
  <p>Früher brauchte man für Datenbank, Login und Dateispeicher drei Systeme und jemanden, der Server wartet. Supabase liefert alles aus einem Guss: eine <strong>Postgres-Datenbank</strong> (der Industriestandard), <strong>Auth</strong> (Registrierung, Login, Passwort vergessen, Google-Login), <strong>Storage</strong> für Bilder, und ein Dashboard, in dem ihr eure Daten seht. Kostenlos für Prototypen, Server in Frankfurt, und über <strong>MCP</strong> kann Claude direkt damit arbeiten.</p>
  <Callout type="warn" title="Free-Tier-Falle">
    <p>Supabase pausiert kostenlose Projekte nach <strong>7 Tagen ohne Zugriff</strong>. In der Zwischenwoche einmal öffnen reicht. Pausiert? Dashboard → „Restore project“, dauert 2 Minuten.</p>
  </Callout>

  <h2>Authentifizierung vs. Autorisierung</h2>
  <p><strong>Authentifizierung:</strong> Wer ist das? (Login.) <strong>Autorisierung:</strong> Was darf diese Person? (Eigene Anfrage löschen: ja. Fremde: nein.) Die zweite Frage ist die, die Anfänger*innen – und Agenten – gern vergessen. <strong>Row Level Security (RLS)</strong> beantwortet sie direkt in der Datenbank: Pro Tabelle Regeln wie „lesen darf jeder, anlegen nur Angemeldete, löschen nur, wem die Zeile gehört“. Fragt Claude bei jeder neuen Tabelle: <em>„Welche RLS-Policies hast du gesetzt, und was passiert, wenn eine fremde Person eine Zeile ändern will?“</em></p>

  <h2>Secrets & Umgebungsvariablen</h2>
  <p>Eure App braucht Zugangsdaten: die Supabase-URL, Keys, später vielleicht einen Claude-API-Key. Die stehen in <code>.env.local</code>, einer Datei, die <strong>nie ins Repo kommt</strong>. Auf Vercel tragt ihr dieselben Werte im Dashboard ein. So kann der Code öffentlich sein und die Schlüssel privat bleiben.</p>
  <table>
    <tr><th>Variable</th><th>Darf der Browser sie sehen?</th></tr>
    <tr><td><code>NEXT_PUBLIC_SUPABASE_URL</code>, <code>NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY</code></td><td>Ja – deshalb <code>NEXT_PUBLIC_</code>. Der Publishable Key ist durch RLS geschützt.</td></tr>
    <tr><td><code>ANTHROPIC_API_KEY</code>, <code>SUPABASE_SECRET_KEY</code></td><td><strong>Niemals.</strong> Nur im Backend. Wenn Claude so einen Key in eine Frontend-Datei schreibt: stoppen.</td></tr>
  </table>

  <h2>Begriffe, die heute fallen</h2>
  <table>
    <tr><th>Begriff</th><th>Bedeutet</th></tr>
    <tr><td>Migration</td><td>Eine protokollierte Änderung an der Datenbankstruktur („Tabelle requests anlegen“). Claude legt sie an; so ist nachvollziehbar, wie die Datenbank entstanden ist.</td></tr>
    <tr><td>Seed-Daten</td><td>Beispieldaten, mit denen die Datenbank gefüllt wird, damit die App nicht leer aussieht.</td></tr>
    <tr><td>Schema</td><td>Die Gesamtheit aller Tabellen und Beziehungen – der Bauplan eurer Daten.</td></tr>
    <tr><td>Server Component / Client Component</td><td>Next.js-Interna: Was auf dem Server gerendert wird (Daten holen) vs. im Browser (Klicks). Claude kümmert sich darum; der Fehler „useState in Server Component“ ist aber ein Klassiker, den ihr wiedererkennen werdet.</td></tr>
    <tr><td>Realtime</td><td>Supabase kann Änderungen live an alle Browser pushen (Zähler steigt bei allen gleichzeitig). Nettes „Später“-Feature.</td></tr>
  </table>

  <FooterNav prev={{ href: '/tag-2#konzept-4', t: 'Tag 2' }} next={{ href: '/konzepte/mcp', t: 'Ergänzung: MCP' }} />
</Layout>

<style>
  .db-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem 0 1rem; }
  .db-chips button { font: inherit; font-weight: 600; font-size: .95rem; padding: .5rem .9rem; border-radius: 999px; border: 2px solid var(--border); background: var(--bg); color: var(--fg); cursor: pointer; }
  .db-chips button[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
  .db-tabellen { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .db-tabellen table { margin: 0; background: var(--bg); border: 2px solid var(--border); border-radius: 10px; border-collapse: separate; border-spacing: 0; overflow: hidden; font-size: .9rem; }
  .db-tabellen [data-t="items"] { grid-column: 1 / -1; }
  .db-tabellen table { align-self: start; }
  .db-tabellen caption { text-align: left; padding: 0 0 .35rem; }
  .db-tabellen th { font-family: var(--mono); text-transform: none; letter-spacing: 0; font-size: .8rem; }
  .db-tabellen th, .db-tabellen td { padding: .45rem .6rem; }
  .db-tabellen tr:last-child td { border-bottom: 0; }
  /* Über den Tabellen, damit man am Handy nach dem Tippen nicht scrollen muss. Die Mindesthöhe setzt das Skript. */
  .db-erklaerung { margin: 0 0 1rem; }

  /* Hervorhebung nie nur über Farbe: Hintergrund, Rahmen und fette Schrift. */
  #db[data-zeige="tabelle"] [data-t="items"],
  #db[data-zeige="zeile"] [data-row="samtsessel"] td,
  #db[data-zeige="spalte"] [data-col="ort"],
  #db[data-zeige="id"] [data-col="id"],
  #db[data-zeige="beziehung"] [data-rel] { background: var(--accent-soft); font-weight: 700; color: var(--fg); }
  #db[data-zeige="tabelle"] [data-t="items"] { border-color: var(--accent); }
  #db[data-zeige="zeile"] [data-row="samtsessel"] td { border-top: 2px solid var(--accent); border-bottom: 2px solid var(--accent); }
  #db[data-zeige="spalte"] [data-col="ort"],
  #db[data-zeige="id"] [data-col="id"],
  #db[data-zeige="beziehung"] [data-rel] { outline: 2px solid var(--accent); outline-offset: -2px; }

  @media (max-width: 600px) {
    .db-tabellen { grid-template-columns: 1fr; }
    .db-chips { gap: .4rem; }
    .db-chips button { padding: .35rem .7rem; font-size: .9rem; }
  }
</style>
