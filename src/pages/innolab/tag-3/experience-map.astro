---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import FooterNav from '../../../components/FooterNav.astro';
import Folie from '../../../components/Folie.astro';
import Fluss from '../../../components/Fluss.astro';
import Timer from '../../../components/Timer.astro';
import MiroLink from '../../../components/MiroLink.astro';
import Aufloesung from '../../../components/Aufloesung.astro';
import KaffeebarMap from '../../../components/KaffeebarMap.astro';
import Baum from '../../../components/bild/Baum.astro';
import { CircleCheck, CircleX, CornerDownRight, Footprints, Heart, Quote, Square } from '@lucide/astro';
import { KAFFEEBAR_BAUM_INTERVIEWS } from '../../../components/innolab-beispiel';
import { ENDE_TAG_3 } from '../../../components/innolab-zeiten';
import KAFFEEBAR_INTERVIEWS from '../../../werkstatt/beispiele/interviews.json';
import { MOMENTNAMEN, SKIZZEN, geschichtenIn, zaehlung, type GruppeId } from '../../../data/kaffeebar-skizzen';

const TORRES = 'Teresa Torres, „Continuous Discovery Habits“ (2021)';
// „Drei bis fünf“ steht nicht im Buch, sondern in Torres’ Buchclub-Leitfaden zu Kapitel 6 (Product Talk, 2026).
const BUCHCLUB = 'https://www.producttalk.org/cdh-book-club-april-2026-2/';
// Die Auflösungen der Folien 4 bis 9 (anlauf-a bis vom-tief-aus) öffnen sich gemeinsam, wenn Markus nach der Runde auf Folie „anlauf-a“
// (die erste der Gruppe, Folie nach „drei-anlaeufe“) aufdeckt; ENDE_TAG_3 ist nur der späte Rückfall.
const GRUPPE = 'map-anlaeufe';
// Folie „warum-nochmal“: nur Outcome und die drei Momente (oberste Ebene) des Kaffeebar-Baums.
const NUR_MOMENTE = { t: KAFFEEBAR_BAUM_INTERVIEWS.t, kinder: (KAFFEEBAR_BAUM_INTERVIEWS.kinder ?? []).map((k) => ({ t: k.t })) };
// Anlauf A (Folie „drei-anlaeufe“, klein wiederholt auf „anlauf-a“).
const ANLAUF_A = ['In die Halle kommen', 'Schlange ansehen', 'auf die Uhr schauen', 'anstellen', 'warten', 'Kaffee nehmen', 'zum Bahnsteig', 'einsteigen'];
// Ein Moment: tut · fühlt · belegt (erzählt in N von M Geschichten) – die Prüfzeile unter jedem Anlauf, die Bilanz der Folien 4–5.
const BAUSTEINE = ['tut', 'fühlt', 'belegt'] as const;
// Folie „zusammen“: Ablauf (oben) + Gefühl (unten) = Moment. Die Karte trägt nur Name und Zählung (+ Marke Tief/Ende, ohne
// ID); Momente und Zählung wie auf journey-map.astro#beispiel, die Zahl aus den Skizzen (zaehlung). Die Schritte und Gefühle
// sind die Anläufe A und B von Folie „drei-anlaeufe“. Die Zitate mit IDs bleiben in der Zähltabelle.
const ZUSAMMEN = [
  { schritte: ['In die Halle kommen', 'Schlange ansehen', 'auf die Uhr schauen'], gefuehl: 'Zeitdruck', moment: MOMENTNAMEN.a, g: 'a', marke: 'Tief', art: 'tief' },
  { schritte: ['anstellen', 'warten'], gefuehl: 'Frust', moment: MOMENTNAMEN.c, g: 'c', marke: 'Tief', art: 'tief' },
  { schritte: ['einsteigen'], gefuehl: 'Ruhe', moment: MOMENTNAMEN.d, g: 'd', marke: 'Ende', art: 'ende' },
] as const;
// Marken wie in den Skizzen: Tief/Ende steht dort an einem Sticky der Gruppe.
const markeFehlt = ZUSAMMEN.filter((z) => !SKIZZEN.some((s) => s.stickies.some((st) => st.g === z.g && st.marke === z.art))).map((z) => z.g);
// Restzeile auf „zusammen“: Kaffee nehmen, zum Bahnsteig – nur Einzelstimmen ohne Gruppe (IDs im Handout).
const EINZELSTIMMEN = ['I1-4', 'I5-5'] as const;
// Folie „anlauf-c“: ein Zitat, eine Notiz, eine Meinung – Texte wörtlich aus dem Werkstatt-Beispiel.
const ZITATE = new Map(KAFFEEBAR_INTERVIEWS.interviews.flatMap((iv) => iv.zitate.map((z) => [z.id, z.text] as const)));
const NOTIZ_I1 = KAFFEEBAR_INTERVIEWS.interviews.find((iv) => iv.id === 'I1')?.notizen ?? '';
const NOTIZ_SATZ = 'Schaut erst auf die Schlange, dann auf die Uhr.';
// Zitat-IDs einer Gruppe in den Skizzen (nur Stickies mit Zitat) – für die Zahlen, die der Text nennt.
const idsIn = (g: GruppeId) => SKIZZEN.flatMap((s) => s.stickies.filter((st) => st.g === g && st.id && !st.notiz).map((st) => st.id!));
const gezeigt = [
  ...EINZELSTIMMEN,
  'I2-1', 'I4-2', 'I5-6', 'I2-2', 'I2-4', 'I2-5', 'I3-3', 'I4-3',
  // nur gesprochen (Begleiter „anlauf-a“): der Automat in drei Geschichten
  'I1-3', 'I2-3',
];
const fehlt = gezeigt.filter((id) => !ZITATE.has(id));
// Folie „vom-tief-aus“ (Handout): wörtlich zitierte Sätze müssen im Werkstatt-Beispiel stehen.
const HANDOUT_ZITATE = { 'I2-5': 'Am liebsten wüsste ich einfach, wann er fertig ist.', 'I4-2': 'Anstellen ist ein Glücksspiel.', 'I4-3': 'Meistens ist es der Automat.' } as const;
const handoutFalsch = Object.entries(HANDOUT_ZITATE).filter(([id, text]) => ZITATE.get(id) !== text).map(([id]) => id);
if (handoutFalsch.length) throw new Error(`tag-3/experience-map.astro: Handout-Zitat weicht vom Werkstatt-Beispiel ab: ${handoutFalsch.join(', ')}`);
if (fehlt.length) throw new Error(`tag-3/experience-map.astro: Zitat-IDs fehlen in werkstatt/beispiele/interviews.json: ${fehlt.join(', ')}`);
if (markeFehlt.length) throw new Error(`tag-3/experience-map.astro: Marke Tief/Ende fehlt in den Skizzen, Gruppe ${markeFehlt.join(', ')}`);
// Restzeile: Einzelstimmen stehen in den Skizzen, aber in keiner Gruppe.
const einzelGruppiert = EINZELSTIMMEN.filter((id) => !SKIZZEN.some((s) => s.stickies.some((st) => st.id === id && !st.g)));
if (einzelGruppiert.length) throw new Error(`tag-3/experience-map.astro: Einzelstimme fehlt in den Skizzen oder hat eine Gruppe: ${einzelGruppiert.join(', ')}`);
// Texte, die Zahlen aus den Skizzen nennen: „fünf Zitate, drei Geschichten“ (anlauf-c), „Im Zug“ in einer Geschichte (zusammen),
// der Automat in drei von fünf Geschichten (Begleiter anlauf-a).
if (idsIn('a').length !== 5 || geschichtenIn('a') !== 3) throw new Error('tag-3/experience-map.astro: „fünf Zitate, drei Geschichten“ stimmt nicht mehr');
if (geschichtenIn('d') !== 1) throw new Error('tag-3/experience-map.astro: „Im Zug“ steht nicht mehr in genau einer Geschichte');
if (zaehlung('b') !== '3 von 5' || !['I1-3', 'I2-3', 'I4-3'].every((id) => idsIn('b').includes(id))) throw new Error('tag-3/experience-map.astro: Automat nicht mehr in I1-3, I2-3, I4-3 (3 von 5)');
if (!NOTIZ_I1.includes(NOTIZ_SATZ)) throw new Error('tag-3/experience-map.astro: Notiz zu I1 hat sich geändert');
---
<Layout title="Tag 3 · Experience Map nachschärfen">
  <span class="eyebrow">Innolab · Tag 3 · 09:00–09:25</span>
  <h1>Experience Map nachschärfen</h1>
  <p class="lead">Bevor der Baum wächst: Was ein Moment braucht – an drei Anläufen der Kaffeebar, dann an eurer eigenen Map.</p>
  <Orientierung seite="innolab/tag-3/experience-map" leiste={false} />

  <Folie>
    <h2 id="warum-nochmal">Heute werden eure Momente zu Ästen</h2>
    <p class="folie-satz">Jeder Moment eurer Map wird ein oberster Ast: drei bis fünf Momente, die sich nicht überschneiden.</p>
    <Baum schmal momente knoten={NUR_MOMENTE} label="Baum der Kaffeebar: Outcome, darunter die drei Momente der Experience Map als oberste Äste (Halle: entscheiden; Anstehen und Warten; Im Zug)" />
    <p class="small muted">{TORRES}, S. 86–87; drei bis fünf: Torres, Buchclub-Leitfaden zu Kapitel 6 („Ch. 6: Mapping the Opportunity Space“, <a href={BUCHCLUB}>producttalk.org</a>, 2026).</p>
    <div class="nur-handout">
      <p>Jeder Moment der Experience Map wird eine oberste Chance des Baums ({TORRES}, S. 86–87). Sind die Momente unklar, sind es die Äste auch, und jede Chance darunter hängt im Ungefähren. Darum schärft ihr die Map, bevor ihr die Chancen aus den Snapshots unter die Momente hängt.</p>
      <p>Die Momente dürfen sich nicht überschneiden: „Overlap will prevent us from working on one opportunity at a time“ ({TORRES}, S. 87). Drei bis fünf steht so nicht im Buch; Torres nennt die Zahl in ihrem Buchclub-Leitfaden zu Kapitel 6 („identify 3-5 distinct moments in time to serve as your top-level opportunities“, <a href={BUCHCLUB}>Product Talk, „Ch. 6: Mapping the Opportunity Space“</a>, 2026), ohne Begründung. Im Buch hat ihr Beispiel vier Momente ({TORRES}, S. 87).</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="bausteine">Was ein Moment braucht</h2>
    <p class="folie-satz">Ein Moment ist ein Zeitpunkt der Geschichte, benannt aus Sicht der Kundschaft – und gezählt: Wie viele Geschichten erzählen ihn?</p>
    <ol class="bausteine" aria-label="Ein Moment: was die Person tut, plus wie es sich anfühlt, plus belegt: erzählt in N von M Geschichten">
      <li data-schritt><Footprints size={28} aria-hidden="true" /> <strong>tut</strong> <span>Was macht die Person dort?</span></li>
      <li data-schritt><Heart size={28} aria-hidden="true" /> <strong>fühlt</strong> <span>Wie fühlt es sich an?</span></li>
      <li data-schritt><Quote size={28} aria-hidden="true" /> <strong>belegt</strong> <span>erzählt in N von M Geschichten</span></li>
    </ol>
    <p class="small muted">{TORRES}, S. 56, 69, 87–88; Nielsen Norman Group, „Journey Mapping 101“. N von M am Moment: Format dieses Kurses.</p>
    <div class="nur-handout">
      <p>Torres beschreibt einen Knoten als „a distinct moment in time, an action, or an event“ und hängt an jeden Schritt den Kontext: Was denkt, fühlt, tut die Person dort ({TORRES}, S. 56)? Daher kommen die ersten beiden Bausteine.</p>
      <p>Einen Moment findet ihr nicht in einer Geschichte, sondern über viele: Torres sucht die Knoten, die „story after story“ auftauchen, näht die häufigsten zu einer Map zusammen, die alle gesammelten Geschichten abbildet, und benennt die Momente schlicht, etwa „Choosing something to watch“ ({TORRES}, S. 87). Auf die Momentkarte kommen darum nur zwei Dinge: der Name aus Sicht der Kundschaft und die Zahl der Geschichten, die ihn erzählen („N von M“). Welche Zitate dazugehören, entscheidet ihr beim Zusammenlegen und Zählen.</p>
      <p>Die Zitate mit ihren IDs bleiben in der Zähltabelle und auf dem Snapshot: Dort gehört ein einprägsames Zitat hin (S. 69), und bei den Chancen braucht ihr die Belege wieder („have we seen it in more than one interview?“, S. 88). Dass schon der Moment eine Zahl trägt, ist das Format dieses Kurses. Die Nielsen Norman Group schreibt dazu: „A journey map is only as reliable as the evidence behind it.“ (<a href="https://www.nngroup.com/articles/journey-mapping-101/">„Journey Mapping 101“</a>)</p>
      <p><strong>Was ist eine Geschichte?</strong> Ein konkretes Erlebnis, das die Person erzählt – was an einem bestimmten Mal tatsächlich passiert ist. Torres fragt danach mit „Tell me about the last time …“ ({TORRES}, S. 64). Eine Geschichte ist nicht dasselbe wie ein Interview: Ein Interview kann mehrere Geschichten enthalten – oder keine, wenn die Person nur Meinungen äußert oder allgemeine Fragen beantwortet („Worauf achtest du …?“). Meist trägt ein Snapshot eine Geschichte; gezählt wird, in wie vielen erzählten Geschichten ein Moment vorkommt, nicht wie viele Personen eine Frage beantwortet haben.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="drei-anlaeufe">Drei Anläufe an der Kaffeebar: Was fehlt?</h2>
    <p class="folie-satz">Jede*r für sich, alle drei Anläufe: Welche der drei Bausteine sind da, welche fehlen? <Timer minuten={2} /></p>
    <p class="folie-satz zweite">Und: An welchem Schritt von A entsteht „Frust“?</p>
    <div class="anlaeufe">
      <section class="anlauf">
        <p class="anlauf-name">A</p>
        <ol class="anlauf-fluss" aria-label="Anlauf A: acht Schritte von In die Halle kommen bis einsteigen">
          {ANLAUF_A.map((t) => <li><span>{t}</span></li>)}
        </ol>
        <p class="pruefzeile" aria-label="Prüfzeile A: tut, fühlt, belegt">{BAUSTEINE.map((b) => <span><Square size={16} aria-hidden="true" /> {b}</span>)}</p>
      </section>
      <section class="anlauf">
        <p class="anlauf-name">B</p>
        <ul class="anlauf-karten" aria-label="Anlauf B: drei Karten ohne Pfeile">
          <li>Zeitdruck</li><li>Frust</li><li>Ruhe</li>
        </ul>
        <p class="pruefzeile" aria-label="Prüfzeile B: tut, fühlt, belegt">{BAUSTEINE.map((b) => <span><Square size={16} aria-hidden="true" /> {b}</span>)}</p>
      </section>
      <section class="anlauf">
        <p class="anlauf-name">C</p>
        <div class="anlauf-c">
          <p class="anlauf-kopf">Problem</p>
          <ul class="anlauf-karten">
            <li>Die Pendler*innen prüfen die Wartezeit.</li>
            <li>Viele entscheiden sich aus Zeitmangel gegen die Kaffeebar.</li>
          </ul>
          <p class="anlauf-kopf">Ausweichen</p>
          <ul class="anlauf-karten">
            <li>Die Pendler*innen weichen auf Alternativen aus.</li>
          </ul>
        </div>
        <p class="pruefzeile" aria-label="Prüfzeile C: tut, fühlt, belegt">{BAUSTEINE.map((b) => <span><Square size={16} aria-hidden="true" /> {b}</span>)}</p>
      </section>
    </div>
    <p class="small muted ausgedacht">Ausgedacht, aus dem Material der Kaffeebar.</p>
    <div class="nur-handout">
      <p>Die drei Anläufe sind ausgedacht, aus dem Material der Kaffeebar gebaut, und zeigen Fehler, die beim Bauen einer Map oft passieren. Jede*r schaut sich für sich alle drei an, prüft sie an den drei Bausteinen der Folie davor und sucht den Schritt von A, zu dem „Frust“ aus B gehört. Erst danach kommt die Auflösung.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="anlauf-a">Anlauf A</h2>
    <p class="folie-satz">Was zeigt Anlauf A – und was fehlt ihm?</p>
    <ol class="anlauf-fluss klein" aria-label="Anlauf A, zur Erinnerung: acht Schritte von In die Halle kommen bis einsteigen">
      {ANLAUF_A.map((t) => <li><span>{t}</span></li>)}
    </ol>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <p class="pointe">Ein Ablauf zeigt, was passiert – nicht, wie es erlebt wird.</p>
      <p class="bilanz"><span class="ja"><CircleCheck size={20} aria-hidden="true" /> tut</span> <span class="nein"><CircleX size={20} aria-hidden="true" /> fühlt</span> <span class="nein"><CircleX size={20} aria-hidden="true" /> belegt</span></p>
      <ul class="gross">
        <li data-schritt>Nur der glatte Weg: Niemand kehrt um, niemand weicht aus.</li>
      </ul>
      <p class="small muted">Knoten, Pfeile, Kontext, „Don’t just map out the happy path.“: {TORRES}, S. 56. Belegt (N von M): Format dieses Kurses.</p>
      <div class="nur-handout">
        <p>Ein Ablauf ist ein guter Anfang: Er zeigt die Reihenfolge. Torres baut die Map genau so auf – erst Knoten und Pfeile, dann an jedem Schritt der Kontext: Was denkt, fühlt, tut die Person dort ({TORRES}, S. 56)? Anlauf A bleibt beim ersten Schritt stehen. Torres warnt außerdem davor, nur den glatten Weg zu zeichnen: Auf die Map gehört auch, wo Schritte wiederholt werden, wo jemand aus Frust aufgibt und wo der Weg eine Schleife macht (S. 56). An der Kaffeebar ist das der Automat. Dass ein Moment belegt sein muss – erzählt in N von M Geschichten –, ist das Format dieses Kurses.</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="anlauf-b">Anlauf B</h2>
    <p class="folie-satz">Was zeigt Anlauf B – und was fehlt ihm?</p>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <p class="pointe">Ein Gefühl ohne Zeitpunkt ist noch kein Moment.</p>
      <p class="bilanz"><span class="nein"><CircleX size={20} aria-hidden="true" /> tut</span> <span class="ja"><CircleCheck size={20} aria-hidden="true" /> fühlt</span> <span class="nein"><CircleX size={20} aria-hidden="true" /> belegt</span></p>
      <ul class="gross">
        <li data-schritt>Wann? Wobei? – Das Gefühl braucht den Schritt, an dem es entsteht.</li>
      </ul>
      <p class="small muted">Kontext am Schritt: {TORRES}, S. 56. Gefühl als Wegweiser zur Ursache: S. 95 (dort für Chancen).</p>
      <div class="nur-handout">
        <p>Gefühle sind wertvoll: Sie zeigen, wo es weh tut. Sie gehören aber an den Schritt, an dem sie entstehen, als Kontext ({TORRES}, S. 56) – nicht als eigener Knoten. Ohne Pfeile fehlt die Reihenfolge. Als Ast wäre „Frust“ zu allgemein: Torres hält nicht das Gefühl fest, sondern seine Ursache (S. 95, dort für Chancen).</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="zusammen">A und B übereinander</h2>
    <p class="folie-satz">Legt Ablauf und Gefühle übereinander: Was gehört zum selben Zeitpunkt?</p>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <ol class="zusammen" aria-label="Aus Ablauf und Gefühlen werden drei Momente der Kaffeebar, jeder mit Name und Zählung">
        {ZUSAMMEN.map((z) => (
          <li data-schritt>
            <span class="z-schritte">{z.schritte.map((s) => <span class="chip">{s}</span>)}</span>
            <span class="z-plus" aria-hidden="true">+</span>
            <span class="chip gefuehl">{z.gefuehl}</span>
            <span class="z-pfeil" aria-hidden="true">↓</span>
            <span class="karte">
              <strong>{z.moment}</strong>
              <span class="zaehl">{zaehlung(z.g)}</span>
              <span class={`pill ${z.art}`}>{z.marke}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="rest small muted" data-schritt><span class="chip grau">Kaffee nehmen</span> <span class="chip grau">zum Bahnsteig</span> nur Einzelstimmen → bleiben im Snapshot.</p>
      <p class="pointe z-pointe" data-schritt>Schritte und Gefühl zeigen den Zeitpunkt. Die Zahl sagt, wie viele Geschichten ihn erzählen.</p>
      <div class="nur-handout">
        <p>Die Momente, Zitate und Zählungen sind die der fertigen Kaffeebar-Map (<a href="/innolab/methoden/journey-map#beispiel">Experience Map, Beispiel</a>). Auf jeder Karte stehen nur der Name und die Zahl der Geschichten, die den Moment erzählen; welche Zitate dazugehören, steht in der Zähltabelle. „Im Zug“ steht in einer Geschichte und bleibt als erzähltes Ende. Zu „Kaffee nehmen“ und „zum Bahnsteig“ gibt es nur Einzelstimmen (I1-4, I5-5) ohne Gefühl am Schritt; sie werden kein Moment und bleiben im Snapshot. Ein Gefühl, zu dem kein Schritt gehört, ist eine Frage für das nächste Interview: Wann war das?</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="anlauf-c">Anlauf C</h2>
    <p class="folie-satz">Was zeigt Anlauf C – und was fehlt ihm?</p>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <p class="pointe">Ein Moment heißt, wie die Kundschaft ihn erlebt – und gezählt wird, wie viele Geschichten ihn erzählen.</p>
      <div class="gegenueber">
        <p><CircleX size={20} aria-hidden="true" class="icon-nein" /> „Viele entscheiden sich aus Zeitmangel gegen die Kaffeebar.“</p>
        <p><CircleCheck size={20} aria-hidden="true" class="icon-ja" /> <span><strong>{MOMENTNAMEN.a}</strong> <span class="zaehl">{zaehlung('a')}</span></span></p>
      </div>
      <ul class="belegprobe" data-schritt>
        <li class="beleg-zitat">„{ZITATE.get('I2-1')}“ <span class="id">I2-1</span> <em>Zitat aus der Geschichte: zählt</em></li>
        <li class="beleg-notiz">„{NOTIZ_SATZ}“ <em>Notiz: zählt nicht</em></li>
        <li class="beleg-meinung">„{ZITATE.get('I4-2')}“ <span class="id">I4-2</span> <em>Meinung: steht an keiner Stelle der Geschichte</em></li>
      </ul>
      <ul class="gross dicht">
        <li data-schritt>Gezählt werden Geschichten, nicht Zitate: fünf Zitate, drei Geschichten.</li>
        <li data-schritt>Jedes Zitat muss tragen, was auf der Karte steht.</li>
        <li data-schritt>Eure eigene Frage ist kein Beleg.</li>
      </ul>
      <p class="small muted">Muster über Geschichten: {TORRES}, S. 87. Worte der Kundschaft: S. 70 (dort für Chancen). N von M: Format dieses Kurses; die Zitate mit IDs bleiben in der Zähltabelle.</p>
      <div class="nur-handout">
        <p>Eine Zusammenfassung in der dritten Person („Viele …“, „Die Pendler*innen …“) klingt sachlich, ist aber eure Deutung. Auf die Map kommt der Moment so, wie die Person ihn erlebt: als Tätigkeit aus ihrer Sicht, knapp benannt wie bei Torres („Deciding to watch something“, {TORRES}, S. 87), mit der Zahl der Geschichten, die ihn erzählen. Die Worte der Kundschaft verlangt Torres für Chancen (S. 70, 92). Notizen zeigt ihr gestrichelt, zählt sie aber nicht. Eine Meinung („Anstellen ist ein Glücksspiel.“) steht an keiner Stelle der Geschichte. Und was ihr im Interview gefragt habt, belegt nichts: Beleg ist, was die Person geantwortet hat.</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="was-allen-fehlt">Was fehlt allen dreien?</h2>
    <p class="folie-satz">Was fehlt allen drei Anläufen noch?</p>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <KaffeebarMap namen="taetigkeit" />
      {/* Jeder Punkt deckt im Beamer seinen Teil der Map mit auf: data-schritt="x" ↔ data-teil="x" in KaffeebarMap.astro. */}
      <ul class="gross dicht nach-map">
        <li data-schritt="umweg"><CornerDownRight size={20} aria-hidden="true" /> Umweg und Schleife: als Pfeil.</li>
        <li data-schritt="marken">Tief und Ende: markieren – wo tut es am meisten weh, wie geht es aus?</li>
        <li data-schritt="grau">Nicht erzählt: graue Karte – zählt 0, ist eure nächste Interviewfrage.</li>
        <li data-schritt="grenze">Überschneidung: Passt ein Sticky unter zwei Momente? Fragt: Wann in der Geschichte? Sonst überschneiden sie sich – zusammenlegen oder schärfer trennen.</li>
      </ul>
      <p class="small muted">Umweg und Schleife: {TORRES}, S. 56. Ohne Überschneidung: S. 86–87; die Frage „Wann in der Geschichte?“: abgeleitet aus S. 87–88. Marken und graue Karte: Format dieses Kurses – stärkster Moment und Ende prägen, wie ein Erlebnis in Erinnerung bleibt (Peak-End); was fehlt, fragt ihr im nächsten Interview nach.</p>
      <div class="nur-handout">
        <p>Auf der Map steht jeder Moment mit Name und Zählung, wie auf euren Karten; die Zitate mit IDs bleiben in der Zähltabelle. Dazu zeigt die Map, wo jemand umkehrt oder ausweicht – und wie es ausgeht. Warum stärkster Moment und Ende: <a href="/innolab/methoden/journey-map#peak-end">Peak-End</a>. Die Kaffeebar-Map hat ihren Umweg (Automat → Zug), ihre Tiefpunkte und ein erzähltes Ende ({MOMENTNAMEN.d}, {zaehlung('d')}). Erzählt bei euch niemand, wie es ausging, legt ihr eine graue Karte „Ende? – nicht erzählt“ hin: Sie zählt 0, ist aber die nächste Interviewfrage. Die Momente dürfen sich nicht überschneiden, sonst lässt sich an keiner Chance einzeln arbeiten ({TORRES}, S. 86–87). Passt ein Sticky unter zwei Momente, fragt ihr: Wann in der Geschichte passiert das? Gibt es keinen Unterschied, legt ihr die beiden zusammen, sonst trennt ihr sie schärfer.</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="vom-tief-aus">Momente finden: davor, danach</h2>
    <p class="folie-satz">Fangt beim stärksten Moment eurer Skizze an und fragt euch durch die Geschichte.</p>
    <div class="davor-danach" aria-label="Vom stärksten Moment aus: was davor passiert ist, was danach – am Rand, was nicht erzählt wurde">
      <span class="chip grau">nicht erzählt?</span>
      <span class="dd-pfeil" aria-hidden="true">←</span>
      <span class="dd-karte">davor?</span>
      <span class="dd-pfeil" aria-hidden="true">←</span>
      <span class="dd-karte dd-anker">Tief · ID</span>
      <span class="dd-pfeil" aria-hidden="true">→</span>
      <span class="dd-karte">danach?</span>
      <span class="dd-pfeil" aria-hidden="true">→</span>
      <span class="chip grau">nicht erzählt?</span>
    </div>
    <Aufloesung ab={ENDE_TAG_3} gruppe={GRUPPE}>
      <ul class="gross dicht">
        <li data-schritt>Zeitpunkt oder Thema? Ein Thema taucht an mehreren Stellen auf.</li>
        <li data-schritt>Ein Gefühl? Sucht den Augenblick, der es auslöst.</li>
        <li data-schritt>Derselbe Moment heißt: dasselbe Vorhaben, nicht dieselben Worte.</li>
      </ul>
      <p class="small muted">{TORRES}, S. 66, 88, 95; Stickdorn u. a., „This Is Service Design Doing“ (Methodenseite „Mapping Journeys“); Indi Young.</p>
      <div class="nur-handout">
        <p>Die Momente zu finden ist der schwerste Schritt. Fangt nicht mit einer Vorlage an, sondern an einem Anker: dem stärksten Moment eurer Skizze, oft dem Tief. Von dort fragt ihr „Was ist direkt davor passiert? Was danach?“, bis die Geschichte endet (Torres führt im Interview mit denselben Zeitfragen durch die Geschichte, dort vom Anfang aus: „What happened first?“, „What happened next?“, „What happened before that?“, {TORRES}, S. 66; vom wichtigsten Schritt aus nach vorn und hinten: Stickdorn u. a., <a href="https://www.thisisservicedesigndoing.com/methods/mapping-journeys">Methodenseite „Mapping Journeys“</a>). Zum Schluss prüft ihr Anfang, Mitte und Ende: Fehlt ein Teil, legt ihr eine graue Karte „nicht erzählt“ hin – das ist die Frage fürs nächste Interview.</p>
        <p><strong>Zwölf Fragen an eine Karte</strong> – in dieser Reihenfolge:</p>
        <ol>
          <li><strong>Erzählt oder Gewohnheit?</strong> Ist das an einem bestimmten Mal passiert, oder sagt die Person „meistens / immer“? Eine Gewohnheit zeigt ihr; sie stützt einen Moment nur, wenn sie an einer Stelle der Geschichte steht – wie „Meistens ist es der Automat.“ (I4-3) am Umweg zum Automaten. Steht sie an keiner Stelle, ist sie eine Meinung (Torres steuert bei „I usually …“ zurück zum konkreten Fall, {TORRES}, S. 66).</li>
          <li>Wo in der Geschichte taucht das auf? ({TORRES}, S. 88: „Where did this pain point show up in your customer’s story?“)</li>
          <li>Was ist direkt davor passiert? Was danach? ({TORRES}, S. 66)</li>
          <li>Was hat die Person dort getan, entschieden oder bemerkt? (Knoten: „a distinct moment in time, an action, or an event“, {TORRES}, S. 56)</li>
          <li>Hat sich hier geändert, was die Person tut oder vorhat? (Stufengrenze, nach Stickdorn, <a href="https://www.smaply.com/blog/customer-journey-stages">Smaply-Blog</a>)</li>
          <li>Zeitpunkt oder Thema? Ein Thema taucht an mehreren Stellen der Geschichte auf. (abgeleitet aus {TORRES}, S. 88)</li>
          <li>Ein Gefühl: Was ist in dem Augenblick passiert, der es ausgelöst hat? (Torres: ein Gefühl ist ein Wegweiser zur Ursache – bei ihr für Chancen, hier auf Momente übertragen, {TORRES}, S. 95)</li>
          <li>Steht das so in der Geschichte, oder ist es eure Interviewfrage? (Beleg ist, was die Person erzählt hat – nicht, was ihr gefragt habt.)</li>
          <li>Was wollte die Person in diesem Augenblick erreichen – ist das in der anderen Geschichte dasselbe? (Indi Young: zusammen gehört, worauf die Aufmerksamkeit gerichtet ist, nicht dieselben Worte, <a href="https://alistapart.com/article/a-new-way-to-listen">„A New Way to Listen“</a>)</li>
          <li>Gleiche Situation, gleiches Vorhaben: zwei Momente oder einer? (Stickdorn, Smaply-Blog; {TORRES}, S. 86)</li>
          <li>Passt ein Zitat unter zwei Momente? Dann ist es einer – oder ihr trennt schärfer. (abgeleitet aus {TORRES}, S. 86–88)</li>
          <li>Würde die Person den Moment so nennen? ({TORRES}, S. 92: „Can I imagine a customer saying this?“)</li>
        </ol>
        <p><strong>Ist das ein Moment?</strong> An der Kaffeebar:</p>
        <table>
          <thead><tr><th>Karte</th><th>Moment?</th><th>Beispiel</th></tr></thead>
          <tbody>
            <tr><td>Zeitpunkt, erzählt</td><td>ja</td><td>„Halle: entscheiden“ (I2-4, I2-1)</td></tr>
            <tr><td>Ablaufschritt</td><td>nein</td><td>„Kaffee nehmen“: nichts entschieden, nur eine Einzelstimme (I1-4) – bleibt im Snapshot</td></tr>
            <tr><td>Gefühl</td><td>nein</td><td>„Zeitdruck“ – wann? Beim Blick auf die Uhr in der Halle (I2-2)</td></tr>
            <tr><td>Thema</td><td>nein</td><td>„Wartezeit“: liegt in der Halle (I2-1) und beim Anstehen (I3-3) – zwei Momente</td></tr>
            <tr><td>Eure Frage</td><td>nein</td><td>eine Karte im Wortlaut des Leitfadens, etwa „Wie entscheidest du dich?“ (ausgedacht)</td></tr>
            <tr><td>Lösung, Wunsch</td><td>nein</td><td>„Am liebsten wüsste ich einfach, wann er fertig ist.“ (I2-5) – eine Chance unter einem Moment</td></tr>
            <tr><td>Meinung</td><td>nein</td><td>„Anstellen ist ein Glücksspiel.“ (I4-2)</td></tr>
            <tr><td>Zusammenfassung</td><td>nein</td><td>„Viele entscheiden sich aus Zeitmangel gegen die Kaffeebar.“ (Anlauf C)</td></tr>
          </tbody>
        </table>
        <p>Antworten auf allgemeine Fragen enthalten keine Momente. Fehlt die Geschichte, ist das die Frage fürs nächste Interview ({TORRES}, S. 66–67).</p>
        <p>Warum keine feste Vorlage (etwa „vorher – suchen – entscheiden – danach“)? Sie gibt Kästchen vor, die ihr dann füllt – statt die Momente in den Geschichten zu finden. Mit dünnen Interviews ergibt der Weg vom Anker aus weniger Momente und mehr graue Karten; das ist der ehrliche Stand. Weiter lesen: <a href="https://www.nngroup.com/articles/journey-mapping-101/">Nielsen Norman Group, „Journey Mapping 101“</a> (Phasen statt Schritt-für-Schritt-Protokoll).</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="eure-map">So entsteht eure Map – Schritt für Schritt</h2>
    <p class="folie-satz">Euer Versuch von Tag 2, Schritt für Schritt. <Timer minuten={15} /></p>
    <p class="wozu"><strong>Wozu?</strong> Damit oben in eurem Baum drei bis fünf Momente stehen, unter die ihr Chancen hängen könnt.</p>
    <p class="small miro-zeile">Miro, T3 · 0: <MiroLink name="T3 · 0 · So entsteht eure Map - Kaffeebar">Beispiel: Kaffeebar</MiroLink> · <MiroLink name="T3 · 0 · So entsteht eure Map - Sofie">Sofie</MiroLink> · <MiroLink name="T3 · 0 · So entsteht eure Map - Joachim">Joachim</MiroLink> · <MiroLink name="T3 · 0 · So entsteht eure Map - Hewen">Hewen</MiroLink></p>
    <ol class="gross dicht">
      <li><strong>Schritt 1:</strong> eure Snapshot-Skizzen, eine Zeile je Interview.</li>
      <li><strong>Zusammenlegen:</strong> derselbe Moment der Geschichte, nicht dieselben Worte – welche Zitate gehören hierher?</li>
      <li><strong>Zählen:</strong> Geschichten mit Zitat, ‚N von M‘ (M = eure Geschichten, meist eine je Interview) – Notizen zählen nicht.</li>
      <li><strong>Momente:</strong> Name aus Sicht der Kundschaft + ‚N von M‘ – derselbe Name wie die Spalte beim Zählen.</li>
      <li><strong>Map:</strong> drei bis fünf Momente, verbunden; Umweg als Pfeil, <span class="nw">‚Tief · ID‘</span>, <span class="nw">‚Ende · ID‘</span>.</li>
    </ol>
    <div class="nur-handout">
      <p>Auf Miro hat jede*r einen eigenen Frame „T3 · 0 · So entsteht eure Map - euer Name“ mit dem eigenen Material von Tag 2. Markus geht sie mit jeder und jedem durch, je etwa fünf Minuten, an einem Moment: Welche Zitate gehören in diese Spalte, und wie heißt der Moment? Auf die Karte kommen nur der Name und ‚N von M‘. Der Weg ist bei allen derselbe, nur das Material ist ein anderes. Bei drei Geschichten ist M = 3; ein Moment ohne Zitat bekommt eine graue Karte, ‚0 von 3‘.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="in-den-baum">Eure Momente werden Äste</h2>
    <p class="folie-satz">Nehmt eure Momente als oberste Äste in den Baum.</p>
    <p data-schritt class="gross">Vorher ein letzter Blick: Sind zwei davon derselbe Zeitpunkt?</p>
    <p class="small muted">{TORRES}, S. 86–87.</p>
    <p><a href="/innolab/methoden/baum">Weiter: Opportunity Solution Tree</a></p>
    <div class="nur-handout">
      <p>Jede*r für sich: die Momente in der Reihenfolge der Geschichte lesen und bei jedem Paar fragen, ob es ein Zeitpunkt ist oder zwei. Ist es einer, legt ihr sie zusammen oder trennt schärfer. Dann holt ihr die Momente aus eurem Frame T3 · 0 als blaue Karten unter den Outcome eures Baums.</p>
    </div>
  </Folie>

  <FooterNav prev={{ href: '/innolab/tag-3', t: 'Tag 3 · Lösung & Story' }} next={{ href: '/innolab/methoden/baum', t: 'Opportunity Solution Tree' }} />
</Layout>

