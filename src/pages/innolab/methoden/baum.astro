<script>
  // „warum“: gewählte Nummern markieren, sobald die Runde „zwoelf“ aufgedeckt ist (Stand kommt von Antwortrunde.astro).
  import { ANTWORTRUNDE_STAND, type AntwortrundeStand } from '../../../lib/antworten';
  import { ZWOELF_PAARE, gewaehltMarkieren, gewaehltSchluessel, gewaehltZaehlen } from '../../../lib/gewaehlt';
  let zuletzt: string | null = null;
  document.addEventListener(ANTWORTRUNDE_STAND, (e) => {
    const d = (e as CustomEvent<AntwortrundeStand>).detail;
    if (d?.runde !== 'zwoelf') return;
    const z = gewaehltZaehlen(d.frei ? d.texte : [], ZWOELF_PAARE);
    const k = gewaehltSchluessel(z);
    if (k === zuletzt) return;
    zuletzt = k;
    gewaehltMarkieren(document, 'zwoelf', z);
  });
</script>
