---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import MethodenKarte from '../../../components/MethodenKarte.astro';
import ClaudePruefung from '../../../components/ClaudePruefung.astro';
import Prompt from '../../../components/Prompt.astro';
import Bearbeiten from '../../../components/Bearbeiten.astro';
import { abText } from '../../../components/aufloesung';
import { MOM_TEST_GRUPPE, NACH_MOM_TEST } from '../../../components/innolab-zeiten';
import Callout from '../../../components/Callout.astro';
import FooterNav from '../../../components/FooterNav.astro';
import MiroFrame from '../../../components/MiroFrame.astro';
import Folie from '../../../components/Folie.astro';
import Timer from '../../../components/Timer.astro';
import Fluss from '../../../components/Fluss.astro';
import Aufloesung from '../../../components/Aufloesung.astro';
import Matrix2x2 from '../../../components/bild/Matrix2x2.astro';
import Skala from '../../../components/bild/Skala.astro';
import { Flag, MapPin, Sparkles } from '@lucide/astro';
// Hinweise an den gesperrten Teilen: wann sie aufgehen und was ein Klick öffnet. Jede Übung hat ihre eigene Gruppe
// (mom-test-…): Markus deckt eine auf, alle sehen nur diese – die Pointen späterer Übungen bleiben zu. Die letzte („ausgraben“)
// ist in MOM_TEST_GRUPPE, zusammen mit Editor und Vorlage, Probe-Prompt und Prüfliste (nur im Handout) und dem Leitfaden der
// Mappe: Mit ihr geht das Material für den Leitfaden-Block auf. Ein Klick der Studierenden öffnet nur den einen Teil.
const AB = abText(NACH_MOM_TEST);
const OEFFNET = `Öffnet sich, sobald Markus es aufdeckt, spätestens ${AB}. Sagt Markus es, öffnet ein Klick auf den Knopf diesen Teil.`;

// Auflösungen und Leitfaden-Editor: offen, sobald Markus aufdeckt, spätestens ab NACH_MOM_TEST (Ende des Kurstags).
---
<Layout title="Jobs to be Done & Mom Test">
  <span class="eyebrow">Innolab · Tag 1 · Methode</span>
  <h1>Jobs to be Done & Mom Test</h1>
  <p class="lead">Interviews, die herausfinden, was Menschen wirklich tun – statt höflich zu bestätigen, was ihr hören wollt.</p>
  <Orientierung seite="innolab/methoden/interview" leiste={false} />
  <MethodenKarte slug="interview" />

  <Folie>
    <h2 id="jtbd">Jobs to be Done</h2>
    <p class="folie-satz">Menschen kaufen keine Produkte – sie heuern sie für einen Job an.</p>
    <Fluss label="Ein Job in einem Satz: Wenn, will ich, damit – am Beispiel der Pendlerin an der Kaffeebar" hervor={[1]} knoten={[
      { t: 'Wenn …', sub: 'ich um 7:30 am Bahnhof ankomme,', icon: MapPin },
      { t: 'will ich …', sub: 'einen Kaffee in der Hand haben, bevor der Zug kommt,', icon: Flag },
      { t: 'damit …', sub: 'ich die Fahrt zum Aufwachen nutzen kann.', icon: Sparkles },
    ]} />
    <p class="small muted">Konkurrenz für diesen Job: andere Cafés, der Automat, der Thermobecher, der Schlaf im Zug.</p>
    <p class="nur-handout">Die Form: <strong>Wenn</strong> [Situation], <strong>will ich</strong> [Ziel], <strong>damit</strong> [was sich dadurch ändert]. Die Pendlerin an der Kaffeebar will nicht „einen Kaffee“. Sie will wach und halbwegs gut gelaunt in Wien ankommen, ohne ihren Zug zu riskieren. Jobs findet ihr nicht, indem ihr danach fragt. Ihr findet sie in Geschichten über das, was Menschen zuletzt getan haben. Dafür gibt es den Mom Test.</p>
  </Folie>

  <Folie>
    <h2 id="mom-test">Der Mom Test</h2>
    <p class="folie-satz">Schreibt drei Fragen an eure Zielgruppe.</p>
    <p>Allein, eine Frage pro Sticky. <Timer minuten={5} /></p>
    <p data-schritt><strong>Dann reihum:</strong> Sagt in einem Satz, wer eure Zielgruppe ist, und stellt eure Fragen der Person rechts von euch. Sie antwortet als jemand aus dieser Zielgruppe – höflich und ehrlich, so wie im echten Leben.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-auftakt" fuer="alle" hinweis={`Erst eure Fragen schreiben. ${OEFFNET}`} knopf="Auflösung zeigen (nach der Übung)">
      <p class="folie-satz">Auf „Würdest du …?“ sagen alle Ja – selbst eure Mutter.</p>
      <ol class="gross">
        <li data-schritt><strong>Redet über ihr Leben, nicht über eure Idee.</strong> Sobald ihr die Idee erzählt, wird das Gespräch höflich.</li>
        <li data-schritt><strong>Fragt nach dem letzten konkreten Mal.</strong> Was jemand letzten Dienstag getan hat, ist eine Tatsache.</li>
        <li data-schritt><strong>Redet weniger, hört mehr.</strong> Je mehr ihr redet, desto weniger erfahrt ihr.</li>
      </ol>
      <p class="small muted">Nach Rob Fitzpatrick, „The Mom Test“ (2013).</p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="fragen-matrix">Wo liegen eure Fragen?</h2>
    <p class="folie-satz">Prüft eure drei Fragen an zwei Achsen.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-matrix" fuer="alle" hinweis={OEFFNET} knopf="Matrix zeigen (nach der Übung)">
      <Matrix2x2 label="Mom Test als Matrix: nach oben über ihr Leben statt über eure Idee, nach rechts Vergangenheit statt Zukunft"
        y={{ label: 'Thema', unten: 'eure Idee', oben: 'ihr Leben' }}
        x={{ label: 'Zeit', links: 'Zukunft', rechts: 'Vergangenheit' }}
        felder={['', 'Hier fragen', 'Höfliches Ja', '']} hervor="or"
        punkte={[
          { t: 'Würdest du eine App zum Vorbestellen nutzen?', x: .12, y: .3 },
          { t: 'Erzähl mir vom letzten Morgen am Bahnhof.', x: .88, y: .7, hervor: true },
        ]} />
      <p class="nur-handout">Rechts oben liegen Fragen nach dem, was jemand zuletzt getan hat (Regeln 1 und 2). Links unten bekommt ihr Höflichkeit statt Tatsachen. Eigene Darstellung nach den Regeln von Rob Fitzpatrick.</p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="statt-besser">Eure Fragen umschreiben</h2>
    <p class="folie-satz">Jetzt macht ihr eure drei Fragen besser.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-umschreiben" fuer="alle" hinweis={OEFFNET} knopf="Beispiele zeigen (nach der Übung)">
      <div style="overflow-x:auto">
        <table>
          <thead><tr><th>Statt: Zukunft</th><th>Besser: Vergangenheit</th></tr></thead>
          <tbody>
            <tr data-schritt><td>Würdest du Kaffee vorbestellen, wenn es eine App gäbe?</td><td>Erzähl mir vom letzten Morgen, an dem du am Bahnhof Kaffee wolltest.</td></tr>
            <tr data-schritt><td>Wie viel würdest du dafür zahlen?</td><td>Was hast du diese Woche für Kaffee unterwegs ausgegeben?</td></tr>
            <tr data-schritt><td>Findest du die Schlange nervig?</td><td>Was hast du gemacht, als die Schlange zu lang war?</td></tr>
            <tr data-schritt><td>Wäre es nicht praktisch, wenn …?</td><td>Hast du schon mal etwas ausprobiert, um das zu umgehen? Was war das?</td></tr>
          </tbody>
        </table>
      </div>
      <p class="nur-handout">Vorsicht bei Komplimenten („Coole Idee!“), Allgemeinplätzen („Ich trinke normalerweise …“) und Zukunftsversprechen („Das würde ich sicher nutzen“). Holt sie zurück in die Vergangenheit: „Wann war das zuletzt?“</p>
      <p data-schritt><strong>Und jetzt eure drei Fragen:</strong> Welche würde Markus wieder mit „Ja, total!“ beantworten? Umschreiben. <Timer minuten={5} /></p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="antworten">Welche Antwort zählt?</h2>
    <p class="folie-satz">Sortiert die vier Antworten von schwach nach stark.</p>
    <p>Bestellt vor und zahlt im Voraus. · „Coole Idee!“ · „Letzte Woche zweimal den Zug verpasst.“ · „Würde ich sicher nutzen.“ <Timer minuten={2} /></p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-antworten" fuer="alle" hinweis={OEFFNET} knopf="Skala zeigen (nach der Übung)">
      <Skala label="Antworten von sagen bis tun: Kompliment, Zukunftsversprechen, erzählte Vergangenheit, Commitment" links="sagen" rechts="tun"
        stufen={[
          { t: 'Kompliment', sub: 'lobt die Idee' },
          { t: 'Zukunft', sub: 'verspricht etwas' },
          { t: 'Vergangenheit', sub: 'erzählt, was war' },
          { t: 'Commitment', sub: 'gibt Zeit, Geld oder Ruf' },
        ]}
        punkte={[
          { t: '„Coole Idee!“', stufe: 0, schritt: true },
          { t: '„Würde ich sicher nutzen.“', stufe: 1, schritt: true },
          { t: '„Letzte Woche zweimal den Zug verpasst.“', stufe: 2, schritt: true },
          { t: 'Bestellt vor und zahlt im Voraus.', stufe: 3, schritt: true },
        ]} />
      <p class="nur-handout">Komplimente und Zukunftsversprechen kosten nichts und beweisen nichts. Erzählte Vergangenheit ist eine Tatsache – das ist, was eure Interviews liefern sollen. Am stärksten ist Commitment: Jemand gibt etwas her, Zeit, Geld oder seinen Namen. Das seht ihr erst in Experimenten. Nach Rob Fitzpatrick, „The Mom Test“ (2013), und Christian Rohrer, <a href="https://www.nngroup.com/articles/which-ux-research-methods/">„When to Use Which User-Experience Research Methods“</a> (Nielsen Norman Group): was Menschen sagen und was sie tun.</p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="warum-geschichten">Warum Meinungsfragen täuschen</h2>
    <p class="folie-satz">Menschen beschreiben ihr ideales Ich – nicht, was sie tun.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-geschichten" fuer="alle" hinweis={OEFFNET} knopf="Zeigen (nach der Übung)">
      <div class="gegenueber">
        <div data-schritt><p><strong>„Worauf achtest du beim Jeanskauf?“</strong><br />„Die Passform ist das Wichtigste.“</p></div>
        <div data-schritt><p><strong>„Erzähl vom letzten Jeanskauf.“</strong><br />„Auf Amazon. Ob sie passt, wusste ich nicht – aber die Marke mag ich, und sie war im Angebot.“</p></div>
      </div>
      <div class="nur-handout">
        <p>Teresa Torres stellt diese zwei Fragen in jedem Workshop, und immer klafft eine Lücke zwischen der ersten und der zweiten Antwort. Niemand lügt: Wir verstehen unser eigenes Verhalten schlecht. Wir überschätzen, wie oft wir Sport machen, und halten uns für überdurchschnittliche Autofahrer*innen (Teresa Torres, „Continuous Discovery Habits“ (2021), S. 60–61).</p>
        <p>Dahinter steckt, was der Neuropsychologe Michael Gazzaniga den „Interpreter“ im Gehirn nennt: Fehlt uns der wahre Grund für eine Handlung, erfinden wir eine stimmige Erklärung und glauben sie selbst. Daniel Kahneman: Selbstsicherheit zeigt nur, dass sich jemand eine stimmige Geschichte gebaut hat – nicht, dass sie wahr ist (S. 61–62).</p>
        <p>Torres hat das teuer gelernt. Alle Recruiter*innen, die sie befragte, wollten „passive Kandidat*innen“ gewinnen – Menschen, die gerade nicht suchen. Ihr Team baute genau dafür ein Produkt, und es floppte: Gemessen wurden die Recruiter*innen daran, wie schnell sie Stellen besetzen, und das geht mit aktiv Suchenden schneller. Sie hatte gefragt, was die Leute <em>wollen</em>, nicht, was sie <em>tun</em> (S. 63).</p>
      </div>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="forschungsfrage">Was ihr wissen wollt ≠ was ihr fragt</h2>
    <p class="folie-satz">Die Forschungsfrage stellt ihr nie – ihr fragt nach einer Geschichte.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe="mom-test-forschungsfrage" fuer="alle" hinweis={OEFFNET} knopf="Zeigen (nach der Übung)">
      <div style="overflow-x:auto">
        <table>
          <thead><tr><th></th><th>Forschungsfrage: was ihr lernen wollt</th><th>Interviewfrage: was ihr fragt</th></tr></thead>
          <tbody>
            <tr data-schritt><th>Kaffeebar</th><td>Wann und wo entscheiden Pendler*innen, ob sie Kaffee holen? (aus A1)</td><td>„Erzähl mir von deinem letzten Morgen am Bahnhof.“</td></tr>
            <tr data-schritt><th>enger</th><td>Was passiert, wenn die Schlange zu lang ist?</td><td>„Erzähl vom letzten Mal, als du an der Kaffeebar angestanden bist.“</td></tr>
            <tr data-schritt><th>weiter</th><td>Wie werden Pendler*innen morgens wach?</td><td>„Erzähl mir von deinem gestrigen Morgen, vom Aufstehen bis ins Büro.“</td></tr>
          </tbody>
        </table>
      </div>
      <p class="nur-handout">Teresa Torres trennt, was ihr lernen wollt (Forschungsfragen), von dem, was ihr im Gespräch fragt (Interviewfragen). Direkte Fragen nach dem eigenen Verhalten liefern das ideale Ich; eine konkrete Erinnerung an das letzte Mal ist verlässlicher. Ein bis zwei Geschichten-Fragen ersetzen einen langen Fragebogen. Wie eng ihr fragt, hängt davon ab, was ihr gerade lernen wollt: Eng hilft, ein bestehendes Angebot zu verbessern; weit zeigt, womit es eigentlich konkurriert (Teresa Torres, „Continuous Discovery Habits“ (2021), S. 64–65). Eure Forschungsfrage kommt aus der riskantesten Annahme der Annahmen-Map.</p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="ausgraben">Die Geschichte ausgraben</h2>
    <p class="folie-satz">Die erste Antwort ist ein Satz – die Geschichte müsst ihr ausgraben.</p>
    <Aufloesung ab={NACH_MOM_TEST} gruppe={MOM_TEST_GRUPPE} fuer="alle" hinweis={OEFFNET} knopf="Zeigen (nach der Übung)">
      <ul class="gross">
        <li data-schritt><strong>Ankündigen:</strong> „Erzähl mit allen Details – ich frage am Ende nach.“</li>
        <li data-schritt><strong>Zeit:</strong> „Wo warst du? Was ist als Erstes passiert? Und dann?“</li>
        <li data-schritt><strong>Personen und Hürden:</strong> „Wer war dabei? Was war schwierig? Wie bist du damit umgegangen?“</li>
        <li data-schritt><strong>Zurück zum Fall:</strong> Auf „Normalerweise …“ folgt „Und an diesem Morgen?“</li>
      </ul>
      <p class="nur-handout">Auf „Erzähl vom letzten Mal“ kommt meist ein Satz: „Gestern nach dem Essen hab ich eine Serie geschaut.“ Im Gespräch erwarten wir ein Hin und Her zu gleichen Teilen; das müsst ihr am Anfang aufheben. Dann helfen die Bausteine jeder Geschichte: eine Hauptfigur, ein Ablauf in der Zeit, ein Ort, Hindernisse und Helfer. Rutscht die Person ins Allgemeine („Meistens …“), holt sie freundlich zurück. Und nicht jede Person hat die Geschichte, die ihr sucht – nehmt, was sie erzählen will (Teresa Torres, „Continuous Discovery Habits“ (2021), S. 65–67).</p>
    </Aufloesung>
  </Folie>

  <Folie>
    <h2 id="vorgehen">So geht ihr vor (90 min)</h2>
    <p class="folie-satz">Erst schreiben, dann proben – mit Claude und mit Markus.</p>
    <MiroFrame name="T1 · 4 · Interviewleitfaden" />
    <ol class="gross dicht">
      <li data-schritt><strong>Leitfaden allein schreiben:</strong> Ziel ist die Forschungsfrage aus eurer riskantesten Annahme. Dann 5–7 Fragen, die meisten nach dem letzten konkreten Mal, jede gegen die drei Regeln halten, in der Werkstatt speichern – „Bearbeiten“ unter <a href="#vorlage">In der Werkstatt speichern</a>, auf euren Laptops. <Timer minuten={20} /></li>
      <li data-schritt><strong>Prüfliste und Claude</strong> unter <a href="#pruefen">Prüfen</a>. <Timer minuten={10} /></li>
      <li data-schritt><strong>Probe mit Claude:</strong> Prompt unter <a href="#probe">Probe mit Claude</a>. Claude spielt eine zurückhaltende Person aus eurer Zielgruppe, danach Feedback. <Timer minuten={15} /></li>
      <li data-schritt><strong>Live-Interview, reihum 3 × 15 min:</strong> Markus spielt eine schwierige Person, 10 min Interview, 5 min Feedback. Die anderen beobachten: Wo wurde gepitcht, wo fehlte eine Nachfrage? Was ihr lernt, kommt danach in den Leitfaden. <Timer minuten={15} /></li>
    </ol>
  </Folie>

  <div class="nur-handout">
  <h2 id="vorlage">In der Werkstatt speichern</h2>
  <Aufloesung ab={NACH_MOM_TEST} gruppe={MOM_TEST_GRUPPE} fuer="alle" hinweis={`Editor und Vorlage enthalten die Lösung des Mom Test – öffnet sie erst danach. ${OEFFNET}`} knopf="Editor und Vorlage öffnen">
  <p>Jede*r speichert den eigenen Leitfaden in der Werkstatt: Ziel, Zielgruppe, Einstieg, Kern- und Nachfragen, Abschluss. Die Vorlage darunter zeigt, wie ein Leitfaden nach dem Mom Test aussieht. Übertragt nur, was zu eurem Produkt passt.</p>
  <Bearbeiten artefakt="leitfaden" />
  <Prompt label="Vorlage · Interviewleitfaden"># Interviewleitfaden — [Produkt]

Ziel: [Forschungsfrage aus eurer riskantesten Annahme – was wollt ihr herausfinden?]
Wen: [Zielgruppe aus Abschnitt 1, wie ihr sie findet]

## Einstieg
„Danke, dass du dir Zeit nimmst. Ich will verstehen, wie du [Situation] heute erlebst – es gibt keine falschen Antworten. Darf ich das Gespräch aufnehmen? Die Aufnahme bleibt bei mir, aufgeschrieben wird nur, was ohne deinen Namen auskommt.“

## Kernfragen
1. Erzähl mir vom letzten Mal, als du [Situation].
2. Was hast du da genau gemacht? Was ist dann passiert?
3. Was war daran mühsam?
4. Was hast du schon ausprobiert, um das zu umgehen? Was hat es dich gekostet (Zeit, Geld, Nerven)?
5. [eigene Frage]

## Nachfragen
- Warum?
- Wann war das zuletzt?
- Und davor?
- Kannst du mir das zeigen?

## Abschluss
„Wen sollte ich noch fragen?“</Prompt>
  </Aufloesung>

  <Callout type="warn" title="Einwilligung und Anonymisierung">
    <p>Nehmt nur mit Einwilligung auf. Die Aufnahme und eure Notizen bleiben bei euch und kommen nie ins App-Repo, das ist öffentlich. Jedes Interview bekommt ein Pseudonym, I1 bis I5; das sind später die Zitat-IDs. In den Notizen stehen keine Namen, Arbeitgeber oder andere Angaben, an denen man die Person erkennt. Bevor ihr Notizen Claude gebt, müssen sie so bereinigt sein.</p>
    <p>Vor dem Gespräch zeigt ihr den <a href="/innolab/werkstatt/interview-datenschutz">Datenschutzhinweis für Interviewte</a> am Handy oder ausgedruckt: Aufnahme nur mit Einwilligung, Pseudonym, private Mappe, Auswertung mit KI, Widerruf.</p>
  </Callout>

  <h2 id="probe">Probe mit Claude</h2>
  <Aufloesung ab={NACH_MOM_TEST} gruppe={MOM_TEST_GRUPPE} fuer="alle" hinweis={`Der Prompt verrät die Regeln des Mom Test – öffnet ihn erst danach. ${OEFFNET}`} knopf="Prompt öffnen">
  <p>Am besten in Claude Chat (dort geht auch der Sprachmodus), sonst in Claude Code:</p>
  <Prompt label="Probe-Interview · Claude Chat oder Claude Code">Spiel eine Person aus dieser Zielgruppe: [Abschnitt 1 aus eurem Brief]. Erfinde dir ein realistisches Leben mit Gewohnheiten, die nicht zu meiner Idee passen müssen. Sei zurückhaltend: Antworte kurz, bleib allgemein, wenn ich allgemein frage, und erzähl Konkretes nur, wenn ich nach dem letzten konkreten Mal frage. Frag ich nach der Zukunft oder stelle ich eine Idee vor, sei höflich und unverbindlich. Ich beginne das Interview, du wartest auf meine erste Frage. Wenn ich „Ende“ schreibe, gib mir Feedback nach dem Mom Test: Wo habe ich gepitcht, wo nach der Zukunft gefragt, wo eine Nachfrage verpasst? Höchstens drei Punkte, mit Zitat, sonst nichts – kein Lob, keine weiteren Tipps. Schlag als bessere Frage nur Fragen nach dem letzten konkreten Mal vor, keine nach Häufigkeiten („Wie oft …?“).</Prompt>
  <p>Die Probe ersetzt kein echtes Interview. Claude erfindet eine plausible Person – eure Zielgruppe kennt es nicht.</p>
  </Aufloesung>

  <h2 id="pruefen">Prüfen</h2>
  <Aufloesung ab={NACH_MOM_TEST} gruppe={MOM_TEST_GRUPPE} fuer="alle" hinweis={`Die Prüfliste verrät die Regeln des Mom Test – öffnet sie erst danach. ${OEFFNET}`} knopf="Prüfliste öffnen">
    <ClaudePruefung slug="interview" />
  </Aufloesung>

  </div>

  <Folie>
    <h2 id="uebertrag">Übertrag auf euer Produkt</h2>
    <p class="folie-satz">Was ist bei euch „der letzte Morgen am Bahnhof“?</p>
    <p>Die konkrete Situation, nach der ihr fragt. Fällt euch keine ein, ist eure Zielgruppe noch zu allgemein – zurück zum <a href="/innolab/methoden/problem-rahmen">Problem-Rahmen</a>.</p>
  </Folie>

  <FooterNav prev={{ href: '/innolab/methoden/annahmen', t: 'Annahmen-Map' }} next={{ href: '/innolab/tag-1/abschluss', t: 'Tag 1 · Abschluss' }} />
</Layout>
