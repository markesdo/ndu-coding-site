---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import MethodenKarte from '../../../components/MethodenKarte.astro';
import ClaudePruefung from '../../../components/ClaudePruefung.astro';
import Bearbeiten from '../../../components/Bearbeiten.astro';
import Callout from '../../../components/Callout.astro';
import FooterNav from '../../../components/FooterNav.astro';
import Folie from '../../../components/Folie.astro';
import Timer from '../../../components/Timer.astro';
import Fluss from '../../../components/Fluss.astro';
import Baum from '../../../components/bild/Baum.astro';
import BuchAbbildung from '../../../components/bild/BuchAbbildung.astro';
import MiroFrame from '../../../components/MiroFrame.astro';
import { CircleAlert, Footprints, Hammer, Target, TrendingUp, Users } from '@lucide/astro';
import { KAFFEEBAR_BAUM } from '../../../components/innolab-beispiel';

// Ein Problem ohne Lösung lässt mehrere Lösungen zu (Fehler 1): Wurzel und erste Chance aus dem roten Faden (tag-1.astro),
// die Lösungen ohne ihre Tests.
const chance = KAFFEEBAR_BAUM.kinder![0]!;
const loesungsraum = { t: KAFFEEBAR_BAUM.t, kinder: [{ t: chance.t, kinder: chance.kinder!.map((l) => ({ t: l.t })) }] };
---
<Layout title="Problem-Rahmen & Produkt-Brief">
  <span class="eyebrow">Innolab · Tag 1 · Methode</span>
  <h1>Problem-Rahmen & Produkt-Brief</h1>
  <p class="lead">Für wen arbeitet ihr, was läuft heute schief – und woran merkt ihr, dass es besser geworden ist?</p>
  <Orientierung seite="innolab/methoden/problem-rahmen" leiste={false} />
  <MethodenKarte slug="problem-rahmen" />

  <Folie>
    <h2 id="worum">Worum es geht</h2>
    <p class="folie-satz">Erst der Rahmen, dann die Lösung.</p>
    <Fluss label="Problem-Rahmen in drei Fragen: für wen, welches Problem, woran ihr es merkt" hervor={[2]} knoten={[
      { t: 'Für wen?', sub: 'eine konkrete Person in einer konkreten Situation', icon: Users },
      { t: 'Welches Problem?', sub: 'was heute schiefgeht – ohne Lösung', icon: CircleAlert },
      { t: 'Woran merkt ihr es?', sub: 'das Outcome: was Menschen danach anders tun', icon: Target },
    ]} />
    <p>Dazu zwei Fragen, die den Rahmen schärfen: <strong>Wie wird das Problem heute gelöst?</strong> Und <strong>was macht euer Produkt bewusst nicht?</strong></p>
    <div class="nur-handout">
      <p>Das Outcome ist die Wurzel des Opportunity Solution Tree, an der alle weiteren Methoden hängen. Der Brief hat dieselben Abschnitte wie im Coding-Kurs. Neu ist der Blick darauf, und ihr speichert ihn in der Werkstatt. Alles darin ist eine <strong>Annahme</strong>, bis Interviews und Tests sie stützen. Deshalb bleibt Abschnitt 3 („das Produkt in einem Satz“) heute offen, und Abschnitt 5 (MVP) kommt erst an Tag 3 aus der Story Map. Wer heute schon die Lösung festschreibt, hört in den Interviews nur noch, was dazu passt.</p>
      <Callout type="info" title="Ihr habt schon ein Produkt?">
        <p>Dann übertragt ihr euren Brief aus dem Coding-Kurs in die Werkstatt, statt neu anzufangen, und schärft dabei die Abschnitte 1, 2, 4 und 6. Was ihr dabei ändert, kommt als Zeile ins <a href="/innolab/methoden/entscheidungslog">Entscheidungslog</a>.</p>
      </Callout>
    </div>
  </Folie>

  <Folie>
    <h2 id="fehler-1">Fehler 1: Die Lösung steckt im Problem</h2>
    <p class="folie-satz">Ein Problem ohne Lösung lässt Platz für bessere Ideen.</p>
    <p class="small muted">Eine (erfundene) Kaffeebar in der Halle des Hauptbahnhofs St. Pölten: Morgens ist sie voll, die Inhaberin hat das Gefühl, Kundschaft zu verlieren.</p>
    <div class="gegenueber">
      <Callout type="warn" title="Schwach – was ist daran schwach?"><p>„Pendler*innen brauchen eine App zum Vorbestellen.“</p></Callout>
      <div data-schritt><Callout type="tip" title="Stark"><p>„Die Schlange ist morgens länger als die Zeit bis zur Abfahrt. Wer den Zug erreichen will, verzichtet auf Kaffee oder nimmt den Automaten.“</p></Callout></div>
    </div>
  </Folie>

  <Folie>
    <h2 id="loesungsraum">Ein Problem, mehrere Lösungen</h2>
    <p class="folie-satz">Die starke Fassung lässt drei Lösungen zu – die schwache nur eine.</p>
    <Baum knoten={loesungsraum} label="Ein Problem, drei mögliche Lösungen: App, Express-Theke, Kaffeewagen" />
    <p class="nur-handout">Die schwache Fassung lässt nur eine Lösung zu, die App. Die starke beschreibt das Problem und lässt Platz für drei – und für bessere, die erst in den Interviews auftauchen. Alle drei Lösungen hängen aber noch an derselben Sicht auf das Problem: Die Schlange ist zu lang. Die nächste Folie fragt, ob es ein besseres Problem gibt.</p>
  </Folie>

  <Folie>
    <h2 id="reframing">Gibt es ein besseres Problem?</h2>
    <p class="folie-satz">Wer das Problem neu rahmt, findet Lösungen, an die vorher niemand dachte.</p>
    <BuchAbbildung src="/quellen/hbr/reframing.png" alt="Oben: Problem „Der Aufzug ist zu langsam“ führt zu Lösungen, die ihn schneller machen – neuer Aufzug, stärkerer Motor, besserer Algorithmus. Darunter, neu gerahmt: „Das Warten nervt“ führt zu „das Warten soll sich kürzer anfühlen“ – Spiegel, Musik, Desinfektionsspender" quelle="Thomas Wedell-Wedellsborg, „Are You Solving the Right Problems?“, Harvard Business Review, Jan.–Feb. 2017, S. 2." />
    <p data-schritt><strong>Kaffeebar:</strong> „Die Schlange ist zu lang“ → Express-Theke, App, Kaffeewagen. Neu gerahmt: „Geht sich ein Kaffee bis zur Abfahrt aus?“ → eine Anzeige der Wartezeit an der Tür.</p>
    <div class="nur-handout">
      <p>Die Mieter*innen eines Bürohauses beschweren sich über den langsamen Aufzug. Fast alle denken sofort an Lösungen, die ihn schneller machen. Die Hausverwaltung hängt Spiegel neben den Aufzug – die Beschwerden hören auf, weil die Wartenden sich selbst ansehen. Der Spiegel löst nicht das gestellte Problem, sondern ein anderes, besseres. Wedell-Wedellsborg betont: Die erste Sicht ist nicht falsch. Es geht nicht darum, das „echte“ Problem zu finden, sondern zu prüfen, ob es ein besseres gibt.</p>
      <p>Warum das zählt: In seiner Umfrage unter Führungskräften aus 91 Organisationen in 17 Ländern sagten 85 %, ihre Organisation sei schlecht darin, Probleme zu erkennen, und 87 %, das koste viel. Ein zweites Beispiel aus dem Artikel: Tierheime werben seit Jahrzehnten um mehr Adoptionen. Lori Weise rahmte das Problem neu: Etwa 30 % der Hunde werden von ihren Besitzer*innen abgegeben, oft aus Geldnot. Ihr Programm hilft diesen Familien, ihre Hunde zu behalten – die Hunde kommen gar nicht erst ins Heim.</p>
      <p>Aus den sieben Praktiken des Artikels nutzen wir drei. <strong>Schreibt das Problem in ganzen Sätzen auf</strong> – erst dann merkt man, dass alle Verschiedenes meinen. <strong>Sucht positive Ausnahmen:</strong> Wer erwischt den Zug doch mit Kaffee, und was ist bei ihr anders? <strong>Stellt das Ziel infrage:</strong> Geht es um Kaffee – oder darum, wach im Büro anzukommen?</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="fehler-2">Fehler 2: Der Outcome zählt Output</h2>
    <p class="folie-satz">Gemessen wird, was Menschen tun – nicht, was ihr baut.</p>
    <div class="gegenueber">
      <Callout type="warn" title="Schwach – was ist daran schwach?"><p>„Die App hat 500 Downloads.“</p></Callout>
      <div data-schritt><Callout type="tip" title="Stark"><p>„Wir glauben, dass Pendler*innen morgens Kaffee bekommen, ohne ihren Zug zu riskieren. Wir merken es, wenn mehr von ihnen mit Kaffee in den Zug steigen.“</p></Callout></div>
    </div>
    <div data-schritt>
      <Fluss label="Wo schwach und stark liegen: Downloads sind Output, Kaffee im Zug ist Outcome" hervor={[1]} knoten={[
        { t: 'Output', sub: '500 Downloads', icon: Hammer },
        { t: 'Outcome', sub: 'mehr steigen mit Kaffee in den Zug', icon: Footprints },
        { t: 'Impact', sub: 'mehr Umsatz am Morgen', icon: TrendingUp },
      ]} />
    </div>
    <div class="nur-handout">
      <p>500 Downloads sagen nichts darüber, ob jemand seinen Zug erwischt. Das Outcome ist ein <strong>Product Outcome</strong>: was Menschen mit eurem Produkt anders tun (Teresa Torres, „Continuous Discovery Habits“, 2021, S. 40). Wie viele es in einem Test sein müssen – etwa „4 von 5 Testpersonen“ –, legt ihr erst auf der <a href="/innolab/methoden/experiment">Experiment-Karte</a> fest. Für ein neues Outcome wisst ihr noch nicht, was es bewegt. Torres rät deshalb, mit einem <strong>Lernziel</strong> zu beginnen („herausfinden, was Pendler*innen vom Kaffee abhält“) und die Zielzahl erst zu setzen, wenn ihr mehr wisst (S. 44).</p>
      <p>Der ganze Rahmen der Kaffeebar, schwach und stark:</p>
      <div style="overflow-x:auto">
        <table>
          <thead><tr><th></th><th>Schwach</th><th>Stark</th></tr></thead>
          <tbody>
            <tr><th>Für wen?</th><td>Kaffeetrinker*innen</td><td>Pendler*innen, die werktags zwischen 7:15 und 7:45 auf den Zug nach Wien warten</td></tr>
            <tr><th>Problem</th><td>Pendler*innen brauchen eine App zum Vorbestellen.</td><td>Die Schlange ist morgens länger als die Zeit bis zur Abfahrt. Wer den Zug erreichen will, verzichtet auf Kaffee oder nimmt den Automaten.</td></tr>
            <tr><th>Heute gelöst durch</th><td>–</td><td>Automat, Thermobecher von zu Hause, ganz verzichten, einen Zug später nehmen</td></tr>
            <tr><th>Macht es NICHT</th><td>Alles, was mit Kaffee zu tun hat</td><td>Keine Lieferung an den Bahnsteig · kein Mittagsgeschäft · keine anderen Bahnhöfe</td></tr>
            <tr><th>Outcome</th><td>Die App hat 500 Downloads.</td><td>Wir glauben, dass Pendler*innen morgens Kaffee bekommen, ohne ihren Zug zu riskieren. Wir merken es, wenn mehr von ihnen mit Kaffee in den Zug steigen.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </Folie>

  <Folie>
    <h2 id="vorgehen">So geht ihr vor (60 min)</h2>
    <p class="folie-satz">Erst allein, dann zu dritt, dann festhalten und prüfen.</p>
    <MiroFrame name="T1 · 2 · Problem-Rahmen & Produkt-Brief" />
    <ol class="gross dicht">
      <li data-schritt><strong>Allein, ein Sticky pro Feld:</strong> Für wen? Welches Problem? Wie wird es heute gelöst? Was macht es nicht (drei Dinge)? Keine Lösung, kein Produktname. <Timer minuten={15} /></li>
      <li data-schritt><strong>Outcome:</strong> „Wir glauben, dass … Wir merken es, wenn …“ – etwas, das Menschen anders tun und das ihr schon an wenigen Personen beobachten könnt. Keine Funktion, noch keine Zielzahl. <Timer minuten={10} /></li>
      <li data-schritt><strong>Dreierrunde:</strong> Jede*r liest vor. Die anderen fragen nur: „Woran würdest du das merken?“, „Ist das schon eine Lösung?“ und „Gibt es ein besseres Problem – wer hat es nicht, und warum?“ <Timer minuten={15} /></li>
      <li data-schritt><strong>Festhalten</strong> in der Werkstatt: „Bearbeiten“ unter <a href="#werkstatt">In der Werkstatt speichern</a>. <Timer minuten={10} /></li>
      <li data-schritt><strong>Prüfen:</strong> erst die Prüfliste selbst, dann Claude – beides unter <a href="#pruefen">Prüfen</a>. <Timer minuten={10} /></li>
    </ol>
  </Folie>

  <div class="nur-handout">
  <h2 id="werkstatt">In der Werkstatt speichern</h2>
  <p>Jede*r speichert den eigenen Brief in der Werkstatt. Der Editor hat dieselben sieben Abschnitte wie der Brief im Coding-Kurs, links das Formular, rechts die Vorschau. Abschnitt 3 bleibt heute offen, Abschnitt 5 verweist auf die Story Map von Tag 3. Alle Artefakte seht ihr unter <a href="/innolab/mappe">Meine Mappe</a>.</p>
  <Bearbeiten artefakt="brief" />

  <h2 id="pruefen">Prüfen</h2>
  <ClaudePruefung slug="problem-rahmen" />

  </div>

  <Folie>
    <h2 id="uebertrag">Übertrag auf euer Produkt</h2>
    <p class="folie-satz">Was ist bei euch die Schlange vor der Kaffeebar?</p>
    <p>Der Moment, in dem für eure Zielgruppe heute etwas schiefgeht. Geht er nicht in einen Satz, ist er eine offene Frage für die Interviews – Abschnitt 7.</p>
  </Folie>

  <FooterNav prev={{ href: '/innolab/tag-1', t: 'Tag 1 · Rahmen & Verstehen' }} next={{ href: '/innolab/methoden/entscheidungslog', t: 'Entscheidungslog' }} />
</Layout>
