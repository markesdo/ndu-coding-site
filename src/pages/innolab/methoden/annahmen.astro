---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import MethodenKarte from '../../../components/MethodenKarte.astro';
import ClaudePruefung from '../../../components/ClaudePruefung.astro';
import Prompt from '../../../components/Prompt.astro';
import Bearbeiten from '../../../components/Bearbeiten.astro';
import FooterNav from '../../../components/FooterNav.astro';
import Folie from '../../../components/Folie.astro';
import Timer from '../../../components/Timer.astro';
import Matrix2x2 from '../../../components/bild/Matrix2x2.astro';
import VierArten from '../../../components/bild/VierArten.astro';
import BuchAbbildung from '../../../components/bild/BuchAbbildung.astro';
import BildText from '../../../components/bild/BildText.astro';
import MiroFrame from '../../../components/MiroFrame.astro';
import { MCP_WERKZEUGE } from '../../../werkstatt/vertrag';

// Achsen und Felder der Annahmen-Map: leer auf „Worum es geht“, gefüllt auf „Am Beispiel“.
// Ausrichtung wie bei Bland (Testing Business Ideas) und Torres (Kap. 9): rechts wenig Beleg, oben rechts zuerst testen –
// so passt die Folie zu den Abbildungen in beiden Büchern.
const karte = {
  y: { label: 'wichtig', unten: 'weniger', oben: 'sehr' },
  x: { label: 'Unsicherheit', links: 'starker Beleg', rechts: 'kein Beleg' },
  felder: ['Beleg prüfen, darauf bauen', 'Zuerst testen', 'Abhaken', 'Später prüfen'] as [string, string, string, string],
  hervor: 'or' as const,
};
// Red Team über den Connector, ohne ihn mit beiden Artefakten per „Für Claude kopieren“; der Werkzeugname kommt aus dem
// Vertrag, nicht als Text.
const redTeam = `Lies meinen Produkt-Brief und meine Annahmen-Map aus der Werkstatt (Werkzeug ${MCP_WERKZEUGE.artefaktLesen}). Ohne Werkstatt-Zugang nimm die beiden Texte, die ich unter diese Nachricht einfüge. Wo im Brief steckt eine Annahme, die in der Map fehlt? Zitier höchstens drei Stellen wörtlich und frag mich zu jeder, was wir dort voraussetzen. Formulier die Annahmen nicht für mich – ich entscheide, was in die Map kommt.`;
---
<Layout title="Annahmen-Map">
  <span class="eyebrow">Innolab · Tag 1 · Methode</span>
  <h1>Annahmen-Map</h1>
  <p class="lead">Was muss alles stimmen, damit euer Produkt funktioniert – und welche dieser Annahmen kann euch am schnellsten das Genick brechen?</p>
  <Orientierung seite="innolab/methoden/annahmen" leiste={false} />
  <MethodenKarte slug="annahmen" />

  <Folie>
    <h2 id="warum">Warum Annahmen sichtbar machen?</h2>
    <p class="folie-satz">Wer seine Annahmen nicht kennt, kann sie nicht prüfen – und baut das Falsche.</p>
    <p data-schritt>Portland baut mit Millionen Steuergeld Wohnungen für Familien, die aus ihrem Viertel verdrängt wurden. Jahre später stehen die meisten leer: Es gab fast nur Ein- und Zweizimmerwohnungen, die Familien hatten vier und mehr Personen.</p>
    <div class="nur-handout">
      <p>Teresa Torres eröffnet ihr Kapitel über Annahmen mit dieser Geschichte („Continuous Discovery Habits“, 2021, S. 115–116). Stadt und Bauträger wollten das Richtige und nahmen an, kleine Wohnungen helfen den meisten Familien. Niemand prüfte das. Am Ende wurden die Wohnungen auf dem freien Markt verkauft.</p>
      <p>Zwei Denkfehler machen das so häufig. <strong>Confirmation Bias:</strong> Wir suchen und merken uns, was unsere Idee bestätigt, und übersehen, was dagegen spricht. <strong>Escalation of Commitment:</strong> Je mehr wir in eine Idee gesteckt haben, desto fester halten wir an ihr fest – auch wenn sie Fehler hat (S. 116–117). Dagegen hilft, die Annahmen hinter einer Idee aufzuschreiben, bevor man baut, und gezielt die riskanteste zu prüfen. Das geht schneller als die ganze Idee zu testen, und man verliebt sich weniger in sie.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="worum">Worum es geht</h2>
    <p class="folie-satz">Getestet wird zuerst, was sehr wichtig ist und kaum belegt.</p>
    <p class="nur-handout">Zwei Fragen pro Annahme: <strong>Wie wichtig ist sie?</strong> Fällt das Produkt um, wenn sie falsch ist? <strong>Welchen Beleg habt ihr?</strong></p>
    <BildText>
      <BuchAbbildung src="/quellen/bland/annahmen-map.jpg" alt="Assumptions Map aus Testing Business Ideas: senkrecht Important bis Unimportant, waagrecht Have Evidence bis No Evidence; oben rechts gestrichelt umrandet die Hypothesen, die zuerst getestet werden" quelle="Assumptions Map. David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019), S. 38." />
      <ul>
        <li data-schritt><strong>Oben rechts:</strong> wichtig, kein Beleg – zuerst testen.</li>
        <li data-schritt><strong>Oben links:</strong> wichtig, belegt – darauf bauen, Beleg prüfen.</li>
        <li data-schritt><strong>Unten:</strong> weniger wichtig – später oder gar nicht.</li>
        <li data-schritt>Schnell sortieren: relativ zueinander, nicht exakt.</li>
      </ul>
    </BildText>
    <div class="nur-handout"><Matrix2x2 label="Annahmen-Map, leer: nach oben wichtig, nach rechts weniger Beleg; oben rechts zuerst testen" {...karte} /></div>
    <p class="nur-handout">Euer Brief ist voller Annahmen, auch wenn sie wie Tatsachen klingen. Die Annahmen-Map macht sie sichtbar und sortiert sie nach diesen zwei Fragen. Die riskanteste Annahme – sehr wichtig, kaum belegt – kommt zuerst dran. Oben links liegt, was wichtig und gut belegt ist: Darauf baut ihr, prüft aber, ob der Beleg wirklich trägt.</p>
    <p class="nur-handout"><strong>Heute und an Tag 3.</strong> Heute geht es vor allem um Annahmen über eure Kundschaft und ihr Problem: Wer hat es, wann, was tun sie heute? Diese prüft ihr mit den Interviews bis Tag 2; die riskanteste wird zur Forschungsfrage eures Leitfadens. Annahmen über eine Lösung – ob jemand im Gehen bestellt, ob es sich rechnet – lassen sich in Interviews kaum prüfen. Für sie macht ihr an Tag 3 eine eigene Map pro Idee, wenn ihr mehrere Ideen habt, und testet sie mit Experimenten (Teresa Torres, „Continuous Discovery Habits“, 2021, Kap. 9–10).</p>
  </Folie>

  <Folie>
    <h2 id="arten">Vier Arten von Annahmen</h2>
    <p class="folie-satz">Sammelt in allen vier – sonst übersieht ihr eine Art von Risiko.</p>
    <VierArten label="Vier Arten von Annahmen" mitte="Vorbestellen" schritt arten={[
      { t: 'Wünschenswert', frage: 'Wollen die Menschen das?', beispiel: 'lieber vor Ort als am Automaten', farbe: 'yellow' },
      { t: 'Machbar', frage: 'Können wir es bauen und betreiben?', beispiel: '40 Bestellungen in 30 min', farbe: 'blue' },
      { t: 'Wirtschaftlich', frage: 'Trägt es sich?', beispiel: 'rechnet sich ohne weitere Kraft', farbe: 'green' },
      { t: 'Bedienbar', frage: 'Kommen die Menschen damit zurecht?', beispiel: 'bestellen in 20 s im Gehen', farbe: 'purple' },
    ]} />
    <div class="nur-handout" style="overflow-x:auto">
      <table>
        <thead><tr><th>Art</th><th>Beispiel Kaffeebar</th></tr></thead>
        <tbody>
          <tr><th>Wünschenswert</th><td>Wir glauben, dass Pendler*innen lieber vor Ort Kaffee holen als den Automaten zu nehmen.</td></tr>
          <tr><th>Machbar</th><td>Wir glauben, dass die Bar morgens 40 Bestellungen in 30 Minuten zubereiten kann.</td></tr>
          <tr><th>Wirtschaftlich</th><td>Wir glauben, dass sich die zusätzlichen Bestellungen ohne eine weitere Kraft am Morgen rechnen.</td></tr>
          <tr><th>Bedienbar</th><td>Wir glauben, dass Pendler*innen im Gehen innerhalb von 20 Sekunden bestellen können.</td></tr>
        </tbody>
      </table>
    </div>
    <div class="nur-handout">
      <BuchAbbildung src="/quellen/bland/annahmen-arten.jpg" alt="Drei überlappende Kreise: Feasible – Can we do this?, Desirable – Do they want this?, Viable – Should we do this?" quelle="Types of Hypotheses. David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019), S. 32." />
      <p>Bland unterscheidet drei Arten: Wollen sie das? Können wir das? Sollten wir das (trägt es sich)? Marty Cagan nimmt die Bedienbarkeit als vierte dazu, weil ein Produkt, das Menschen wollen, an der Bedienung scheitern kann. Teresa Torres ergänzt eine fünfte Frage, die fast alle Teams vergessen: <strong>Kann es schaden?</strong> Welche Daten sammelt ihr, wer bleibt außen vor, würde es euch stören, wenn eine Zeitung darüber berichtet („Continuous Discovery Habits“, S. 118, 126–128)?</p>
    </div>
    <p class="small muted">Die vier Arten gehen auf Marty Cagan zurück (Wert, Machbarkeit, Wirtschaftlichkeit, Bedienbarkeit), die Map auf David J. Bland.</p>
  </Folie>

  <Folie>
    <h2 id="beleg">Was zählt als Beleg?</h2>
    <p class="folie-satz">Was Menschen tun, wiegt mehr als was sie sagen.</p>
    <div style="overflow-x:auto">
      <table>
        <thead><tr><th>Schwacher Beleg</th><th>Stärkerer Beleg</th></tr></thead>
        <tbody>
          <tr data-schritt><td><strong>Meinung:</strong> „Ich würde …“, „Ich finde … wichtig“</td><td><strong>Tatsache:</strong> „Letzte Woche habe ich …“</td></tr>
          <tr data-schritt><td><strong>Was Menschen sagen</strong> – im Interview, in einer Umfrage</td><td><strong>Was Menschen tun</strong> – beobachtet, gemessen</td></tr>
          <tr data-schritt><td><strong>Testsituation:</strong> Sie wissen, dass sie getestet werden</td><td><strong>Echte Situation:</strong> Sie wissen es nicht</td></tr>
          <tr data-schritt><td><strong>Kleiner Einsatz:</strong> E-Mail-Adresse hinterlassen</td><td><strong>Großer Einsatz:</strong> im Voraus bezahlen, den eigenen Namen geben</td></tr>
        </tbody>
      </table>
    </div>
    <p class="small muted">Nach „Strength of Evidence“, David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019), S. 52.</p>
    <div class="nur-handout"><BuchAbbildung src="/quellen/bland/beleg-staerke.jpg" breit alt="Tabelle Weak Evidence gegen Strong(er) Evidence: Meinungen gegen Fakten, was Menschen sagen gegen was sie tun, Laborsituation gegen echte Situation, kleine gegen große Investition" quelle="Strength of Evidence. David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019), S. 52." /></div>
    <p class="nur-handout">Daraus entsteht die Skala in der Werkstatt: <strong>noch keiner</strong> – <strong>gesagt</strong> (Meinung: „Ich würde …“) – <strong>erzählt</strong> (was jemand das letzte Mal tatsächlich getan hat) – <strong>getan</strong> (beobachtet, gemessen, bezahlt). Eure Interviews bis Tag 2 bringen Annahmen bestenfalls auf „erzählt“. „Getan“ zeigen erst Experimente ab Tag 3.</p>
  </Folie>

  <Folie>
    <h2 id="beispiel">Am Beispiel: die riskanteste Annahme</h2>
    <p class="folie-satz">A1 ist sehr wichtig und gar nicht belegt – sie wird zuerst getestet.</p>
    <Matrix2x2 label="Annahmen-Map der Kaffeebar: nach oben wichtig, nach rechts weniger Beleg" {...karte}
      punkte={[
        { t: 'A1 · Entscheiden schon vor der Ankunft', x: .92, y: .86, hervor: true },
        { t: 'A2 · 40 Bestellungen in 30 min', x: .1, y: .72 },
        { t: 'A3 · Bestellen in 20 s im Gehen', x: .9, y: .3 },
        { t: 'A4 · Rechnet sich ohne weitere Kraft', x: .1, y: .26 },
      ]} />
    <p class="nur-handout"><strong>A1 · Wir glauben, dass Pendler*innen schon vor der Ankunft am Bahnhof entscheiden, ob sie Kaffee holen.</strong> Das ist eine Annahme über ihr Verhalten, nicht über eine Lösung. Ist sie falsch, hilft keine Vorbestellung, egal wie gut sie gebaut ist. Sie ist damit wichtiger als die Frage, ob 20 Sekunden zum Bestellen reichen. Daraus wird die Forschungsfrage für die Interviews: <em>Wann und wo entscheiden Pendler*innen, ob sie Kaffee holen?</em> Gefragt wird nicht danach, sondern nach dem letzten Morgen: „Erzähl mir von deinem letzten Morgen am Bahnhof.“</p>
  </Folie>

  <Folie>
    <h2 id="vorgehen">So geht ihr vor (45 min)</h2>
    <p class="folie-satz">Erst allein sammeln und einordnen, dann zu dritt verschieben.</p>
    <MiroFrame name="T1 · 3 · Annahmen-Map" />
    <ol class="gross">
      <li data-schritt><strong>Allein sammeln:</strong> pro Art mindestens drei Sätze „Wir glauben, dass …“, je ein Sticky in Miro. <Timer minuten={10} /></li>
      <li data-schritt><strong>Einordnen:</strong> jede Annahme in die Matrix – wie wichtig, wie belegt. <Timer minuten={10} /></li>
      <li data-schritt><strong>Dreierrunde:</strong> Die anderen schieben Stickies, wo sie anderer Meinung sind, und ergänzen, was fehlt. <Timer minuten={10} /></li>
      <li data-schritt><strong>Festhalten und prüfen:</strong> in der Werkstatt speichern, die riskanteste markieren, Prüfliste, Claude. <Timer minuten={15} /></li>
    </ol>
  </Folie>

  <div class="nur-handout">
  <h2 id="werkstatt">In der Werkstatt speichern</h2>
  <p>Aus Miro in die Werkstatt: Jede*r trägt die eigene Map ein, eine Annahme pro Zeile mit Art, Wichtigkeit und Beleg. Rechts entsteht dieselbe Matrix wie auf der Folie. Zum Schluss wählt ihr die riskanteste Annahme aus.</p>
  <Bearbeiten artefakt="annahmen" />

  <h2 id="pruefen">Prüfen</h2>
  <ClaudePruefung slug="annahmen" />
  <p>Danach ein zweiter Durchgang als Red Team:</p>
  <Prompt label="Red Team · Claude, mit oder ohne Connector">{redTeam}</Prompt>
  <p class="small muted">Ohne Connector: Prompt einfügen, darunter den Brief und die Annahmen-Map, beide aus „Für Claude kopieren“ im jeweiligen Editor.</p>

  </div>

  <Folie>
    <h2 id="uebertrag">Übertrag auf euer Produkt</h2>
    <p class="folie-satz">Welche Annahme ist bei euch das „schon vor der Ankunft entscheiden“?</p>
    <p>Die Annahme, ohne die alles andere egal ist, wird die Forschungsfrage eures <a href="/innolab/methoden/interview">Interviewleitfadens</a> – den schreibt ihr gleich danach.</p>
  </Folie>

  <FooterNav prev={{ href: '/innolab/methoden/entscheidungslog', t: 'Entscheidungslog' }} next={{ href: '/innolab/methoden/interview', t: 'Jobs to be Done & Mom Test' }} />
</Layout>
