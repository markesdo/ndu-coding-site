<style>
  .fluss-titel { display: flex; align-items: center; gap: .4rem; margin: 1rem 0 -.75rem; font-weight: 600; }
  .fluss-titel :global(.icon-nein) { color: var(--muted); }
  .fluss-titel :global(.icon-ja) { color: var(--green); }
  /* Folie „peak-end“: der Aufbau des Versuchs vor den beiden Reihen. */
  .versuch { margin: .75rem 0 0; max-width: none; }
  .versuch ~ :global(.fluss) { margin: .75rem 0; }
  .nw { white-space: nowrap; }
  /* Folie „beispiel“: das Raster – Spalten sind die gemeinsamen Knotennamen (das Beschriften), Zeilen die Geschichten,
     die letzte Zeile die Zählung (eigener Aufdeck-Schritt). */
  .raster { margin: 0; table-layout: fixed; font-size: .8rem; line-height: 1.3; }
  .raster th, .raster td { padding: .3rem .45rem; }
  .raster thead th { font-family: inherit; font-size: .8rem; font-weight: 700; color: var(--fg); text-transform: none; letter-spacing: 0; border-bottom: 2px solid var(--border); }
  .raster thead td, .raster tbody th { width: 8rem; }
  .raster tbody th { font-size: .85rem; }
  .raster .id { color: var(--muted); white-space: nowrap; font-size: .9em; }
  .raster .leer { color: var(--muted); }
  /* Trennlinie vor der Zählzeile an der letzten Geschichte, nicht an der Zählzeile: Die ist bis zum Aufdecken versteckt
     und soll mit border-collapse keine Linie zeichnen. */
  .raster .letzte-geschichte > * { border-bottom: 2px solid var(--border); }
  .zaehlzeile th, .zaehlzeile td { font-weight: 600; border: 0; }
  .beispiel-block { container: beispiel / inline-size; }
  .beispiel-block .table-scroll { margin: .5rem 0 0; }
  .raster-fuss { margin: .2rem 0 0; }
  .map-titel { flex-wrap: wrap; column-gap: .8rem; max-width: none; margin: .7rem 0 0; }
  .map-legende { font-weight: 400; font-size: .8rem; color: var(--muted); }
  /* Folie „peak-end“: die Markenform, kleiner unter dem Merksatz. */
  .merksatz { margin-bottom: 0; }
  .marke-form { margin: .3rem 0 .6rem; font-size: .9rem; color: var(--muted); }
  /* Folie „vorgehen“: N von M in voller Breite – div statt p, global.css begrenzt Absätze auf Folien auf 36em. */
  .nvm { margin-top: .2rem; }
  /* Marken (.pill.tief / .pill.ende, global.css) im Raster und an den Karten: so groß wie die IDs daneben. */
  .raster .pill, .map .pill { white-space: nowrap; font-size: .85em; line-height: 1.2; padding: .1rem .4rem; }
  /* Folie „beispiel“: die Map – drei Momente als Karten, unter dem ersten der Umweg (gestrichelt). */
  .map { list-style: none; margin: .45rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; font-size: .85rem; line-height: 1.3; }
  .map > li { position: relative; margin: 0; display: flex; flex-direction: column; gap: .45rem; }
  .map > li + li::before { content: '→' / ''; position: absolute; left: -1.5rem; top: 1.4rem; color: var(--muted); font-size: 1.1rem; }
  .karte { display: flex; flex-direction: column; align-items: flex-start; gap: .3rem; padding: .55rem .7rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); }
  .karte strong { font-size: .95rem; line-height: 1.25; }
  .map .id { color: var(--muted); white-space: nowrap; font-size: .9em; }
  .umweg { display: flex; flex-direction: column; gap: .2rem; margin-left: 1rem; padding: .35rem .6rem; border: 1px dashed var(--muted); border-radius: var(--radius); font-size: .9em; }
  .umweg-titel { display: flex; align-items: center; gap: .3rem; font-weight: 600; color: var(--muted); }
  /* Schmale Spalte (Container, nicht Fenster – die Seitenleiste zählt mit): Karten untereinander, das Raster scrollt in .table-scroll. */
  @container beispiel (max-width: 700px) {
    .map { grid-template-columns: 1fr; gap: 1.6rem; }
    .map > li + li::before { content: '↓' / ''; left: 50%; top: -1.4rem; }
    .raster { table-layout: auto; min-width: 34rem; }
  }
  /* Folie „gruppieren“: fünf Skizzen als Reihen von Stickies. Schritt 1 (.gruppen-an) färbt sie nach Gruppe, die
     übrigen werden grau; im Handout (kein Beamer) sind die Farben gleich da. Farbe trägt nie allein: Buchstabe A–D. */
  .g-a { --g: var(--blue); --g-soft: var(--blue-soft); }
  .g-b { --g: var(--yellow-ink); --g-soft: var(--yellow-soft); }
  .g-c { --g: var(--purple); --g-soft: var(--purple-soft); }
  .g-d { --g: var(--cyan); --g-soft: var(--cyan-soft); }
  /* Jede Geschichte ein Band mit Haarlinie: Umbrüche innerhalb einer Geschichte liegen enger als der Abstand zur nächsten. */
  .skizzen { display: flex; flex-direction: column; margin: .4rem 0 0; }
  .skizze { display: grid; grid-template-columns: 1.9rem minmax(0, 1fr); align-items: start; padding: .3rem 0; }
  .skizze + .skizze { border-top: 1px solid var(--border); }
  .skizze-i { font-family: var(--mono); font-weight: 700; font-size: .9rem; padding-top: .1rem; }
  .stickies { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; row-gap: .25rem; }
  /* Der Pfeil steht vor dem Sticky: Bricht die Reihe um, beginnt die neue Zeile mit „→“, keiner hängt am Zeilenende. */
  :global(.content) .stickies > li { margin: 0; display: inline-flex; align-items: center; max-width: 100%; }
  .stickies > li + li::before { content: '→'; content: '→' / ''; margin: 0 .18rem; color: var(--muted); }
  .sticky { display: inline-flex; align-items: center; gap: .2rem; padding: .1rem .3rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-2); font-size: .8rem; line-height: 1.25; white-space: nowrap; transition: background-color .2s, border-color .2s, opacity .2s; }
