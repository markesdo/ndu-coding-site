---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import MethodenKarte from '../../../components/MethodenKarte.astro';
import ClaudePruefung from '../../../components/ClaudePruefung.astro';
import FooterNav from '../../../components/FooterNav.astro';
import Folie from '../../../components/Folie.astro';
import Fluss from '../../../components/Fluss.astro';
import Timer from '../../../components/Timer.astro';
import BuchAbbildung from '../../../components/bild/BuchAbbildung.astro';
import BildText from '../../../components/bild/BildText.astro';
import MiroFrame from '../../../components/MiroFrame.astro';
import { CircleCheck, CircleX, CornerDownRight } from '@lucide/astro';
import { METHODEN } from '../../../components/methoden';
import KAFFEEBAR_INTERVIEWS from '../../../werkstatt/beispiele/interviews.json';
import { GRUPPEN, SKIZZEN, buchstabe, gruppeName, skizzenFehler, zaehlung } from '../../../data/kaffeebar-skizzen';

const TORRES = 'Teresa Torres, „Continuous Discovery Habits“ (2021)';
const KANE = 'Lexie Kane, „The Peak–End Rule: How Impressions Become Memories“, Nielsen Norman Group (2018)';
// Folie „Prüfen“: die Kurzformen der Prüfliste aus methoden.ts, damit Folie und Checkliste nicht auseinanderlaufen.
const PRUEFLISTE = METHODEN.find((m) => m.slug === 'journey-map')?.pruefliste;
if (!PRUEFLISTE?.length) throw new Error('journey-map.astro: Methode „journey-map“ oder ihre Prüfliste fehlt in methoden.ts');
const PRUEF_KURZ = PRUEFLISTE.map((p) => p.kurz ?? p.text);
const KAHNEMAN = 'Daniel Kahneman u. a., „When More Pain Is Preferred to Less: Adding a Better End“, Psychological Science 4 (1993), S. 401–405';
// Folien „gruppieren“ und „beispiel“: Skizzen, Gruppen und Zählung aus einer Quelle (data/kaffeebar-skizzen.ts).
const ZITAT_IDS = new Set(KAFFEEBAR_INTERVIEWS.interviews.flatMap((iv) => iv.zitate.map((z) => z.id)));
const SKIZZEN_FEHLER = skizzenFehler(SKIZZEN, ZITAT_IDS);
if (SKIZZEN_FEHLER.length) throw new Error(`journey-map.astro: Kaffeebar-Skizzen: ${SKIZZEN_FEHLER.join('; ')}`);
---
<Layout title="Experience Map">
  <span class="eyebrow">Innolab · Tag 2 · Methode</span>
  <h1>Experience Map aus den Geschichten</h1>
  <p class="lead">Eure Map von Tag 1 war eine Vermutung. Jetzt habt ihr Geschichten aus Interviews – daraus wird die Map, deren Momente die obersten Äste eures Baums werden.</p>
  <Orientierung seite="innolab/methoden/journey-map" leiste={false} />
  <MethodenKarte slug="journey-map" />

  <Folie>
    <h2 id="wofuer">Wofür die Map?</h2>
    <p class="folie-satz">Ein Bild davon, wie eure Kundschaft es heute erlebt.</p>
    <ul class="gross">
      <li data-schritt><strong>Gemeinsam:</strong> Die anderen fragen nach, was ihr in euren Geschichten überseht.</li>
      <li data-schritt><strong>Weiterentwickeln:</strong> Tag 1 war Vermutung – die Geschichten zeigen, was davon hält.</li>
      <li data-schritt><strong>Für den Baum:</strong> Ihre Momente werden die obersten Äste.</li>
    </ul>
    <p class="small muted">{TORRES}, S. 51, 57, 70, 86.</p>
    <div class="nur-handout">
      <p>Teresa Torres beginnt mit einem Trio, in dem jede*r eine eigene Vorstellung davon hat, was die Kundschaft aufhält. Jede*r zeichnet zuerst die eigene Map; zusammen ergeben sie ein reicheres Bild des Chancenraums, als eine Person allein zeichnen könnte. Die gemeinsame Map „will guide your customer interviews, and it will help give structure to the opportunity space. It can and should evolve week over week“ ({TORRES}, S. 51).</p>
      <p>Im Interview hilft sie, die Geschichte zu verfolgen: auf bestimmte Knoten hören und nach Knoten fragen, die in der Erzählung fehlen (S. 66). Für den Baum ist sie die Struktur: Oft reicht es, jeden Knoten der Map auf die oberste Ebene der Chancen zu legen (S. 86). Ohne gemeinsames Weiterzeichnen laufen die Bilder im Team auseinander, selbst wenn alle dieselben Interviews gehört haben (S. 57).</p>
      <p>Torres sagt ‚evolve‘, nicht ‚neu zeichnen‘ (S. 51, 57). Wir bauen die Map heute aus den Geschichten auf, weil die von Tag 1 nur auf Vermutungen stand – der Fall, für den Torres den Weg über die Interview-Zeichnungen nennt (S. 86) – und legen die alte daneben: Wo gleichen die Geschichten ihr, wo nicht (S. 70)? Die Map von Tag 1 hielt fest, was ihr zu wissen glaubtet – Torres nennt das „hunches and possibilities, not truth“ –, wo ihr offene Fragen hattet und was die Interviews prüfen sollten (S. 51). Zwei ihrer Anti-Muster betreffen genau diesen Moment: so weiterzumachen, als wäre die Map wahr, und zu vergessen, sie mit dem Gelernten weiterzuentwickeln (S. 57). Der Umfang bleibt der von Tag 1: Er kommt aus eurem Outcome im Produkt-Brief (S. 52–53). Gezeichnet wird das Erleben der Menschen, nicht euer Produkt und keine Bildschirmabfolge (S. 54).</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="erleben">Erleben, nicht Bildschirme</h2>
    <p class="folie-satz">Zeichnet, wie die Kundschaft es erlebt – nicht euer Produkt.</p>
    <p class="fluss-titel"><CircleX size={20} aria-hidden="true" class="icon-nein" /> Aus Sicht der Kaffeebar</p>
    <Fluss label="Nicht so: der Ablauf aus Sicht der Kaffeebar – Bestellung, Bezahlung, Zubereitung, Ausgabe" knoten={[
      { t: 'Bestellung' }, { t: 'Bezahlung' }, { t: 'Zubereitung' }, { t: 'Ausgabe' },
    ]} />
    <div data-schritt>
      <p class="fluss-titel"><CircleCheck size={20} aria-hidden="true" class="icon-ja" /> Aus Sicht der Pendlerin (I2)</p>
      <Fluss label="So: der Morgen aus Sicht der Pendlerin I2 – Ankunft 7:31, acht Leute in der Schlange, Blick auf die Uhr, weiter zum Automaten, Zug 7:42" hervor={[3]} knoten={[
        { t: 'Ankunft 7:31' }, { t: 'acht Leute in der Schlange' }, { t: 'Blick auf die Uhr' }, { t: 'weiter zum Automaten', sub: 'gibt auf' }, { t: 'Zug 7:42' },
      ]} />
    </div>
    <p>Ihr kennt das vielleicht als <strong>Customer Journey</strong>.</p>
    <p class="small muted">{TORRES}, S. 54.</p>
    <div class="nur-handout">
      <p>Torres: „don’t focus on your product. Instead, draw the experience of your customer.“ Das Trio aus ihrem Beispiel zeichnete keine Abfolge von Bildschirmen seines Antragsformulars, sondern den Ablauf, wie die Kundschaft ihn erlebte: wo sie hängen blieb, was schiefging, wie sie umsteuerte und wo sie schließlich aufgab. Beim Streaming-Beispiel geht es um den weiteren Zusammenhang: Wann und wo spielt Video eine Rolle, wie erfahren Menschen von Inhalten, mit wem schauen sie, welche Hindernisse gibt es ({TORRES}, S. 54)?</p>
      <p>Bei der Kaffeebar heißt das: nicht Bestellung, Bezahlung, Zubereitung, Ausgabe – das ist der Ablauf hinter der Theke –, sondern der Morgen der Pendlerin, wie I2 ihn erzählt hat, mit der Stelle, an der sie aufgibt. In anderen Lehrveranstaltungen heißt so etwas oft Customer Journey; Torres nennt es „experience map“ (S. 57).</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="knoten">Knoten und Verbindungen</h2>
    <p class="folie-satz">Zeichnen statt beschreiben: Kästchen, Pfeile und Strichmännchen reichen.</p>
    <BildText>
      <BuchAbbildung src="/quellen/torres/experience-map.jpg" alt="Skizze einer Experience Map mit Strichmännchen: von einer Empfehlung über das Suchen bis zum Film und dem Ende, mit einem Abzweig, wenn nichts gefunden wird" quelle={`Experience Map „Wie unterhalten sich Menschen mit Videos?“. ${TORRES}, S. 54.`} />
      <ul>
        <li data-schritt><strong>Knoten:</strong> ein Moment, eine Handlung oder ein Ereignis.</li>
        <li data-schritt><strong>Verbindungen:</strong> wie es weitergeht – auch Schleifen und Abbrüche („?“).</li>
        <li data-schritt><strong>Kontext:</strong> Was denkt, fühlt, tut die Person dort?</li>
      </ul>
    </BildText>
    <div class="nur-handout">
      <p>Die Skizze von Torres beantwortet „Wie unterhalten sich Menschen mit Videos?“: Jemand hört von einer Serie, erzählt anderen davon, sucht sie, findet sie nicht (das Fragezeichen mit den Pfeilen hin und zurück) oder findet den Film – und am Ende steht „The End“ ({TORRES}, S. 54). Zeichnen statt Worte, weil Sprache vage ist: Zwei Menschen können glauben, sie seien sich einig, und doch Verschiedenes meinen. Zeichnen zwingt, konkret zu werden; schön muss es nicht sein (S. 53–55).</p>
      <p>Ein <strong>Knoten</strong> ist ein bestimmter Zeitpunkt, eine Handlung oder ein Ereignis; <strong>Verbindungen</strong> zeigen, wie es von Knoten zu Knoten weitergeht, auch in Schleifen, etwa wenn jemand bei Netflix nichts findet und zu YouTube wechselt. Zum Schluss kommt an jeden Schritt der <strong>Kontext</strong>: Was denkt, fühlt und tut die Person dort (S. 56)?</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="geschichten">Aus Geschichten eine Map</h2>
    <p class="folie-satz">Welche Knoten tauchen in Geschichte um Geschichte auf?</p>
    <MiroFrame name="T2 · 1 · Experience Map" />
    <ol class="gross">
      <li><strong>Beschriften:</strong> In jeder Skizze die Schlüsselmomente benennen – das sind eure Knoten.</li>
      <li data-schritt><strong>Muster suchen:</strong> Welche Knoten kommen in mehreren Geschichten vor?</li>
      <li data-schritt><strong>Zusammenlegen:</strong> Ähnliche Knoten zusammen, ohne wichtige Details zu verlieren; die häufigsten werden die Map. Jede Gruppe bekommt einen Namen (Kursregel).</li>
      <li data-schritt><strong>Verbinden:</strong> Pfeile – auch Wiederholungen, Schleifen und wo jemand aufgibt.</li>
    </ol>
    <p class="small muted">{TORRES}, S. 86–87 (Schritte 1–3), S. 56 (Zusammenlegen, Verbindungen); Gruppennamen: Kursregel.</p>
    <div class="nur-handout">
      <p>Torres nennt zwei Wege zur Struktur des Chancenraums: die Schritte der Experience Map – oder, wenn die Map noch keine klaren Momente hat, die Zeichnungen aus den Interviews. Dann beschriftet ihr die Knoten jeder Geschichte, sucht die Knoten, die in Geschichte um Geschichte auftauchen, und fügt die häufigsten zu einer Map zusammen, die eure gesammelten Geschichten abbildet ({TORRES}, S. 86–87).</p>
      <p>Wie ihr zusammenfügt, führt Torres auf S. 87 nicht aus. Wir übernehmen dafür ihre Regeln für die gemeinsame Map aus Kapitel 4 (S. 56): Ein <strong>Knoten</strong> ist ein Zeitpunkt, eine Handlung oder ein Ereignis, eine <strong>Verbindung</strong> zeigt, wie es weitergeht. Ähnliche Knoten dürft ihr zusammenlegen, aber nicht so weit verallgemeinern, dass wichtige Details verloren gehen. Zeichnet nicht nur den glatten Weg: wo Schritte wiederholt werden, wo jemand aus Frust aufgibt, wo es in Schleifen zurückgeht. Zum Schluss kommt der Kontext an jeden Schritt: Was denkt, fühlt, tut die Person dort? (S. 56)</p>
      <p>Die Skizzen stehen im Feld „Geschichte als Skizze“ der Snapshot-Karten auf T1 · 5 – der Snapshot trägt die Experience Map seiner Geschichte, bei Torres „the nodes and the links that make up the story“ (S. 70). Meist sind sie schon im Synthese-Block entstanden. Wer um 15:25 noch keine hat, zeichnet sie zuerst dort: Zettel und Pfeile aus den Notizen in der Werkstatt, höchstens drei Geschichten. Das gilt auch für die synthetischen Ersatz-Transkripte; die Map daraus trägt die Marke „Synthetisch“.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="peak-end">Stärkster Moment und Ende</h2>
    <p class="folie-satz">Erinnert wird der stärkste Moment und das Ende – nicht der Durchschnitt.</p>
    <p class="versuch">Hand in kaltem Wasser: Welchen Durchgang würdet ihr wiederholen?</p>
    <Fluss label="Kälteversuch, Durchgang 1: 60 Sekunden bei 14 Grad, Ende: Hand raus am kältesten Punkt" knoten={[{ t: 'Durchgang 1', sub: '60 s bei 14 °C' }, { t: 'Ende', sub: 'Hand raus – am kältesten Punkt' }]} />
    <Fluss label="Kälteversuch, Durchgang 2: 60 Sekunden bei 14 Grad, Ende: noch 30 Sekunden, langsam auf etwa 15 Grad erwärmt, weniger unangenehm" hervor={[1]} knoten={[{ t: 'Durchgang 2', sub: '60 s bei 14 °C' }, { t: 'Ende: + 30 s, langsam auf 15 °C', sub: 'etwas wärmer, weniger unangenehm' }]} />
    <div data-schritt>
      <p class="merksatz"><strong>Die meisten</strong> wählten Durchgang 2 – obwohl er 30 s länger unangenehm war. Erinnert wird das bessere Ende. Markiert darum in jeder Geschichte den stärksten Moment – Hoch oder Tief – und das Ende.</p>
      <p class="marke-form">Die Marke: ein Wort mit Zitat-ID, am Moment der Map – <span class="nw">‚Tief · I3-3‘</span>, <span class="nw">‚Ende · I3-5‘</span>.</p>
    </div>
    <p class="small muted">{KANE}; {KAHNEMAN}.</p>
    <div class="nur-handout">
      <p>Die Peak-End-Regel ist ein Denkfehler beim Erinnern: Intensive Momente (die Spitzen) und das Ende eines Erlebnisses zählen beim späteren Urteil am meisten ({KANE}). Der Artikel beschreibt den Versuch von Daniel Kahneman, Barbara Fredrickson, Charles Schreiber und Donald Redelmeier („When More Pain Is Preferred to Less: Adding a Better End“, 1993): 32 Studenten hielten eine Hand in kaltes Wasser, einmal 60 Sekunden bei 14 °C, einmal dieselben 60 Sekunden und danach 30 Sekunden, in denen das Wasser langsam auf etwa 15 °C erwärmt wurde – „still painful but distinctly less so for most subjects“ ({KAHNEMAN}, S. 401). Vor die Wahl gestellt, welchen Durchgang sie wiederholen, wählten 22 von 32 (69 %) den längeren – obwohl er länger unangenehm war, weil er etwas besser endete. Von den 21, die am Ende weniger Schmerz spürten, waren es 17 (81 %); die 11 ohne diese Abnahme teilten sich 6 zu 5 (S. 403).</p>
      <p>Für eure Map heißt das: Schaut, wo die Geschichten am stärksten ausschlagen, im Guten wie im Schlechten, und wie sie enden. Das NN/g-Team rät, negative Spitzen ernst zu nehmen (Verwirrung, Frust) und auf ein gutes Ende zu achten – „last impressions are lasting impressions“. Die Experience Map selbst stammt nicht aus diesem Artikel; die Regel ist der Grund, warum ihr den stärksten Moment (Hoch oder Tief) und das Ende markiert.</p>
      <p>Stärkster Moment heißt: die Stelle, an der die Person im Zitat selbst am deutlichsten Gefühl zeigt, im Guten oder im Schlechten. Die Regel gilt für das Erleben einer Person; sucht ihn darum in jeder Geschichte und setzt die Marke auf der Map an den Moment, in dem er liegt: ein Wort mit Zitat-ID, etwa ‚Tief · I3-3‘ oder ‚Ende · I3-5‘. Liegen die Tiefpunkte mehrerer Geschichten im selben Moment, stehen dort mehrere IDs (‚Tief · I3-3 · I5-6‘) – so seht ihr ohne Rechnen, wo sie sich häufen. Kein Emoji und kein eigener Knoten: Das Gefühl ist ein Wegweiser zur Ursache ({TORRES}, S. 95). Smileys in der Papierskizze sind in Ordnung (S. 57). Am Zitat festmachen ist eine Regel dieses Kurses; sie steht in keiner der beiden Quellen. Gezählt wird nur, in wie vielen Geschichten ein Knoten vorkommt (‚3 von 5‘, am Namen der Gruppe; M = alle eure Geschichten, bei drei synthetischen: von 3); die Marken tragen keine Zahl.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="momente">Momente werden Äste</h2>
    <p class="folie-satz">Jeder Ast ist ein eigener Zeitpunkt – ohne Überschneidung.</p>
    <BildText>
      <div class="aeste">
        <ol class="momente-reihe" aria-label="Die vier Momente der Experience Map bei Torres: Entscheiden, etwas zu schauen; Auswählen; Schauen; Ende. Jeder Moment wird ein Ast.">
          <li>Entscheiden, etwas zu schauen</li>
          <li>Auswählen</li>
          <li>Schauen</li>
          <li>Ende</li>
        </ol>
        <div class="bild-outcome">
          <BuchAbbildung src="/quellen/torres/aeste-momente.jpg" alt="Baum mit dem Outcome „Increase viewing minutes“ oben und vier Ästen darunter, einer pro Moment der Experience Map: „I need something to do.“, „I'm not sure what to watch.“, „I'm watching a show.“, „My show ended.“" quelle={`Jeder Moment der Experience Map wird ein Ast, eine oberste Chance. ${TORRES}, S. 87.`}>
            <span slot="marke" class="outcome-marke" aria-hidden="true">← Outcome</span>
          </BuchAbbildung>
        </div>
      </div>
      <ul>
        <li data-schritt><strong>Ein Moment pro Ast</strong>, in der Reihenfolge der Geschichte.</li>
        <li data-schritt><strong>Keine Überschneidung</strong>, sonst lässt sich nicht eine Chance nach der anderen bearbeiten.</li>
        <li data-schritt><strong>In den Worten der Kundschaft:</strong> „Ich weiß nicht, was ich schauen soll.“</li>
      </ul>
    </BildText>
    <div class="nur-handout">
      <p>Ziel ist, den Chancenraum nach unterscheidbaren Momenten zu ordnen, damit sich die Äste nicht überschneiden. Oft reicht es, jeden Knoten der Experience Map auf die oberste Ebene des Baums zu legen. Im Streaming-Beispiel werden aus vier Momenten – sich entscheiden, etwas zu schauen; etwas auswählen; schauen; das Ende – vier oberste Chancen (S. 86–87). Ohne Überschneidung könnt ihr an einer Chance arbeiten, ohne alle anderen mitzuziehen (S. 86). Im nächsten Block hängt ihr die Chancen aus euren Snapshots unter diese Äste. Torres nennt diese Äste „top-level opportunities“: Aus jedem Moment formuliert ihr eine oberste Chance, die diesen Moment wiedergibt – in der Abbildung in Ich-Form, etwa „My show ended.“ (S. 87, 91). Der Ast ist also selbst schon eine Chance, keine eigene Ebene über den Chancen.</p>
      <p>Die vier Schritte über der Abbildung sind die Momente aus Torres’ Experience Map; jeder wird eine oberste Chance (S. 86–87). Der Kreis oben, „Increase viewing minutes“, ist kein Moment, sondern das Outcome – die Wurzel des Baums.</p>
      <p>Torres trennt Knoten und Momente nicht: ‚key moment (or node)‘ (S. 87). Was sie beschreibt: ähnliche Knoten zusammenlegen, ohne wichtige Details zu verlieren (S. 56), und Momente ohne Überschneidung (S. 86–87). Was sie nicht beschreibt: wie aus den sechs Knoten ihrer Beispiel-Map (S. 56) die vier Momente werden (S. 87). Nur ‚Momente festlegen‘ als eigener Schritt ist eine Regel dieses Kurses.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="gruppieren">Kaffeebar: Gleiches zusammenlegen</h2>
    <MiroFrame name="T2 · 1 · Experience Map" />
    <p class="folie-satz kompakt">Zu dritt auf Miro, T2 · 1, Kaffeebar, Schritt 1: Eine*r schiebt, alle entscheiden. <Timer minuten={5} /></p>
    <div class="gruppen">
      {/* Steht vor den Skizzen, damit die Färbung ohne :has auskommt (.gruppen-an.gezeigt ~ .skizzen). */}
      <p data-schritt class="gruppen-an small muted">Gleiche Farbe, gleicher Buchstabe: derselbe Moment der Geschichte.</p>
      <div class="skizzen">
        {SKIZZEN.map((s) => (
          <div class="skizze">
            <span class="skizze-i">{s.i}</span>
            <ol class="stickies" aria-label={`Skizze ${s.i}, Stickies in der Reihenfolge der Geschichte`}>
              {s.stickies.map((st) => (
                <li>
                  <span class:list={['sticky', st.g && `gruppiert g-${st.g}`, { notiz: st.notiz }]}>
                    <span class="g-buchstabe" aria-hidden="true">{st.g ? buchstabe(st.g) : ''}</span>
                    <span class="sticky-text">
                      <span>{st.t}</span>
                      {st.notiz ? <span class="id">Notiz</span>
                        : st.marke ? <span class={`pill ${st.marke}`}>{st.marke === 'tief' ? 'Tief' : 'Ende'} · {st.id}</span>
                        : <span class="id">{st.id}</span>}
                    </span>
                    <span class="sr-only">{st.g ? `(Gruppe ${buchstabe(st.g)}: ${gruppeName(st.g)})` : '(grau: bleibt im Snapshot)'}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <div data-schritt class="gruppen-legende-block">
        <ul class="gruppen-legende">
          {GRUPPEN.map(({ g, name }) => <li class={`gruppiert g-${g}`}><span class="g-buchstabe" aria-hidden="true">{buchstabe(g)}</span> {name}</li>)}
          <li class="grau">grau: bleibt im Snapshot</li>
        </ul>
        <p class="regel"><strong>Gleicher Moment in der Geschichte, nicht gleiche Worte.</strong> Den Namen gebt ihr.</p>
      </div>
    </div>
    <p class="small muted">{TORRES}, S. 56, 87.</p>
    <div class="nur-handout">
      <p>Erst gruppiert ihr selbst: Die 23 Stickies der fünf Kaffeebar-Skizzen liegen auf Miro (T2 · 1, Spalte Kaffeebar), danach zeigt die Folie eine Lösung. Die Übungsrunde macht ihr zu dritt, weil die Kaffeebar euer einziges gemeinsames Produkt ist: Torres lässt ein Team seine Maps gemeinsam zusammenführen, statt die beste auszuwählen ({TORRES}, S. 55–56: ‚focus on synthesizing your work together rather than choosing the “best” drawing‘). ‚Eine*r schiebt, alle entscheiden‘ ist eine Regel dieses Kurses: Die anderen schlagen als Frage vor („Derselbe Moment?“), Namen-Stickies erst, wenn alle einverstanden sind, Zweifelsfälle liegen lassen. An eurem eigenen Produkt arbeitet ihr danach allein. Die Zitat-IDs zählen in der Reihenfolge, in der ihr die Zitate eingetragen habt – nicht in der Reihenfolge der Geschichte. Die Skizze folgt der Geschichte: I2 beginnt mit I2-4.</p>
      <p>Die Spaltennamen stehen in keiner Skizze. Sie entstehen, wenn ihr ähnliche Knoten zusammenlegt ({TORRES}, S. 56) und der Gruppe einen Namen gebt: Maßgeblich ist, dass die Stickies denselben Moment der Geschichte meinen, nicht dieselben Worte. Torres fügt ‚the most common nodes‘ zusammen (S. 87); dass Einzelnes im Snapshot bleibt, folgern wir daraus (Kursregel). Ausnahme: das Ende – auch bei Torres ein eigener Moment (S. 87). Gezählt werden Geschichten, nicht Stickies, und nur, was ein Zitat trägt; Notizen zeigt ihr, zählt sie aber nicht. Stickies zusammenschieben ist die Arbeitsweise dieses Kurses.</p>
      <ul>
        {GRUPPEN.map(({ g, name }) => {
          const zitate = SKIZZEN.flatMap((s) => s.stickies.filter((st) => st.g === g && st.id).map((st) => st.id));
          const notizen = SKIZZEN.filter((s) => s.stickies.some((st) => st.g === g && st.notiz)).map((s) => s.i);
          return <li><strong>{buchstabe(g)} · {name}:</strong> {zitate.join(', ')}{notizen.length > 0 && `; Notiz ${notizen.join(', ')} (zählt nicht)`} – {zaehlung(g)}.</li>;
        })}
      </ul>
      <p>Die Ankunftssätze I1-1, I4-1 und I5-1 bleiben grau: Sie beschreiben den Hintergrund, keinen erzählten Moment. Ebenso I1-4 (ein Hochpunkt ohne Platz in der Abfolge), I5-4 und I5-5 (nur in einer Geschichte). I3-4 („Bei mehr als fünf Leuten lass ich es.“) und I4-2 („Anstellen ist ein Glücksspiel.“) sind eine Regel und eine Meinung übers Anstehen, keine erzählten Momente: I3-4 steht nicht auf der Skizze; I4-2 steht darauf, bleibt aber grau – laut Notiz steht I4 selten an, das Anstehen kommt in ihrer Geschichte nicht vor. Dass I3 sich anstellt, steht nur in der Notiz („Stellt sich trotzdem an, wenn weniger als fünf Leute warten.“); darum ist der Sticky gestrichelt und zählt nicht. „Im Zug“ trägt nur eine Geschichte (I3-5), bleibt aber eine Gruppe: Dort endet die Geschichte, und das Ende markiert ihr ohnehin; der Zug steht auch in der Notiz zu I2. Dass I2-4, I2-1 und I2-2 im Raster der nächsten Folie in einer Zelle stehen („Tafel, Schlange · 8 Leute · Uhr“, in der Reihenfolge der Geschichte), ist selbst ein Beispiel für Zusammenlegen: drei Stickies, ein Moment, eine Geschichte – darum bleibt es bei {zaehlung('a')}.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="beispiel">Kaffeebar: von den Gruppen zur Map</h2>
    <p class="folie-satz">Ordnen, Umweg als Pfeil, Marken an ihren Moment.</p>
    <div data-schritt class="beispiel-block">
      <div class="table-scroll">
      <table class="raster">
        <caption class="sr-only">Zwei Geschichten der Kaffeebar, I2 und I3, beschriftet: Die Spalten sind die gemeinsamen Knotennamen, jede Zelle trägt die Worte der Person mit Zitat-ID. Darunter die Zählung, in wie vielen der fünf Geschichten jeder Knoten vorkommt.</caption>
        <thead>
          <tr>
            <td></td>
            {GRUPPEN.map(({ name }) => <th scope="col">{name}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">I2</th>
            <td>Tafel, Schlange <span class="id">I2-4</span> · <span class="nw">8 Leute</span> <span class="pill tief">Tief · I2-1</span> · <span class="nw">Uhr <span class="id">I2-2</span></span></td>
            <td>„… gedrückt, ohne nachzudenken.“ <span class="id">I2-3</span></td>
            <td class="leer" aria-label="nicht erzählt">–</td>
            <td class="muted">nur in der Notiz</td>
          </tr>
          <tr class="letzte-geschichte">
            <th scope="row">I3</th>
            <td>„… wie es ausschaut …“ <span class="id">I3-1</span></td>
            <td class="leer" aria-label="nicht erzählt">–</td>
            <td>„Ich weiß nie, wie lange …“ <span class="id">I3-2</span> <span class="pill tief">Tief · I3-3</span></td>
            <td>„… in Ruhe.“ <span class="pill ende">Ende · I3-5</span></td>
          </tr>
          <tr data-schritt class="zaehlzeile">
            <th scope="row"><strong>Geschichten mit diesem Knoten</strong></th>
            {GRUPPEN.map(({ g }) => <td>{zaehlung(g)}</td>)}
          </tr>
        </tbody>
      </table>
      </div>
      <p class="raster-fuss small muted">I1, I4, I5 im Handout. Raster nur auf der Folie (Kursformat, nicht Torres), nicht auf Miro.</p>
    </div>
    <div data-schritt class="beispiel-block">
      <p class="fluss-titel map-titel">Die Map: drei Momente <span class="map-legende">Tief · ID = dort liegt der Tiefpunkt dieser Geschichte.</span></p>
      <ol class="map" aria-label="Experience Map der Kaffeebar, drei Momente. Erstens: Ich komme in die Halle und entscheide, Zitat I2-1: das wird nix, Tief I2-1; von dort ein Umweg über den Automaten zum Zug, Zitat I4-4: Dann halt die Brühe, Tief I4-4. Zweitens: Ich stehe an und warte auf meinen Kaffee, Zitat I3-3: Das war ein Fehler, Tief I3-3 und I5-6. Drittens: Ich bin im Zug, Zitat I3-5: in Ruhe, Ende I3-5.">
        <li>
          <div class="karte">
            <strong>„Ich komme in die Halle und entscheide.“</strong>
            <span>„… <b>das wird nix</b>.“ <span class="id">I2-1</span></span>
            <span class="pill tief">Tief · I2-1</span>
          </div>
          <div class="umweg">
            <span class="umweg-titel"><CornerDownRight size={18} aria-hidden="true" /> Umweg: Automat → Zug</span>
            <span>„<b>Dann halt die Brühe.</b>“ <span class="id">I4-4</span></span>
            <span class="pill tief">Tief · I4-4</span>
          </div>
        </li>
        <li>
          <div class="karte">
            <strong>„Ich stehe an und warte auf meinen Kaffee.“</strong>
            <span>„… <b>Das war ein Fehler.</b>“ <span class="id">I3-3</span></span>
            <span class="pill tief">Tief · I3-3 · I5-6</span>
          </div>
        </li>
        <li>
          <div class="karte">
            <strong>„Ich bin im Zug.“</strong>
            <span>„… <b>in Ruhe</b>.“ <span class="id">I3-5</span></span>
            <span class="pill ende">Ende · I3-5</span>
          </div>
        </li>
      </ol>
    </div>
    <div class="nur-handout">
      <p>Die Map von Tag 1 (Miro T1 · 1) ging von „Ankunft am Bahnhof, 7:31“ über „Blick auf die Schlange“ und „Reicht die Zeit bis 7:42?“ zu „Anstellen“ oder „Zum Automaten“ – der Pfeil vom Automaten zum Zug mit „?“ – und endete „im Zug, mit oder ohne Kaffee“. Heute legt ihr zuerst zusammen (Folie davor): Denselben Knoten erzählt jede Geschichte mit anderen Worten – I2 schaut „auf die Tafel, dann auf die Schlange“ (I2-4), I3 schaut, „wie es ausschaut“ (I3-1), I5 entscheidet, „wenn ich die Halle seh“ (I5-3). Ihr gebt ihm einen gemeinsamen Namen, hier „Halle: schauen, entscheiden“. Diese Namen sind die Spalten des Rasters; jede Geschichte ist eine Zeile, jede Zelle trägt die Worte der Person mit Zitat-ID. Erzählt eine Geschichte den Knoten nicht, bleibt die Zelle leer; steht er nur in der Notiz, schreibt ihr das dazu. Auf der Folie stehen I2 und I3, die anderen drei sind genauso beschriftet:</p>
      <ul>
        <li><strong>I1:</strong> Halle nur in der Notiz („Schaut erst auf die Schlange, dann auf die Uhr.“) · Umweg: „Der Automat ist halt Notlösung, aber er ist schnell.“ (I1-3) · Anstehen und Warten: – · Zug: –.</li>
        <li><strong>I4:</strong> Halle klingt nur an („Ich bin um 7:28 da, das reicht nie für die Schlange.“, I4-1) · Umweg: „Meistens ist es der Automat.“ (I4-3), „Dann halt die Brühe.“ (I4-4), Tief · I4-4 · Anstehen und Warten: – („Anstellen ist ein Glücksspiel.“, I4-2, ist eine Meinung, kein erzählter Moment; laut Notiz steht er selten an) · Zug: –.</li>
        <li><strong>I5:</strong> Halle: „Das entscheid ich, wenn ich die Halle seh.“ (I5-3) · Umweg: – · Anstehen und Warten: „Bei mehreren Bestellungen wird mir das Warten zu lang.“ (I5-6), Tief · I5-6 · Zug: –.</li>
      </ul>
      <p>Dann zählt ihr Spalte für Spalte, in wie vielen Geschichten der Knoten vorkommt – die letzte Zeile, „Geschichten mit diesem Knoten“. Halle: 3 von 5 (I2-4, I3-1, I5-3); bei I1 und I4 steht es nur in der Notiz oder klingt in I4-1 an. Automat: 3 von 5 (I1-3, I2-3, I4-3). Anstehen und Warten: 2 von 5 (I3-2, I5-6). Zug: 1 von 5 (I3-5); bei I2 steht der Zug nur in der Notiz. Der Automat ist die Ausweichroute und beantwortet das „?“ von Tag 1; er ist kein eigener Moment, sondern ein Umweg, der in der Halle beginnt, und gehört als Pfeil auf die Map. Das Raster gibt ihm trotzdem eine eigene Spalte, weil er einen eigenen Pfeil bekommt. Neu ist das Warten, ohne zu wissen, wie lange. Anstehen und Warten nach dem Bestellen überschneiden sich in den Geschichten (I3-3 lässt offen, ob er schon bestellt hatte; das Anstehen selbst erzählt kein Zitat – I3-4 nennt nur seine Regel, wann er sich anstellt, und die Notiz zu I3 sagt dasselbe) – darum ein Moment: „Ich stehe an und warte auf meinen Kaffee.“ So sieht der Schritt ‚Überschneidendes zusammenlegen‘ aus. I2-5 („Am liebsten wüsste ich einfach, wann er fertig ist.“) ist ein Wunsch, kein erzählter Moment – I2 geht an diesem Morgen zum Automaten; das Zitat stützt eine Chance, nicht den Knoten.</p>
      <p>Den Tiefpunkt markiert ihr in jeder Geschichte: I2-1 beim Blick auf die Schlange in der Halle, I4-4 („Dann halt die Brühe.“) über den Automatenkaffee, also auf dem Umweg, I3-3 und I5-6 beim Anstehen und Warten; I1 erzählt keinen. Jede Marke wandert mit ihrer ID an ihren Moment der Map: ‚Tief · I2-1‘ an die Halle, ‚Tief · I4-4‘ an den Umweg, ‚Tief · I3-3 · I5-6‘ ans Anstehen und Warten – dort häufen sie sich. Das Ende erzählt nur I3: ‚Ende · I3-5‘. Der Schmerz zeigt sich beim Warten; ein Gefühl ist aber ein Wegweiser zur Ursache ({TORRES}, S. 95): Hinter I3-3 steht, dass I3 nie weiß, wie lange es dauert (I3-2). Im Baum wird daraus je Moment eine eigene Chance (S. 88): beim Warten „Wann ist mein Kaffee fertig?“ (I2-5, I3-3), bei der Entscheidung in der Halle „Geht sich ein Kaffee noch aus?“ (I2-4, I3-2, I5-2). Diese Aufteilung ist unsere Lesart der Geschichten, nicht Torres. An jedem Moment steht ein Zitat, in dem die Person Gefühl zeigt, das Gefühlswort fett. Hochpunkte gibt es auch – „Wenn der erste Schluck passt, ist der Morgen gerettet.“ (I1-4), „Das ist schön.“ (I3-6) –, aber ohne eigenen Knoten oder schwächer als der Tiefpunkt derselben Geschichte; sie stehen darum nicht auf der Map. Torres benennt die Momente neutral (Liste S. 87) und formuliert erst die obersten Chancen in Ich-Form (Abbildung S. 87); hier stehen die Momente schon in den Worten der Kundschaft.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="vorgehen">So geht ihr vor (60 min)</h2>
    <p class="folie-satz">Erst allein, dann zu dritt, dann die Momente festlegen.</p>
    <MiroFrame name="T2 · 1 · Experience Map" />
    <ol class="gross dicht">
      <li><strong>Allein:</strong> Eure Skizzen liegen als Kopie in eurer Spalte auf T2 · 1 – Gleiches zusammenschieben und benennen, zählen (Zahl auf den Namen-Sticky, etwa ‚3 von 5‘), zur Map verbinden, Marken mitnehmen; die Map von Tag 1 (T1 · 1) zum Vergleich. <Timer minuten={12} /></li>
      <li data-schritt><strong>Zu dritt:</strong> Reihum die eigene Spalte auf T2 · 1 zeigen – alle schauen auf dem Board mit; die anderen fragen nach, ohne die eigene Map zu verteidigen. <Timer minuten={10} /></li>
      <li data-schritt><strong>Momente festlegen:</strong> Überschneidendes zusammenlegen; drei bis fünf in den Worten der Kundschaft, je ein Zitat mit ID – möglichst mit Gefühl, Gefühlswort fett. Marken an ihren Moment: <span class="nw">‚Tief · I3-3‘</span>, <span class="nw">‚Ende · I3-5‘</span>. <Timer minuten={8} /></li>
      <li data-schritt><strong>Prüfen (5 min, nächste Folie):</strong> Prüfliste allein, dann Claude mit einem Bild eurer Spalte – so geht’s unter <a href="#pruefen">Prüfen</a>.</li>
    </ol>
    <div class="small muted nvm">N von M: in N von M Geschichten kommt der Knoten vor (bei drei synthetischen: von 3).</div>
    <div class="nur-handout">
    <p>In der Pause kopiert Markus eure Skizzen von T1 · 5 in eure Spalte auf T2 · 1 (Zone „Schritt 1: Gleiches zusammenlegen“), Stickies und Pfeile; eine Skizze als Foto kopiert, wer sie gemacht hat. 12 + 10 + 8 + 5 sind 35 Minuten; dazu gut 20 Minuten Theorie und Kaffeebar gemeinsam. Alle Maps liegen auf demselben Board, jede*r in der eigenen Spalte von T2 · 1; zum Zeigen teilt niemand den Bildschirm, alle schauen auf dem Board mit. Bei Torres teilt ein Trio seine Maps, um eine gemeinsame Map für ein Produkt zu bauen (S. 55–56). Ihr habt drei Produkte und fügt nichts zusammen; wir übernehmen nur die Regeln fürs Zeigen: fragen, auf Unterschiede achten, nicht verteidigen (S. 55). Die anderen kennen eure Kundschaft nicht – sie sehen aber, wo ein Knoten euer Produkt zeigt, wo der Umweg fehlt und wo sich Momente überschneiden. Überschneidendes zusammenlegen folgt Torres: ähnliche Knoten zusammenlegen (S. 56), Momente ohne Überschneidung (S. 86–87). Torres hängt an jeden Schritt den Kontext – was die Person denkt, fühlt, tut, möglichst als Bild ({TORRES}, S. 56). Hier trägt das Zitat diesen Kontext: Wählt je Moment das Zitat, in dem die Person selbst Gefühl zeigt, und setzt das Gefühlswort fett. Die Marken (stärkster Moment, Ende) wandern mit ihrer Zitat-ID an den Moment, in dem sie liegen; liegen mehrere im selben Moment, stehen dort mehrere IDs. Gezählt wird nur das Vorkommen: in N von M Geschichten kommt der Knoten vor (M = alle eure Geschichten, bei drei synthetischen: von 3). Erzählt niemand ein Gefühl, schreibt ‚Gefühl: nicht erzählt‘ – das ist eine Frage für das nächste Interview. Das Gefühl bleibt am Moment und wird kein eigener Knoten und keine Chance (S. 95). Fett statt Smiley ist eine Regel dieses Kurses. Drei bis fünf ist ein Richtwert dieses Kurses; Torres’ Beispiel hat vier Momente (S. 87). Der Tiefpunkt bleibt ein Moment („Ich stehe an und warte auf meinen Kaffee.“), kein Gefühl („Ich bin gestresst“) – ein Gefühl zeigt auf eine Ursache (S. 95). Die Map entsteht auf Miro in eurer Spalte von T2 · 1 und bleibt dort, eine Datei dazu gibt es nicht; jeder Moment und jede Chance darauf nennt mindestens eine Zitat-ID aus der Werkstatt, etwa I2-3. Ohne ID kein Beleg. Zum Prüfen geht ihr erst die Prüfliste durch und gebt Claude dann ein Bild eurer Map (unten unter „Prüfen“).</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="pruefen-folie">Prüfen (5 min)</h2>
    <p class="folie-satz">Erst ihr, dann Claude – Claude fragt, ihr entscheidet. <Timer minuten={5} /></p>
    <ul class="gross">
      {PRUEF_KURZ.map((t) => <li>{t}</li>)}
    </ul>
    <p data-schritt><strong>Dann Claude:</strong> Prompt kopieren und in claude.ai einfügen (<span style="white-space: nowrap">Werkstatt-Connector</span> an) · Foto eurer Spalte (Cmd+Ctrl+Shift+4) · Cmd+V · senden. <a href="#pruefen">So geht’s ↗</a></p>
    <p class="nur-handout">Die Punkte sind die Prüfliste dieser Methode in Kurzform; abhaken und den Prompt kopieren könnt ihr direkt darunter unter „Prüfen“.</p>
  </Folie>

  <Folie>
    <h2 id="nach-pruefen">Nach dem Prüfen</h2>
    <p class="folie-satz">Ein Befund ist eine Vermutung, kein Urteil.</p>
    <ul class="gross">
      <li>Einen Befund wählen, die Frage selbst beantworten.</li>
      <li>Stimmt er: auf Miro ändern. Sonst: lassen, Zeile ins Log.</li>
      <li>Nachfragen nur nach Belegen. Der Rest bis Tag 3.</li>
    </ul>
    <p class="nur-handout">Ausführlich, mit den beiden Nachfragen zum Kopieren, steht es unten unter „Prüfen“ bei „Danach entscheidet ihr“.</p>
  </Folie>

  <div class="nur-handout">
  <h2 id="pruefen">Prüfen</h2>
  <ClaudePruefung slug="journey-map" />
  </div>

  <Folie>
    <h2 id="uebertrag">Übertrag auf euer Produkt</h2>
    <p class="folie-satz">Was steht jetzt auf eurer Map, das an Tag 1 noch fehlte?</p>
    <p data-schritt><strong>Reihum:</strong> ein neuer Knoten, dann euer Befund und eure Entscheidung – je ein Satz.</p>
    <p class="nur-handout">Wenn nichts: Habt ihr die Geschichten wirklich nachgezeichnet oder die alte Map nur abgehakt? Die Momente nehmt ihr in den nächsten Block mit – sie werden die obersten Äste eures Opportunity Solution Tree. Auch diese Map ist ein Stand, kein Ergebnis: Mit jedem weiteren Interview entwickelt ihr sie weiter (S. 51, 57).</p>
  </Folie>

