---
import Layout from '../../../layouts/Layout.astro';
import Orientierung from '../../../components/Orientierung.astro';
import MethodenKarte from '../../../components/MethodenKarte.astro';
import Uebergang from '../../../components/Uebergang.astro';
import ClaudePruefung from '../../../components/ClaudePruefung.astro';
import MiroFrame from '../../../components/MiroFrame.astro';
import MiroLink from '../../../components/MiroLink.astro';
import FooterNav from '../../../components/FooterNav.astro';
import Folie from '../../../components/Folie.astro';
import Timer from '../../../components/Timer.astro';
import BuchAbbildung from '../../../components/bild/BuchAbbildung.astro';
import BildText from '../../../components/bild/BildText.astro';
import VierArten from '../../../components/bild/VierArten.astro';
import Linie from '../../../components/bild/Linie.astro';

const GASSMANN = 'Oliver Gassmann, Karolin Frankenberger, Michaela Csik, „Geschäftsmodelle entwickeln“ (2. Aufl. 2017)';
const GASSMANN_KURZ = 'Gassmann u. a., „Geschäftsmodelle entwickeln“ (2017)';
const VPD = 'Osterwalder u. a., „Value Proposition Design“ (2014)';
const CAGAN = 'Marty Cagan, „Inspired“ (2. Aufl. 2018)';
const TORRES = 'Teresa Torres, „Continuous Discovery Habits“ (2021)';
const BLAND = 'David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019)';

// Optionaler Kartensatz (nur Handout, keine Kurszeit): zwölf der 55 Muster, die zu kleinen digitalen Produkten passen,
// Idee in eigenen Worten. Dimensionen wie in den Steckbriefen (II-1.x, „Das Muster …: Was und Wert“); Firmen aus den
// Steckbriefen, Netflix bei Subscription aus der Frageliste des Konfrontationsprinzips (I-2.3.2).
const KARTEN = [
  { muster: 'Add-on', dim: 'Was, Wert', idee: 'Ein günstiges Grundprodukt, Extras kosten', firma: 'Ryanair' },
  { muster: 'Subscription', dim: 'Was, Wert', idee: 'Regelmäßig zahlen, regelmäßig bekommen', firma: 'Netflix' },
  { muster: 'Freemium', dim: 'Was, Wert', idee: 'Basis gratis, wenige zahlen für mehr', firma: 'Skype' },
  { muster: 'Flatrate', dim: 'Was, Wert', idee: 'Ein Preis, so viel man will', firma: 'Netflix, SBB-GA' },
  { muster: 'Pay-per-Use', dim: 'Was, Wert', idee: 'Bezahlt wird, was tatsächlich genutzt wird', firma: 'Car2Go' },
  { muster: 'Pay What You Want', dim: 'Was, Wert', idee: 'Die Kundschaft legt den Preis fest', firma: 'Radiohead' },
  { muster: 'Hidden Revenue', dim: 'Wer, Was, Wie, Wert', idee: 'Nicht die Nutzer*innen zahlen, sondern Dritte', firma: 'Google' },
  { muster: 'Two-Sided Market', dim: 'Was, Wie, Wert', idee: 'Zwei Gruppen, die einander brauchen', firma: 'eBay' },
  { muster: 'Affiliation', dim: 'Wie, Wert', idee: 'Andere bringen Kundschaft und werden pro Abschluss bezahlt', firma: 'Amazon' },
  { muster: 'Customer Loyalty', dim: 'Was, Wert', idee: 'Treue wird belohnt, Kaufdaten fallen an', firma: 'Payback' },
  { muster: 'Self-Service', dim: 'Was, Wie, Wert', idee: 'Die Kundschaft übernimmt einen Teil der Arbeit', firma: 'IKEA' },
  { muster: 'Cross Selling', dim: 'Was, Wie, Wert', idee: 'Zum Grundprodukt ein zweites mit höherer Marge', firma: 'Tchibo' },
];
---
<Layout title="Geschäftsmodell">
  <span class="eyebrow">Innolab · Tag 4 · Methode</span>
  <h1>Geschäftsmodell</h1>
  <p class="lead">Problem-Solution Fit habt ihr seit der Value Map auf Papier. Heute schreibt ihr auf, woran der dritte Fit hängt: Wer zahlt wofür, was kostet es – und welche Annahme steckt dahinter?</p>
  <Orientierung seite="innolab/methoden/geschaeftsmodell" leiste={false} />
  <Uebergang station="geschaeftsmodell" />
  <MethodenKarte slug="geschaeftsmodell" />

  <Folie>
    <h2 id="warum-jetzt">Wo ihr steht: drei Arten von Fit</h2>
    <p class="folie-satz">Auch ein geliebtes Produkt muss sich tragen.</p>
    <BildText>
      <BuchAbbildung src="/quellen/vpd/drei-fits.png" alt="Illustration in drei Stufen: unten 1 Problem-Solution Fit am Zeichentisch, darüber 2 Product-Market Fit auf einer grünen Wiese, oben 3 Business Model Fit auf einem Bankgebäude" quelle={`Drei Arten von Fit, von unten nach oben. ${VPD}, S. 115 (PDF).`} schmal />
      <ul>
        <li data-schritt><strong>1 Problem-Solution Fit</strong> – auf Papier: Eure Value Map trifft belegte Pains. Hier steht ihr.</li>
        <li data-schritt><strong>2 Product-Market Fit</strong> – im Markt: Menschen wollen es wirklich. Das prüfen eure Tests ab E1.</li>
        <li data-schritt><strong>3 Business Model Fit</strong> – in der Bank: Es bringt mehr ein, als es kostet.</li>
        <li data-schritt><strong>Heute:</strong> Fit 3 erreicht ihr nicht – ihr schreibt auf, woran er hängt.</li>
      </ul>
    </BildText>
    <div class="nur-handout">
      <p>Value Proposition Design ordnet die drei Arten von Fit als Stufen: „On Paper“, „In the Market“, „In the Bank“ ({VPD}, S. 117–118 PDF). Zum Problem-Solution Fit heißt es: „The fit you achieve is not yet proven and exists mainly on paper.“ (S. 117 PDF). Zum Business Model Fit: „No value proposition–however great–can survive without a sound business model.“ und „You don’t have business model fit until you can generate more revenues with your value proposition than you incur costs to create and deliver it“ (S. 118 PDF). Marty Cagan sagt dasselbe für Produkte: „The costs to produce, market and sell your product must be sufficiently less than the revenue your product generates.“ ({CAGAN}, S. 277).</p>
      <p><strong>Kursregel:</strong> Fit 2 und 3 brauchen Belege aus dem Markt; heute entsteht nur die Annahme dazu.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="vor-experiment">Warum vor der Experiment-Karte</h2>
    <p class="folie-satz">Gleich wählt ihr die riskanteste Annahme – dafür müssen alle auf der Map stehen.</p>
    <div class="gm-arten"><VierArten label="Vier Arten von Annahmen, wirtschaftlich hervorgehoben" mitte="Im Gehen bestellen" hervor={2} arten={[
      { t: 'Wünschenswert', frage: 'Wollen die Menschen das?', farbe: 'yellow' },
      { t: 'Machbar', frage: 'Können wir es bauen und betreiben?', farbe: 'blue' },
      { t: 'Wirtschaftlich', frage: 'Trägt es sich?', farbe: 'green' },
      { t: 'Bedienbar', frage: 'Kommen die Menschen damit zurecht?', farbe: 'purple' },
    ]} /></div>
    <ul class="gross dicht">
      <li data-schritt><strong>Wirtschaftlich:</strong> „Should we build it?“ – funktioniert für die Kundschaft, aber auch für euch?</li>
      <li data-schritt><strong>Blinder Fleck:</strong> An Wunsch und Bedienung denkt man, an die Kosten oft nicht.</li>
      <li data-schritt><strong>Benennen, nicht durchrechnen:</strong> ein Satz für die Map, keine Kalkulation.</li>
      <li data-schritt><strong>Getestet wird trotzdem zuerst,</strong> ob es jemand will.</li>
    </ul>
    <div class="nur-handout">
      <p>Teresa Torres: „Viability assumptions: Should we build it? There are many ideas that will work for our customers but won’t work for our business.“ ({TORRES}, S. 118). Sie zählt fünf Arten von Annahmen, neben Wünschbarkeit, Wirtschaftlichkeit, Machbarkeit und Bedienbarkeit auch ethische (S. 118); die Annahmen-Map der Werkstatt arbeitet wie an Tag 1 mit Cagans vier; „ethisch“ (Kann es schaden?) gibt es dort als Ergänzung.</p>
      <p>Der blinde Fleck ist bei jedem Team ein anderer: „most teams have a bias toward one category or another“. Ein Muster, das Torres nennt: „Or they always remember desirability and usability, but they forget viability.“ (S. 128). Darum kommt die wirtschaftliche Annahme jetzt auf die Map – bevor ihr an der Experiment-Karte die riskanteste wählt.</p>
      <p><strong>Kursentscheidung: nur ein kurzer Block.</strong> Cagan nennt Preis, Kanäle und Kosten echte Risiken, aber: „while these are real risks, they are largely academic at this stage“ ({CAGAN}, S. 189). Das größte Risiko sei das Wertrisiko, „discovering a compelling solution to customers. A solution that your customers will choose to buy and use.“, und „you don’t need to spend your time doing pricing optimization testing, sales tools, marketing programs, and cutting costs, until and unless you have discovered a truly valuable product.“ (S. 190). Gassmann u. a.: „weniger Business-Plan, dafür mehr haptische Realisierung“ ({GASSMANN}, I-2.5). Ihr benennt das Modell und seine Annahme, ihr rechnet es nicht durch.</p>
      <p>Getestet wird in Blands Reihenfolge: zuerst Wünschbarkeit, dann Machbarkeit, dann Wirtschaftlichkeit ({BLAND}, S. 34–35, 39). Bei der Kaffeebar kommt deshalb A5 (bestellen sie im Gehen?) zuerst dran, nicht A4 – siehe <a href="/innolab/methoden/experiment#beispiel">Experiment-Karte</a>.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="dreieck">Wer, Was, Wie, Wert</h2>
    <p class="folie-satz">Ein Geschäftsmodell beantwortet vier Fragen – zwei habt ihr schon.</p>
    <BildText>
      <BuchAbbildung src="/quellen/gassmann/dreieck.jpg" alt="Dreieck mit WER? in der Mitte und WAS?, WIE? und WERT? an den Ecken; dazwischen die Felder Nutzenversprechen, Wertschöpfungskette und Ertragsmechanik, außen die vier Fragen" quelle={`Das magische Dreieck. ${GASSMANN_KURZ}, Bild 1.2.`} />
      <ul>
        <li data-schritt><strong>Wer?</strong> Eure Zielkundschaft – steht im Kundenprofil.</li>
        <li data-schritt><strong>Was?</strong> Euer Angebot – steht in der Value Map.</li>
        <li data-schritt><strong>Wie?</strong> Was ihr braucht und tut, um es zu liefern. Neu heute.</li>
        <li data-schritt><strong>Wert?</strong> Wer zahlt wofür – und was kostet es. Neu heute.</li>
      </ul>
    </BildText>
    <div class="nur-handout">
      <p>Gassmann, Frankenberger und Csik beschreiben ein Geschäftsmodell mit vier Dimensionen: <em>Wer</em> sind unsere Zielkunden? <em>Was</em> bieten wir ihnen an (Nutzenversprechen)? <em>Wie</em> stellen wir die Leistung her (Prozesse, Aktivitäten, Ressourcen, Fähigkeiten)? <em>Wie wird Wert erzielt</em> (Ertragsmechanik: „Kostenstruktur und die Umsatzmechanismen“)? Die Kundschaft steht in der Mitte – „immer und ohne Ausnahme“. Die ersten beiden Fragen betreffen die externe Seite, die letzten beiden die interne. Magisch ist das Dreieck, weil sich keine Ecke ändern lässt, ohne dass die anderen nachziehen ({GASSMANN}, I-1.2). Für Workshops sei das einfache Modell „zielführender als komplexe Canvas-Strukturen, da fokussierter diskutiert wird“ (I-1.2). Ihre Checkliste für ein neues Modell nennt unter Wie? auch Partner (Tabelle 2.2, I-2.4.1).</p>
      <p>Ziel jeder Geschäftsmodellinnovation ist, Wert zu schaffen und abzuschöpfen, „in den Worten eines uns bekannten CEOs: ‚Create value, capture value.‘“ (I-1.2). Darum ist Wert? eine eigene Frage. Für Apps heißt das: Über die Hälfte aller App-Entwickler verdient weniger als 1.000 US-Dollar im Monat – ein gutes Produkt allein ergibt noch kein tragfähiges Geschäftsmodell (I-2.2.2).</p>
      <p><strong>Unser Abgleich</strong> mit Value Proposition Design (eigene Zuordnung des Kurses): Kundensegment = Wer?, Wertversprechen = Was?, Schlüsselressourcen, -aktivitäten und -partner = Wie?, Einnahmequellen und Kostenstruktur = Wert? ({VPD}, S. 27–28 PDF). Das Business Model Canvas hat dazu Kanäle und Kundenbeziehungen, die im Dreieck keine eigene Ecke haben. Wer? und Was? habt ihr also schon; heute kommen Wie? und Wert? dazu.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="modell">Am Beispiel: Wie? und Wert? der Kaffeebar</h2>
    <MiroFrame name="T4 · 7 · Geschäftsmodell · Kaffeebar" />
    <p class="folie-satz">Wer? und Was? stehen schon – neu sind zwei Zeilen.</p>
    <div style="overflow-x:auto">
      <table class="gm-modell">
        <thead><tr><th>Frage</th><th>Kaffeebar</th><th>Steht in</th></tr></thead>
        <tbody>
          <tr class="muted"><th>Wer?</th><td>Pendler*innen, 7:15–7:45</td><td>Kundenprofil</td></tr>
          <tr class="muted"><th>Was?</th><td>Im Gehen bestellen, „fertig vor der Abfahrt“</td><td>Value Map</td></tr>
          <tr data-schritt><th>Wie?</th><td>Bestellseite, Aufsteller mit Code, Bildschirm, Express-Ausgabe</td><td>neu</td></tr>
          <tr data-schritt><th>Wert?</th><td><strong>Ertrag:</strong> Kaffee zum normalen Preis, bezahlt an der Ausgabe.<br /><strong>Kosten:</strong> Aufsteller, Bildschirm, Betrieb der Seite – keine weitere Kraft.<br /><strong>Heute</strong> zahlt die Kundschaft an der Theke.</td><td>neu</td></tr>
        </tbody>
      </table>
    </div>
    <div class="nur-handout">
      <p>Wer? und Was? stehen schon fest: Pendler*innen zwischen 7:15 und 7:45 (Kundenprofil) und Bestellen im Gehen mit der Zusage „fertig vor der Abfahrt“ (Value Map). Wie? und Wert? folgen Gassmanns Checkliste für das neue Modell: bei Wie? Ressourcen, Aktivitäten und Partner, bei Wert? die Kostentreiber („Welches sind die wesentlichen Kosten in unserem Geschäftsmodell?“) und die Ertragsströme („Wofür ist der Kunde bereit zu bezahlen? Wie bezahlen die Kunden momentan?“) ({GASSMANN}, Tabelle 2.2). Die Kosten stehen deshalb bei Wert?, nicht bei Wie?: Die Ertragsmechanik umfasst „Kostenstruktur und die Umsatzmechanismen“ (I-1.2). Bezahlt wird wie in Slice 1 der <a href="/innolab/methoden/story-map">Story Map</a> an der Ausgabe.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="annahme">Die Linie zum Geld – daraus wird die Annahme</h2>
    <p class="folie-satz">Mehr Kaffee im Zug ist noch kein Geschäft: Dazwischen steht ein „weil“.</p>
    <Linie label="Linie durch den Baum der Kaffeebar: Lösung, Ziel-Chance, Outcome, Impact; der letzte Pfeil trägt das „weil“" weil={2} knoten={[
      { art: 'Lösung', t: 'Im Gehen bestellen' },
      { art: 'Ziel-Chance', t: '„Geht sich ein Kaffee noch aus?“' },
      { art: 'Outcome', t: 'Mehr Pendler*innen mit Kaffee im Zug' },
      { art: 'Impact', t: 'Mehr Umsatz am Morgen' },
    ]} />
    <ul class="gross dicht">
      <li data-schritt><strong>Linie:</strong> … führt zu mehr Umsatz, weil die zusätzlichen Bestellungen mehr einbringen, als sie kosten.</li>
      <li data-schritt><strong>A4:</strong> „Wir glauben, dass die zusätzlichen Bestellungen mehr einbringen, als Aufsteller, Bildschirm und Bestellseite kosten – ohne weitere Kraft am Morgen.“</li>
      <li data-schritt><strong>In der Map:</strong> wirtschaftlich · Wichtigkeit hoch · Beleg: noch keiner.</li>
      <li data-schritt><strong>Ertrag über den Kosten</strong> – nicht bloß „mehr Umsatz“.</li>
    </ul>
    <div class="nur-handout">
      <p>Die Annahme findet ihr, indem ihr die Linie eures Baums abschreitet. Torres: „Another way to generate assumptions, particularly viability assumptions, is to use your opportunity solution tree to work backwards from your solution back to your outcome.“ Ein Satzanfang dafür: „Addressing the target opportunity will drive the desired outcome because…“ ({TORRES}, S. 125). Bei einem Produkt-Outcome kommt die Verbindung zum Geschäft dazu: „we might also need to test the assumptions connecting our product outcome to our business outcome to uncover viability assumptions.“ Torres’ Beispiel: „The cost of adding local channels will be offset by the gain from more renewals.“ (S. 126). Torres’ <em>business outcome</em> heißt im Kurs <em>Impact</em>, wie im Problem-Rahmen.</p>
      <p>Bei der Kaffeebar ist das die Linie vom Outcome „mehr Pendler*innen mit Kaffee im Zug“ zum Impact „mehr Umsatz am Morgen“ aus dem <a href="/innolab/methoden/problem-rahmen">Problem-Rahmen</a>: Mehr Pendler*innen mit Kaffee führen zu mehr Umsatz, <em>weil</em> die zusätzlichen Bestellungen mehr einbringen, als sie kosten. Dieses „weil“ ist die Annahme. In die Map kommt sie wie jede andere als „Wir glauben, dass …“ – und zwar das, was ihr prüfen wollt: Ertrag über den Kosten, nicht bloß mehr Umsatz.</p>
      <p><strong>Kursregel:</strong> In der Annahmen-Map steht diese Annahme seit Tag 1 als A4 („rechnet sich ohne weitere Kraft“), als unwichtig und mit Beleg „getan“ – damals war der heutige Betrieb gemeint. Mit den Kosten vor Augen bewertet ihr sie neu: Wichtigkeit hoch; für zusätzliche Bestellungen mit neuen Kosten gibt es noch keinen Beleg. Neben ihr steht A2, die Machbarkeit (40 Bestellungen in 30 Minuten). Beide stehen auf der Map, wenn ihr gleich an der Experiment-Karte die riskanteste Annahme wählt.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="vorgehen">So geht ihr vor (10 min)</h2>
    <p class="folie-satz">Zwei Zeilen, eine Linie, ein Satz.</p>
    <ol class="gross dicht">
      <li data-schritt><strong>Wie? und Wert? schreiben:</strong> was ihr braucht, wer wofür zahlt, die größten Kosten als Posten. <Timer minuten={4} /></li>
      <li data-schritt><strong>Linie abschreiten:</strong> „[Outcome] führt zu [Impact], weil …“ <Timer minuten={2} /></li>
      <li data-schritt><strong>Annahme schreiben:</strong> „Wir glauben, dass …“ – Ertrag über den Kosten. <Timer minuten={2} /></li>
      <li data-schritt><strong>In die Annahmen-Map:</strong> Art „wirtschaftlich“, Wichtigkeit, Beleg. <Timer minuten={2} /></li>
    </ol>
    <p class="small">Schritt 1–3 auf Miro in eurem Frame „T4 · 7 · Geschäftsmodell · Produkt n“: <MiroLink name="T4 · 7 · Geschäftsmodell · Produkt 1">Produkt 1</MiroLink> · <MiroLink name="T4 · 7 · Geschäftsmodell · Produkt 2">Produkt 2</MiroLink> · <MiroLink name="T4 · 7 · Geschäftsmodell · Produkt 3">Produkt 3</MiroLink>. Schritt 4 in der Werkstatt.</p>
    <p class="nur-handout">Davor rund acht Minuten Theorie, die Folien bis hierher; danach zwei Minuten Übertrag. Wer? und Was? verweisen auf Kundenprofil und Value Map, ihr schreibt sie nicht neu. Jede*r arbeitet allein am eigenen Produkt; Markus fragt im 1:1 nach. Die Annahme kommt in der Werkstatt als Art „wirtschaftlich“ in die Annahmen-Map, mit Wichtigkeit und Beleg – direkt danach wählt ihr an der Experiment-Karte die riskanteste. Prüfen mit der Liste unten ist Hausaufgabe.</p>
  </Folie>

  <div class="nur-handout">
  <h2 id="vorlage">So sieht euer Frame aus</h2>
  <p>Euer Geschäftsmodell steht nur auf Miro, in eurem Frame „T4 · 7 · Geschäftsmodell · Produkt n“ – eine Datei gibt es nicht. Die Felder:</p>
  <ul>
    <li><strong>Wer?</strong> → Kundenprofil: euer Segment, nur als Verweis.</li>
    <li><strong>Was?</strong> → Value Map: euer Angebot, nur als Verweis.</li>
    <li><strong>Wie?</strong> Ressourcen, Aktivitäten, Partner.</li>
    <li><strong>Wert?</strong> Ertrag: wer zahlt wofür; wie die Kundschaft heute bezahlt. Kosten: die größten Posten.</li>
    <li><strong>Linie:</strong> [Outcome] führt zu [Impact], weil …</li>
    <li><strong>Annahme (wirtschaftlich):</strong> Wir glauben, dass … (A[n]) – dieselbe Annahme steht in der Annahmen-Map der Werkstatt.</li>
  </ul>

  <h2 id="pruefen">Prüfen</h2>
  <p>Euer Modell liegt auf Miro: Nehmt den Weg „Ohne Claude Code: Text in Claude einfügen“ und fügt den Text aus eurem Frame ein – oder einen Screenshot des Frames. Wählt dafür Opus (in Claude Code <code>/model opus</code>, auf claude.ai im Modellmenü).</p>
  <ClaudePruefung slug="geschaeftsmodell" />
  </div>

  <Folie>
    <h2 id="uebertrag">Übertrag auf euer Produkt</h2>
    <p class="folie-satz">Wer zahlt bei euch – die Menschen, die es nutzen, oder jemand anderes?</p>
    <ul class="gross">
      <li data-schritt>Woran hängt euer Modell: an einer Zahl, die ihr heute nicht kennt?</li>
      <li data-schritt>Zahlt niemand: Wozu trägt es dann bei?</li>
    </ul>
    <div class="nur-handout">
      <p>Die Zahl, die ihr nicht kennt, steht jetzt als wirtschaftliche Annahme in eurer Annahmen-Map; welche Annahme zuerst getestet wird, entscheidet ihr an der Experiment-Karte. Wer zahlt, muss nicht wer nutzt: Gassmanns Checkliste fragt bei Wer? zuerst „Wer sind unsere Zielkunden?“ und gleich danach „Für wen generieren wir (zusätzlichen) Wert?“ ({GASSMANN}, Tabelle 2.2).</p>
      <p>Nicht jede Idee muss selbst Geld bringen: „some ideas are designed to be loss leaders and instead contribute to another business goal besides revenue.“ ({TORRES}, S. 118). Dann schreibt ihr bei Wert?, zu welchem Ziel sie beiträgt. Wisst ihr nicht, wer zahlen könnte, helfen die <a href="#musterkarten">Musterkarten</a> unten.</p>
    </div>
  </Folie>

  <div class="nur-handout">
    <h2 id="musterkarten">Wenn ihr nicht wisst, wer zahlt: Musterkarten nach Gassmann</h2>
    <p>Zum Nachschlagen, keine Kurszeit. Ein Geschäftsmodellmuster ist „eine bestimmte Konfiguration der vier Kernelemente (Wer-Was-Wie-Wert?) eines Geschäftsmodells, welche sich in verschiedenen Firmen und Industrien als erfolgreich erwiesen hat“. Gassmann u. a. fanden heraus, dass „rund 90 Prozent der Geschäftsmodellinnovationen Rekombinationen von Elementen von 55 bereits bestehenden Geschäftsmodellen“ sind; neu ist ein Muster nur für die eigene Branche – „Kapieren geht vor Kopieren“ ({GASSMANN}, I-2.1).</p>
    <BildText>
      <BuchAbbildung src="/quellen/gassmann/add-on.jpg" alt="Zeichnung einer Flugzeugkabine: Sitzplatz, Gepäck und Getränk tragen je ein Preisschild mit Pluszeichen" quelle={`Das Muster Add-on (Ryanair). ${GASSMANN_KURZ}, Steckbrief II-1.1.`} schmal />
      <p>Ein Beispiel ist <strong>Add-on</strong>: Bei Ryanair wird die „Basis-Fare“ für Flugtickets günstig angeboten; extra kosten „Bordservice, Verpflegung (Essen und Trinken), Reiseversicherung, Priority Boarding, Extragepäck und Übergepäck“ (Steckbrief II-1.1). Die Preisschilder im Bild sind diese Extras.</p>
    </BildText>
    <p><strong>Konfrontation</strong> (I-2.3.2): Man wählt Muster, die sich „von der eigenen Branchenlogik grundlegend unterscheiden“ (im Buch sechs bis acht), und fragt je Muster: „Wie würde Firma xy unser Geschäft führen?“ – als hätte diese Firma „unser eigenes Unternehmen akquiriert“. Beispiel aus dem Buch: „Subscription: Wie würde Netflix unser Geschäft führen?“ Und: „Pro Karte müssen mehrere Ideen für das eigene Geschäftsmodell generiert werden.“ Gegenstück ist das Ähnlichkeitsprinzip mit Mustern aus analogen Branchen. Die Mottos stehen in Tabelle 2.1: Ähnlichkeit „Mache dir das Vertraute fremd“, Konfrontation „Mache dir das Fremde vertraut“. Handgeschriebene Karteikarten funktionieren genauso gut wie der gedruckte Satz der Autor*innen (I-2.3).</p>
    <p><strong>Kursauswahl: zwölf der 55 Muster.</strong> Die Frage auf jeder Karte: „Wie würde [Firma] unser Geschäft führen?“</p>
