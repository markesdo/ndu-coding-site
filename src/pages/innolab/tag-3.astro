---
import Layout from '../../layouts/Layout.astro';
import Orientierung from '../../components/Orientierung.astro';
import Block from '../../components/Block.astro';
import Callout from '../../components/Callout.astro';
import Checklist from '../../components/Checklist.astro';
import FooterNav from '../../components/FooterNav.astro';
---
<Layout title="Tag 3 · Lösung & Story">
  <span class="eyebrow">Innolab · Tag 3 · Samstag, 21. November 2026 · 09:00–17:30</span>
  <h1>Tag 3 · Lösung & Story</h1>
  <p class="lead">Aus den Momenten eurer Experience Map wächst ein Baum voller Chancen. Aus ihm wird eine Ziel-Chance, dazu ein Kundenprofil, an dem ihr Ideen messt. Dann eine Frage und drei Ideen als Lückensätze; eine wird der Spitzenreiter auf Papier – mit einem Angebot und seinem Fit. Zum Schluss die Theorie, wie daraus eine Geschichte mit Höhepunkt wird.</p>
  <Orientierung seite="innolab/tag-3" />

  <h2 id="ablauf">Ablauf</h2>
  <div class="schedule" data-kurstag="2026-11-21">
    <Block time="09:00–09:25" type="uebung" title="Experience Map nachschärfen" href="/innolab/tag-3/experience-map">Was ein Moment braucht: drei Anläufe der Kaffeebar, dann eure eigene Map – ihre Momente werden die Äste.</Block>
    <Block time="09:25–10:30" type="uebung" title="Opportunity Solution Tree" href="/innolab/methoden/baum">Chancen aus den Snapshots unter die Momente hängen, ordnen, Anti-Muster prüfen.</Block>
    <Block time="10:30–10:40" type="pause" title="Pause" />
    <Block time="10:40–11:30" type="uebung" title="Ziel-Chance wählen" href="/innolab/methoden/ziel-chance">Geschwister-Chancen durch vier Linsen vergleichen.</Block>
    <Block time="11:30–12:00" type="uebung" title="Kundenprofil" href="/innolab/methoden/kundenprofil">Jobs, Pains, Gains aus dem Baum, je Spalte geordnet – bevor es eine Idee gibt.</Block>
    <Block time="12:00–13:00" type="pause" title="Mittagspause" />
    <Block time="13:00–13:30" type="uebung" title="How Might We" href="/innolab/methoden/hmw">Von der Ziel-Chance zur Frage, die Ideen öffnet.</Block>
    <Block time="13:30–13:35" type="pause" title="Pause" />
    <Block time="13:35–15:05" type="uebung" title="Ideation" href="/innolab/methoden/ideation">15 bis 20 Ideen für eine Chance, drei davon als Lückensätze gegen euer Profil.</Block>
    <Block time="15:05–15:15" type="pause" title="Pause" />
    <Block time="15:15–16:00" type="uebung" title="Value Map & Fit" href="/innolab/methoden/value-map">Drei Lückensätze vergleichen, Spitzenreiter wählen, seine Value Map ordnen und den Fit prüfen.</Block>
    <Block time="16:00–16:30" type="konzept" title="Der Story-Bogen" href="/innolab/methoden/concept-story#story-bogen">Sieben Stationen, A × B = C, flach oder hoch – heute nur Theorie.</Block>
    <Block time="16:30–17:15" type="uebung" title="Puffer">Nachholen, was vom Tag offen ist: Baum, Ziel-Chance, Kundenprofil, Value Map.</Block>
    <Block time="17:15–17:30" type="plenum" title="Abschluss" href="#abschluss">Rückblick, Entscheidungslog, Ausblick auf Tag 4.</Block>
  </div>

  <hr />
  <h2 id="faden">Wo ihr im roten Faden steht</h2>
  <p>Heute werden aus <strong>Chancen</strong> <strong>Lösungen</strong>. Tag 2 endete nach der Experience Map; ihre Momente sind die Äste eures Baums. Zuerst schärft ihr die Momente eurer Map nach (<a href="/innolab/tag-3/experience-map">Experience Map nachschärfen</a>). Dann geht ihr den Weg von Teresa Torres weiter, den ihr an Tag 2 begonnen habt: Baum → Ziel-Chance. Bevor ihr Ideen sucht, schreibt ihr das Kundenprofil – so beschreibt es die Menschen und nicht eure Ideen. Danach HMW und Ideation; die drei Ideen schreibt ihr als Lückensätze gegen dieses Profil. Die Value Map zeigt, welche davon heute euer Spitzenreiter auf Papier wird und was ihr Fit offen lässt. Die Concept Story – warum das jemanden interessiert – lernt ihr heute als Theorie kennen; eine eigene schreibt ihr heute noch nicht. Wer dafür zahlt (Geschäftsmodell) und an welcher Annahme die Idee hängt (Experiment-Karte), klärt ihr zu Beginn von Tag 4; dort folgen auch Story Map, Usage Story und Prototyp.</p>
  <Callout type="info" title="Heute noch ohne Claude Pro">
    <p>Claude Pro schließt ihr erst am Morgen von Tag 4 neu ab (<a href="/setup#claude-pro">wie</a>), denn Claude Code braucht ihr zum ersten Mal an Tag 4: für das Pre-Mortem der Experiment-Karte um 9:20, danach für den Prototyp. Heute reicht Claude im Free-Plan: Den Baum prüft Claude an einem Bild aus Miro. Wo eine Seite „Prüfen lassen · Claude Code“ anbietet, nehmt ihr den Weg „Ohne Claude Code: Text in Claude einfügen“. Die Dateien in <code>docs/</code> legt ihr in VS Code an; committen und pushen geht dort über <em>Source Control</em>.</p>
  </Callout>

  <h2 id="methoden">Die Methoden von heute</h2>
  <ul>
    <li><a href="/innolab/tag-3/experience-map">Experience Map nachschärfen</a> – Schritt + Gefühl + Zitat = Moment</li>
    <li><a href="/innolab/methoden/baum">Opportunity Solution Tree</a> – Chancen unter die Momente, geordnet und geprüft</li>
    <li><a href="/innolab/methoden/ziel-chance">Ziel-Chance wählen</a> – vier Linsen nach Torres</li>
    <li><a href="/innolab/methoden/kundenprofil">Kundenprofil</a> – Jobs, Pains, Gains aus eurem Baum, je Spalte geordnet</li>
    <li><a href="/innolab/methoden/hmw">How Might We</a> – die Frage zur Ziel-Chance</li>
    <li><a href="/innolab/methoden/ideation">Ideation</a> – 15 bis 20 Ideen, drei als Lückensätze</li>
    <li><a href="/innolab/methoden/value-map">Value Map & Fit</a> – Spitzenreiter wählen, seine Value Map ordnen, Fit prüfen</li>
    <li><a href="/innolab/methoden/concept-story">Concept Story</a> – heute nur Theorie: wie eine Geschichte zeigt, warum es besser ist als das, was Menschen heute tun</li>
  </ul>

  <h2 id="abschluss">Abschluss & bis Tag 4</h2>
  <p>Bevor ihr geht:</p>
  {/* -v3: Die Häkchen hängen an der Position (Checklist.astro ohne ids). Seit 12.11.2026 mit dem Baum, ohne Geschäftsmodell
      und Experiment-Karte (-v2); seit 20.11.2026 ohne Concept Story, die an Tag 3 nur Theorie ist (-v3) – alte Häkchen
      sollen nicht an verschobenen Punkten hängen. */}
  <Checklist id="il-tag3-abschluss-v3" items={[
    'Euer Baum auf Miro (Baum · euer Name): jede Chance mit Zitat-ID, jede Karte mit einer Linie',
    '<code>docs/ZIEL-CHANCE.md</code> (so weit wie im Raum geschafft), <code>KUNDENPROFIL.md</code>, <code>HMW.md</code>, <code>IDEEN.md</code> und <code>VALUE-MAP.md</code> im Repo',
    'Eine Zeile pro Entscheidung von heute im Entscheidungslog der Werkstatt',
    'Committet und gepusht',
  ]} />
  <p><strong>Bis Tag 4:</strong> <code>docs/ZIEL-CHANCE.md</code> fertig schreiben und mit Claude prüfen (<a href="/innolab/methoden/ziel-chance#pruefen">Prüfen</a>) – im Raum reicht die Zeit dafür nicht.</p>
  <p><a href="/innolab/tag-4">Tag 4</a> am 28. November beginnt mit dem Geschäftsmodell und der Experiment-Karte: wer zahlt, und an welcher Annahme der Spitzenreiter hängt. Dann wird aus ihm ein Plan (Story Map), ein Kernablauf (Usage Story) und ein erster Prototyp, den ihr testen könnt. Am Nachmittag spielt ihr Scrum einmal mit Lego durch.</p>
  <p><strong>Claude Pro:</strong> am Morgen des 28. November neu abschließen und gleich wieder kündigen, nicht früher (<a href="/setup#claude-pro">wie</a>). An Tag 4 braucht ihr Claude Code gleich am Vormittag.</p>

  <FooterNav prev={{ href: '/innolab/tag-2', t: 'Tag 2 · Kunde & Erlebnis' }} next={{ href: '/innolab/tag-3/experience-map', t: 'Experience Map nachschärfen' }} />
</Layout>
