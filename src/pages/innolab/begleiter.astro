---
// Präsentator-Begleiter: auf dem Tablet neben dem Beamer. Zeigt zu einer Folie von Tag 1 oben, was Markus sagt (live),
// darunter die Vorbereitung. Folgt der Position, die der Beamer-Tab an /api/position meldet (wo-ist.ts); von Hand
// blättern pausiert das Folgen. Folienliste aus den Seitenquellen (lib/begleiter.ts), Notizen aus data/begleiter/.
// Eigenes schlankes Gerüst statt Layout.astro: ohne Seitenleiste, Beamer-Modus und „Markus ist bei …“-Knopf.
// Liegt hinter dem Kurspasswort wie alles unter /innolab; verlinkt nur beim Präsentator (PraesentatorEinstieg.astro).
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/global.css';
import { CalendarClock, ChevronLeft, ChevronRight, CircleQuestionMark, ExternalLink, Eye, LayoutGrid, Play, Timer, Undo2 } from '@lucide/astro';
import Quelle from '../../components/BegleiterQuelle.astro';
import { NOTIZEN } from '../../data/begleiter';
import { TAG_1 } from '../../data/begleiter/tag';
import { ablaufBloecke, folienPlan, hhmm, kurstagAus, quellenAusGlob, seitenLabel, stichwortForm, streichVerweis, tagFolien, uebungMinuten } from '../../lib/begleiter';
import { teamFrameLink } from '../../lib/team-board';

// Glob vom Projektwurzel aus (wie in lib/begleiter.test.ts), damit die Schlüssel nicht vom Ordner dieser Datei abhängen.
const quellen = quellenAusGlob(import.meta.glob('/src/pages/innolab/**/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>);
const folien = tagFolien(quellen);
// Ohne Folien wäre die Seite leer und das Folgen sinnlos – lieber den Build abbrechen.
if (folien.length === 0) throw new Error('Begleiter: keine Folien von Tag 1 gefunden (Glob oder Seitenpfade geändert?)');
// Soll-Zeit je Folie aus dem Ablauf von Tag 1 (Übungen mit ihrer Dauer); Kurstag, damit „vorn/hinten“ nur an dem Tag erscheint.
// Ohne Ablauf (Quelle fehlt oder keine Blöcke) bricht ablaufBloecke den Build ab.
const ablauf = quellen['/innolab/tag-1'];
const bloecke = ablaufBloecke(ablauf);
const minutenJe = folien.map((f) => uebungMinuten(NOTIZEN[f.pfad]?.[f.id]?.uebung?.dauer));
const plan = folienPlan(folien, bloecke, (i) => minutenJe[i]);
const kurstag = kurstagAus(ablauf ?? '');
const seitenName = (pfad: string) => seitenLabel(pfad, quellen[pfad] ?? '');
const gruppen = [...new Set(folien.map((f) => f.pfad))].map((pfad) => ({
  pfad, name: seitenName(pfad), folien: folien.map((f, i) => ({ ...f, i })).filter((f) => f.pfad === pfad),
}));
// Streich-Eintrag der Tageskarte → Index der Folie in seinem Block, damit „(toast)“ dorthin blättert.
const folieImBlock = (block: string, id: string) => folien.findIndex((f, i) => plan[i]?.block === block && (f.id === id || f.unterIds.includes(id)));
---
<!doctype html>
<html lang="de" data-bereich="innolab">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <title>Begleiter · Innolab</title>
    <link rel="icon" href="/favicon-innolab.svg" type="image/svg+xml" />
  </head>
  <body class="begleiter">
    <nav class="steuer" aria-label="Folien">
      <button type="button" class="btn rund" data-zurueck aria-label="Vorige Folie" title="Vorige Folie (←)"><ChevronLeft size={22} aria-hidden="true" /></button>
      <select data-liste aria-label="Folie wählen">
        {gruppen.map((g) => (
          <optgroup label={g.name}>
            {g.folien.map((f) => <option value={f.i}>{f.i + 1}. {f.titel}</option>)}
          </optgroup>
        ))}
      </select>
      <button type="button" class="btn rund" data-weiter aria-label="Nächste Folie" title="Nächste Folie (→)"><ChevronRight size={22} aria-hidden="true" /></button>
      <button type="button" class="btn folgen" data-folgen data-meldung="frage"><span class="punkt" aria-hidden="true"></span><Undo2 class="zurueck-icon" size={18} aria-hidden="true" /> <span data-folgen-text>Frage den Beamer …</span></button>
      <button type="button" class="btn klein" data-nur-live aria-pressed="false" title="Vorbereitung ausblenden, nur den Live-Block zeigen"><Eye size={18} aria-hidden="true" /> <span>Nur live</span></button>
      <button type="button" class="btn klein" data-tag-auf title="Tageskarte: Ablauf, Lernziele, Streichliste, Material"><CalendarClock size={18} aria-hidden="true" /> <span>Tag</span></button>
      <button type="button" class="btn lage" data-lage data-kurstag={kurstag} hidden></button>
      <button type="button" class="btn uhr" data-uhr title="Uhrzeit; läuft ein Übungs-Timer, hier tippen zum Stoppen">--:--</button>
      <p class="sr-only" data-status role="status"></p>
    </nav>

    <dialog class="tageskarte" data-tageskarte aria-labelledby="tageskarte-titel">
      <div class="tk-kopf">
        <h1 id="tageskarte-titel">Tag 1 <span>Ablauf, Lernziele, Material</span></h1>
        <form method="dialog"><button class="btn" aria-label="Tageskarte schließen">Schließen</button></form>
      </div>
      <ol class="tk-bloecke">
        {bloecke.map((b) => {
          const t = TAG_1.bloecke[b.titel];
          return (
            <li class:list={[{ pause: !b.href }]} data-von={b.von} data-bis={b.bis}>
              <p class="tk-zeit">{hhmm(b.von)}–{hhmm(b.bis)} · <strong>{b.titel}</strong></p>
              {t && <p class="tk-ziel">{t.lernziel}</p>}
              {t?.streichen && t.streichen.length > 0 && (
                <div class="tk-streichen"><span>Wenn hinten:</span><ul>{t.streichen.map((x) => {
                  const v = streichVerweis(x);
                  const ziel = v.id ? folieImBlock(b.titel, v.id) : -1;
                  return <li>{ziel >= 0 ? <>{v.text} <button type="button" class="tk-folie" data-springe={ziel} title={`Zu Folie ${ziel + 1}: ${folien[ziel].titel}`}>{folien[ziel].titel}{v.zusatz}</button></> : x}</li>;
                })}</ul></div>
              )}
            </li>
          );
        })}
      </ol>
      {TAG_1.material.length > 0 && (
        <>
          <h2>Material und Technik</h2>
          <ul class="tk-material">
            {TAG_1.material.map((m) => (
              <li><label><input type="checkbox" data-material={m.id} /> <span>{m.was} <span class="tk-wann">({m.wann})</span></span></label></li>
            ))}
          </ul>
        </>
      )}
    </dialog>

    <main>
      {folien.map((f, i) => {
        const n = NOTIZEN[f.pfad]?.[f.id];
        const naechste = folien[i + 1];
        const frameLink = n?.miro?.frame ? teamFrameLink(n.miro.frame) : null;
        return (
          <article data-index={i} hidden={i !== 0} data-plan-folie={plan[i] ? JSON.stringify(plan[i]) : undefined}>
            <header class="kopf">
              <p class="seite"><span class="nr">{i + 1}/{folien.length}</span> <span data-plan-text>{seitenName(f.pfad)}</span> <a class="oeffnen" href={`${f.pfad}#${f.id}`} target="_blank" rel="noopener" aria-label="Folie öffnen (neuer Tab)" title="Folie öffnen"><ExternalLink size={16} aria-hidden="true" /></a></p>
              <h1>{f.titel}</h1>
              {f.satz && <p class="satz">{f.satz}</p>}
            </header>

            <section class="live" aria-label="Live">
              {n ? (
                <>
                  <ul class="stichworte">{n.live.map((s) => {
                    const st = stichwortForm(s);
                    return (
                      <li class:list={[{ zitat: st.zitat }]} data-takt={st.takt ?? undefined}>
                        {st.cue && <><b class="cue">{st.cue}:</b> </>}{st.rest}{st.takt !== null && <span class="takt-zeit" aria-hidden="true"></span>}
                      </li>
                    );
                  })}</ul>
                  {n.verstaendnis && (
                    <div class="check">
                      <p class="frage"><CircleQuestionMark size={20} aria-hidden="true" /> <span><span class="label">Frag den Raum:</span> {n.verstaendnis.frage}</span></p>
                      {n.verstaendnis.falsch && <p class="falsch"><span>Häufig falsch:</span> {n.verstaendnis.falsch}</p>}
                      <details>
                        <summary>Antwort</summary>
                        <p>{n.verstaendnis.antwort}</p>
                      </details>
                    </div>
                  )}
                  {n.uebung && (n.uebung.dauer || n.uebung.form) && (
                    minutenJe[i]
                      ? <button type="button" class="sozial" data-timer={minutenJe[i]} title={`Timer ${minutenJe[i]} min starten`}><Timer size={20} aria-hidden="true" /> {[n.uebung.dauer, n.uebung.form].filter(Boolean).join(' · ')} <span class="start"><Play size={16} aria-hidden="true" /> Timer</span></button>
                      : <p class="sozial"><Timer size={20} aria-hidden="true" /> {[n.uebung.dauer, n.uebung.form].filter(Boolean).join(' · ')}</p>
                  )}
                </>
              ) : (
                <p class="leer">Zu dieser Folie gibt es noch keine Notizen.</p>
              )}
              {(n?.ueberleitung || naechste) && (
                <div class="weiter">
                  {n?.ueberleitung && <p class="ueberleitung">{n.ueberleitung}</p>}
                  {naechste && <p class="naechste"><span>Als Nächstes:</span> <strong>{naechste.titel}</strong>{naechste.pfad !== f.pfad && ` (${seitenName(naechste.pfad)})`}</p>}
                </div>
              )}
              {n?.miro && (
                <div class="miro">
                  <h2><LayoutGrid size={18} aria-hidden="true" /> In Miro{n.miro.frame && ':'} {n.miro.frame && (frameLink
                    ? <a href={frameLink} target="_blank" rel="noopener noreferrer"><strong>{n.miro.frame}</strong> <ExternalLink size={14} aria-hidden="true" /><span class="sr-only">(öffnet in neuem Tab)</span></a>
                    : <strong>{n.miro.frame}</strong>)}</h2>
                  <details>
                    <summary>Schritte{n.miro.vorschlaege && n.miro.vorschlaege.length > 0 && ' und Vorschläge'}</summary>
                    <ul>{n.miro.schritte.map((s) => <li>{s}</li>)}</ul>
                    {n.miro.vorschlaege && n.miro.vorschlaege.length > 0 && (
                      <>
                        <h3>Vorschläge für die Kaffeebar</h3>
                        <ul class="zettel">{n.miro.vorschlaege.map((s) => <li>{s}</li>)}</ul>
                      </>
                    )}
                  </details>
                </div>
              )}
            </section>

            {n && (n.kern || n.geschichte || n.zusatz || n.fragen || n.ablauf) && (
              <section class="vorbereitung" aria-label="Vorbereitung">
                {n.kern && n.kern.length > 0 && (
                  <div class="vb">
                    <h2>Kern aus der Quelle</h2>
                    {n.kern.map((k) => <p>{k.text} <Quelle q={k.quelle} /></p>)}
                  </div>
                )}
                {n.geschichte && (
                  <div class="vb">
                    <h2>Zum Erzählen</h2>
                    <p>{n.geschichte.text} <Quelle q={n.geschichte.quelle} /></p>
                  </div>
                )}
                {n.zusatz && n.zusatz.length > 0 && (
                  <div class="vb">
                    <h2>Zusatzfälle</h2>
                    {n.zusatz.map((z) => (
                      <div class="zusatz">
                        <p class="etikett">Zusatz, nicht aus den Kursquellen</p>
                        <h3>{z.titel}</h3>
                        <p>{z.text} <Quelle q={z.quelle} /></p>
                      </div>
                    ))}
                  </div>
                )}
                {n.fragen && n.fragen.length > 0 && (
                  <div class="vb">
                    <h2>Erwartbare Fragen</h2>
                    <dl>{n.fragen.map((q) => <><dt>{q.frage}</dt><dd>{q.antwort}</dd></>)}</dl>
                  </div>
                )}
                {n.ablauf && (
                  <div class="vb">
                    <h2>Übung</h2>
                    {n.ablauf.schritte && <><h3>Ablauf</h3><ol>{n.ablauf.schritte.map((s) => <li>{s}</li>)}</ol></>}
                    {n.ablauf.achten && <><h3>Worauf achten</h3><ul>{n.ablauf.achten.map((s) => <li>{s}</li>)}</ul></>}
                    {n.ablauf.fehler && <><h3>Typische Fehler</h3><ul>{n.ablauf.fehler.map((s) => <li>{s}</li>)}</ul></>}
                    {n.ablauf.aufloesung && <><h3>Auflösung</h3><p>{n.ablauf.aufloesung}</p></>}
                  </div>
                )}
              </section>
            )}
          </article>
        );
      })}
    </main>

    <script>
      import { anzeige, type Ereignis, type Zustand } from '../../components/begleiter-anzeige';
      import { folieZu, hhmm, tempo, wischErlaubt, type Folie, type PlanFolie } from '../../lib/begleiter';
      import { abfrageKette, jsonHolen } from '../../lib/kette';
      import { ABFRAGE_MS, ABFRAGE_TIMEOUT_MS, RUHIG_MS, alterText, naechsteAbfrage, positionPruefen } from '../../lib/position';

      const artikel = [...document.querySelectorAll<HTMLElement>('main > article')];
      // Folienliste für folieZu: beim Bauen als JSON in die Seite geschrieben (unten, begleiter-folien).
      const folien = JSON.parse(document.getElementById('begleiter-folien')!.textContent!) as Folie[];
      const liste = document.querySelector<HTMLSelectElement>('[data-liste]')!;
      const folgenKnopf = document.querySelector<HTMLButtonElement>('[data-folgen]')!;
      const folgenText = document.querySelector<HTMLElement>('[data-folgen-text]')!;
      const status = document.querySelector<HTMLElement>('[data-status]')!;
      const uhrKnopf = document.querySelector<HTMLButtonElement>('[data-uhr]')!;
      const lageKnopf = document.querySelector<HTMLButtonElement>('[data-lage]')!;
      const plaene = artikel.map((a) => (a.dataset.planFolie ? (JSON.parse(a.dataset.planFolie) as PlanFolie) : null));

      let z: Zustand = { index: 0, folgen: true, meldung: 'frage' };
      let beamerTitel = '';
      let fehlerInFolge = 0;

      // Kurz im Knopf (passt in eine Zeile), ausführlich für Screenreader und im Tooltip.
      const KURZ: Record<string, string> = {
        frage: 'Frage den Beamer …', ok: 'Folgt dem Beamer', 'nicht-tag-1': 'Beamer nicht auf Tag 1',
        'keine-position': 'Beamer meldet nichts', 'keine-verbindung': 'Keine Verbindung', hand: 'Zum Beamer',
      };

      function zeichnen(vorher: number) {
        if (z.index !== vorher) {
          artikel[vorher].hidden = true;
          artikel[z.index].hidden = false;
          scrollTo({ top: 0 });
        }
        liste.value = String(z.index);
        const meldung = z.folgen ? z.meldung : 'hand';
        const lang = !z.folgen
          ? 'Von Hand geblättert, Folgen pausiert. Tippen: zurück zum Beamer'
          : {
                frage: 'Frage den Beamer …',
                ok: 'Folgt dem Beamer',
                'nicht-tag-1': `Beamer ist nicht auf Tag 1${beamerTitel ? `: ${beamerTitel}` : ''}`,
                'keine-position': 'Beamer meldet nichts',
                'keine-verbindung': 'Keine Verbindung zum Beamer, die letzte Folie bleibt stehen',
              }[z.meldung];
        folgenKnopf.dataset.meldung = meldung;
        folgenKnopf.title = z.folgen ? `${lang}. Tippen: hier stehen bleiben` : lang;
        folgenText.textContent = KURZ[meldung];
        if (status.textContent !== lang) status.textContent = lang;
        planZeichnen();
      }

      // Zeitplan in der Kopfzeile der Folie: Block und Rest bis Blockende (sonst Soll-Fenster der Folie für die
      // Vorbereitung). Am Kurstag zwischen Beginn und Ende zeigt der Knopf neben der Uhr nur die Abweichung von der
      // Soll-Zeit der gezeigten Folie (folienPlan in lib/begleiter.ts): +29 hinten, −5 vorn, ✓ im Plan.
      const kurstag = lageKnopf.dataset.kurstag ?? '';
      const zwei = (n: number) => String(n).padStart(2, '0');
      function planZeichnen() {
        const p = plaene[z.index];
        const zeile = artikel[z.index].querySelector<HTMLElement>('[data-plan-text]')!;
        let text = zeile.textContent ?? '';
        let lage = '';
        if (p) {
          const d = new Date();
          const heute = `${d.getFullYear()}-${zwei(d.getMonth() + 1)}-${zwei(d.getDate())}`;
          const jetzt = d.getHours() * 60 + d.getMinutes() + d.getSeconds() / 60;
          text = `${p.block} · ${hhmm(p.von)}–${hhmm(p.bis)} · Folie ca. ${hhmm(p.sollVon)}–${hhmm(p.sollBis)}`;
          if (heute === kurstag && jetzt >= (plaene.find(Boolean)?.von ?? 0) - 30 && jetzt <= (plaene.at(-1)?.bis ?? 0) + 30) {
            const t = tempo(p, jetzt);
            text = `${p.block} bis ${hhmm(p.bis)} · ${t.rest >= 0 ? `noch ${t.rest} min` : `${-t.rest} min überzogen`}`;
            lage = t.abweichung > 0 ? 'hinten' : t.abweichung < 0 ? 'vorn' : 'ok';
            lageKnopf.textContent = t.abweichung > 0 ? `+${t.abweichung}` : t.abweichung < 0 ? `−${-t.abweichung}` : '✓';
            const lang = t.abweichung > 0 ? `${t.abweichung} min hinter dem Plan` : t.abweichung < 0 ? `${-t.abweichung} min vor dem Plan` : 'Im Plan';
            lageKnopf.title = `${lang}. Tippen: Tageskarte`;
            lageKnopf.setAttribute('aria-label', `${lang}, Tageskarte öffnen`);
          }
        }
        if (zeile.textContent !== text) zeile.textContent = text;
        lageKnopf.hidden = !lage;
        lageKnopf.dataset.lage = lage;
      }

      // Uhr in der Leiste; ein Tipp auf die Dauer einer Übung startet dort einen Countdown, ein Tipp auf die Uhr stoppt ihn.
      // „Nach N min:“-Stichworte der Folie, auf der der Timer gestartet wurde, bekommen die Uhrzeit dazu und werden blass,
      // sobald sie vorbei sind.
      let timerEnde: number | null = null;
      let timerStart = 0;
      let timerArtikel: Element | null = null;
      function taktZeichnen() {
        for (const li of document.querySelectorAll<HTMLElement>('li[data-takt]')) {
          const an = timerEnde !== null && li.closest('article') === timerArtikel;
          const zeit = new Date(timerStart + Number(li.dataset.takt) * 60_000);
          const text = an ? ` → ${zwei(zeit.getHours())}:${zwei(zeit.getMinutes())}` : '';
          const span = li.querySelector('.takt-zeit')!;
          if (span.textContent !== text) span.textContent = text;
          li.classList.toggle('vorbei', an && Date.now() >= zeit.getTime());
        }
      }
      function uhrZeichnen() {
        const d = new Date();
        taktZeichnen();
        if (timerEnde === null) {
          uhrKnopf.textContent = `${zwei(d.getHours())}:${zwei(d.getMinutes())}`;
          delete uhrKnopf.dataset.timer;
          return;
        }
        const rest = Math.round((timerEnde - d.getTime()) / 1000);
        uhrKnopf.dataset.timer = rest <= 0 ? 'aus' : rest < 60 ? 'knapp' : 'laeuft';
        uhrKnopf.textContent = rest <= 0 ? `Zeit! +${Math.floor(-rest / 60)}:${zwei(-rest % 60)}` : `${Math.floor(rest / 60)}:${zwei(rest % 60)}`;
      }
      document.addEventListener('click', (e) => {
        const knopf = (e.target as Element | null)?.closest<HTMLElement>('[data-timer]');
        if (!knopf || knopf === uhrKnopf) return;
        timerStart = Date.now();
        timerEnde = timerStart + Number(knopf.dataset.timer) * 60_000;
        timerArtikel = knopf.closest('article');
        uhrZeichnen();
      });
      uhrKnopf.addEventListener('click', () => { timerEnde = null; uhrZeichnen(); });
      setInterval(() => { uhrZeichnen(); planZeichnen(); }, 1000);

      // Bildschirm wach halten, solange die Seite offen ist (sonst schläft das Tablet ein und das Folgen ruht). Eine
      // laufende Anfrage blockiert weitere (schnelle Tipps hintereinander), damit es nur eine Sperre gibt; der Browser
      // gibt sie beim Verstecken der Seite frei, visibilitychange holt sie wieder.
      let wachSperre: { release(): Promise<void> } | null = null;
      let wachAnfrage: Promise<void> | null = null;
      function wachHalten() {
        const wl = (navigator as Navigator & { wakeLock?: { request(art: 'screen'): Promise<{ release(): Promise<void>; addEventListener(t: string, f: () => void): void }> } }).wakeLock;
        if (!wl || wachSperre || wachAnfrage || document.hidden) return;
        wachAnfrage = wl.request('screen')
          .then((sperre) => {
            wachSperre = sperre;
            sperre.addEventListener('release', () => { if (wachSperre === sperre) wachSperre = null; });
          })
          .catch((e) => console.warn('[begleiter] Bildschirm bleibt nicht wach:', e))
          .finally(() => { wachAnfrage = null; });
      }

      function melden(e: Ereignis) {
        const vorher = z.index;
        z = anzeige(z, e);
        zeichnen(vorher);
      }

      const blaettern = (index: number) => melden({ art: 'blaettern', index: Math.max(0, Math.min(artikel.length - 1, index)) });

      const kette = abfrageKette({
        ruheMs: RUHIG_MS,
        ruht: () => document.hidden || !z.folgen,
        // Auch ohne Position im schnellen Takt: Das Tablet ist meist offen, bevor der Beamer startet. Bei Fehlern wie in
        // wo-ist.ts erst nach mehreren in Folge langsamer (naechsteAbfrage).
        runde: async () => {
          try {
            const daten = (await jsonHolen('/api/position', ABFRAGE_TIMEOUT_MS)) as { position?: unknown; zeit?: number; jetzt?: number };
            fehlerInFolge = 0;
            const p = positionPruefen(daten.position);
            const alt = typeof daten.zeit === 'number' && typeof daten.jetzt === 'number' && alterText(daten.jetzt - daten.zeit) === null;
            if (!p || alt) melden({ art: 'leer' });
            else {
              beamerTitel = p.titel;
              melden({ art: 'position', index: folieZu(folien, p.pfad, p.anker) });
            }
            return ABFRAGE_MS;
          } catch (e) {
            fehlerInFolge += 1;
            console.warn('[begleiter] Position nicht geholt:', e);
            melden({ art: 'fehler' });
            return naechsteAbfrage('fehler', fehlerInFolge).ms;
          }
        },
      });

      document.querySelector('[data-zurueck]')!.addEventListener('click', () => blaettern(z.index - 1));
      document.querySelector('[data-weiter]')!.addEventListener('click', () => blaettern(z.index + 1));
      liste.addEventListener('change', () => blaettern(Number(liste.value)));
      folgenKnopf.addEventListener('click', () => {
        if (z.folgen) blaettern(z.index); // Schalter aus = hier stehen bleiben
        else { melden({ art: 'folgen' }); kette.sofort(); }
      });
      addEventListener('keydown', (e) => {
        if (e.repeat || e.altKey || e.ctrlKey || e.metaKey || karte.open || (e.target as Element | null)?.closest?.('select, input, textarea')) return;
        if (e.key === 'ArrowLeft') { e.preventDefault(); blaettern(z.index - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); blaettern(z.index + 1); }
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) return;
        wachHalten();
        if (z.folgen) kette.sofort();
      });
      // Nach einem WLAN-Aussetzer nicht erst die lange Pause der Fehlerkette abwarten.
      addEventListener('online', () => { if (z.folgen) kette.sofort(); });
      // Manche Browser geben die Sperre erst nach einer Berührung.
      addEventListener('pointerdown', wachHalten, { passive: true });

      // Wischen nach links/rechts blättert: nur deutlich waagerecht und nur im Kopf oder Live-Block, nicht in der
      // Vorbereitung, in Feldern oder in waagerecht scrollbarem Inhalt (wischErlaubt in lib/begleiter.ts).
      let wisch: { x: number; y: number } | null = null;
      document.querySelector('main')!.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        wisch = e.touches.length === 1 && e.target instanceof Element && wischErlaubt(e.target) ? { x: t.clientX, y: t.clientY } : null;
      }, { passive: true });
      document.querySelector('main')!.addEventListener('touchend', (e) => {
        if (!wisch) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - wisch.x;
        const dy = t.clientY - wisch.y;
        wisch = null;
        if (Math.abs(dx) > 70 && Math.abs(dy) < Math.abs(dx) / 2) blaettern(z.index + (dx < 0 ? 1 : -1));
      }, { passive: true });

      // „Nur live“: Vorbereitung ausblenden, damit Scrollen im Kurs nie im Langtext landet; je Gerät gemerkt.
      const nurLiveKnopf = document.querySelector<HTMLButtonElement>('[data-nur-live]')!;
      const merken = (k: string, v: string | null) => { try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch { /* ohne Speicher eben nicht gemerkt */ } };
      const gemerkt = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      function nurLive(an: boolean) {
        document.body.classList.toggle('nur-live', an);
        nurLiveKnopf.setAttribute('aria-pressed', String(an));
        merken('begleiter:nur-live', an ? '1' : null);
      }
      nurLive(gemerkt('begleiter:nur-live') === '1');
      nurLiveKnopf.addEventListener('click', () => nurLive(!document.body.classList.contains('nur-live')));

      // Tageskarte: aus der Leiste oder dem Plan-Knopf neben der Uhr; der laufende Block ist markiert, Material-Häkchen je Kurstag gemerkt.
      const karte = document.querySelector<HTMLDialogElement>('[data-tageskarte]')!;
      function karteAuf() {
        const p = plaene[z.index];
        for (const li of karte.querySelectorAll<HTMLElement>('.tk-bloecke > li')) {
          li.classList.toggle('jetzt', !!p && Number(li.dataset.von) === p.von && Number(li.dataset.bis) === p.bis);
        }
        karte.showModal();
        karte.querySelector('.jetzt')?.scrollIntoView({ block: 'center' });
      }
      document.querySelector('[data-tag-auf]')!.addEventListener('click', karteAuf);
      lageKnopf.addEventListener('click', karteAuf);
      // „Wenn hinten“-Einträge nennen ihre Folie: tippen blättert dorthin (pausiert das Folgen wie jedes Blättern).
      for (const b of karte.querySelectorAll<HTMLElement>('[data-springe]')) {
        b.addEventListener('click', () => { karte.close(); blaettern(Number(b.dataset.springe)); });
      }
      karte.addEventListener('click', (e) => { if (e.target === karte) karte.close(); }); // Tipp neben die Karte schließt
      const haken = `begleiter:material:${kurstag}`;
      const gesetzt = new Set((gemerkt(haken) ?? '').split(',').filter(Boolean));
      for (const box of karte.querySelectorAll<HTMLInputElement>('[data-material]')) {
        box.checked = gesetzt.has(box.dataset.material!);
        box.addEventListener('change', () => {
          if (box.checked) gesetzt.add(box.dataset.material!); else gesetzt.delete(box.dataset.material!);
          merken(haken, [...gesetzt].join(',') || null);
        });
      }

      // Drucken (Vorbereitung): alle Miro-Schritte aufgeklappt.
      addEventListener('beforeprint', () => { for (const d of document.querySelectorAll('details')) d.open = true; });

      zeichnen(0);
      uhrZeichnen();
      wachHalten();
      kette.sofort();
    </script>
    <script type="application/json" id="begleiter-folien" set:html={JSON.stringify(folien).replace(/</g, '\\u003c')} />

    <style>
      .begleiter { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font); font-size: 18px; line-height: 1.5; }
      .steuer {
        position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: .5rem;
        padding: .5rem 16px; background: var(--bg-2); border-bottom: 1px solid var(--border);
      }
      .steuer .btn { display: inline-flex; align-items: center; gap: .4rem; min-height: 48px; white-space: nowrap; }
      .steuer .rund { padding: .4rem .6rem; }
      .steuer select {
        flex: 1 1 10rem; min-width: 0; min-height: 44px; font: inherit; font-size: 1rem; padding: .4rem .6rem;
        background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: var(--radius);
      }
      /* Status als Punkt im Folgen-Knopf: grün folgt, gelb Problem, grau fragt; pausiert = Akzent „Zurück zum Beamer“. */
      .folgen .punkt { width: .7rem; height: .7rem; border-radius: 50%; background: var(--muted); flex: none; }
      .folgen[data-meldung="ok"] .punkt { background: var(--green); }
      .folgen[data-meldung="keine-verbindung"] .punkt, .folgen[data-meldung="nicht-tag-1"] .punkt, .folgen[data-meldung="keine-position"] .punkt { background: var(--yellow); }
      .folgen[data-meldung="keine-verbindung"], .folgen[data-meldung="nicht-tag-1"] { color: var(--yellow-ink); }
      .folgen[data-meldung="hand"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
      .folgen[data-meldung="hand"] .punkt, .folgen:not([data-meldung="hand"]) .zurueck-icon { display: none; }
      .klein { padding: .4rem .6rem; }
      .klein[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); }
      .nur-live .vorbereitung { display: none; }
      /* Uhr und Plan-Abweichung: auf Armlänge lesbar, Ziffern gleich breit. */
      .uhr, .lage { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 1.35rem; font-weight: 700; padding: .3rem .6rem; }
      .uhr { justify-content: center; min-width: 5.2ch; }
      .uhr[data-timer] { font-size: 1.6rem; }
      .uhr[data-timer="laeuft"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); }
      .uhr[data-timer="knapp"] { background: var(--yellow-soft); border-color: var(--yellow); color: var(--yellow-ink); }
      .uhr[data-timer="aus"] { background: var(--yellow-soft); border-color: var(--yellow); color: var(--yellow-ink); outline: 3px solid var(--yellow); outline-offset: 1px; }
      /* .steuer davor: sonst gewinnt „.steuer .btn“ (inline-flex), und der leere Knopf bliebe neben der Uhr stehen. */
      .steuer .lage[hidden] { display: none; }
      .lage[data-lage="hinten"] { background: var(--yellow-soft); border-color: var(--yellow); color: var(--yellow-ink); }
      .lage[data-lage="vorn"], .lage[data-lage="ok"] { border-color: var(--green); color: var(--green); }
      /* Telefon: oben Status, Ansicht, Plan und Uhr; darunter Blättern mit der Folienliste in voller Breite. */
      @media (max-width: 640px) {
        .steuer { flex-wrap: wrap; gap: .4rem; }
        .steuer::after { content: ""; flex-basis: 100%; order: 1; }
        [data-zurueck], .steuer select, [data-weiter] { order: 2; }
        .steuer .uhr { margin-left: auto; }
        /* Nur Punkt bzw. Zurück-Pfeil; der Text bleibt für Screenreader. */
        .folgen [data-folgen-text] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        .uhr[data-timer] { font-size: 1.35rem; }
        .steuer:has(.lage:not([hidden])) [data-tag-auf] { display: none; }
      }
      main { max-width: 900px; margin: 0 auto; padding: 1rem 16px 4rem; }
      article[hidden] { display: none; }
      /* Eine Kopfzeile: Foliennummer, Block mit Rest (planZeichnen), Folie öffnen als Icon. */
      .kopf .seite { display: flex; align-items: baseline; gap: .5rem; margin: 0; font-size: 1rem; color: var(--muted); }
      .kopf .nr { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--fg); }
      .kopf .satz { margin: 0 0 .3rem; font-size: 1.05rem; color: var(--muted); font-style: italic; }
      .kopf h1 { margin: .15rem 0 .3rem; font-family: var(--display); font-size: clamp(1.5rem, 4vw, 2.1rem); line-height: 1.2; }
      .oeffnen { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; min-height: 36px; margin: -8px 0 -8px auto; align-self: center; color: var(--blue); flex: none; }
      @media (max-width: 640px) { .kopf .satz { display: none; } }
      .live { margin-top: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-2); }
      .stichworte { margin: 0; padding-left: 1.2em; font-size: clamp(1.35rem, 3.2vw, 1.7rem); line-height: 1.4; }
      .stichworte li + li { margin-top: .35rem; }
      /* Zum Sagen kursiv mit Akzent-Punkt, Regieanweisungen gerade; das Stichwort vor dem Doppelpunkt fängt den Blick. */
      .stichworte li.zitat { font-style: italic; }
      .stichworte li.zitat::marker { color: var(--accent); }
      .stichworte .cue { color: var(--accent-ink); font-weight: 600; }
      .stichworte .takt-zeit { font-family: var(--mono); font-variant-numeric: tabular-nums; font-weight: 700; color: var(--accent-ink); }
      .stichworte li.vorbei { opacity: .5; }
      .sozial { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: .9rem 0 0; font-size: 1.25rem; font-weight: 600; color: var(--accent-ink); }
      button.sozial { width: 100%; padding: .5rem .7rem; text-align: left; font: inherit; font-size: 1.25rem; font-weight: 600; background: var(--accent-soft); border: 1px solid var(--accent); border-radius: var(--radius); cursor: pointer; }
      .sozial .start { display: inline-flex; align-items: center; gap: .25rem; margin-left: auto; font-size: 1rem; }
      .check { margin-top: .7rem; padding: .5rem .8rem; border: 1px solid var(--blue); border-radius: var(--radius); background: var(--blue-soft); }
      .check .frage { display: flex; gap: .5rem; align-items: flex-start; margin: 0; font-size: 1.2rem; }
      .check .frage svg { flex: none; margin-top: .25rem; color: var(--blue); }
      .check .label { color: var(--blue); font-weight: 600; }
      .check summary { min-height: 36px; display: flex; align-items: center; cursor: pointer; color: var(--muted); }
      .check details p { margin: .2rem 0; font-size: 1.05rem; }
      .check .falsch { margin: .3rem 0 0; font-size: 1.05rem; }
      .check .falsch span { color: var(--yellow-ink); font-weight: 600; }
      .weiter { margin-top: 1rem; padding: .7rem .9rem; border-left: 4px solid var(--accent); background: var(--bg); border-radius: 4px; }
      .miro { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--border); }
      .miro h2 { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: 0; font-size: 1.15rem; color: var(--muted); font-weight: 600; }
      .miro h2 a, .miro h2 strong { color: var(--blue); }
      .miro h2 strong { color: var(--fg); }
      .miro h2 a strong { color: var(--blue); }
      .miro summary { margin-top: .3rem; min-height: 44px; display: flex; align-items: center; cursor: pointer; color: var(--muted); }
      .miro h3 { margin: .7rem 0 .2rem; font-size: .95rem; color: var(--muted); }
      .miro ul { margin: .3rem 0 0; padding-left: 1.2em; font-size: 1.1rem; }
      .miro .zettel { font-size: .95rem; color: var(--muted); }
      .ueberleitung { margin: 0; font-size: 1.2rem; }
      .leer { margin: 0; font-size: 1.25rem; color: var(--muted); }
      .naechste { margin: .4rem 0 0; font-size: 1.15rem; }
      .naechste span { color: var(--muted); }
      .vorbereitung { margin-top: 1.5rem; max-width: 36em; } /* rund 70 Zeichen je Zeile */
      .vb { margin-top: 1.5rem; }
      .vb h2 { margin: 0 0 .4rem; font-family: var(--display); font-size: 1.15rem; }
      .vb h3 { margin: .8rem 0 .2rem; font-size: 1rem; }
      .vb p, .vb li, .vb dd { font-size: 1.05rem; }
      .zusatz { margin-top: .8rem; padding: .6rem .9rem; border-left: 3px solid var(--yellow); background: var(--yellow-soft); border-radius: 4px; }
      .zusatz h3 { margin: .2rem 0; }
      .etikett { margin: 0; font-size: .85rem; font-weight: 600; color: var(--yellow-ink); }
      dt { font-weight: 600; margin-top: .6rem; }
      dd { margin: .1rem 0 0; }
      .tageskarte {
        width: min(760px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 1rem 1.2rem; overflow: auto;
        color: var(--fg); background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px;
      }
      .tageskarte::backdrop { background: rgb(0 0 0 / .6); }
      .tk-kopf { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      .tk-kopf h1 { margin: 0; font-family: var(--display); font-size: 1.3rem; }
      .tk-kopf h1 span { display: block; font-family: var(--font); font-size: .95rem; font-weight: 400; color: var(--muted); }
      .tk-kopf .btn { min-height: 44px; }
      .tk-bloecke { list-style: none; margin: .8rem 0 0; padding: 0; }
      .tk-bloecke > li { padding: .6rem .8rem; border-left: 3px solid var(--border); margin-top: .4rem; }
      .tk-bloecke > li.pause { color: var(--muted); padding-block: .2rem; }
      .tk-bloecke > li.jetzt { border-left-color: var(--accent); background: var(--bg); }
      .tk-zeit { margin: 0; font-family: var(--mono); font-size: .95rem; }
      .tk-ziel { margin: .2rem 0 0; }
      .tk-streichen { margin-top: .3rem; font-size: .95rem; }
      .tk-streichen span { color: var(--yellow-ink); font-weight: 600; }
      .tk-streichen ul { margin: .1rem 0 0; padding-left: 1.2em; }
      .tk-streichen .tk-folie { display: inline; font: inherit; text-align: left; padding: 0; border: 0; background: none; color: var(--blue); text-decoration: underline; cursor: pointer; }
      .tageskarte h2 { margin: 1.2rem 0 .4rem; font-family: var(--display); font-size: 1.1rem; }
      .tk-material { list-style: none; margin: 0; padding: 0; }
      .tk-material label { display: flex; gap: .6rem; align-items: flex-start; min-height: 40px; padding: .3rem 0; }
      .tk-material input { width: 1.3rem; height: 1.3rem; margin-top: .15rem; flex: none; }
      .tk-wann { color: var(--muted); font-size: .9rem; }
      @media (max-width: 760px) { .klein span { display: none; } }

      /* Vorbereitung auf Papier: alle Folien untereinander, ohne Leiste. */
      @media print {
        .steuer, .oeffnen, .sozial .start, .tageskarte { display: none !important; }
        .kopf .satz { display: block; }
        .nur-live .vorbereitung { display: block; }
        article[hidden] { display: block; }
        article + article { break-before: page; }
      }
    </style>
  </body>
