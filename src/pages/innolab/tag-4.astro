---
import Layout from '../../layouts/Layout.astro';
import Orientierung from '../../components/Orientierung.astro';
import Block from '../../components/Block.astro';
import Callout from '../../components/Callout.astro';
import Checklist from '../../components/Checklist.astro';
import FooterNav from '../../components/FooterNav.astro';
import Folie from '../../components/Folie.astro';
import Arbeitsfluss from '../../components/bild/Arbeitsfluss.astro';
import WasBauenWir from '../../components/bild/WasBauenWir.astro';
import Baum from '../../components/bild/Baum.astro';
import SliceImBaum from '../../components/bild/SliceImBaum.astro';
import BildText from '../../components/bild/BildText.astro';
import BuchAbbildung from '../../components/bild/BuchAbbildung.astro';
import Prompt from '../../components/Prompt.astro';
import MiroFrame from '../../components/MiroFrame.astro';
import MiroLink from '../../components/MiroLink.astro';
import { KAFFEEBAR_BAUM_TAG_4 } from '../../components/innolab-beispiel';
import { FOLIENSATZ_URL } from '../../lib/foliensatz';

const TORRES = 'Teresa Torres, „Continuous Discovery Habits“ (2021)';
const BLAND = 'David J. Bland & Alexander Osterwalder, „Testing Business Ideas“ (2019)';
const LICHAW = 'Donna Lichaw, „The User’s Journey“ (2016)';
---
<Layout title="Tag 4 · Prototyp & Scrum">
  <span class="eyebrow">Innolab · Tag 4 · Samstag, 28. November 2026 · 09:00–17:30 · online in Teams</span>
  <h1>Tag 4 · Prototyp & Scrum</h1>
  <p class="lead">Der Tag beginnt mit dem, was von Tag 3 offen ist: Value Map und Fit. Dann zeigen wir, was ihr heute baut – Slice 1 – und wo er in eurem Baum hängt; danach schreibt ihr eure Concept Story. Danach das Geschäftsmodell und die Karte, die die riskanteste Annahme eures Spitzenreiters testet. Dann wird aus ihm ein geschnittener Plan, ein Kernablauf mit Höhepunkt und ein Prototyp auf Papier, den ihr testen könnt. Am Nachmittag lernt ihr Scrum kennen. Claude Code braucht ihr heute nicht: Gebaut wird an Tag 5.</p>
  <p>Heute seid ihr online in einer Teams-Besprechung; den Link findet ihr in Teams. Miro und Werkstatt nutzt ihr auf eurem Laptop; legt Papier und Stift bereit – oder zeichnet die Bildschirme am Nachmittag lo-fi in Figma.</p>
  <Orientierung seite="innolab/tag-4" />
  {/* Seit 26.11.2026 nachts (Dozent): Tag 4 ohne Claude. Der Prototyp entsteht auf Papier; Claude Pro und Claude Code
      richten alle an Tag 5 gemeinsam ein (tag-5#claude-pro-jetzt), dort baut Claude Code Slice 1 aus den Skizzen. */}
  <Callout type="info" title="Heute ohne Claude – Claude Code ab Tag 5">
    <p>Heute arbeitet ihr auf Papier, auf Miro und in der Werkstatt; Claude Code braucht ihr erst an Tag 5. Installiert es bis Tag 5 auf eurem Mac (<a href="/setup#lokal-schnellweg">mit dem Setup-Skript</a>). Claude Pro schließt ihr nicht vorher allein ab, sondern an Tag 5 gemeinsam in der Besprechung (<a href="/innolab/tag-5#claude-pro-jetzt">Folie</a>); haltet dann eure Kredit- oder Debitkarte bereit.</p>
  </Callout>

  <h2 id="ablauf">Ablauf</h2>
  <div class="schedule" data-kurstag="2026-11-28">
    <Block time="09:00–09:05" type="plenum" title="Arbeitsfluss – ihr seid hier" href="#arbeitsfluss">Was ihr von Tag 1 bis 3 mitbringt und was heute daraus wird.</Block>
    <Block time="09:05–09:35" type="uebung" title="Value Map & Fit (Nachholen von Tag 3)" href="/innolab/methoden/value-map#vorgehen">Den Vorschlag in T3 · 4 bestätigen oder ändern – Was davon ist die Website, die ihr baut – und trifft sie allein noch P1? Dann füllen, ordnen, Fit, festhalten; zum Schluss die drei Ideen als Lösungen in euren Baum, der Spitzenreiter markiert.</Block>
    <Block time="09:35–09:40" type="plenum" title="Was bauen wir?" href="#was-bauen-wir">Slice 1 und der Baum: Was ihr heute baut, hängt am Spitzenreiter, den ihr gerade markiert habt.</Block>
    <Block time="09:40–10:30" type="uebung" title="Story-Bogen + Concept Story" href="/innolab/methoden/concept-story#story-bogen">Theorie, alle Folien (etwa 20 min): sieben Stationen, A × B = C, flach oder hoch. Dann 30 min schreiben, allein, auf Miro in „T4 · 0 · Concept Story · Produkt n“: sieben Stationen mit Flach-Probe als Check, festhalten.</Block>
    <Block time="10:30–10:40" type="pause" title="Pause" />
    <Block time="10:40–11:00" type="uebung" title="Geschäftsmodell" href="/innolab/methoden/geschaeftsmodell">Wer, Was, Wie, Wert; die Linie vom Outcome zum Geld; die wirtschaftliche Annahme für die Map.</Block>
    <Block time="11:00–11:40" type="uebung" title="Experiment-Karte" href="/innolab/methoden/experiment#annahmen-der-idee">Schritte der Idee, Annahmen, Map, Karte E1 mit Schwelle; Annahme und E1 in den Baum.</Block>
    <Block time="11:40–13:05" type="uebung" title="Story Map" href="/innolab/methoden/story-map">Warm-up „euer Morgen“, Backbone, Slice 1 nach Outcome und Lernziel.</Block>
    <Block time="13:05–14:05" type="pause" title="Mittagspause" />
    <Block time="14:05–14:35" type="uebung" title="Usage Story" href="/innolab/methoden/usage-story">Der Kernablauf mit Höhepunkt nahe am Ende.</Block>
    <Block time="14:35–15:30" type="uebung" title="Prototyp auf Papier" href="/innolab/methoden/prototyp-spike">Papier-Skizzen oder lo-fi in Figma, Abnahmekriterien, Karte E2, Trockenlauf. Gebaut wird an Tag 5.</Block>
    <Block time="15:30–16:25" type="uebung" title="Puffer: nachholen, was offen ist">Allein fertig machen, was heute offen blieb – zuerst Papier-Prototyp und Karte E2, dann Story Map und Usage Story; Markus kommt ins 1:1.</Block>
    <Block time="16:25–16:35" type="pause" title="Pause" />
    <Block time="16:35–17:15" type="konzept" title="Agil & Scrum" href="/innolab/methoden/scrum#foliensatz">Theorie aus dem <a href={FOLIENSATZ_URL} target="_blank" rel="noopener noreferrer">Foliensatz</a>: Wasserfall, Agiles Manifest, Scrum nach dem Guide. Dann hier: wo wir abweichen, Kaffeebar auf der Scrum-Karte (Miro), Auflösung am Gleis-1-Express.</Block>
    <Block time="17:15–17:30" type="plenum" title="Origin Story & Hausaufgabe" href="#abschluss">Wie eine Person den Wert eures Produkts zum ersten Mal sieht; Origin Story und Karte E1 fertig. Freiwillig: Usability-Tests mit dem Papier-Prototyp.</Block>
  </div>

  {/* 9:00: Im Beamer kommt nach dem Ablauf der Arbeitsfluss (dieselbe Folie wie auf /innolab/arbeitsfluss), dann → zur Value Map
      (9:05). Erst dort wird der Spitzenreiter bestätigt; darum kommen „Was bauen wir?“ und „Slice 1 im Baum“ danach, um 9:35:
      → von value-map#uebertrag führt hierher zurück. */}
  <Folie weiter="/innolab/methoden/value-map#vorgehen" weiterTitel="Value Map & Fit (Nachholen)">
    <h2 id="arbeitsfluss">Arbeitsfluss – ihr seid hier</h2>
    <p class="folie-satz">Was ihr mitbringt und was heute daraus wird.</p>
    <Arbeitsfluss id="af-tag-4" hier={4} bis={4} aufdecken={3} />
    <p class="nur-handout small">Die drei Fäden an der Kaffeebar und alle Stationen mit einem Satz: <a href="/innolab/arbeitsfluss?tag=4#beleg">Fäden im Detail</a>.</p>
  </Folie>

  {/* 9:35, nach der Value Map: ← führt zurück zu ihrer letzten Folie, nicht zum Arbeitsfluss von 9:00. */}
  <Folie zurueck="/innolab/methoden/value-map#uebertrag">
    <h2 id="was-bauen-wir">Was bauen wir?</h2>
    <p class="folie-satz">Heute einen Prototyp von Slice 1 auf Papier – der kleinsten Version eures Spitzenreiters, die von Anfang bis Ende durchgeht. An Tag 5 baut Claude Code daraus die echte Version.</p>
    {/* Die drei Zuläufe konkret für heute (Durchsicht 26.11.): woher jede Linie kommt und was daraus wird. Auf
        /innolab/arbeitsfluss bleiben sie tagneutral (Vorgaben in WasBauenWir.astro). */}
    <WasBauenWir
      schritte={false}
      beleg="liefert den Inhalt: den Weg eurer Person – aus Interviews und Experience Map."
      outcome="liefert das Maß: was Menschen danach anders tun – aus eurem Brief."
      annahme="liefert das Lernziel: was der Slice zeigen muss – daraus wird Test E1."
    >Heute Mittag steht Slice 1 auf eurer Story Map, am Nachmittag als Prototyp auf Papier. An Tag 5 besprecht ihr, ob er hält – und baut ihn.</WasBauenWir>
  </Folie>

  {/* Letzte Folie des Morgens: → am Ende führt zur Concept Story (9:40); die Folien des Abschlusses weiter unten kommen erst
      um 17:15, über scrum#weiter-tag-4. Darum ohne data-schritt (SliceImBaum.astro). */}
  <Folie weiter="/innolab/methoden/concept-story#story-bogen" weiterTitel="Story-Bogen + Concept Story">
    <h2 id="slice-im-baum">Slice 1 im Baum</h2>
    <p class="folie-satz">Slice 1 ist der Spitzenreiter, konkret gemacht.</p>
    <SliceImBaum />
    <p class="nur-beamer">An Tag 5, im Debrief: Hätte die Annahme gehalten, bleibt der Slice. Sonst geht ihr zurück in den Baum.</p>
    <div class="nur-handout">
      <p>Slice 1 ist kein Knoten im Baum. Unter einer Lösung hängen bei Teresa Torres nur die Annahmen-Tests ({TORRES}, S. 26–27). Slice 1 liegt auf eurem Story-Map-Frame und verbindet beides: Er macht den Spitzenreiter so konkret, dass ihr seine Annahmen seht. Genau dafür nutzt Torres die Story Map: „Story mapping forces you to get specific about how an idea will work and what you expect your end-users will do. While many teams use story mapping to align around product requirements, it’s also a great technique for helping us to surface underlying assumptions“ (S. 119). Danach geht man die Map Schritt für Schritt durch – „you can use your story map to uncover hidden assumptions“ (S. 122); in ihrem Beispiel: „From a simple 5-step story map, we generated 20 assumptions“ (S. 124).</p>
      <p>Die drei Linien kommen aus dem Baum. <strong>Outcome</strong> ist seine Wurzel, derselbe Satz wie im Produkt-Brief. Auf der Story Map steht er im Rahmen über der Map, und links neben Slice 1 steht als Ziel-Outcome, wer danach was anders tut. <strong>Beleg</strong> sind die Chancen: aus den Momenten der Experience Map, belegt mit Zitat-IDs. Slice 1 folgt dem Pfad zur Ziel-Chance mit Stern. <strong>Annahme</strong> sind die Tests unter der Lösung: Das Lern-Sticky „Wir lernen, ob … (A5)“ trägt dieselben IDs wie die Knoten im Baum, und E1 testet A5.</p>
      <p>An der Kaffeebar steht im Rahmen „Mehr Pendler*innen steigen morgens mit Kaffee in den Zug“, links neben Slice 1 „Pendler*innen mit knapper Zeit bestellen im Gehen, statt zum Automaten auszuweichen, und haben den Kaffee vor der Abfahrt“ (<a href="/innolab/methoden/story-map#beispiel">Story Map</a>). Die Barista bekommt dort eine eigene Reihe – ohne sie kommt kein Kaffee an –, und im Lern-Sticky steht neben A5 auch A2: Schafft die Bar 40 Bestellungen in 30 Minuten? Im Baum hängt nur die riskanteste Annahme, A5 mit E1.</p>
      <p>An Tag 5 markiert ihr im Baum, was E1 gezeigt hätte (und E2, falls getestet) (<a href="/innolab/tag-5#debrief">Test-Debrief</a>). Spricht das für die Annahmen, bleibt Slice 1, und an Tag 5 werden daraus die ersten Issues, die Claude Code nach euren Skizzen baut. Was ein Test widerlegt, fliegt aus dem Slice. Trägt der Spitzenreiter nicht mehr, geht ihr zurück in den Baum: zu einer der anderen beiden Lösungen unter der Ziel-Chance oder zu einer anderen Chance.</p>
    </div>
  </Folie>

  <hr />
  <h2 id="faden">Wo ihr im roten Faden steht</h2>
  <p>Heute werden aus der <strong>Lösung</strong> <strong>Experimente</strong>. Zuerst holt ihr nach, was von Tag 3 offen ist: Value Map und Fit eures Spitzenreiters. Dann schreibt ihr eure Concept Story – warum jemand in Sekunden versteht, dass euer Spitzenreiter besser ist als das, was er heute tut. Das Geschäftsmodell zeigt, wer dafür zahlt; die Experiment-Karte, an welcher Annahme er hängt – daraus wird E1. Die Story Map zeigt, was ihr zuerst baut; die Usage Story, wie es sich anfühlen soll; der Prototyp auf Papier, ob der Ablauf trägt – gebaut wird er an Tag 5. Den Papier-Prototyp könnt ihr nach dem Kurstag mit echten Menschen testen (freiwillig); E1 beschreibt, wie ihr die riskanteste Annahme prüfen würdet. Am Nachmittag beginnt der Schritt vom Entdecken zum Liefern: Ihr lernt Scrum kennen, so wie Produktteams in Unternehmen arbeiten. Als Team für eure drei Produkte stellt ihr euch zu Beginn von Tag 5 auf. Das Entdecken hört dabei nicht auf: Euer Sprint endet mit einem Review, in dem ihr wieder lernt.</p>
  <p class="small">Den Plan mit „Ihr seid hier“ zeigt die Folie <a href="#arbeitsfluss">Arbeitsfluss</a> oben, zu Beginn des Tages im Beamer gleich nach dem Ablauf.</p>
  <p><strong>Der Baum wächst heute um Lösungen und Tests.</strong> Euer Baum auf Miro („Baum · Produkt n“) endet bisher bei der Ziel-Chance mit Stern. Nach der Value Map hängt ihr eure drei Ideen als Lösungen darunter und markiert den Spitzenreiter; nach der Experiment-Karte kommen unter ihn die riskanteste Annahme und E1, nach dem Papier-Prototyp E2. Je etwa zwei Minuten. So steht der Baum, wie Teresa Torres ihn zeichnet: Outcome, Chancen, mehrere Lösungen unter einer Chance und darunter die Annahmen-Tests, die zeigen, ob eine Lösung trägt ({TORRES}, S. 25–27).</p>
  <Baum knoten={KAFFEEBAR_BAUM_TAG_4} label="Baum der Kaffeebar ab Tag 4: Outcome, darunter die Ziel-Chance „Geht sich ein Kaffee noch aus?“, darunter drei Lösungen – Wartezeit-Anzeige, Im Gehen bestellen als Spitzenreiter, Kaffeewagen am Bahnsteig –, unter dem Spitzenreiter A5 mit dem Test E1" />
  <Callout type="info" title="Wenn die Story Map länger dauert">
    <p>Wer bei der Story Map hinterherhängt, kürzt bei der Usage Story auf die Stationen 4 und 5: Krise und Höhepunkt reichen für den Prototyp auf Papier. Was offen bleibt, holt ihr im Puffer nach.</p>
  </Callout>

  <h2 id="methoden">Die Methoden von heute</h2>
  <ul>
    <li><a href="/innolab/methoden/value-map">Value Map & Fit</a> – Nachholen von Tag 3: Spitzenreiter bestätigen, Value Map ordnen, Fit prüfen</li>
    <li><a href="/innolab/methoden/concept-story">Concept Story</a> – warum euer Spitzenreiter besser ist als das, was Menschen heute tun; sieben Stationen auf Miro</li>
    <li><a href="/innolab/methoden/geschaeftsmodell">Geschäftsmodell</a> – wer zahlt wofür, die Linie vom Outcome zum Geld und welche Annahme dahintersteckt</li>
    <li><a href="/innolab/methoden/experiment">Experiment-Karte & Origin Story</a> – Annahmen testen, nicht Ideen; die Origin Story folgt im <a href="#abschluss">Abschluss</a></li>
    <li><a href="/innolab/methoden/story-map">Story Map</a> – der Plan, nach Outcome geschnitten</li>
    <li><a href="/innolab/methoden/usage-story">Usage Story</a> – der Kernablauf mit Höhepunkt</li>
    <li><a href="/innolab/methoden/prototyp-spike">Prototyp auf Papier & Usability-Test</a> – ein Blatt je Bildschirm, getestet, bevor eine Zeile Code steht; gebaut wird an Tag 5</li>
    <li><a href="/innolab/methoden/scrum">Scrum im Team</a> – Agil und Scrum, die Theorie aus dem Foliensatz (Lego4Scrum ist dieses Kursjahr nicht dabei); Teamaufstellung und Definition of Done folgen an Tag 5</li>
  </ul>

  {/* 17:15: Hierher führt → von der letzten Tag-4-Folie auf scrum (#weiter-tag-4). Vier Folien: Origin Story, ihr Beispiel
      (#origin-beispiel), Hausaufgabe, Ende – → bleibt auf „Ende Tag 4“ stehen (Folie.astro, ende). */}
  {/* ← führt zurück zur letzten Tag-4-Folie auf scrum, nicht zu „Was bauen wir?“ von 9:35 (nach der Value Map). */}
  <Folie zurueck="/innolab/methoden/scrum#weiter-tag-4">
    <h2 id="abschluss">Abschluss: die Origin Story</h2>
    <p class="folie-satz">Wie eine Person den Wert eures Produkts zum ersten Mal sieht – und was sie dann tut. Ergebnis: der Text für euren Test E1.</p>
    <BildText>
      <BuchAbbildung src="/quellen/lichaw/origin-story.jpg" alt="Grüner Bogen: Current State, Problem, Find out about product mit Wegweiser (Search, Marketing, Word of mouth), Impediments Competition als Hürde, See value / solution mit Glühbirne (Landing page, Touchpoints, Content), Take action Experience value, Goal(s) met" quelle={`Die Origin Story. ${LICHAW}, Abb. 4.3.`} />
      {/* Sieben Stationen wie im Miro-Frame „T4 · 6 · Origin Story · Produkt n“ (Wunsch Markus 27.11.). */}
      <ol class="dicht">
        <li data-schritt><strong>Exposition</strong> – wie in der Concept Story.</li>
        <li data-schritt><strong>Auslöser</strong> – wie in der Concept Story.</li>
        <li data-schritt><strong>Steigende Handlung</strong> – wo sie davon hört.</li>
        <li data-schritt><strong>Krise</strong> – was sie zurückhält.</li>
        <li data-schritt><strong>Höhepunkt</strong> – sie <em>sieht</em> den Wert, auf Aufsteller oder Landingpage.</li>
        <li data-schritt><strong>Fallende Handlung</strong> – die eine Handlung: die Messgröße von E1.</li>
        <li data-schritt><strong>Ende</strong> – ihr Ziel und euer messbares Geschäftsziel.</li>
      </ol>
    </BildText>
    <div class="nur-handout">
      <p>Im Abschluss gibt es zehn Minuten Input zur Origin Story – sie ist der Text für euren Aufsteller oder eure Landingpage und führt zur Handlung, die E1 misst. Ihr schreibt sie auf Miro, nach der <MiroLink name="T4 · 6 · Anleitung Origin Story">Anleitung</MiroLink> links daneben, in eurem Frame „T4 · 6 · Origin Story · Produkt n“: <MiroLink name="T4 · 6 · Origin Story · Produkt 1">Produkt 1</MiroLink> · <MiroLink name="T4 · 6 · Origin Story · Produkt 2">Produkt 2</MiroLink> · <MiroLink name="T4 · 6 · Origin Story · Produkt 3">Produkt 3</MiroLink>.</p>
      <p>„An origin story is the story of how someone becomes your customer for the first time“; sie ist die Brücke zwischen Concept Story und Usage Story ({LICHAW}, Kap. 4). Die Krise kennt vier Formen: Konkurrenz, andere Lösungen (selbst machen, analog), Widerstand gegen Neues, Sorgen um Sicherheit. Der Höhepunkt liegt dort, wo jemand den Wert sieht – Startseite, Landingpage, Laden, Telefon. Danach kommt genau eine Handlung, und am Ende steht, wie ihr sie messt: „you call your main character to action and determine how to measure that action“. Die Handlung soll das Ziel der Person benennen: „start training“ statt „sign up“ (Kap. 4, FitCounter).</p>
      <p>Wie das für die Kaffeebar aussieht, zeigt die nächste Folie.</p>
    </div>
  </Folie>

  {/* 17:15, zweite Folie der Origin Story (Durchsicht 26.11.): Das Beispiel stand nur im Handout; im Beamer fehlte, was
      Studierende hier schreiben. Der Aufstellertext ist Beispiel, kein Prompt zum Übernehmen – darum ohne Kopieren.
      Ohne Miro-Pille (Dozent 27.11.): Links nur, wo die Arbeit beginnt – das Beispiel auf Miro verlinkt #hausaufgabe. */}
  <Folie>
    <h2 id="origin-beispiel">Am Beispiel: der Aufsteller der Kaffeebar</h2>
    <p class="folie-satz">Erst der Pain, dann das Produkt, dann die Antwort auf die Hürde.</p>
    <Prompt label="Beispiel · Origin Story als Aufstellertext" kopieren={false}>Zug in 8 Minuten, Schlange bis zur Tür?
Bestell im Gehen. Scan den Code, gib deine Abfahrtszeit ein –
wir sagen dir sofort, ob dein Kaffee vor der Abfahrt fertig ist.
Abholen an der Express-Ausgabe. Ohne App, ohne Anmeldung.</Prompt>
    <ul class="gross">
      <li data-schritt><strong>Die eine Handlung:</strong> „Trag deinen Zug ein“ – nicht „E-Mail hinterlassen“.</li>
      <li data-schritt><strong>Sie ist die Messgröße von E1.</strong></li>
    </ul>
    <div class="nur-handout">
      <p>Bei der Kaffeebar ist das der Aufsteller aus E1. Seine Handlung heißt „Trag deinen Zug ein“, nicht „E-Mail hinterlassen“ – sie benennt das Ziel der Person und ist zugleich die Messgröße der Karte.</p>
      <p>Erst der Pain, dann das Produkt, dann die Antwort auf die Hürde – so läuft Lichaws Bogen der Origin Story: erst das Problem, dann die Hürde, dann sieht die Person den Wert ({LICHAW}, Abb. 4.3). Bland baut eine Landingpage anders auf: oben das Wertversprechen, darunter die Handlung, erst darunter Pains, Lösung und Gains ({BLAND}, S. 261). Unser Aufsteller beginnt mit dem Pain, weil er im Vorbeigehen wirken muss – das ist eine Entscheidung des Kurses.</p>
    </div>
  </Folie>

  <Folie>
    <h2 id="hausaufgabe">Hausaufgabe bis Tag 5</h2>
    <p class="folie-satz">Bis Tag 5: Origin Story und eure Karte E1 fertig – Tests mit Menschen sind freiwillig.</p>
    <MiroFrame name="T4 · 6 · Anleitung Origin Story" />
    {/* Die Schritte nur im Beamer; im Handout steht die Checkliste, aus der sie stammen. Seit 27.11.2026 (Dozent): E1 läuft
        nicht, die Karte bleibt Theorie; Reihenfolge Origin Story → Karte E1 → freiwillig Usability-Tests → Aufräumen → bis Tag 5 (seit Code-Review #459 ohne Linear: das braucht Claude Code und kommt an Tag 5). */}
    <ol class="gross dicht nur-beamer">
      <li data-schritt><strong>Origin Story</strong> auf Miro – der Text, mit dem E1 laufen würde: „T4 · 6 · Origin Story · Produkt n“ (<MiroLink name="T4 · 6 · Origin Story · Produkt 1">Produkt 1</MiroLink> · <MiroLink name="T4 · 6 · Origin Story · Produkt 2">2</MiroLink> · <MiroLink name="T4 · 6 · Origin Story · Produkt 3">3</MiroLink> · Beispiel <MiroLink name="T4 · 6 · Origin Story · Kaffeebar">Kaffeebar</MiroLink>).</li>
      <li data-schritt><strong>Karte E1 fertig machen,</strong> falls offen – mit „Wir entscheiden vorher“, im Frame „T4 · 0 · Annahmen der Idee“ (<MiroLink name="T4 · 0 · Annahmen der Idee">Miro</MiroLink>).</li>
      <li data-schritt><strong>Freiwillig: Usability-Tests</strong> mit dem Papier-Prototyp – Karte E2, Befunde in „T4 · 5 · Prototyp · Produkt n“ (<MiroLink name="T4 · 5 · Prototyp · Produkt 1">Produkt 1</MiroLink> · <MiroLink name="T4 · 5 · Prototyp · Produkt 2">2</MiroLink> · <MiroLink name="T4 · 5 · Prototyp · Produkt 3">3</MiroLink>); fünf sind ideal, auch zwei, drei helfen.</li>
      <li data-schritt><strong>Fertig machen, was heute offen blieb</strong> – auch Skizzen und Abnahmekriterien: An Tag 5 baut Claude Code danach (ganze Liste im Handout).</li>
      <li data-schritt><strong>Bis Tag 5:</strong> Claude Code installieren, noch nicht anmelden; die anderen beiden als Collaborator ins Repo. Linear richtet ihr an Tag 5 gemeinsam ein.</li>
    </ol>
    <div class="nur-handout">
      <p>Bei uns läuft E1 nicht: Die Karte E1 (<MiroLink name="T4 · 0 · Annahmen der Idee">Miro, „T4 · 0 · Annahmen der Idee“</MiroLink>) beschreibt, wie ihr eure riskanteste Annahme prüfen würdet; an Tag 5 besprecht ihr, was sie gezeigt hätte (<a href="/innolab/methoden/experiment#so-liefe-e1">So würde E1 laufen</a>). Tests mit Menschen sind freiwillig – mit dem Papier-Prototyp, als Usability-Test mit Karte E2. Claude Code installiert ihr bis Tag 5 (<a href="/setup#lokal-schnellweg">Setup-Skript</a>); Claude Pro schließt ihr erst an Tag 5 gemeinsam ab.</p>
      <p>Anleitung auf Miro: <MiroLink name="T4 · 6 · Anleitung Origin Story">Origin Story</MiroLink>; für E2, falls ihr testet: <MiroLink name="T4 · 6 · Anleitung Lernkarten">Lernkarten</MiroLink>.</p>
