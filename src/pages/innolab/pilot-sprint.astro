---
// PILOT, nicht verlinkt und nicht zum Mergen: Vorschau der Grafik „Scrum auf einem Bild“ (bild/SprintKreislauf.astro)
// als Folien in den Zuständen alles, Planning, Daily, Review, Aufdecken und Kurs-Takt. Astro routet Dateien mit „_“ nicht,
// darum ohne Unterstrich.
import Layout from '../../layouts/Layout.astro';
import Folie from '../../components/Folie.astro';
import SprintKreislauf from '../../components/bild/SprintKreislauf.astro';
---
<Layout title="Pilot: Sprint-Kreislauf">
  <span class="eyebrow">Innolab · Pilot · nicht verlinkt</span>
  <h1>Pilot: Scrum auf einem Bild</h1>

  <Folie>
    <h2 id="alles">Scrum auf einem Bild</h2>
    <p class="folie-satz">Eine Person ordnet, das Team baut ein Inkrement, alle prüfen und passen an – wiederholen.</p>
    <SprintKreislauf id="sk-alles" />
  </Folie>

  <Folie>
    <h2 id="planning">Sprint Planning</h2>
    <p class="folie-satz">Warum, was, wie – daraus wird der Sprint Backlog mit dem Sprint-Ziel.</p>
    <SprintKreislauf id="sk-planning" hervor={['planning', 'sprint-backlog']} />
  </Folie>

  <Folie>
    <h2 id="daily">Daily Scrum</h2>
    <p class="folie-satz">15 Minuten, jeden Tag: der Plan für heute, auf das Sprint-Ziel hin.</p>
    <SprintKreislauf id="sk-daily" hervor="daily" />
  </Folie>

  <Folie>
    <h2 id="review">Sprint Review</h2>
    <p class="folie-satz">Eine Arbeitssitzung mit Stakeholdern, keine Präsentation.</p>
    <SprintKreislauf id="sk-review" hervor="review" />
  </Folie>

  <Folie>
    <h2 id="aufdecken">Schritt für Schritt</h2>
    <p class="folie-satz">Erst das Backlog, dann einmal durch den Sprint.</p>
    <SprintKreislauf id="sk-aufdecken" aufdecken={1} />
  </Folie>

  <Folie>
    <h2 id="takt">Unser Takt</h2>
    <p class="folie-satz">Ein Sprint, drei Produkte, dieselben drei Köpfe.</p>
    <SprintKreislauf id="sk-takt" takt="ein Sprint, 12.–19.12." hervor={['product-backlog', 'sprint-backlog', 'inkrement']} />
  </Folie>
</Layout>
