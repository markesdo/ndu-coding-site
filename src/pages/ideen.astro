---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
const ideen = [
  { t: 'Lerngruppen-Finder', p: 'Wer lernt wann wofür? Gruppe anlegen, beitreten, Termin abstimmen.', s: 'Gruppen anlegen → beitreten → Terminvorschläge → Abstimmung' },
  { t: 'Mensa- & Kaffee-Radar', p: 'Was gibt es heute, wie voll ist es, was sagen andere?', s: 'Tagesmenü anzeigen → Bewertung abgeben → „Wie voll?“-Meldung → Favoriten' },
  { t: 'Skill-Tausch', p: 'Ich kann Figma, du kannst Excel. Angebote und Gesuche unter Studierenden.', s: 'Angebot/Gesuch anlegen → suchen → anfragen → Bewertung' },
  { t: 'Semester-Budget', p: 'Einnahmen, Fixkosten, was bleibt pro Woche? Für Studierende, nicht für Buchhalter*innen.', s: 'Posten erfassen → Wochenbudget → Warnung → Monatsübersicht' },
  { t: 'Praktikums-Tracker', p: 'Bewerbungen, Status, Fristen, Kontakte – statt Excel-Chaos.', s: 'Bewerbung anlegen → Status ändern → Fristen-Erinnerung → Notizen' },
  { t: 'Feedback-Wand', p: 'Anonymes, moderiertes Feedback an Lehrende nach jeder Einheit.', s: 'Einheit anlegen → anonym posten → upvoten → Lehrende antworten' },
  { t: 'Zweitbücher-Börse', p: 'Lehrbücher und Skripten weitergeben – pro Studiengang.', s: 'Inserat → suchen → anfragen → als vergeben markieren' },
  { t: 'Thesis-Buddy', p: 'Schreibfortschritt tracken, Pomodoro-Sessions, Accountability-Partner*in.', s: 'Ziel setzen → Session loggen → Fortschritt → Partner*in einladen' },
  { t: 'Raum-Finder', p: 'Welcher Raum ist jetzt frei zum Lernen? Crowd-gemeldet.', s: 'Räume → „frei/belegt“ melden → Karte → Favoriten' },
  { t: 'Outfit für den Anlass', p: 'Kleider, Anzüge und Accessoires für Ball, Hochzeit oder Präsentation leihen statt kaufen – mit Größe, Anlass und Abholort.', s: 'Anlass wählen → passende Outfits sehen → anfragen → Rückgabe bestätigen' },
];
---
<Layout title="Projektideen">
  <span class="eyebrow">Zwischenwoche</span>
  <h1>Projektideen</h1>
  <p class="lead">Zehn Ideen in der Größe, die in fünf Tagen mit 3–5 Issues machbar ist. Alle mit echten Nutzer*innen in eurer Nähe – das macht das Testen leicht.</p>
  <Callout type="tip" title="Die beste Idee ist eure eigene">
    <p>Ein Problem, das ihr selbst habt, spezifiziert ihr besser als jedes fremde. Nehmt die Liste als Größenmaßstab, nicht als Vorgabe. Und: Leihbar mit drei neuen Issues aus „Später“ weiterzubauen ist ausdrücklich erlaubt.</p>
  </Callout>
  <div class="grid">
    {ideen.map(i => (
      <div class="card"><h3>{i.t}</h3><p class="small">{i.p}</p><p class="small muted"><strong>Issues:</strong> {i.s}</p></div>
    ))}
  </div>
  <h2>Zu groß? Zu klein?</h2>
  <p><strong>Zu groß</strong>, wenn ihr mehr als eine Nutzerrolle mit unterschiedlichen Oberflächen braucht, Zahlungen, Echtzeit-Chat oder eine native App. <strong>Zu klein</strong>, wenn nichts gespeichert wird – dann ist es eine Website, und ihr lernt Datenbank und Login nicht. <strong>Richtig</strong>: eine Rolle, eine Kernaktion, Daten, die nach dem Reload noch da sind, Login erst, wenn es die Kernaktion wirklich braucht.</p>
</Layout>
