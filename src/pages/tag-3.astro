---
import Layout from '../layouts/Layout.astro';
import Orientierung from '../components/Orientierung.astro';
import Block from '../components/Block.astro';
import Checklist from '../components/Checklist.astro';
import Prompt from '../components/Prompt.astro';
import Callout from '../components/Callout.astro';
import FooterNav from '../components/FooterNav.astro';
import KonzeptStation from '../components/KonzeptStation.astro';
import Quiz from '../components/Quiz.astro';
import Fluss from '../components/Fluss.astro';
import Schritte from '../components/Schritte.astro';
import { bild } from '../components/anleitung-bilder';
import { LINEAR_INVITE_URL } from 'astro:env/server';
import { linearEinladung } from '../lib/linear-einladung';
import { Bot, ExternalLink, GitMerge, GitPullRequest, ListTodo, Users } from '@lucide/astro';

const einladung = linearEinladung(LINEAR_INVITE_URL);
// Team-Sprint (Übung 10): an einer Stelle, falls Repo oder Workspace fürs Innolab neu entstehen.
const TEAM_REPO = 'https://github.com/markusd-ndu/leihbar-team';
const TEAM_APP = 'https://leihbar-team.vercel.app';
const TEAM_LINEAR_WS = 'https://linear.app/leihbar-team';
const TEAM_LINEAR = `${TEAM_LINEAR_WS}/project/leihbar-b338831c32cd`;
const teamIssue = (kennung: string) => `${TEAM_LINEAR_WS}/issue/${kennung}`;
// Dieselben Issues als GitHub-Issues im Team-Repo (Ausweg ohne Linear).
const TEAM_GITHUB_ISSUE: Record<string, number> = { 'LEI-5': 1, 'LEI-6': 2, 'LEI-7': 3 };
const teamGithubIssue = (kennung: string) => `${TEAM_REPO}/issues/${TEAM_GITHUB_ISSUE[kennung]}`;
---
<Layout title="Tag 3 · Shippen & selbständig werden">
  <span class="eyebrow">Donnerstag, 15. Oktober 2026 · 09:00–17:00</span>
  <h1>Tag 3 · Shippen & selbständig werden</h1>
  <p class="lead">Euren Prototyp absichern, den nächsten Screen mit Claude Design entwerfen und bauen lassen, zu dritt an einer App arbeiten – und sehen, wo das Programmieren mit KI 2026 steht.</p>
  <Orientierung seite="tag-3" />

  <h2 id="ablauf">Ablauf</h2>
  <div class="schedule" data-kurstag="2026-10-15">
    <Block time="09:00–09:10" type="plenum" title="Stand-up">Reihum: eure App live am Handy, dazu ein Satz, wo es gerade hakt. Gelöst wird in den Übungen.</Block>
    <Block time="09:10–09:35" type="konzept" title="Konzept 7 · Vom Prototyp zum Produkt" href="#konzept-7">Ein Test klickt ein Kriterium von selbst durch, GitHub prüft bei jedem Push, ein frischer Blick prüft vor dem Zusammenführen.</Block>
    <Block time="09:35–10:30" type="uebung" title="Übung 8 · Ein Test, der mich schützt" href="#uebung-8">Eigene App: ein Test, eine automatische Prüfung auf GitHub, ein Pull Request mit Review.</Block>
    <Block time="10:30–10:45" type="pause" title="Pause" />
    <Block time="10:45–11:05" type="konzept" title="Konzept 8 · Design → Code" href="#konzept-8">Warum ein Design-System Drift verhindert, drei Wege vom Entwurf zum Code, was bei der Übergabe verloren geht.</Block>
    <Block time="11:05–12:00" type="uebung" title="Übung 9 · Teil 1 · Entwerfen mit Claude Design" href="#uebung-9">Euer Design-System einlesen, den nächsten Screen entwerfen, Nutzertest mit dem klickbaren Prototyp.</Block>
    <Block time="12:00–13:00" type="pause" title="Mittagspause" />
    <Block time="13:00–13:50" type="uebung" title="Übung 9 · Teil 2 · Übergabe an Claude Code" href="#uebung-9-d">Überarbeiten, an Claude Code übergeben, als Pull Request bauen lassen, Entwurf und Ergebnis vergleichen.</Block>
    <Block time="13:50–14:20" type="konzept" title="Konzept 9 · So wird 2026 gearbeitet" href="#konzept-9">Was die Modelle können, was die Studien sagen, drei Sätze zum Mitnehmen. Live: ein Agent arbeitet in der Cloud.</Block>
    <Block time="14:20–15:40" type="uebung" title="Übung 10 · Team-Sprint" href="#uebung-10">Zu dritt an einer Leihbar: Issue aus Linear, eigener Branch, Pull Request, gegenseitiges Review, zusammenführen.</Block>
    <Block time="15:40–15:50" type="pause" title="Pause" />
    <Block time="15:50–16:40" type="plenum" title="Demos" href="#demos">Rund 15 Minuten pro Person, mit Vorher-Nachher aus Claude Design.</Block>
    <Block time="16:40–17:00" type="plenum" title="Abschluss" href="#abschluss">Innolab, Organisatorisches, Reflexion, Feedback.</Block>
  </div>

  <hr />
  <h2 id="konzept-7">Konzept 7 · Vom Prototyp zum Produkt <span class="pill konzept">25 min</span></h2>
  <KonzeptStation links={[{ href: '/konzepte/qualitaet', t: 'Konzept 7 lesen' }]} danach={{ href: '#uebung-8', t: 'Übung 8' }}>
    <p>In Übung 8 baut ihr in eure eigene App, was einen Prototyp von einem Produkt trennt: Prüfungen, die nicht müde werden.</p>
    <ul>
      <li>Ein Produkt funktioniert immer: auch bei falscher Bedienung, für Fremde, nach der zwanzigsten Änderung.</li>
      <li>Aus einem Akzeptanzkriterium wird ein <strong>Test</strong>, der es von selbst durchklickt, sooft ihr oder Claude ihn startet. Dann kann Claude nicht „fertig“ sagen, bevor es stimmt.</li>
      <li>Bei jedem Push prüft <strong>GitHub</strong> automatisch, ob die App noch baut. Rot heißt: noch nicht zusammenführen.</li>
      <li>Ein <strong>Pull Request</strong> ist die Übergabe: Jemand mit frischem Blick schaut drauf, bevor die Änderung live geht.</li>
    </ul>
  </KonzeptStation>

  {/* Alte Anker aus der Zeit der Werkstätten – geteilte Links führen weiter in den Tag. */}
  <span id="werkstatt"></span>
  <span id="werkstatt-1"></span>
  <hr />
  <h2 id="uebung-8">Übung 8 · Ein Test, der mich schützt <span class="pill uebung">55 min</span></h2>
  <Quiz id="einstieg-u8" einstieg="Konzept 7" fragen={[
    { q: 'Claude schreibt aus einem eurer Akzeptanzkriterien einen Test. Was habt ihr danach?', o: ['Eine Prüfung, die das Kriterium auf Knopfdruck von selbst klickt', 'Den Beweis, dass die App jetzt keine Fehler mehr enthält', 'Eine technische Fassung des Kriteriums, die das Backlog ersetzt'], a: 0, w: 'Ein Test prüft genau das eine Kriterium, aber jedes Mal, wenn er läuft. Fehlerfrei macht er die App nicht – er merkt nur, wenn das Geprüfte kaputtgeht.', mehr: { href: '/konzepte/qualitaet', t: 'Vom Prototyp zum Produkt' } },
    { q: 'Neben eurem Pull Request steht ein rotes X. Was heißt das?', o: ['Vercel hat die App mit dem Fehler schon veröffentlicht', 'Die Person im Review hat den Pull Request abgelehnt', 'Eine automatische Prüfung ist gescheitert, noch nicht mergen'], a: 2, w: 'Das X kommt von der Prüfung, die GitHub bei jedem Push startet. Live ist nur, was in main steht – und dahin kommt die Änderung erst nach dem Zusammenführen.', mehr: { href: '/konzepte/qualitaet', t: 'Vom Prototyp zum Produkt' } },
  ]} />
  <p>Ihr arbeitet an eurer eigenen App aus der Zwischenwoche. Alles in dieser Übung passiert auf einem eigenen <a href="/konzepte/git#branch">Branch</a> – <code>main</code> und damit eure Live-App bleiben unberührt, bis ihr am Ende zusammenführt.</p>

  <h3 id="uebung-8-a">a) Ein Test für ein fertiges Kriterium (20 min)</h3>
  <p>Sucht euch in <code>docs/BACKLOG.md</code> ein fertiges Issue und darin ein Akzeptanzkriterium, das ohne Anmeldung prüfbar ist – zum Beispiel „Gegeben die Liste ist leer, dann sehe ich einen Hinweis“.</p>
  <Prompt label="Test schreiben" note="Der letzte Absatz ist der wichtigste: Ein Test, der nie rot wird, prüft nichts.">Leg einen neuen Branch „test-erster“ an und wechsel darauf. Richte Playwright ein, falls es noch fehlt (nur Chromium). Schreib einen End-to-End-Test für genau dieses Akzeptanzkriterium aus docs/BACKLOG.md: [Kriterium einfügen]. Führe ihn aus, er muss grün sein. Erklär mir in drei Sätzen ohne Fachbegriffe, was der Test im Browser tut.

Dann beweis mir, dass er wirklich prüft: Mach die Funktion vorübergehend kaputt, zeig mir, dass der Test rot wird, und stell den alten Stand wieder her. Commite danach den Test auf dem Branch.</Prompt>
  <p class="small">Hängt die Einrichtung länger als fünf Minuten? Sagt es Claude – oder nehmt für diese Übung einen Test ohne Browser (Claude schlägt einen vor) und macht mit b) weiter.</p>

  <h3 id="uebung-8-b">b) Die Prüfung bei jedem Push (15 min)</h3>
  <p>Ab jetzt prüft GitHub bei jedem Push, ob eure App noch fehlerfrei baut – auch wenn ihr es vergesst, auch nachts um zwei.</p>
  <Prompt label="Automatische Prüfung einrichten">Leg einen GitHub-Actions-Workflow .github/workflows/pruefung.yml an, der bei jedem Push und jedem Pull Request npm ci, npm run lint und npm run build ausführt. Prüf vorher, ob der Build Umgebungsvariablen braucht (z. B. NEXT_PUBLIC_SUPABASE_URL). Wenn ja: Nimm sie aus GitHub-Secrets und sag mir genau, welche Namen ich unter Settings → Secrets and variables → Actions anlegen muss – die Werte trage ich selbst ein, frag mich nicht im Chat danach. Den Playwright-Test nimmst du nicht in den Workflow auf – er braucht die echte Datenbank. Commite auf dem Branch und push.</Prompt>
  <p class="small">Profis lassen auch die Tests bei jedem Push laufen; dafür braucht GitHub eine eigene Test-Datenbank. Heute prüft GitHub, ob die App baut – den Test startet ihr oder Claude vor jedem „fertig“.</p>
  <details class="fallback" id="workflow-abgelehnt">
    <summary>GitHub lehnt den Push ab, in der Meldung steht „workflow“?</summary>
    <p>Dann darf euer Zugang keine Workflow-Dateien schreiben. Legt die Datei auf github.com an: In eurem Repo oben den Branch <code>test-erster</code> wählen → <em>Add file</em> → <em>Create new file</em> → als Namen <code>.github/workflows/pruefung.yml</code> → den Inhalt, den Claude euch zeigt, einfügen → <em>Commit changes</em>. Danach in Claude: „Hol dir den neuesten Stand des Branches von GitHub.“</p>
  </details>
  <p>Jetzt einmal absichtlich rot – damit ihr wisst, wie es aussieht, bevor es ernst wird (<a href="/konzepte/qualitaet#pruefung-1">so sieht rot und grün aus</a>):</p>
  <Prompt label="Einmal rot, einmal grün">Bau absichtlich einen Fehler ein, an dem der Build scheitert – einen Typfehler, z. B. const probe: number = "kein Text"; in einer Seite. Prüf mit npm run build, dass er wirklich scheitert, dann commite und push. Sag mir, wo ich auf GitHub sehe, dass die Prüfung scheitert. Wenn ich es gesehen habe, sage ich „weiter“: dann entfernst du den Fehler wieder, commitest und pushst.</Prompt>

  <h3 id="uebung-8-c">c) Pull Request und Review (20 min)</h3>
  <Prompt label="Pull Request erstellen">Erstelle einen Pull Request von diesem Branch nach main. Die Beschreibung ist ohne Programmierkenntnisse verständlich: was neu ist, wie man es prüft, was noch offen ist. Gib mir den Link.</Prompt>
  <p>Reihum wie in der Dreier-Runde: Schickt den Link an die nächste Person. Sie öffnet ihn und prüft, ohne Code zu lesen:</p>
  <ol class="steps">
    <li><strong>Beschreibung</strong> Verstehe ich, was sich ändert und wie ich es prüfe?</li>
    <li><strong>Prüfung</strong> Steht neben dem letzten Commit ein grüner Haken?</li>
    <li><strong>Vorschau</strong> Hat Vercel eine Vorschau-Adresse in den Pull Request geschrieben, kurz durchklicken. (Öffnet sie nur nach Anmeldung, zeigt die Person ihren Bildschirm.)</li>
    <li><strong>Rückmeldung</strong> Ein Satz als Kommentar im Pull Request – oder direkt am Tisch.</li>
  </ol>
  <p>Ist alles grün und die Rückmeldung eingearbeitet, führt ihr selbst zusammen: auf GitHub <em>Merge pull request</em> → <em>Confirm merge</em>. Erst jetzt geht die Änderung live.</p>
  <Prompt label="Danach, in Claude">Wechsel zurück auf main und hol dir den neuesten Stand von GitHub. Zeig mir mit git status, dass alles sauber ist.</Prompt>

  <hr />
  <h2 id="konzept-8">Konzept 8 · Design → Code <span class="pill konzept">20 min</span></h2>
  <KonzeptStation links={[{ href: '/konzepte/design-system', t: 'Konzept 8 lesen' }]} danach={{ href: '#uebung-9', t: 'Übung 9' }}>
    <p>In Übung 9 entwerft ihr den nächsten Screen eurer App in Claude Design, lasst ihn testen und übergebt ihn an Claude Code.</p>
    <ul>
      <li>Ohne System entscheidet jeder Prompt neu, wie ein Button aussieht. Nach zwanzig Issues wirkt die App zusammengestückelt (<strong>Drift</strong>).</li>
      <li>Ein <strong>Design-System</strong> trifft diese Entscheidungen einmal: Tokens, Komponenten, Regeln.</li>
      <li>Drei Wege vom Entwurf zum Code: aus dem Code selbst, aus Figma (im Innolab), mit <strong>Claude Design</strong>.</li>
      <li>Bei der <strong>Übergabe</strong> reist das Aussehen mit – was beim Klick passiert, bei leeren Daten oder am Handy, müsst ihr dazuschreiben.</li>
    </ul>
  </KonzeptStation>

  <span id="design-system"></span>
  <hr />
  <h2 id="uebung-9">Übung 9 · Entwerfen mit Claude Design <span class="pill uebung">105 min</span></h2>
  <Quiz id="einstieg-u9" einstieg="Konzept 8" fragen={[
    { q: 'Was kommt bei der Übergabe von Claude Design an Claude Code nicht von selbst mit?', o: ['Farben, Schriften und Abstände des Entwurfs', 'Was beim Klick passiert, leere Zustände, Fehler', 'Die Komponenten, aus denen der Entwurf gebaut ist'], a: 1, w: 'Ein Entwurf zeigt einen Zustand. Was dazwischen und daneben passiert, steht im Issue – oder Claude rät.', mehr: { href: '/konzepte/design-system#uebergabe', t: 'Was bei der Übergabe mitreist' } },
    { q: 'Warum liest Claude Design zuerst euer Design-System aus dem Repo?', o: ['Damit der Entwurf die Bausteine nutzt, die im Code schon da sind', 'Damit Claude Design euren Code beim Entwerfen gleich mit verbessert', 'Weil Claude Design ohne Repo gar keine Screens entwerfen kann'], a: 0, w: 'Entwirft Claude Design mit euren Tokens und Komponenten, lässt sich der Entwurf ohne Übersetzung bauen – und eure App driftet nicht.', mehr: { href: '/konzepte/design-system', t: 'Design-System' } },
  ]} />
  <p><strong>Claude Design</strong> ist Anthropics Werkzeug für Entwürfe und klickbare Prototypen. Es ist in eurem Pro-Abo enthalten und steckt direkt in Claude: auf <a href="https://claude.ai" target="_blank" rel="noopener">claude.ai</a> in der Seitenleiste unter <em>Design</em> – links der Chat, rechts die Arbeitsfläche. (Die alte Einzelseite claude.ai/design schließt am 14. Dezember; ihr braucht sie nicht.) Wie an Tag 1 beschreibt ihr, was ihr wollt – nur dass am Ende ein Entwurf steht statt Code.</p>
  {/* PLATZHALTER: Screenshots für b) bis e) (Arbeitsfläche, Kommentare/Regler, Übergabe, Ankunft in Claude Code) folgen.  */}

  <h3 id="uebung-9-a">a) Euer System einlesen (15 min)</h3>
  <p>Claude Design liest euer Repo und baut daraus Farben, Schriften, Komponenten und ein kurzes Markenbuch. Das dauert rund fünf Minuten – lasst es laufen.</p>
  <Schritte id="claude-design" steps={[
    { img: bild('tag3/cd-1-system'), alt: 'Claude mit geöffnetem Design-System: Auswahl „Sync from GitHub“, „Build from connectors“, „Upload brand files“', text: 'Auf <a href="https://claude.ai" target="_blank" rel="noopener">claude.ai</a> links <em>Design</em> (1), dann <em>Design System</em>. Claude fragt, woraus das System entstehen soll: <em>Sync from GitHub</em> (2).', marks: [{ x: 8, y: 220, w: 272, h: 28, n: 1 }, { x: 316, y: 316, w: 377, h: 84, n: 2 }] },
    { img: bild('tag3/cd-2-repo'), alt: 'Rückfrage „Which GitHub repository should I build the design system from?“ mit den Optionen Public repo und Private repo', text: 'Claude fragt nach dem Repo. Ist es öffentlich (<em>Public repo</em>, 1), schreibt ihr einfach die Adresse unten ins Feld (2), z. B. <code>https://github.com/euer-name/euer-repo</code>, und drückt Enter. Ist es privat, schlägt Claude vor, GitHub zu verbinden oder das Repo als ZIP hochzuladen – fragt Markus, wenn ihr unsicher seid.', marks: [{ x: 322, y: 440, w: 364, h: 84, n: 1 }, { x: 316, y: 670, w: 377, h: 46, n: 2 }] },
    { img: bild('tag3/cd-3-ergebnis'), alt: 'Fertiges Design-System „Leihbar“: links die Zusammenfassung, rechts das Markenbuch mit Logo und Farben', text: 'Fertig: Links fasst Claude zusammen, was es aus dem Repo übernommen hat – Farben, Schriften, Komponenten, Fotos (1). Rechts steht das Markenbuch (2). Lest beides: Stimmt das mit eurer App überein?', marks: [{ x: 316, y: 300, w: 377, h: 350, n: 1 }, { x: 734, y: 122, w: 740, h: 610, n: 2 }] },
  ]} />
  <p>Dann prüfen, wie bei jedem Ergebnis eines Agenten: Stimmen die Farben mit eurer App überein? Die Schrift? Sehen die Buttons aus wie eure? Was nicht stimmt, sagt ihr Claude Design im Chat – es ist eure App, nicht seine Vorstellung davon.</p>

  <h3 id="uebung-9-b">b) Den nächsten Screen entwerfen (25 min)</h3>
  <p>Nehmt das nächste offene Issue aus eurem Backlog, das eine Oberfläche hat – oder den Screen eurer App, mit dem ihr am wenigsten zufrieden seid.</p>
  <Prompt label="In Claude Design" note="Die Zustände am Ende sind der Teil, den ein Entwurf sonst vergisst – und den Claude Code später raten müsste.">Entwirf mit unserem Design-System den Screen für dieses Issue: [Issue aus docs/BACKLOG.md einfügen – Ziel und Akzeptanzkriterien]. Zuerst fürs Handy (375 px), dann für den Laptop. Verwende nur unsere Farben, Schriften und Komponenten; wenn dir eine Komponente fehlt, sag es, statt eine zu erfinden. Mach daraus einen klickbaren Prototyp. Zeig zusätzlich diese Zustände: keine Daten, Laden, Fehler.</Prompt>
  <Schritte id="entwerfen" steps={[
    { img: bild('tag3/cd-4-prompt'), alt: 'Neues Design in Claude: Auftrag im Eingabefeld, darunter „Claude Design“ und das gewählte Design-System „Leihbar“', text: 'In Claude links <em>Design</em>, dann die Kachel <em>Design</em> → <em>Start with a prompt</em>. Unter dem Eingabefeld euer Design-System wählen (1) – sonst entwirft Claude mit einer eigenen Optik. Auftrag einfügen, abschicken (2). Claude arbeitet fünf bis zehn Minuten.', marks: [{ x: 812, y: 611, w: 74, h: 26, n: 1 }, { x: 1170, y: 563, w: 36, h: 36, n: 2 }], crop: { x: 540, y: 300, w: 720, h: 360 } },
    { img: bild('tag3/cd-5-canvas'), alt: 'Arbeitsfläche mit Reihen für Handy und Laptop in den Zuständen Daten, Keine Daten, Laden, Fehler; links Claudes Annahmen', text: 'Fertig: Auf der Arbeitsfläche liegen eure Screens nebeneinander, je Zustand einer (1). Links schreibt Claude, <em>was es angenommen hat</em> (2) – lest das genau, es sind die Stellen, an denen euer Issue nichts gesagt hat. Zeigt die Fläche nichts, lädt die Seite einmal neu.', marks: [{ x: 765, y: 205, w: 680, h: 445, n: 1 }, { x: 316, y: 155, w: 377, h: 340, n: 2 }] },
  ]} />

  <h3 id="uebung-9-c">c) Nutzertest am Prototyp (15 min)</h3>
  <p>Reihum: Die nächste Person setzt sich an euren Laptop und bekommt nur einen Satz – die Aufgabe aus dem Issue, zum Beispiel „Biete deine Bohrmaschine an“. Ihr erklärt nichts, ihr schaut zu und schreibt mit:</p>
  <ul>
    <li>Wo hat sie gezögert oder an der falschen Stelle getippt?</li>
    <li>Was hat sie erwartet, das nicht kam?</li>
    <li>Was hat sie laut gesagt?</li>
  </ul>
  <Schritte id="prototyp" steps={[
    { img: bild('tag3/cd-6-play'), alt: 'Menü des Abspielknopfs mit der Liste der Prototypen', text: 'Oben rechts auf das Dreieck (1) und den Prototyp wählen, z. B. <em>Handy · Daten</em> (2).', marks: [{ x: 1328, y: 62, w: 32, h: 32, n: 1 }, { x: 1208, y: 124, w: 142, h: 22, n: 2 }] },
    { img: bild('tag3/cd-7-prototyp'), alt: 'Der Prototyp „Meine Gegenstände“ in Handy-Größe, mit drei Gegenständen und der Zahl offener Anfragen', text: 'Der Prototyp lässt sich anklicken wie eine echte App (1). Mit dem Pfeil oben links geht es zurück zur Arbeitsfläche.', marks: [{ x: 962, y: 112, w: 285, h: 612, n: 1 }] },
  ]} />
  <p>Ein Prototyp kostet Minuten, gebauter Code eine Stunde. Was hier auffällt, ist billig zu ändern.</p>

  <h3 id="uebung-9-d">d) Überarbeiten (10 min)</h3>
  <p>Nach der Mittagspause: Arbeitet die Funde aus dem Nutzertest ein – nur die, die das Problem lösen, keine neuen Funktionen. Zwei Wege, je nachdem, wie groß die Änderung ist:</p>
  <Schritte id="ueberarbeiten" steps={[
    { img: bild('tag3/cd-9-kommentar'), alt: 'Kommentar an einem Button auf der Arbeitsfläche, mit „@Claude“ und „Send to Claude“', text: 'Kommentar: oben rechts die Sprechblase (1), dann an die Stelle klicken, die sich ändern soll. Der Kommentar geht mit <em>Send to Claude</em> direkt als Auftrag an Claude (2). Für alles, was eine Erklärung braucht.', marks: [{ x: 1324, y: 8, w: 30, h: 32, n: 1 }, { x: 1112, y: 407, w: 300, h: 123, n: 2 }] },
    { img: bild('tag3/cd-8-regler'), alt: 'Ausgewählter Button und das Eigenschaften-Feld mit Größe, Layout und Abständen', text: 'Selbst schieben: ein Element anklicken, dann das Eigenschaften-Feld öffnen (1). Dort ändert ihr Größe, Abstände und Ausrichtung direkt (2) – ohne Claude, ohne Wartezeit. Unter <em>Tweaks</em> baut euch Claude auf Wunsch eigene Regler, etwa für die Akzentfarbe.', marks: [{ x: 1062, y: 62, w: 28, h: 30, n: 1 }, { x: 1186, y: 296, w: 308, h: 455, n: 2 }] },
  ]} />

  <h3 id="uebung-9-e">e) Übergabe an Claude Code (30 min)</h3>
  <p>Claude Code kann euren Entwurf direkt lesen – ihr gebt ihm nur den Link. Das klappt, weil ihr in Claude Code mit demselben Claude-Konto angemeldet seid.</p>
  <Schritte id="uebergabe" steps={[
    { img: bild('tag3/cd-10-link'), alt: 'Teilen-Feld des Entwurfs mit „Only you“ und „Copy private link“', text: 'Oben rechts <em>Share</em> (1), dann <em>Copy private link</em> (2). Der Link bleibt privat – nur ihr könnt ihn öffnen, auch Claude Code nur mit eurem Konto.', marks: [{ x: 1384, y: 8, w: 78, h: 32, n: 1 }, { x: 1304, y: 402, w: 158, h: 36, n: 2 }] },
  ]} />
  <p>Dann in Claude Code im Terminal, vorher <code>/clear</code>:</p>
  <Prompt label="Übergabe an Claude Code" note="Statt [Link] den kopierten Link, statt [Issue] die Nummer und den Titel des Issues.">Hier ist mein Entwurf aus Claude Design: [Link]. Lies ihn mit deinem Artifact-Werkzeug und setz ihn als [Issue] um, auf einem neuen Branch – main bleibt unberührt. Nutze die Tokens und Komponenten, die es im Projekt schon gibt; keine neuen Farbwerte in Komponenten. Der Entwurf zeigt das Aussehen, die Akzeptanzkriterien in docs/BACKLOG.md sagen, was passieren muss – bei einem Widerspruch frag mich. Bevor du „fertig“ sagst: npm run lint und npm run build fehlerfrei, den Screen bei 375 und 1280 px ansehen (per Playwright, sonst sag mir, was ich prüfen soll), Beleg pro Akzeptanzkriterium. Dann push und erstelle einen Pull Request mit einer Beschreibung ohne Fachjargon.</Prompt>
  <p class="small">Kann Claude Code den Link nicht lesen? Dann im Entwurf <em>Share</em> → <em>Export</em> → <em>HTML</em> herunterladen, die Datei in den Projektordner ziehen und im Auftrag statt des Links den Dateinamen nennen.</p>
  <p>Prüft selbst im Browser, dann wie in Übung 8: Pull Request, grüner Haken, zusammenführen.</p>

  <h3 id="uebung-9-f">f) Entwurf und Ergebnis vergleichen (10 min)</h3>
  <p>Legt den Prototyp und die gebaute Seite nebeneinander, am Handy und am Laptop. Wo sieht das Ergebnis anders aus als der Entwurf? Was hat Claude Code dazuerfunden, weil der Entwurf es nicht gezeigt hat? Schreibt einen Satz dazu in <code>docs/REFLEXION.md</code>: Was würdet ihr beim nächsten Mal ins Issue schreiben? Und behaltet beide Bilder – sie sind euer Vorher-Nachher für die Demo.</p>

  <hr />
  <h2 id="konzept-9">Konzept 9 · So wird 2026 gearbeitet <span class="pill konzept">30 min</span></h2>
  <KonzeptStation links={[{ href: '/konzepte/ausblick', t: 'Konzept 9 lesen' }]} danach={{ href: '#uebung-10', t: 'Übung 10' }}>
    <p>Nach drei Tagen mit einem Agenten: Wo steht das Programmieren mit KI insgesamt – und was davon bleibt, wenn die Werkzeuge nächstes Jahr anders heißen?</p>
    <ul>
      <li>Ihr beschreibt, der Agent baut, ihr prüft.</li>
      <li>Was wichtig ist, steht in einer Datei, nicht im Kopf.</li>
      <li>Je weniger ihr zuschaut, desto genauer muss die Beschreibung sein.</li>
    </ul>
  </KonzeptStation>

