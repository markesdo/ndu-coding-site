---
import Layout from '../layouts/Layout.astro';
import Orientierung from '../components/Orientierung.astro';
import Block from '../components/Block.astro';
import Checklist from '../components/Checklist.astro';
import Prompt from '../components/Prompt.astro';
import FooterNav from '../components/FooterNav.astro';
import Callout from '../components/Callout.astro';
import IssueKarte from '../components/IssueKarte.astro';
import Schritte from '../components/Schritte.astro';
import UmgebungWahl from '../components/UmgebungWahl.astro';
import KonzeptStation from '../components/KonzeptStation.astro';
import Quiz from '../components/Quiz.astro';
import { bild } from '../components/anleitung-bilder';
---
<Layout title="Tag 2 · Bauen wie ein Profi">
  <span class="eyebrow">Freitag, 9. Oktober 2026 · 09:00–18:00</span>
  <h1>Tag 2 · Bauen wie ein Profi</h1>
  <p class="lead">Die App bekommt echte Daten, Login und eine öffentliche Adresse. Ihr lernt, Fehler zu finden und richtig zu übergeben und den Agenten über längere Arbeit hinweg zu steuern. Am Nachmittag testet ihr eure Apps gegenseitig mit euren Konten und bringt Bewegung hinein.</p>
  <Orientierung seite="tag-2" />
  <UmgebungWahl />

  <h2 id="ablauf">Ablauf</h2>
  <div class="schedule" data-kurstag="2026-10-09">
    <Block time="09:00–09:30" type="plenum" title="Recap, Quiz & neue Issues" href="#quiz">Acht Fragen zu Tag 1. Die neuen Issues für heute in euer Repo holen.</Block>
    <Block time="09:30–10:00" type="konzept" title="Konzept 4 · Daten & Backend" href="#konzept-4">Datenbank, API-Routen, Supabase, Secrets & .env, Row Level Security.</Block>
    <Block time="10:00–10:10" type="pause" title="Pause" />
    <Block time="10:10–11:40" type="uebung" title="Übung 3 · Echte Daten" href="#uebung-3">Supabase-Projekt, MCP verbinden, Issue 4: Gegenstand anbieten und dauerhaft speichern.</Block>
    <Block time="11:40–12:25" type="pause" title="Mittagspause" />
    <Block time="12:25–12:45" type="konzept" title="Konzept 5 · Verifizieren & Debuggen" href="#konzept-5">Browser-Konsole vs. Terminal, Fehler übergeben, Definition of Done.</Block>
    <Block time="12:45–14:15" type="uebung" title="Übung 4 · Login & Anfragen" href="#uebung-4">Issues 5–7. Absichtlich kaputt machen, in der Dreier-Runde reparieren. RLS prüfen.</Block>
    <Block time="14:15–14:30" type="pause" title="Pause" />
    <Block time="14:30–14:45" type="konzept" title="Konzept 6 · Agenten steuern" href="#konzept-6">Kontext-Hygiene, CLAUDE.md pflegen, Kosten.</Block>
    <Block time="14:45–15:30" type="uebung" title="Übung 5 · Deploy" href="#uebung-5">Vercel-Plugin, Deploy durch Claude, Environment-Variablen, öffentliche URL am Handy öffnen.</Block>
    <Block time="15:30–16:45" type="uebung" title="Übung 6 · Gemeinsam" href="#uebung-6">Konten auf den Apps der anderen, Issue 9: Zähler live, Issue 10: Anfragen annehmen oder ablehnen.</Block>
    <Block time="16:45–17:00" type="pause" title="Pause" />
    <Block time="17:00–17:45" type="uebung" title="Übung 7 · Bewegung" href="#uebung-7">Motion einrichten, Issues 12–14: Filter, Anfragen ohne Warten, Erfolgsmoment.</Block>
    <Block time="17:45–18:00" type="plenum" title="Zwischenwoche & Abschluss" href="/zwischenwoche">Eigener Mini-Prototyp für die Demo am Do 15.10. Wie man Hilfe holt.</Block>
  </div>

  <hr />
  <h2 id="quiz">Recap-Quiz</h2>
  <Quiz id="quiz-t1" fragen={[
    { q: 'Jemand klickt auf „Ausleihen anfragen“ und nichts passiert. In der Browser-Konsole steht ein roter Fehler. In welcher Schicht sucht ihr zuerst?', o: ['Frontend', 'Datenbank', 'Hosting'], a: 0, w: 'Die Browser-Konsole zeigt Frontend-Fehler. Terminal-Fehler wären Backend.' },
    { q: 'Claude hat vor 40 Nachrichten eine Designentscheidung mit euch getroffen und hält sich jetzt nicht mehr daran. Wahrscheinlichste Ursache?', o: ['Das Modell hat die Entscheidung überstimmt, weil es eine bessere Lösung kennt', 'Die Entscheidung wurde nie committet, deshalb kennt Claude sie nicht mehr', 'Der Verlauf ist so lang, dass die Entscheidung aus dem Kontext gefallen ist'], a: 2, w: 'Dauerhaftes gehört in CLAUDE.md oder docs/ENTSCHEIDUNGEN.md – dann ist es in jeder Session da.' },
    { q: 'Was ist ein gutes Akzeptanzkriterium?', o: ['„Gegeben der Titel ist leer, wenn ich speichere, dann erscheint eine Fehlermeldung und nichts wird gespeichert.“', '„Das Formular prüft alle Eingaben sorgfältig und zeigt bei Problemen immer eine verständliche, hilfreiche Fehlermeldung an.“', '„Die Prüfung des Titels wird mit einem Zod-Schema in der API-Route umgesetzt.“'], a: 0, w: 'Konkret, durchklickbar, mit Negativfall – und kein Wort zum Wie.' },
    { q: 'Ihr habt eine Stunde mit Claude gearbeitet, nichts committet, und jetzt ist alles kaputt. Was hilft?', o: ['Den Browser-Cache leeren und die Vorschau neu laden', 'Source Control → Discard: zurück zum letzten Commit', 'Mit /clear eine neue Session starten, dann ist der alte Stand wieder da'], a: 1, w: '/clear leert nur Claudes Kontext, nicht eure Dateien. Deshalb: nach jedem funktionierenden Issue committen – dann ist der Rückschritt klein.' },
    { q: 'Ein Issue mit Ziel, Grenze und Akzeptanzkriterien liegt vor euch. Wie geht ihr vor?', o: ['Erst einen Plan schreiben lassen, ihn lesen und freigeben', 'Claude zuerst passende Zusatzfunktionen vorschlagen lassen, damit nichts fehlt', 'Direkt umsetzen lassen und für jedes Kriterium einen Beleg verlangen'], a: 2, w: 'Ein klares Issue ist schon der Plan. Ist etwas unklar, fragt Claude zuerst nach. Ist noch offen, was überhaupt entstehen soll: /ndu-idee und /ndu-brainstorm.' },
    { q: 'Ein API-Key gehört …', o: ['in .env.local – und die ist in .gitignore', 'in die CLAUDE.md, damit Claude ihn in jeder Session kennt', 'in eine eigene Datei config/keys.ts, die nur das Backend importiert'], a: 0, w: 'Ein Key, der einmal auf GitHub war, gilt als verbrannt.' },
    { q: 'Was ist der Unterschied zwischen Website und Web-App?', o: ['Web-Apps sind mit einem Framework wie Next.js gebaut, Websites mit reinem HTML', 'Web-Apps lassen sich installieren und funktionieren auch ohne Internet', 'Web-Apps haben Login, speichern Daten und reagieren auf Nutzer*innen'], a: 2, w: 'Leihbar ist eine Web-App – sobald jemand etwas anfragen kann, speichern wir Daten.' },
    { q: 'Claude sagt „Ich habe das getestet, es funktioniert.“ Was tut ihr?', o: ['Weitermachen – Lint und Build sind grün, das reicht als Prüfung', 'Selbst im Browser prüfen – ihr seid der letzte Prüfschritt', 'Claude fragen, ob es wirklich sicher ist, und der Antwort vertrauen'], a: 1, w: 'Claude sieht euren Browser nicht. Akzeptanzkriterien durchklicken.' },
  ]} />

  <h3 id="neue-issues">Neue Issues in euer Repo holen (5 min)</h3>
  <p>Euer Repo ist eine Kopie der Vorlage vom Mittwoch. Seitdem sind im Backlog der Vorlage die Issues 9–14 für den Nachmittag dazugekommen, und die <code>CLAUDE.md</code> hat zwei neue Regeln: Claude schlägt kein nächstes Issue mehr vor, und für Bewegung ist die Bibliothek Motion freigegeben.</p>
  <Prompt>Lade mit curl die Dateien docs/BACKLOG.md und CLAUDE.md von https://raw.githubusercontent.com/markesdo/ndu-coding-2026/main/ in einen temporären Ordner außerhalb des Projekts. Übernimm alle Issues ab Issue 9 mit ihren Zwischenüberschriften in meine docs/BACKLOG.md, vor den Abschnitt „Später / Ideen“; meine bestehenden Issues und ihr Status bleiben, wie sie sind. Streich „Anfrage annehmen oder ablehnen“ aus meiner Später-Liste. Vergleich dann meine CLAUDE.md mit der neuen und übernimm die neuen Regeln; was ich selbst ergänzt habe, bleibt. Sag mir in drei Sätzen, was sich geändert hat, lösch den temporären Ordner, dann /ndu-commit</Prompt>
  <Callout type="info" title="So läuft heute jedes Issue">
    <ol>
      <li><strong>Lesen:</strong> Die Issue-Karte auf dieser Seite zeigt dasselbe Issue wie euer Backlog. Zu dritt erklären, dann erst den Prompt kopieren.</li>
      <li><strong>Bauen lassen:</strong> Der Prompt sagt nur noch, welches Issue und welche Technik. Was gebaut wird, steht im Issue.</li>
      <li><strong>Prüfen:</strong> Claude zeigt für jedes Kriterium einen Beleg. Ihr hakt auf der Karte nur ab, was ihr selbst im Browser gesehen habt.</li>
      <li><strong>Sichern:</strong> <code>/ndu-check</code>, Issue auf fertig, <code>/ndu-commit</code>, <code>/clear</code>. Welches Issue als Nächstes kommt, entscheidet ihr, nicht Claude.</li>
    </ol>
  </Callout>

  <hr />
  <h2 id="konzept-4">Konzept 4 · Daten & Backend <span class="pill konzept">30 min</span></h2>
  <KonzeptStation links={[{ href: '/konzepte/daten-backend', t: 'Konzept 4 lesen' }, { href: '/konzepte/mcp', t: 'Ergänzung: MCP' }]} danach={{ href: '#uebung-3', t: 'Übung 3 · Echte Daten' }}>
    <p>In Übung 3 legt Claude über den Supabase-MCP eure erste Tabelle an. Was es dabei anlegt und warum, versteht ihr mit diesen Grundlagen.</p>
    <ul>
      <li>Eine Anfrage läuft Frontend → API-Route → Datenbank → Antwort. Was der Browser prüft, kann jede*r umgehen – deshalb prüft das Backend noch einmal.</li>
      <li><strong>Row Level Security</strong> legt in der Datenbank fest, wer welche Zeile lesen, anlegen und löschen darf. Sie ist die letzte Verteidigungslinie.</li>
      <li>Zugangsdaten stehen in <code>.env.local</code> und kommen nie ins Repo. Nur Variablen mit <code>NEXT_PUBLIC_</code> darf der Browser sehen.</li>
      <li>Über <strong>MCP</strong> spricht Claude direkt mit Supabase, statt euch SQL zum Kopieren zu geben.</li>
    </ul>
  </KonzeptStation>

  <hr />
  <h2 id="uebung-3">Übung 3 · Echte Daten <span class="pill uebung">90 min</span></h2>
  <p>Bisher stehen die Gegenstände in einer Datei. Jetzt kommen sie in eine Datenbank – damit ein angebotener Gegenstand auch nach dem Reload und für alle anderen da ist.</p>
  <Quiz id="einstieg-u3" einstieg="Konzept 4 und MCP" fragen={[
    { q: 'Anbieten dürfen nur Angemeldete, und das Formular kann das prüfen. Warum braucht die Tabelle items trotzdem Row Level Security?', o: ['Was der Browser prüft, kann jede*r umgehen – RLS prüft in der Datenbank selbst', 'RLS verschlüsselt die Zeilen in der Datenbank, damit Fremde sie nicht lesen können', 'RLS ersetzt die Prüfung im Formular, die kann man dann weglassen'], a: 0, w: 'RLS greift auch dann, wenn Frontend oder API-Route einen Fehler haben. Fragt Claude bei jeder neuen Tabelle nach den Policies.', mehr: { href: '/konzepte/daten-backend', t: 'Daten & Backend' } },
    { q: 'Ihr schreibt: „Leg eine Tabelle items an.“ Was ist mit Supabase-MCP anders als ohne?', o: ['Claude liefert das SQL, ihr fügt es im Dashboard ein und meldet das Ergebnis zurück', 'Claude lädt die Supabase-Doku in den Kontext und schreibt das SQL fehlerfrei', 'Claude legt die Tabelle selbst an und sieht, was die Datenbank antwortet'], a: 2, w: 'Ohne MCP seid ihr der Bote zwischen Claude und der Datenbank. Mit MCP sieht Claude selbst, was die Datenbank antwortet.', mehr: { href: '/konzepte/mcp', t: 'MCP' } },
  ]} />
  <h3 id="supabase">a) Supabase-Projekt (gemeinsam, 15 min)</h3>
  <p class="small muted">Screenshots vom Testdurchgang mit einem neuen Konto am 5.10.2026. Klick auf ein Bild vergrößert es.</p>
  <Schritte id="supabase" nummer="3a" steps={[
    { img: bild('tag2/sb-1-login'), alt: 'Supabase-Anmeldeseite mit „Continue with GitHub“', text: '<a href="https://supabase.com/dashboard" target="_blank" rel="noopener">supabase.com/dashboard</a> öffnen, <em>Continue with GitHub</em>. Den Cookie-Hinweis könnt ihr mit <em>Opt out</em> ablehnen.', marks: [{ x: 115, y: 230, w: 348, h: 42 }] },
    { img: bild('tag2/sb-2-authorize'), alt: 'GitHub fragt „Authorize Supabase“', text: 'GitHub fragt, ob Supabase eure E-Mail-Adresse lesen darf: <em>Authorize supabase</em>. Der Button wird erst nach einer Sekunde aktiv.', marks: [{ x: 748, y: 377, w: 204, h: 36 }] },
    { img: bild('tag2/sb-3-orgs'), alt: 'Leere Organisationsliste mit Button „New organization“', text: 'Neue Konten starten ohne Organisation. <em>New organization</em>.', marks: [{ x: 681, y: 269, w: 134, h: 30 }] },
    { img: bild('tag2/sb-4-org'), alt: 'Formular „Create a new organization“ mit Type Personal und Plan Free', text: 'Name übernehmen, <em>Personal</em> und <em>Free – $0/month</em> lassen, <em>Create organization</em>.', marks: [{ x: 911, y: 437, w: 126, h: 30 }] },
    { img: bild('tag2/sb-5-region'), alt: 'Regionsauswahl, Central EU (Frankfurt) unter Specific Regions', text: 'Im Formular „Create a new project“ die Region öffnen. Vorausgewählt ist „Europe“; scrollt unter <em>Specific Regions</em> zu <em>Central EU (Frankfurt)</em>.', marks: [{ x: 686, y: 290, w: 250, h: 26 }] },
    { img: bild('tag2/sb-6-projekt'), alt: 'Ausgefülltes Projektformular mit Name, Passwort, Region Frankfurt und Security-Optionen', text: 'Name <code>leihbar</code> (1). <em>Generate a password</em>, dann <em>Copy</em> (2) und das Passwort im Passwortmanager speichern – Supabase zeigt es nie wieder. Region Frankfurt (3). Unter <em>Security</em> zusätzlich <em>Enable automatic RLS</em> anhaken (4): Jede neue Tabelle ist dann von Anfang an durch Row Level Security geschützt. <em>Create new project</em> (5).', marks: [{ x: 638, y: 310, w: 356, h: 30, n: 1 }, { x: 929, y: 371, w: 64, h: 22, n: 2 }, { x: 638, y: 457, w: 356, h: 30, n: 3 }, { x: 637, y: 651, w: 150, h: 20, n: 4 }, { x: 885, y: 778, w: 109, h: 22, n: 5 }] },
    { img: bild('tag2/sb-7-uebersicht'), alt: 'Projektübersicht des neuen Projekts, Status Healthy, oben der grüne Button „Connect“', text: 'Nach etwa 10 Sekunden steht das Projekt auf „Healthy“. Oben auf <em>Connect</em>.', marks: [{ x: 492, y: 8, w: 78, h: 24 }] },
    { img: bild('tag2/sb-8-connect'), alt: 'Connect-Dialog, Framework Next.js, darunter der Inhalt für .env.local', text: '<em>Framework</em> → <em>Next.js</em> (1). Unter „Add files“ steht der fertige Inhalt für <code>.env.local</code> (2): Project URL und Publishable Key (<code>sb_publishable_…</code>). Den braucht ihr gleich in Schritt c). Die „Legacy“-Keys (anon, service_role) braucht ihr nicht.', marks: [{ x: 979, y: 237, w: 445, h: 29, n: 1 }, { x: 1062, y: 592, w: 362, h: 34, n: 2 }] },
  ]} />
  <p><strong>E-Mail-Bestätigung aus</strong> (für den Kurs): Authentication → <em>Sign In / Providers</em> → „Confirm email“ deaktivieren. Sonst braucht jede Test-Anmeldung eine echte E-Mail.</p>

  <UmgebungWahl />
  <h3 id="mcp">b) Supabase-MCP verbinden (10 min)</h3>
  <p>MCP ist die Steckdose, über die Claude direkt mit Supabase sprechen kann: Tabellen anlegen, Daten ansehen, Fehler lesen – ohne dass ihr etwas kopiert. Den Befehl dafür liefert Supabase fertig mit.</p>
  <Schritte id="mcp" nummer="3b" steps={[
    { img: bild('tag2/mcp-1-connect'), alt: 'Connect-Dialog, Tab MCP, Client Claude Code, Schritt 1 mit dem Befehl claude mcp add', text: 'Im Connect-Dialog den Tab <em>MCP</em> (1). Client <em>Claude Code</em> ist vorausgewählt. Bei Schritt 1 den ganzen Befehl kopieren (2) – er ist länger als der Kasten, deshalb nicht von Hand markieren, sondern den Kopier-Knopf rechts im Kasten nehmen. Schritt 3 (<em>Agent Skills</em>) ist optional – den überspringt ihr.', marks: [{ x: 1290, y: 105, w: 134, h: 78, n: 1 }, { x: 1052, y: 540, w: 372, h: 44, n: 2 }] },
    { img: bild('tag2/mcp-2-einfuegen'), alt: 'Neues Terminal in VS Code mit eingefügtem Befehl claude mcp add', text: 'In VS Code über dem Terminal auf <kbd>+</kbd> – ein neues Terminal, nicht das mit Claude. Warten, bis die Eingabezeile mit eurem Benutzernamen erscheint, dann einfügen (<kbd>Cmd</kbd>/<kbd>Strg</kbd>+<kbd>V</kbd>) und <kbd>Enter</kbd>. Wer zu früh einfügt, bekommt den Befehl doppelt: <kbd>Strg</kbd>+<kbd>C</kbd> und nochmal.', marks: [{ x: 366, y: 566, w: 1000, h: 26 }] },
    { img: bild('tag2/mcp-3-angelegt'), alt: 'Terminal meldet „Added HTTP MCP server supabase … to project config“, links erscheint .mcp.json', text: '„Added HTTP MCP server supabase“ (1). Links steht die Datei <code>.mcp.json</code> (2) – Context7 war schon drin, Supabase kommt dazu. Sie enthält nur Adressen, keine Schlüssel, und darf mit committet werden.', marks: [{ x: 366, y: 594, w: 615, h: 15, n: 1 }, { x: 60, y: 315, w: 270, h: 17, n: 2 }] },
    { img: bild('tag2/mcp-4-gefunden'), alt: 'Claude meldet „New MCP server found in this project: supabase“, vorausgewählt ist „Continue without using this MCP server“', text: 'Im selben Terminal <code>claude</code> starten. Claude meldet den neuen Server. <strong>Achtung:</strong> Vorausgewählt ist <em>Continue without using this MCP server</em>. Zweimal <kbd>↑</kbd> auf <em>Use this MCP server</em>, dann <kbd>Enter</kbd>.', marks: [{ x: 392, y: 648, w: 145, h: 18 }] },
    { img: bild('tag2/mcp-5-liste'), alt: 'Ausgabe von /mcp, supabase „needs authentication“', text: '<code>/mcp</code> eintippen, <kbd>Enter</kbd>. Bei <em>supabase</em> steht „needs authentication“: mit <kbd>↓</kbd> darauf gehen, <kbd>Enter</kbd>.', marks: [{ x: 398, y: 677, w: 340, h: 17 }] },
    { img: bild('tag2/mcp-6-authenticate'), alt: 'Menü des Supabase-MCP-Servers mit „1. Authenticate“', text: '<em>1. Authenticate</em>, <kbd>Enter</kbd>.', marks: [{ x: 383, y: 747, w: 130, h: 17 }] },
  ]} />
  <div data-nur="codespace">
    <Schritte id="mcp" nummer="3b" start={7} steps={[
      { img: bild('tag2/mcp-7-open'), alt: 'VS Code fragt, ob die Supabase-Seite geöffnet werden soll', text: 'VS Code fragt nach: <em>Open</em>.', marks: [{ x: 1373, y: 465, w: 48, h: 32 }] },
    ]} />
  </div>
  <Schritte id="mcp" nummer="3b" start={8} steps={[
    { img: bild('tag2/mcp-8-authorize'), alt: 'Supabase-Seite „Authorize Claude Code (supabase)“ mit vorausgewählter Organisation', text: 'Supabase zeigt, worauf Claude zugreifen darf. <em>Authorize Claude Code (supabase)</em>. <span data-nur="codespace">Danach erscheint – wie beim Claude-Login – die Fehlerseite „nicht erreichbar“ mit <code>localhost</code> in der Adresse. Weiter mit dem Kasten unter den Bildern.</span> <span data-nur="lokal">Danach springt der Browser von selbst zu Claude zurück.</span>', marks: [{ x: 588, y: 587, w: 320, h: 30 }] },
    { img: bild('tag2/mcp-9-verbunden'), alt: 'Claude meldet „Authentication successful. Connected to supabase.“', text: 'Geschafft: „Authentication successful. Connected to supabase.“ Testet es mit einer Frage, z. B. „Welche Tabellen hat mein Supabase-Projekt?“', marks: [{ x: 398, y: 688, w: 395, h: 18 }] },
  ]} />
  <div data-nur="codespace">
    <Callout type="warn" title="Fehlerseite „localhost“ nach Authorize – so geht es weiter">
      <p>Die Anmeldung schickt euren Browser an <code>localhost</code>, also an euren eigenen Rechner. Claude wartet aber im Codespace. Ihr reicht die Adresse von Hand weiter:</p>
      <ol>
        <li>Auf der Fehlerseite die komplette Adresse oben in der Adressleiste kopieren (sie beginnt mit <code>http://localhost:</code>).</li>
        <li>Im Codespace im Terminal mit <kbd>+</kbd> ein weiteres Terminal öffnen.</li>
        <li>Dort <code>curl "</code>, die Adresse einfügen, <code>"</code> und <kbd>Enter</kbd> – also wie unten, nur mit eurer Adresse.</li>
        <li>Ganz am Ende der Ausgabe steht „Authentication successful“. Zurück ins Claude-Terminal.</li>
      </ol>
    </Callout>
    <Prompt label="Im zweiten Terminal (nicht in Claude) – Adresse aus der Fehlerseite einsetzen">curl "http://localhost:12345/callback?code=…"</Prompt>
  </div>
  <p><strong>Falls die Anmeldung trotzdem nicht klappt:</strong> Verbindet den MCP-Server stattdessen mit einem persönlichen Zugriffstoken.</p>
  <ol class="small">
    <li>Supabase → Account → <a href="https://supabase.com/dashboard/account/tokens" target="_blank" rel="noopener">Access Tokens</a> → neuen Token erzeugen, Name „Kurs-MCP“, auf euer Projekt <code>leihbar</code> beschränken. Token kopieren – er wird nur einmal angezeigt.</li>
    <li>Im Terminal den bisherigen Eintrag entfernen: <code>claude mcp remove supabase</code></li>
    <li>Neu verbinden – <code>PROJECT-REF</code> und <code>TOKEN</code> ersetzen. Den <em>Project Ref</em> findet ihr in der Projekt-Adresse auf der Supabase-Übersicht (<code>https://<strong>abcdefgh</strong>.supabase.co</code> – das fett gedruckte Stück) oder in der Adresszeile des Dashboards nach <code>/project/</code>:</li>
  </ol>
  <Prompt label="Im Terminal (nicht in Claude) – Alternative mit Token">claude mcp add --transport http supabase "https://mcp.supabase.com/mcp?project_ref=PROJECT-REF" --header "Authorization: Bearer TOKEN"</Prompt>
  <p class="small muted">Der Token ist ein Schlüssel zu eurem Supabase-Konto: Er liegt nur bei euch (im Codespace bzw. auf dem Laptop), nie im Repo. Fügt ihn nie in den Chat mit Claude oder in eine Datei im Projekt ein. Nach dem Kurs könnt ihr ihn unter Access Tokens wieder löschen.</p>
  <h3 id="context7">c) Aktuelle Doku: mit und ohne Context7 (5 min)</h3>
  <p>Context7 ist seit Tag 1 in eurem Projekt eingerichtet. Jetzt seht ihr, was es ändert. Erst ohne:</p>
  <Prompt>Wie lege ich mit @supabase/ssr in Next.js einen Supabase-Client für Server Components an? Schlag diesmal nichts nach, antworte aus deinem Wissen und sag, wie sicher du bist.</Prompt>
  <p>Dann <code>/clear</code> und dieselbe Frage mit Doku:</p>
  <Prompt>Wie lege ich mit @supabase/ssr in Next.js einen Supabase-Client für Server Components an? use context7, library /supabase/supabase. Nenn mir die Doku-Stelle, auf die du dich stützt.</Prompt>
  <p>→ Vergleicht: Heißen die Funktionen gleich? Was fehlt in der ersten Antwort? Warum das so ist, steht unter <a href="/konzepte/llm#training">Training und Session</a>; wie man Context7 gut einsetzt, unter <a href="/konzepte/mcp#context7">MCP-Server</a>.</p>
  <h3 id="uebung-3-d">d) .env.local anlegen (5 min)</h3>
  <Prompt>Leg eine .env.local nach dem Muster von .env.example an und sag mir, welche Werte ich wo eintragen soll. Danach prüfe, dass .env.local in .gitignore steht.</Prompt>
  <h3 id="uebung-3-e">e) Issue 4 lesen und bauen lassen (45 min)</h3>
  <IssueKarte nr={4} dauer="45 min" />
