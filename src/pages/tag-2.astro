  <script>
    // Zeigt ein Link (z. B. #vercel-12) in den zugeklappten Ausweichweg, aufklappen und hinspringen.
    const oeffne = () => {
      let ziel = null;
      try { ziel = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null; } catch {}
      const d = ziel?.closest('details');
      if (d && !d.open) { d.open = true; ziel!.scrollIntoView(); }
    };
    oeffne();
    window.addEventListener('hashchange', oeffne);
  </script>
